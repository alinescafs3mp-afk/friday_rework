@@ -0,0 +1,95 @@
+"""Credential input must be refused before web provider/config/DNS/cache effects."""
+import asyncio
+import json
+
+import pytest
+
+from tools import web_tools
+
+
+@pytest.fixture
+def no_web_effects(monkeypatch):
+    effects = []
+    def forbidden(*args, **kwargs):
+        effects.append((args, kwargs))
+        raise AssertionError('credential preflight reached a web effect')
+    monkeypatch.setattr(web_tools, '_ensure_web_plugins_loaded', forbidden)
+    monkeypatch.setattr(web_tools, 'async_is_safe_url', forbidden)
+    monkeypatch.setattr(web_tools, '_finish_debug', forbidden)
+    return effects
+
+
+@pytest.mark.parametrize('url', [
+    'https://public.example/page?token=opaque-value',
+    'https://public.example/page?%74oken=opaque-value',
+    'https://public.example/page?%2574oken=opaque-value',
+    'https://public.example/page?API_KEY=opaque-value',
+    'https://public.example/page?X-Amz-Signature=opaque-value',
+    'https://public.example/page?client_secret=opaque-value',
+    'https://user:opaque-value@public.example/page',
+    'https://opaque-value@public.example/page',
+])
+def test_credential_urls_refuse_whole_extract_before_effects(url, no_web_effects):
+    result = json.loads(asyncio.run(web_tools.web_extract_tool([
+        'https://public.example/public', {'href': url}])))
+    assert result['success'] is False and 'Blocked:' in result['error']
+    assert 'opaque-value' not in json.dumps(result)
+    assert no_web_effects == []
+
+
+@pytest.mark.parametrize('query', [
+    'Find this sk-proj-' + 'a'*56,
+    'Find this sk%2Dproj%2D' + 'a'*56,
+    'Summarize https://public.example/page?token=opaque-value',
+    'Summarize HTTPS://public.example/page?%74oken=opaque-value',
+    'Summarize https%3A%2F%2Fpublic.example%2Fpage%3Ftoken%3Dopaque-value',
+    'Summarize https://public.example/page?token=%20opaque-value',
+    'Summarize https://public.example/page?token=%22opaque-value',
+    'Summarize https://%20opaque-value@public.example/page',
+    'Summarize https%3A%2F%2Fpublic.example%2Fpage%3Ftoken%3D%20opaque-value',
+    'Summarize https%3A%2F%2Fpublic.example%2Fpage%3Ftoken%3D%22opaque-value',
+    'Summarize https%3A%2F%2F%20opaque-value%40public.example%2Fpage',
+    'Read "https://user:opaque-value@public.example/page"',
+])
+def test_credential_search_refuses_before_effects(query, no_web_effects):
+    result = json.loads(web_tools.web_search_tool(query))
+    assert result['success'] is False and 'Blocked:' in result['error']
+    assert 'opaque-value' not in json.dumps(result) and 'a'*56 not in json.dumps(result)
+    assert no_web_effects == []
+
+
+@pytest.mark.parametrize('url', [
+    'https://public.example/page?q=token&key=public&code=200',
+    'https://public.example/page?token=&api_key=',
+    'https://public.example/page?session=public&sig=public',
+    'https://public.example/K%C3%B6ln?q=%D0%BF%D0%BE%D0%B8%D1%81%D0%BA',
+])
+def test_ordinary_query_facets_still_reach_native_dns_gate(url, monkeypatch):
+    seen = []
+    async def denied(value):
+        seen.append(value)
+        return False
+    monkeypatch.setattr(web_tools, 'async_is_safe_url', denied)
+    monkeypatch.setattr(web_tools, '_finish_debug', lambda *args: None)
+    result = json.loads(asyncio.run(web_tools.web_extract_tool([url])))
+    assert seen == [url]
+    assert 'private or internal' in result['results'][0]['error']
+
+
+@pytest.mark.parametrize('query', [
+    'Summarize "https://public.example/page?token=&api_key="',
+    'Summarize https://public.example/page?q=public%26token%3Ddocumentation',
+])
+def test_public_search_url_keeps_original_parameter_structure(query, monkeypatch):
+    from types import SimpleNamespace
+    from agent import web_search_registry
+    seen = []
+    monkeypatch.setattr(web_tools, '_ensure_web_plugins_loaded', lambda: None)
+    monkeypatch.setattr(web_tools, '_get_search_backend', lambda: 'fixture')
+    monkeypatch.setattr(web_search_registry, 'get_provider', lambda name:
+        SimpleNamespace(name='fixture', supports_search=lambda: True))
+    monkeypatch.setattr(web_tools, '_memoized_search', lambda provider, value, limit:
+        seen.append(value) or {'success': True, 'data': {'web': []}})
+    monkeypatch.setattr(web_tools, '_finish_debug', lambda *args: None)
+    assert json.loads(web_tools.web_search_tool(query))['success']
+    assert seen == [query]
