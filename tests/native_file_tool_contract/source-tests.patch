+"""Gateway config reload must replace frozen tool schemas only when their inputs change."""
+import copy
+import threading
+from types import SimpleNamespace
+import pytest
+from gateway.run import GatewayRunner
+from gateway.run_turn_runner import TurnRunner
+from tools.tool_search import assemble_tool_defs,ToolSearchConfig
+from tools.file_tools import READ_FILE_SCHEMA,WRITE_FILE_SCHEMA
+
+
+def harness(config):
+    runner=GatewayRunner.__new__(GatewayRunner)
+    runner._agent_cache={};runner._agent_cache_lock=threading.Lock();runner._session_db=None
+    runner._enforce_agent_cache_cap=lambda:None
+    runner._refresh_fallback_model=lambda:None
+    runner._apply_fallback_chain_to_agent=lambda *args:None
+    context=SimpleNamespace(user_config=copy.deepcopy(config),enabled_toolsets=['file'],
+        source=SimpleNamespace(user_id='synthetic-user',user_id_alt=None),
+        session_id='synthetic-session',session_key='synthetic-key',_interrupt_depth=0)
+    turn=TurnRunner(runner,context)
+    created=[]
+    def build(*args):
+        # No model constructor or transport. Actual native schema assembly provides
+        # the frozen material whose lifetime the real TurnRunner cache owns.
+        schemas=[{'type':'function','function':copy.deepcopy(schema)}
+                 for schema in (READ_FILE_SCHEMA,WRITE_FILE_SCHEMA)]
+        search=context.user_config['tools']['tool_search']
+        tools=assemble_tool_defs(schemas,context_length=262144,
+            config=ToolSearchConfig.from_raw(search)).tool_defs
+        agent=SimpleNamespace(tools=tools,session_id=context.session_id)
+        created.append(agent)
+        return agent
+    turn._build_fresh_agent=build
+    def resolve():
+        return turn._resolve_turn_agent({'model':'offline-main','runtime':{'provider':'custom'}},
+            'telegram','',8,None,{})
+    return context,created,resolve
+
+
+@pytest.mark.parametrize('previous',['auto','on'])
+def test_switch_to_flat_rebuilds_cached_agent_at_next_turn(previous):
+    context,created,resolve=harness({'tools':{'tool_search':{'enabled':previous,'defer':['read_file','write_file']}}})
+    before,reused=resolve()
+    assert not reused
+    assert {t['function']['name'] for t in before.tools}=={'tool_search','tool_describe','tool_call'}
+    assert resolve()==(before,True)
+    original=copy.deepcopy(before.tools)
+    # Represents the existing supported config reload, not an in-flight mutation.
+    context.user_config=copy.deepcopy(context.user_config)
+    context.user_config['tools']['tool_search']['enabled']='off'
+    after,reused=resolve()
+    assert not reused and after is not before and len(created)==2
+    assert {t['function']['name'] for t in after.tools}=={'read_file','write_file'}
+    assert before.tools==original
+    assert resolve()==(after,True) and len(created)==2
+
+
+def test_unrelated_config_keeps_same_agent_and_schema_snapshot():
+    context,created,resolve=harness({'tools':{'tool_search':{'enabled':'off','defer':['read_file']}}})
+    agent,reused=resolve()
+    assert not reused
+    context.user_config=copy.deepcopy(context.user_config)
+    context.user_config['display']={'tool_progress':'verbose'}
+    assert resolve()==(agent,True) and len(created)==1
