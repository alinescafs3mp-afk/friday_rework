+"""Real native scoped schemas, file I/O and media resolution; no model or transport calls."""
+import copy
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+from tests.hermes_cli.ordinary_file_contract_fixtures import env, entered, home, scope, native_agent
+from hermes_cli import friday_prompt_scope as prompts
+from agent import system_prompt
+import model_tools
+from tools.tool_search import ToolSearchConfig, assemble_tool_defs, dispatch_tool_describe
+from gateway.platforms.base import BasePlatformAdapter
+
+
+def names(rows):
+    return {r['function']['name'] for r in rows}
+
+
+def definitions():
+    return model_tools.get_tool_definitions(enabled_toolsets=['file'], quiet_mode=True)
+
+
+def test_flat_schemas_bind_exact_user_grants_and_cache(env,monkeypatch):
+    with entered(env):
+        first=definitions()
+        assert names(first)=={'read_file','write_file'}
+        assert names(definitions())==names(first)
+    with entered(env,'2'):
+        assert names(definitions())=={'read_file'}
+    with entered(env):
+        assert names(definitions())=={'read_file','write_file'}
+        by_name={r['function']['name']:r['function'] for r in first}
+        assert 'own workspace' in by_name['write_file']['parameters']['properties']['path']['description']
+        assert 'Creates parent directories automatically' not in by_name['write_file']['description']
+        assert 'patch' not in by_name['write_file']['description']
+        assert 'Other binary formats are unsupported' in by_name['read_file']['description']
+    # A fresh unscoped operator process retains native file capabilities.
+    monkeypatch.setattr(scope,'_ENGAGED',False)
+    assert {'read_file','write_file','search_files','patch'} <= names(definitions())
+
+
+@pytest.mark.parametrize('env',['auto','on'],indirect=True)
+def test_bridge_catalog_is_filtered_before_disclosure(env):
+    with entered(env):
+        advertised=definitions()
+        assert names(advertised)==scope.BRIDGES
+        raw=model_tools.get_tool_definitions(enabled_toolsets=['file'],quiet_mode=True,skip_tool_search_assembly=True)
+        assert names(raw)=={'read_file','write_file'}
+        described=json.loads(dispatch_tool_describe({'names':['write_file','search_files']},current_tool_defs=raw))
+        assert set(described['tools'])=={'write_file'}
+        assert 'search_files' in described['not_found']
+        assert 'relative path' in described['tools']['write_file']['description']
+        assert 'search_files' not in json.dumps(advertised)
+        # Explicit auto/on retain native behavior even at the large main context.
+        assert assemble_tool_defs(raw,context_length=262144,config=ToolSearchConfig.from_raw({'enabled':'auto','defer':['read_file','write_file']})).activated
+
+
+@pytest.mark.parametrize('filename',['notes with spaces.txt','заметки с пробелами.txt'])
+def test_create_deliver_and_followup_reuse_the_relative_anchor(env,filename):
+    with entered(env) as cap:
+        agent=native_agent()
+        agent.platform='telegram'
+        hint='\n'.join(system_prompt._post_workspace_parts(agent))
+        full=system_prompt.build_system_prompt(agent,None)
+        assert hint in full and 'MEDIA:/absolute/path/to/file' not in full
+        assert 'MEDIA:"./file"' in hint and 'MEDIA:/absolute/' not in hint
+        assert 'returned path directly' in hint
+        assert 'not delivery' in hint
+        before=copy.deepcopy(definitions())
+        result=json.loads(model_tools.handle_function_call('write_file',{'path':filename,'content':'one\ntwo\n'},task_id='synthetic-contract'))
+        assert result['success'] is True and result['create_only'] is True
+        assert result['path']==filename
+        target=cap.home/'workspace'/result['path']
+        original=target.stat()
+        reply='Prepared file.\nMEDIA:"./'+result['path']+'"'
+        guarded,refused=scope.guard_generated_reply(agent,reply)
+        assert refused is False
+        media,clean=BasePlatformAdapter.extract_media(guarded)
+        assert media==[(str(target),False)] and clean=='Prepared file.'
+        assert BasePlatformAdapter.validate_media_delivery_path(media[0][0])==str(target)
+        # A later resend consumes the same anchor; it neither searches nor writes.
+        assert BasePlatformAdapter.extract_media(reply)[0]==media
+        assert target.stat().st_ino==original.st_ino and target.read_bytes()==b'one\ntwo\n'
+        read=json.loads(model_tools.handle_function_call('read_file',{'path':result['path']},task_id='synthetic-followup'))
+        assert read['success'] is True and 'one' in read['content']
+        assert definitions()==before
+        # Quoted instructions are examples, never attachment requests.
+        assert BasePlatformAdapter.extract_media('```\n'+reply+'\n```')[0]==[]
+
+
+@pytest.mark.parametrize('args',[
+    {'calls':'[{"arguments":{"path":"x.txt"}}]'},
+    {'calls':'[{"name":"write_file","arguments":{"path":"x.txt","content":"x"}}'},
+    {'calls':[{'name':'search_files','arguments':{'path':'.','pattern':'*'}}]},
+    {'calls':[{'name':'write_file','arguments':{'path':'ok.txt','content':'x'}},{'name':'search_files','arguments':{'pattern':'*'}}]},
+])
+def test_malformed_and_disallowed_calls_remain_fail_closed(env,args):
+    with entered(env) as cap:
+        with pytest.raises(scope.ScopeDenied):scope.guard_tool('tool_call',args)
+        assert list((cap.home/'workspace').iterdir())==[]
+
+
+def test_unmanaged_file_schema_and_platform_hint_unchanged():
+    from tools.file_tools import WRITE_FILE_SCHEMA
+    definition={'type':'function','function':copy.deepcopy(WRITE_FILE_SCHEMA)}
+    assert prompts.ordinary_file_schema(definition) is definition
+    original='Send MEDIA:/absolute/path/to/file'
+    assert prompts.ordinary_platform_hint(SimpleNamespace(),original)==original
