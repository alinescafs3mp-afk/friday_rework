# SOURCE CANDIDATE ONLY; no kernel load performed.
# Only the root-owned Friday bwrap copy attaches; global bwrap stays unchanged.
abi <abi/5.0>,
include <tunables/global>

profile friday-dsh-native-v1 /usr/local/libexec/friday-dsh-bwrap flags=(attach_disconnected,mediate_deleted) {
  # AppArmor permission only; this does not grant Linux capabilities.
  capability sys_admin,
  capability sys_chroot,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns create,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # Every non-trusted exec stacks an irreversible cap/userns denial.
  allow px /** -> friday-dsh-native-v1//&friday-dsh-command-v1,

  # Secure-exec bwrap prevents model-controlled loader environment injection.
  priority=100 allow /usr/bin/bwrap mrPx -> friday-dsh-native-v1,
  priority=100 allow /usr/local/libexec/friday-dsh-bwrap mrPx -> friday-dsh-native-v1,
  # Existing outer bootstrap clears environment before the exact pinned Node.
  priority=100 allow /usr/bin/python3.14 mrix,
  priority=100 allow /home/jericho/.jericho/runtime/friday-toolchain22.bSt8Uu/node-v22.23.2-linux-x64/bin/node mrix,
}

profile friday-dsh-command-v1 flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkmix /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow dbus,
  audit deny capability,
  audit deny userns,
  # No change_profile or profile transition permission: all exec inherits.
}
