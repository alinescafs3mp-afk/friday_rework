+def _runtime_seen(flag: str, *, config_path: Optional[Path] = None, write: bool = False) -> Optional[bool]:
+    """Use only the current admitted scope; None means a standalone install."""
+    from hermes_cli.friday_user_scope import MARKER, ScopeDenied, check_database, current, policy
+    from hermes_constants import get_default_hermes_root, get_hermes_home
+
+    cap = current()  # A denied or revoked capability must never become legacy mode.
+    if cap is None:
+        homes = {get_hermes_home()}
+        if config_path is not None:
+            homes.add(Path(config_path).absolute().parent)
+        for home in homes:
+            if ((home / MARKER).exists() or (home / MARKER).is_symlink()
+                    or policy(get_default_hermes_root(home=home)) is not None):
+                raise ScopeDenied()
+        return None
+    if config_path is not None and Path(config_path) != cap.home / "config.yaml":
+        raise ScopeDenied()
+    check_database(cap)
+    from hermes_state_registry import acquire
+
+    db = acquire(cap.home / "state.db")
+    try:
+        cap.check()
+        key = f"onboarding.seen.{flag}"
+        if write:
+            db.set_meta(key, "1")
+            return True
+        return db.get_meta(key) == "1"
+    finally:
+        db.close()  # Release this registry reference; other native owners remain live.
+
+
 def is_seen(config: Mapping[str, Any], flag: str) -> bool:
     """True if the user has already been shown this first-touch hint."""
+    runtime_seen = _runtime_seen(flag)
+    if runtime_seen:
