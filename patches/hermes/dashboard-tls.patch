diff --git a/hermes_cli/friday_dashboard_tls.py b/hermes_cli/friday_dashboard_tls.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/friday_dashboard_tls.py
@@ -0,0 +1,148 @@
+"""Owned native Uvicorn TLS and verified same-host clients; no certificate issuer."""
+from __future__ import annotations
+
+import hashlib
+import ipaddress
+import os
+from pathlib import Path
+import ssl
+from urllib.parse import urlsplit
+import urllib.request
+
+FILES = {'certfile': 'dashboard-tls/server.pem', 'keyfile': 'dashboard-tls/server.key',
+         'cafile': 'dashboard-tls/ca.pem'}
+
+
+def require(ok, reason='friday_dashboard_tls_unproved'):
+    if not ok:
+        raise ValueError(reason)
+
+
+def validate(value, host, port, public_url):
+    require(isinstance(value, dict) and value == FILES, 'explicit_owned_dashboard_tls_files_required')
+    bind = ipaddress.ip_address(host)
+    public = urlsplit(public_url)
+    require(not bind.is_unspecified and not bind.is_multicast and public.scheme == 'https'
+            and public.hostname and public.port == port and public.path in ('', '/')
+            and not public.query and not public.fragment and public.username is None
+            and public.password is None, 'explicit_dashboard_tls_authority_required')
+    return dict(value)
+
+
+def files(home, value):
+    from hermes_cli.friday_dashboard_owner import read_owned
+    home = Path(home)
+    folder = home / 'dashboard-tls'
+    require(home.resolve() == home and folder.resolve() == folder)
+    owner_uid = getattr(os, 'getuid', None)
+    require(callable(owner_uid))
+    for directory in (home, folder):
+        info = directory.stat()
+        require(directory.is_dir() and info.st_uid == owner_uid() and not info.st_mode & 0o077)
+    return {name: read_owned(home / path, private=True) for name, path in value.items()}
+
+
+def handshake(server, client, hostname):
+    """Verify key/chain/expiry/SAN with OpenSSL using only in-memory BIOs."""
+    si, so, ci, co = (ssl.MemoryBIO() for _ in range(4))
+    peer = server.wrap_bio(si, so, server_side=True)
+    caller = client.wrap_bio(ci, co, server_hostname=hostname)
+    done = [False, False]
+    for _ in range(16):
+        for index, endpoint in enumerate((caller, peer)):
+            if not done[index]:
+                try:
+                    endpoint.do_handshake()
+                    done[index] = True
+                except ssl.SSLWantReadError:
+                    pass
+        if co.pending:
+            si.write(co.read())
+        if so.pending:
+            ci.write(so.read())
+        if all(done):
+            return
+    raise ValueError('dashboard_tls_local_chain_check_incomplete')
+
+
+def checked(home, value, host, port, public_url):
+    value = validate(value, host, port, public_url)
+    before = files(home, value)
+    server = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    server.minimum_version = ssl.TLSVersion.TLSv1_2
+    server.load_cert_chain(str(Path(home) / value['certfile']), str(Path(home) / value['keyfile']), password='')
+    # Only this explicitly owned CA bundle; no ambient trust/proxy/SSL switches.
+    client = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+    client.minimum_version = ssl.TLSVersion.TLSv1_2
+    client.load_verify_locations(cadata=before['cafile'].decode('ascii'))
+    require(client.check_hostname and client.verify_mode == ssl.CERT_REQUIRED)
+    for hostname in {host, urlsplit(public_url).hostname}:
+        handshake(server, client, hostname)
+    require(files(home, value) == before, 'dashboard_tls_files_changed')
+    binding = {'files': value, 'cert_sha256': hashlib.sha256(before['certfile']).hexdigest(),
+               'ca_sha256': hashlib.sha256(before['cafile']).hexdigest()}
+    return binding, client
+
+
+def declared_settings(home, dash):
+    if 'tls' not in dash:
+        return None
+    return checked(home, dash['tls'], dash['host'], dash['port'], dash['public_url'])
+
+
+def server_options(app, host, port):
+    identity = getattr(app.state, 'friday_dashboard_owner', None)
+    if identity is None or 'tls' not in identity:
+        return {}
+    home = Path(identity['home'])
+    binding, _ = checked(home, identity['tls']['files'], host, port, identity['public_url'])
+    require(binding == identity['tls'])
+    return {'ssl_certfile': str(home / FILES['certfile']),
+            'ssl_keyfile': str(home / FILES['keyfile']),
+            'ssl_version': ssl.PROTOCOL_TLS_SERVER, 'ssl_keyfile_password': '', 'proxy_headers': False,
+            'forwarded_allow_ips': ''}
+
+
+def request_allowed(request, identity):
+    if identity is None or 'tls' not in identity:
+        return True
+    public = urlsplit(identity['public_url'])
+    origin = request.headers.get('origin')
+    return (request.headers.get('host', '').lower() == public.netloc.lower()
+            and (not origin or origin == identity['public_url'])
+            and request.url.scheme in ('https', 'wss'))
+
+
+class NoRedirect(urllib.request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        raise ValueError('dashboard_identity_redirect_refused')
+
+
+def client_open(record, path, *, headers, timeout, data=None, method=None):
+    """Dial the actual guest; validate its certificate before any role token."""
+    from gateway import host_rendezvous as hr
+    from hermes_cli.friday_dashboard_owner import check_attachment
+    check_attachment(record)
+    identity = record.friday_owner
+    require(path in (hr.HOST_IDENTITY_PATH, '/api/dashboard/agent-plugins/activate'))
+    host = hr.dial_host(record)
+    scheme = 'http'
+    handlers = [urllib.request.ProxyHandler({}), NoRedirect()]
+    if 'tls' in identity:
+        binding, context = checked(Path(identity['home']), identity['tls']['files'],
+                                   identity['host'], identity['port'], identity['public_url'])
+        require(binding == identity['tls'] and host == identity['host'])
+        scheme = 'https'
+        handlers.append(urllib.request.HTTPSHandler(context=context))
+    target = '[' + host + ']' if ':' in host else host
+    request_headers = dict(headers)
+    request_headers['Host'] = urlsplit(identity['public_url']).netloc
+    request = urllib.request.Request(f'{scheme}://{target}:{record.port}{path}',
+                                    data=data, headers=request_headers, method=method)
+    return urllib.request.build_opener(*handlers).open(request, timeout=timeout)
+
+
+def public_url(identity, profile=''):
+    from urllib.parse import quote
+    url = identity['public_url']
+    return url + ('/?profile=' + quote(profile, safe='') if profile else '')
