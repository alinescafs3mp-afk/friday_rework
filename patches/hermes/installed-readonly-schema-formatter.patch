+"""Schema authority regression tests; no live/native admission is simulated."""
+import copy
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+from hermes_cli import friday_credential_admission as admission
+from agent.bounded_context import guard_main_request
+
+class OrdinaryReadonlySchemaTests(unittest.TestCase):
+    def setUp(self):
+        self.read = {'type':'function','function':{'name':'read_file','description':'Read file',
+            'parameters':{'type':'object','properties':{'path':{'type':'string'},
+            'offset':{'type':'integer'},'limit':{'type':'integer'}},'required':['path']}}}
+        self.write = {'type':'function','function':{'name':'write_file','description':'Write file',
+            'parameters':{'type':'object','properties':{'path':{'type':'string'},
+            'content':{'type':'string'}},'required':['path','content']}}}
+        self.tools=[self.write,self.read]
+        self.cap=(Path('/SOURCE_FIXTURE_ONLY'),{'output':'/SOURCE_FIXTURE_ONLY/artifact'},
+                  {'source_fixture_only':True})
+        self.scope=patch.object(admission,'_ORDINARY_READONLY',self.cap)
+        self.scope.start();self.addCleanup(self.scope.stop)
+        self.current=patch.object(admission,'cli_ordinary_readonly_current')
+        self.check=self.current.start();self.addCleanup(self.current.stop)
+
+    def test_only_verified_read_file_is_advertised_without_registry_mutation(self):
+        before=copy.deepcopy(self.tools)
+        selected=admission.ordinary_readonly_schemas(self.tools)
+        self.assertEqual(selected,[self.read]);self.assertEqual(self.tools,before)
+        self.assertIsNot(selected[0],self.read)
+        self.check.assert_called_once_with(*self.cap)
+
+    def test_normal_write_scopes_preserve_schema_identity_and_request(self):
+        with patch.object(admission,'_ORDINARY_READONLY',None):
+            self.assertIs(admission.ordinary_readonly_schemas(self.tools),self.tools)
+            self.assertIsNone(admission.ordinary_readonly_schemas(None))
+            request={'tools':self.tools,'functions':[self.write]};before=copy.deepcopy(request)
+            self.assertFalse(admission.ordinary_readonly_request(request))
+            guard_main_request(SimpleNamespace(_bounded_context_policy=None),request)
+            self.assertEqual(request,before);self.check.assert_not_called()
+
+    def test_false_or_malformed_capability_is_never_normal_scope(self):
+        for cap in [False,True,{},[],(),(1,2)]:
+            with self.subTest(cap=cap),patch.object(admission,'_ORDINARY_READONLY',cap):
+                with self.assertRaises(admission.CredentialDenied):admission.ordinary_readonly_schemas(self.tools)
+        self.check.assert_not_called()
+
+    def test_expired_moved_stale_authority_is_rechecked_before_schema(self):
+        for code in ['cli_runtime_clock_expired_or_invalid','cli_ordinary_cached_scope_changed',
+                     'cli_ordinary_history_changed','cli_ordinary_artifact_changed']:
+            with self.subTest(code=code),patch.object(admission,'cli_ordinary_readonly_current',
+                    side_effect=admission.CredentialDenied(code)):
+                with self.assertRaises(admission.CredentialDenied):admission.ordinary_readonly_schemas(self.tools)
+
+    def test_missing_duplicate_and_malformed_schema_deny(self):
+        for tools in [None,[],[self.write],[self.read,self.read],
+                      [{'type':'function','function':{'name':'read_file'}}]]:
+            with self.subTest(tools=tools),self.assertRaises(admission.CredentialDenied):
+                admission.ordinary_readonly_schemas(tools)
+
+    def test_invalid_read_parameter_domains_do_not_create_an_empty_green_set(self):
+        for change in ['path_type','missing_required','wrong_type','foreign_argument']:
+            bad=copy.deepcopy(self.read)
+            if change=='path_type':bad['function']['parameters']['properties']['path']['type']='integer'
+            elif change=='missing_required':bad['function']['parameters']['required']=[]
+            elif change=='wrong_type':bad['type']='other'
+            else:bad['function']['parameters']['properties']['command']={'type':'string'}
+            with self.subTest(change=change),self.assertRaises(admission.CredentialDenied):
+                admission.ordinary_readonly_schemas([bad])
+
+    def test_refresh_appended_memory_and_mcp_definitions_are_removed(self):
+        tools=[self.read,self.write,{'type':'function','function':{'name':'memory'}},
+               {'type':'function','function':{'name':'mcp_terminal'}}]
+        before=copy.deepcopy(tools)
+        self.assertEqual(admission.ordinary_readonly_schemas(tools),[self.read])
+        self.assertEqual(tools,before)
+
+    def test_request_overrides_and_legacy_functions_cannot_restore_tools(self):
+        for request in [{'tools':self.tools},
+                        {'tools':[self.read],'extra_body':{'tools':self.tools}},
+                        {'tools':self.tools,'extra_body':{'tools':[self.read]}},
+                        {'tools':[self.read],'functions':[self.write]},
+                        {'tools':[self.read],'extra_body':{'functions':[self.write]}}]:
+            before=copy.deepcopy(request)
+            with self.subTest(request=request),self.assertRaises(admission.CredentialDenied):
+                guard_main_request(SimpleNamespace(_bounded_context_policy=None),request)
+            self.assertEqual(request,before)
+
+    def test_current_execution_path_guard_remains_required(self):
+        self.assertTrue(admission.ordinary_readonly_tool('read_file',{'path':self.cap[1]['output']}))
+        for name,args in [('write_file',{'path':self.cap[1]['output']}),
+                          ('read_file',{'path':'/foreign'}),
+                          ('read_file',{'path':self.cap[1]['output'],'offset':True}),
+                          ('read_file',{'path':self.cap[1]['output'],'limit':2001})]:
+            with self.subTest(name=name,args=args),self.assertRaises(admission.CredentialDenied):
+                admission.ordinary_readonly_tool(name,args)
+
+    def test_historical_write_file_calls_are_preserved(self):
+        messages=[{'role':'assistant','tool_calls':[{'id':'historical','type':'function',
+                    'function':{'name':'write_file','arguments':'{"path":"/old","content":"saved"}'}}]},
+                  {'role':'tool','tool_call_id':'historical','content':'saved'}]
+        request={'messages':messages,'tools':[self.read]};before=copy.deepcopy(request)
+        self.assertTrue(admission.ordinary_readonly_request(request))
+        self.assertEqual(request,before)
