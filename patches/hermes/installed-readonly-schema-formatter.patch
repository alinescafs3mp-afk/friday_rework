+"""Source-only protected-row tests using the native formatter; no model/send."""
+import copy
+import json
+import unittest
+
+from run_agent import AIAgent
+from agent.bounded_context import (
+    BoundedContextError, BoundedContextPolicy, guard_main_request,
+    remember_bounded_protected_rows,
+)
+from agent.context_compressor import ContextCompressor
+from agent.turn_context import build_api_messages
+from agent.turn_request_assembly import assemble_api_request
+
+
+class ProtectedFormatterTests(unittest.TestCase):
+    def setUp(self):
+        p = BoundedContextPolicy('custom:friday-local', 'dispatcher',
+            'http://192.168.1.78:8001/v1', 40960, 40954, 4096, 4096, 1024, 2048, 4096)
+        c = ContextCompressor('dispatcher', config_context_length=40960,
+            provider='custom', base_url=p.base_url, api_mode='chat_completions',
+            max_tokens=4096, quiet_mode=True)
+        c.bounded_context_policy = p
+        self.agent = a = AIAgent.__new__(AIAgent)  # constructor/startup not executed
+        a.__dict__.update(model='dispatcher', provider='custom',
+            requested_provider='custom:friday-local', api_mode='chat_completions',
+            max_tokens=4096, context_compressor=c, _bounded_context_policy=p,
+            tools=[], _current_turn_timestamp=1791973748.9341815,
+            ephemeral_system_prompt=None, _reasoning_echo_flag=False,
+            request_overrides={}, prefill_messages=None, _use_prompt_caching=False,
+            _usage_anchor=None, client=None, session_id='source-only')
+        a.base_url = p.base_url
+        self.original = [
+            {'role':'system', 'content':'Original authority.'},
+            {'role':'developer', 'content':'Original developer authority.'},
+            {'role':'user', 'content':'Original opening ask.'},
+            {'role':'assistant', 'content':'Older completed facts.'},
+            {'role':'assistant', 'content':'', 'reasoning_content':'Exact reasoning.',
+             'tool_calls':[{'id':'write', 'type':'function', 'function':{
+                 'name':'write_file', 'arguments':json.dumps(
+                     {'path':'/existing', 'content':'Резюме'}, ensure_ascii=False)}}]},
+            {'role':'tool', 'tool_call_id':'write', 'content':'Exact completed result.'},
+            {'role':'user', 'content':'One current ask.'}]
+        self.rows = copy.deepcopy(self.original)
+        self.rows[3]['content'] = 'Summary of older facts.'
+        remember_bounded_protected_rows(c, self.original, 3, 4)
+
+    def request(self, rows=None, formatted=True):
+        rows = self.rows if rows is None else rows
+        if formatted:
+            messages = assemble_api_request(self.agent, messages=rows,
+                current_turn_user_idx=len(rows)-1, _ext_prefetch_cache='',
+                _plugin_user_context='', moa_config=None, active_system_prompt='',
+                original_user_message=rows[-1]['content'],
+                pending_moa_prepared_request=None,
+                request_logger=__import__('logging').getLogger('SOURCE-ONLY')).api_messages
+        else:
+            messages, _ = build_api_messages(self.agent, rows,
+                current_turn_user_idx=len(rows)-1, ext_prefetch_cache='',
+                plugin_user_context='', moa_config=None, active_system_prompt='')
+        return {'model':'dispatcher', 'max_tokens':4096, 'messages':messages}
+
+    def test_actual_formatter_unicode_order_spacing_is_lossless(self):
+        before = copy.deepcopy(self.original)
+        request = self.request()
+        self.assertNotEqual(request['messages'][4]['tool_calls'][0]['function']['arguments'],
+            self.original[4]['tool_calls'][0]['function']['arguments'])
+        request_before = copy.deepcopy(request)
+        guard_main_request(self.agent, request)
+        self.assertEqual(request, request_before)
+        self.assertEqual(self.original, before)
+
+    def test_previous_native_projection_remains_accepted(self):
+        guard_main_request(self.agent, self.request(formatted=False))
+
+    def test_api_sidecar_and_resumed_failed_turn_keep_native_projection(self):
+        rows=copy.deepcopy(self.rows)
+        rows[-1]['api_content']='Stamped current ask, with source-only context.'
+        rows.insert(-1, {'role':'assistant',
+            'content':'Your request was not processed. Send it again if you still want me to carry it out.',
+            'display_kind':'failed_turn',
+            'display_metadata':{'error':'bounded_context: formatter removed or rewrote protected authority/user/tool rows'}})
+        remember_bounded_protected_rows(self.agent.context_compressor,rows,3,4)
+        request=self.request(rows)
+        before=copy.deepcopy(rows)
