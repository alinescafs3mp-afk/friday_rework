+"""Gateway loop capabilities must refuse the isolated plugin host before RPC."""
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from hermes_cli.plugin_host import PluginHost
+from hermes_cli.plugin_host_child import RemotePluginContext
+from hermes_cli.plugin_host_wire import PluginHostUnsupported
+from hermes_cli.plugin_isolation_audit import audit_plugin_dir
+
+
+@pytest.mark.parametrize("method", ["schedule_gateway_work", "deliver_gateway_document"])
+def test_audit_requires_in_process_gateway_capabilities(tmp_path, method):
+    (tmp_path / "plugin.yaml").write_text("name: gateway_boundary\nversion: 1.0\n")
+    (tmp_path / "__init__.py").write_text(
+        f"def register(ctx):\n    ctx.{method}(None)\n")
+    report = audit_plugin_dir(tmp_path)
+    assert report.verdict == "in_process"
+    assert any(method in reason for reason in report.reasons)
+
+
+@pytest.mark.parametrize("method", ["schedule_gateway_work", "deliver_gateway_document"])
+def test_remote_context_refuses_before_rpc(method):
+    runtime = Mock()
+    context = RemotePluginContext(runtime, "gateway_boundary", {"ctx_methods": [method]})
+    with pytest.raises(PluginHostUnsupported, match=method):
+        getattr(context, method)(None)
+    assert not runtime.mock_calls
+
+
+@pytest.mark.parametrize("method", ["schedule_gateway_work", "deliver_gateway_document"])
+def test_parent_rpc_refuses_before_calling_native_context(method):
+    native = Mock()
+    host = object.__new__(PluginHost)
+    host._contexts = {"gateway_boundary": SimpleNamespace(**{method: native})}
+    with pytest.raises(PluginHostUnsupported, match=method):
+        host._serve_ctx({"plugin": "gateway_boundary", "method": method})
+    native.assert_not_called()
