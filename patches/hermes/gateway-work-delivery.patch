+"""One native Telegram document attempt over an immutable byte snapshot."""
+from __future__ import annotations
+
+import hashlib
+import io
+
+from gateway.platforms.base import SendResult
+
+
+async def send_document_bytes(adapter, chat_id, data, *, file_name, reply_to, caption, metadata):
+    if type(data) is not bytes:
+        raise TypeError("document data must be immutable bytes")
+    if not adapter._bot or adapter.is_connected is not True:
+        return SendResult(success=False, error="original_bot_offline")
+    if not reply_to:
+        return SendResult(success=False, error="original_reply_required")
+    _, kwargs = adapter._media_send_kwargs(chat_id, reply_to, metadata)
+    # Retrying without a missing reply/topic silently changes the authorized destination.
+    # Use the existing bot and native media routing, but attempt precisely once.
+    try:
+        with io.BytesIO(data) as stream:
+            message = await adapter._bot.send_document(
+                **kwargs, document=stream, filename=file_name, caption=adapter._caption_1024(caption))
+        document = getattr(message, "document", None)
+        message_id = getattr(message, "message_id", None)
+        if (document is None or not getattr(document, "file_id", None)
+                or type(message_id) is not int or message_id <= 0
+                or str(getattr(getattr(message, "chat", None), "id", "")) != str(chat_id)
+                or getattr(message, "message_thread_id", None) != kwargs.get("message_thread_id")
+                or (getattr(document, "file_size", None) is not None and document.file_size != len(data))):
+            return SendResult(success=False, error="document_ack_unavailable")
+        proof = {
+            "kind": "document", "sha256": hashlib.sha256(data).hexdigest(),
+            "bytes": len(data), "file_name": file_name, "bot_id": str(adapter._bot.id),
+            "chat_id": str(chat_id), "thread_id": adapter._metadata_thread_id(metadata),
+            "reply_to": str(reply_to), "message_id": str(message_id),
+        }
+        return SendResult(success=True, message_id=str(message_id), raw_response=proof)
+    except Exception:  # health: allow BLE001 -- SDK errors can contain bot credentials; ambiguous sends are never retried here.
+        return SendResult(success=False, error="document_ack_unavailable")
