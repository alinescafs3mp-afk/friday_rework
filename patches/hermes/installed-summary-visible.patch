diff --git a/agent/bounded_summary_output.py b/agent/bounded_summary_output.py
new file mode 100644
--- /dev/null
+++ b/agent/bounded_summary_output.py
@@ -0,0 +1,169 @@
+"""One physical, schema-bound visible summary; no truncation or unformatted retry."""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+import copy
+import json
+from typing import Any
+
+_CONTRACT = ContextVar("bounded_summary_visible_contract", default=None)
+STRATEGY = "bounded_visible_json_v1"
+
+
+def _error(reason):
+    from agent.bounded_context import BoundedContextError
+    return BoundedContextError("bounded_context: bounded visible summary " + reason)
+
+
+def escaped_bytes(text: str) -> int:
+    try:
+        return len(json.dumps(text, ensure_ascii=False, allow_nan=False).encode("utf-8")) - 2
+    except (TypeError, ValueError, UnicodeError) as exc:
+        raise _error("is not finite UTF-8 text") from exc
+
+
+def allocate(compressor: Any, mandatory: str) -> None:
+    """Six bytes bounds each Unicode scalar under the real UTF-8 JSON serializer."""
+    headroom = compressor._bounded_summary_json_headroom
+    if type(headroom) is not int or headroom < 6:
+        raise _error("has no complete-string allowance")
+    compressor._bounded_summary_visible_contract = {
+        "strategy": STRATEGY, "escaped_byte_limit": headroom,
+        "max_chars": headroom // 6,
+        "carrier_byte_limit": escaped_bytes(mandatory) + headroom,
+    }
+
+
+def response_format(compressor: Any) -> dict | None:
+    contract = getattr(compressor, "_bounded_summary_visible_contract", None)
+    if not contract or not getattr(compressor, "_bounded_summary_readonly_strategy", False):
+        return None
+    return {"type": "json_schema", "json_schema": {
+        "name": STRATEGY, "strict": True,
+        "schema": {"type": "object", "properties": {
+            "summary": {"type": "string", "minLength": 1, "maxLength": contract["max_chars"]}},
+            "required": ["summary"], "additionalProperties": False}}}
+
+
+@contextmanager
+def output_scope(compressor: Any):
+    contract = getattr(compressor, "_bounded_summary_visible_contract", None)
+    expected = response_format(compressor)
+    state = {"contract": copy.deepcopy(contract), "format": expected, "physical_calls": 0} if expected else None
+    token = _CONTRACT.set(state)
+    try:
+        yield
+    finally:
+        _CONTRACT.reset(token)
+
+
+def active() -> bool:
+    return _CONTRACT.get() is not None
+
+
+def guard_format(request: dict, *, physical: bool = False) -> None:
+    state = _CONTRACT.get()
+    if state is None:
+        return
+    from agent.bounded_context import wire_body
+    body = wire_body(request)
+    if body.get("response_format") != state["format"]:
+        raise _error("required format missing or changed; unformatted retry forbidden")
+    if physical:
+        if state["physical_calls"]:
+            raise _error("physical attempt already consumed; retry forbidden")
+        state["physical_calls"] += 1
+
+
+def _field(value, name, default=None):
+    return value.get(name, default) if isinstance(value, dict) else getattr(value, name, default)
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise _error("JSON has duplicate keys")
+        result[key] = value
+    return result
+
+
+def _reject_constant(value):
+    raise _error("JSON has nonfinite constant")
+
+
+def parse_response(compressor: Any, response: Any) -> str:
+    contract = compressor._bounded_summary_visible_contract
+    choices = _field(response, "choices")
+    if not isinstance(choices, list) or len(choices) != 1:
+        raise _error("requires exactly one explicit completed choice")
+    choice = choices[0]
+    if _field(choice, "index") != 0:
+        raise _error("choice index is missing or changed")
+    reason = _field(response, "_bounded_actual_finish_reason",
+                    _field(choice, "_bounded_actual_finish_reason", _field(choice, "finish_reason")))
+    if _field(choice, "finish_reason") != "stop" or reason != "stop":
+        raise _error("requires explicit finish_reason=stop; incomplete/length rejected")
+    message = _field(choice, "message")
+    content = _field(message, "content")
+    if (_field(message, "refusal") or _field(message, "tool_calls")
+            or not isinstance(content, str) or not content.strip()):
+        raise _error("requires visible JSON text without refusal/tool calls")
+    check_raw_text(content, contract)
+    try:
+        value = json.loads(content, object_pairs_hook=_unique_object, parse_constant=_reject_constant)
+    except (ValueError, TypeError) as exc:
+        raise _error("invalid or incomplete JSON") from exc
+    if type(value) is not dict or set(value) != {"summary"} or type(value["summary"]) is not str:
+        raise _error("wrong JSON shape or value types")
+    summary = value["summary"]
+    if not summary.strip() or len(summary) > contract["max_chars"]:
+        raise _error("empty or schema-length-exceeding completed string")
+    from agent.context_compressor import _is_summary_refusal
+    from agent.agent_runtime_helpers import strip_think_blocks
+    if _is_summary_refusal(summary) or strip_think_blocks(None, summary) != summary:
+        raise _error("refusal or hidden-thought markup is not a complete visible summary")
+    if escaped_bytes(summary) > contract["escaped_byte_limit"]:
+        raise _error("completed string exceeds escaped-byte allowance")
+    return summary
+
+
+def check_raw_text(text: str, contract: dict | None = None) -> None:
+    if contract is None:
+        state = _CONTRACT.get()
+        if state is None:
+            return
+        contract = state["contract"]
+    # An ASCII escaped astral scalar uses 12 response bytes versus 4 wire bytes;
+    # schema maxLength <= headroom/6 bounds even that syntax. Extra whitespace
+    # is deliberately finite; oversized bodies are rejected, never clipped.
+    try:
+        size = len(text.encode("utf-8"))
+    except UnicodeError as exc:
+        raise _error("response is not UTF-8") from exc
+    if size > 2 * contract["escaped_byte_limit"] + 64:
+        raise _error("raw response exceeded finite parser allowance")
+
+
+def check_stream_choice(chunk: Any, text_so_far: str, previous_finish: Any = None) -> None:
+    if not active():
+        return
+    choices = _field(chunk, "choices")
+    if not isinstance(choices, list) or len(choices) > 1:
+        raise _error("stream choice shape changed")
+    if choices:
+        choice = choices[0]
+        delta = _field(choice, "delta")
+        if previous_finish is not None:
+            raise _error("stream choice after terminal status")
+        if _field(choice, "index") != 0 or (delta is not None and _field(delta, "content") is not None
+                                              and not isinstance(_field(delta, "content"), str)):
+            raise _error("stream content type or choice index changed")
+    check_raw_text(text_so_far)
+
+
+def check_carrier(compressor: Any, summary: str) -> None:
+    contract = getattr(compressor, "_bounded_summary_visible_contract", None)
+    if contract and escaped_bytes(summary) > contract["carrier_byte_limit"]:
+        raise _error("completed deterministic carrier exceeds reserved escaped bytes")
