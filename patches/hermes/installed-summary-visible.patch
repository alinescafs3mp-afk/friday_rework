+def claim_explicit_manual_once(agent):
+    """Reuse the consumed v12 semantic job; claim in memory before its sole force call."""
+    if _ORDINARY_READONLY is None or _ORDINARY_READONLY[1].get('schema') != 'friday.cli-ordinary-readonly.v8':
+        return False
+    home,binding,clock = _ORDINARY_READONLY
+    cli_ordinary_readonly_current(home,binding,clock)
+    unit = Path('/proc/self/cgroup').read_text().strip().rsplit('/',1)[-1]
+    intent = cli_ordinary_failed_v6_json(read_owned(Path(home)/'preparation/cli-runtime'/(unit+'.intent.json'),private=True))
+    request = intent['request']
+    require(intent['clock'] == clock and request['schema'] == 'friday.installed-cli-request.v12'
+            and request['ordinary_readonly'] == binding and request['home'] == str(home), 'cli_summary_visible_runtime_binding_changed')
+    cli_ordinary_native_unit_current(home,request,clock,intent['physical'])
+    cli_ordinary_job_consumed(home,request,clock)
+    cli_summary_visible_recovery_contract(request['strategy_recovery'],binding,source=Path(home)/'hermes-agent')
+    require(getattr(agent,'session_id',None) == binding['id']
+            and getattr(agent,'compression_in_place',None) is True,
+            'cli_summary_visible_inplace_session_required')
+    job = request['job_id']
+    used = globals().get('_SUMMARY_VISIBLE_RECOVERY_CLAIMED_JOB')
+    require(used in (None,job), 'cli_summary_visible_recovery_job_changed')
+    if used == job:
+        return False
+    compressor = agent.context_compressor
+    require(getattr(compressor,'_session_id',None) == binding['id']
+            and getattr(compressor,'_ineffective_compression_count',None) == 2,
+            'cli_summary_visible_current_stop_required')
+    globals()['_SUMMARY_VISIBLE_RECOVERY_CLAIMED_JOB'] = job
+    return True
