+@pytest.mark.asyncio
+async def test_real_native_send_then_profile_exit_error_is_unknown(setup, monkeypatch):
+    from gateway import run
+    original = run._async_profile_runtime_scope
+    @asynccontextmanager
+    async def broken(home):
+        async with original(home):
+            yield
+        raise RuntimeError("PRIVATE_TEARDOWN_ERROR")
+    monkeypatch.setattr(run, '_async_profile_runtime_scope', broken)
+    _install(setup)
+    result = await setup.context.deliver_gateway_document(route=_route(), data=b'actual-bytes', file_name='answer.txt')
+    assert len(setup.sent) == 1 and setup.sent[0]['bytes'] == b'actual-bytes'
+    assert result == {'state': 'UNKNOWN', 'error': 'gateway_delivery_uncertain'}
+    assert 'PRIVATE' not in str(result)
+
+@pytest.mark.asyncio
+async def test_native_send_then_callee_exception_is_unknown(setup, monkeypatch):
+    _install(setup)
+    original = setup.runner._deliver_plugin_document
+    async def broken(context, **kwargs):
+        result = await original(context, **kwargs)
+        assert result['state'] == 'DELIVERED'
+        raise RuntimeError('PRIVATE_POST_SEND')
+    monkeypatch.setattr(setup.runner, '_deliver_plugin_document', broken)
+    result = await setup.context.deliver_gateway_document(route=_route(), data=b'x', file_name='x.txt')
+    assert len(setup.sent) == 1 and result['state'] == 'UNKNOWN'
+    assert 'PRIVATE' not in str(result)
+
+@pytest.mark.asyncio
+async def test_preflight_optout_proves_no_send(setup):
+    _install(setup)
+    _configure(setup.home, allow_gateway_delivery=False)
+    result = await setup.context.deliver_gateway_document(route=_route(), data=b'x', file_name='x.txt')
+    assert result == {'state': 'FAILED', 'error': 'gateway_delivery_preflight_rejected'}
+    assert not setup.sent
+
+@pytest.mark.asyncio
+async def test_native_route_refusal_proves_no_send(setup):
+    _install(setup)
+    route = _route(); route['bot_id'] = '999'
+    result = await setup.context.deliver_gateway_document(route=route, data=b'x', file_name='x.txt')
+    assert result == {'state': 'FAILED', 'error': 'gateway_document_route_rejected'}
+    assert not setup.sent
