@@ -0,0 +1,36 @@
+"""Hygiene failure diagnostics preserve the commit boundary and reason precedence."""
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.run_turn_hygiene import hygiene_no_commit_reason
+
+
+@pytest.mark.parametrize(("signals", "expected"), [
+    ({}, "compression did not run"),
+    ({"_compression_skipped_due_to_lock": True}, "attempt skipped: compression lease held by another process"),
+    ({"_compression_skipped_due_to_lock": "owner"}, "attempt skipped: compression lease held by another process"),
+    ({"_compression_blocked_transient": "cooldown"}, "attempt blocked: cooldown"),
+    ({"_last_compression_attempt_in_place": None}, "attempt aborted before commit"),
+    ({"_last_compression_timed_out": True}, "attempt summary timed out"),
+    ({"_last_compression_summary_warning": "interrupted"}, "attempt aborted before commit: interrupted"),
+    ({"_last_compression_attempt_in_place": False}, "no session_db on the hygiene agent"),
+    ({"_last_compression_attempt_in_place": False, "_session_db": object()}, "in-place commit did not complete"),
+])
+def test_hygiene_reason_distinguishes_attempt_from_commit(signals, expected):
+    if signals:
+        signals = {"_last_compression_attempt_recorded": True, **signals}
+    assert hygiene_no_commit_reason(SimpleNamespace(**signals)) == expected
+
+
+def test_no_attempt_and_lock_skip_take_precedence_over_later_signals():
+    agent = SimpleNamespace(
+        _last_compression_attempt_recorded=False,
+        _compression_skipped_due_to_lock="owner",
+        _compression_blocked_transient="cooldown",
+        _last_compression_timed_out=True,
+        _last_compression_attempt_in_place=False,
+    )
+    assert hygiene_no_commit_reason(agent) == "compression did not run"
+    agent._last_compression_attempt_recorded = True
+    assert hygiene_no_commit_reason(agent) == "attempt skipped: compression lease held by another process"
