+def _revoke_pin(g, failure, monkeypatch):
+    manager = g.ctx._manager
+    config_path = g.home / "config.yaml"
+    config = yaml.safe_load(config_path.read_text())
+    if failure == "consent":
+        config["plugins"]["entries"]["notify-plugin"]["allow_gateway_injection"] = False
+        config_path.write_text(yaml.safe_dump(config))
+    elif failure == "config_disabled":
+        config["plugins"]["disabled"] = ["notify-plugin"]
+        config_path.write_text(yaml.safe_dump(config))
+    elif failure == "config_removed":
+        config["plugins"]["enabled"] = []
+        config_path.write_text(yaml.safe_dump(config))
+    elif failure == "config_error":
+        monkeypatch.setattr("hermes_cli.plugins.load_config_readonly", lambda: 1 / 0)
+    elif failure == "unload":
+        manager.unload()
+    elif failure == "reload_same_manifest":
+        manager.unload()
+        manager._plugins[g.ctx.plugin_id] = LoadedPlugin(manifest=g.ctx.manifest, enabled=True)
+    elif failure == "replace_load":
+        manager._plugins[g.ctx.plugin_id] = LoadedPlugin(
+            manifest=PluginManifest(name="notify-plugin", key="notify-plugin", source="user"), enabled=True)
+    elif failure == "disabled":
+        manager._plugins[g.ctx.plugin_id].enabled = False
+    elif failure == "gateway_replaced":
+        manager.set_gateway_message_injector(object(), lambda **kw: True)
+    elif failure == "profile":
+        monkeypatch.setattr(g.runner, "_resolve_profile_home_for_source", lambda source: g.home / "foreign")
+    elif failure == "user":
+        g.runner._is_user_authorized.return_value = False
+    elif failure == "session":
+        g.store.reset_session(g.entry.session_key)
+    elif failure != "none":
+        raise AssertionError(failure)
