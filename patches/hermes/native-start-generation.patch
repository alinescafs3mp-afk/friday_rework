+"""Friday generation proof through the existing native gateway identify verb.
+
+The server captures admitted bytes once before binding its native control socket.
+A later source/config change refuses identification; it cannot adopt a new build
+on behalf of modules already loaded by the running receiver. No store or grant.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+from pathlib import Path
+
+from hermes_cli import friday_dashboard_owner as owner
+
+
+def expected(home):
+    home = Path(home)
+    value = owner.expected()
+    owner.require(value["home"] == str(home))
+    inputs = {}
+    for name in ("config.yaml", "FRIDAY-PROFILE.json", ".env", "auth.json"):
+        path = home / name
+        inputs[name] = (owner.sha(owner.read_owned(path, private=True))
+                        if path.exists() or path.is_symlink() else None)
+    # Existing protected Basic signing material also binds low-entropy config;
+    # neither values nor unsalted credential hashes enter native identify output.
+    _basic, settings, _plaintext, _material = owner.credentials(home, value["operator"])
+    material = json.dumps({"owner": value, "inputs": inputs}, sort_keys=True).encode()
+    return {"home": str(home), "source": value["source"],
+            "configuration": hmac.new(settings["secret"], material, hashlib.sha256).hexdigest()}
+
+
+def bind_identify(home, handler):
+    if not owner.enabled():
+        return handler
+    boot = expected(home)
+
+    def identify():
+        owner.require(expected(home) == boot)
+        return {**handler(), "friday_owner": boot}
+
+    return identify
