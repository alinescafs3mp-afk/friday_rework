+def render_ordinary_readonly_prompt(agent: Any, prompt: str) -> str:
+    """Render only a proven core coding brief for a bounded admitted read lane.
+
+    Stored authority is never rebuilt or globally searched/replaced. The exact
+    core-owned prefix must match; quoted project/user/plugin text is untouched.
+    Unknown/custom scaffolds keep every original byte and may still fail fit.
+    """
+    from agent.bounded_context import BoundedContextPolicy
+    from hermes_cli import friday_credential_admission as admission
+    if not isinstance(getattr(agent, "_bounded_context_policy", None), BoundedContextPolicy):
+        return prompt
+    if admission._ORDINARY_READONLY is None:
+        return prompt
+    selected = admission.ordinary_readonly_schemas(agent.tools)
+    if agent.tools != selected or getattr(agent, "valid_tool_names", None) != {"read_file"}:
+        return prompt
+    from agent.coding_context import CODING_AGENT_GUIDANCE, _TODO_SENTENCE, _NO_TODO_SENTENCE
+    identity, _ = _identity_parts(agent, agent.context_compressor.context_length)
+    prefix = _join_tier([*identity, HERMES_AGENT_HELP_GUIDANCE_NO_SKILLS,
+                         *_guidance_parts(agent), *_alibaba_identity_part(agent)])
+    brief = CODING_AGENT_GUIDANCE.replace(_TODO_SENTENCE, _NO_TODO_SENTENCE)
+    frame = prefix + "\n\n" + brief + "\n\n"
+    if not isinstance(prompt, str) or not prompt.startswith(frame):
+        return prompt
+    rendered = brief
+    for fragment in _READONLY_UNAVAILABLE_CODING_FRAGMENTS:
+        if rendered.count(fragment) != 1:
+            return prompt
+        rendered = rendered.replace(fragment, "", 1)
+    return prefix + "\n\n" + rendered + "\n\n" + prompt[len(frame):]
+
