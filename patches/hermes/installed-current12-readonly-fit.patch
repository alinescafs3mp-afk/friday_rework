+def readonly_utf8_messages(agent: Any, rows: list) -> bool:
+    """Canonicalize embedded JSON only in the admitted bounded readonly lane.
+
+    Saved history is never passed here. Arguments and read_file JSON results
+    retain exact decoded types/values, identities and order; textual authority
+    and all non-read results remain byte-for-byte unchanged.
+    """
+    from hermes_cli import friday_credential_admission as admission
+    if (admission._ORDINARY_READONLY is None or not isinstance(
+            getattr(agent, "_bounded_context_policy", None), BoundedContextPolicy)):
+        return False
+    admission.cli_ordinary_readonly_current(*admission._ORDINARY_READONLY)
+    read_ids = set()
+    for row in rows:
+        for call in row.get("tool_calls") or []:
+            try:
+                fn = call["function"]
+                fn["arguments"] = lossless_utf8_json(fn["arguments"])
+                if fn["name"] == "read_file":
+                    read_ids.add(call["id"])
+            except (KeyError, TypeError) as exc:
+                raise BoundedContextError("bounded_context: invalid embedded tool JSON") from exc
+    for row in rows:
+        if row.get("role") == "tool" and row.get("tool_call_id") in read_ids:
+            row["content"] = lossless_utf8_json(row.get("content"))
+    return True
+
+
+def lossless_utf8_json(value: Any) -> str:
+    """Strict object JSON, with typed and decimal-precise roundtrip comparison."""
+    from decimal import Decimal
+    def unique(pairs):
+        obj = {}
+        for key, val in pairs:
+            if key in obj:
+                raise ValueError("duplicate embedded JSON key")
+            obj[key] = val
+        return obj
+    def nonfinite(value):
+        raise ValueError("nonfinite embedded JSON value")
+    def typed(v):
+        if isinstance(v, dict):
+            return (dict, tuple(sorted((k, typed(x)) for k, x in v.items())))
+        if isinstance(v, list):
+            return (list, tuple(typed(x) for x in v))
+        return (type(v), v)
+    try:
+        if not isinstance(value, str):
+            raise ValueError("embedded JSON must be text")
+        parsed = json.loads(value, object_pairs_hook=unique, parse_constant=nonfinite)
+        if not isinstance(parsed, dict):
+            raise ValueError("embedded JSON must be an object")
+        precise = json.loads(value, object_pairs_hook=unique, parse_float=Decimal,
+                             parse_constant=nonfinite)
+        encoded = json.dumps(parsed, ensure_ascii=False, separators=(",", ":"),
+                             sort_keys=True, allow_nan=False)
+        encoded.encode("utf-8")
+        again = json.loads(encoded, object_pairs_hook=unique, parse_float=Decimal,
+                           parse_constant=nonfinite)
+        if typed(precise) != typed(again):
+            raise ValueError("embedded JSON numeric precision changed")
+        return encoded
+    except (TypeError, ValueError, UnicodeError, OverflowError) as exc:
+        raise BoundedContextError("bounded_context: embedded JSON is not lossless finite UTF-8") from exc
+
