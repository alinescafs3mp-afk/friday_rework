+    def test_canonical_truthful_schema_is_idempotent_without_mutating_registry(self):
+        before=copy.deepcopy(self.tool);s=admission.ordinary_readonly_schemas([self.tool])
+        self.assertEqual(self.tool,before);self.assertEqual(admission.ordinary_readonly_schemas(s),s)
+        f=s[0]['function'];p=f['parameters']['properties']
+        self.assertEqual(p,{'path':{'type':'string'},'offset':{'type':'integer','default':1,'minimum':1,'maximum':1000000},'limit':{'type':'integer','default':2000,'minimum':1,'maximum':2000}})
+        self.assertEqual(f['parameters']['required'],['path'])
+        for name in ['success','content','total_lines','path','readonly']:self.assertIn(name,f['description'])
+        for fiction in ['LINE_NUM','Office','PDF','SQLite','vision','next_offset']:self.assertNotIn(fiction,f['description'])
+
+    def test_custom_and_unbounded_metadata_remain_exact(self):
+        custom=copy.deepcopy(self.tool);custom['function']['description']='Custom quoted LINE_NUM|CONTENT and PDF'
+        self.assertEqual(admission.ordinary_readonly_schemas([custom]),[custom])
+        with patch('agent.bounded_context.configured_policy',return_value=None):
+            self.assertEqual(admission.ordinary_readonly_schemas([self.tool]),[self.tool])
+        with patch.object(admission,'_ORDINARY_READONLY',None):
+            tools=[self.tool];self.assertIs(admission.ordinary_readonly_schemas(tools),tools)
+
+    def test_native_domains_and_json_contract_match_advertisement(self):
+        with patch.object(admission,'cli_ordinary_readonly_artifact',return_value='один\nдва\nтри'.encode()):
+            value=json.loads(admission.ordinary_readonly_file('read_file',{'path':self.cap[1]['output'],'offset':2,'limit':1}))
+        self.assertEqual(value,{'success':True,'content':'два','total_lines':3,'path':self.cap[1]['output'],'readonly':True})
+        for change in [{'offset':0},{'offset':1000001},{'limit':0},{'limit':2001},{'offset':True},{'limit':True},{'path':'/foreign'}]:
+            args={'path':self.cap[1]['output'],**change}
+            with self.subTest(change=change),self.assertRaises(admission.CredentialDenied):
+                admission.ordinary_readonly_tool('read_file',args)
