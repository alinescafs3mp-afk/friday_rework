+"""Silent native pairing for a fresh operator-prepared ordinary Telegram bot.
+
+This creates no product/native grant, capability, session or outbound message.
+The original Telegram observation and disabled setup must both be intact.
+"""
+import json
+import time
+from pathlib import Path
+
+
+def request_prepared_pairing(runner, event):
+    """One pending request, then only the existing operator approval/activation.
+
+    The native persisted rate stamp also prevents an expired/revoked request
+    from being silently recreated. Such identities require operator inspection.
+    All failures are silent; no request text or credential is logged.
+    """
+    try:
+        return _request(runner, event)
+    except (AttributeError, KeyError, OSError, RuntimeError, TypeError, ValueError):
+        return False
+
+
+def _request(runner, event):
+    from gateway.config import Platform
+    from gateway.session_identity import identity_of
+    from hermes_cli import friday_user_scope as scope
+    from hermes_cli.config import config_write_transaction, load_config_readonly
+    from hermes_cli.friday_product_access import KEY, access_policy, principal_id, validate_access
+    from hermes_cli.plugins_state import PluginState, _locked_plugin_state
+    from hermes_constants import get_default_hermes_root, get_hermes_dir
+    from plugins.platforms.telegram.telegram_ingress import message_provenance
+
+    source = event.source
+    identity = identity_of(source)
+    if (event.internal or source.platform != Platform.TELEGRAM or source.is_bot is not True
+            or source.chat_type != 'dm' or source.thread_id or identity is None
+            or not identity.multiplexed or identity.transport_inferred
+            or source.profile != identity.runtime_profile):
+        return False
+    adapter = identity.adapter()
+    if adapter is None or adapter is not runner._intake_adapter_for(source):
+        return False
+    observation = message_provenance(adapter, event)
+    if (observation is None or event.raw_message.from_user.is_bot is not True
+            or observation['user_id'] == observation['bot_id']):
+        return False
+    root = Path(identity.authorization_home)
+    home = get_default_hermes_root(home=root) / 'profiles' / identity.runtime_profile
+    if identity.runtime_home != home or home.resolve() != home or root.resolve() != root:
+        return False
+    scope._private(root, directory=True)
+    # Preparation/activation/config edits use these same native locks. State
+    # read and pending creation are held together so disable/role changes cannot
+    # race a stale product snapshot. No new lock registry or state schema.
+    with scope.authority(root), config_write_transaction(root / 'config.yaml'):
+        policy = access_policy()
+        accounts = [] if policy is None else [a for a in policy['accounts']
+            if a['platform'] == 'telegram' and a['transport_profile'] == identity.transport_profile
+            and a['account_id'] == observation['bot_id'] and identity.runtime_profile in a['runtime_profiles']]
+        if len(accounts) != 1:
+            return False
+        principal = ('telegram', identity.transport_profile, observation['bot_id'], observation['user_id'])
+        key = principal_id(*principal)
+        active = scope.policy(root)
+        bindings = [] if active is None else [b for b in active['bindings']
+            if tuple(b[k] for k in ('platform','transport_profile','account_id','user_id')) == principal]
+        if len(bindings) != 1 or bindings[0]['runtime_profile'] != identity.runtime_profile:
+            return False
+        binding = bindings[0]
+        scope._private(home, directory=True)
+        with config_write_transaction(home / 'config.yaml'):
+            marker = home / scope.MARKER
+            if marker.exists() or marker.is_symlink() or getattr(source, '_friday_user_scope', None) is not None:
+                return False
+            stat = scope._private(home, directory=True)
+            receipt_path = home / scope.ONBOARDING
+            scope._private(receipt_path)
+            receipt = json.loads(receipt_path.read_text(encoding='utf-8-sig'))
+            fields = {'schema','binding_sha256','config_sha256','soul_sha256',
+                      'required_secrets','directory_identity','template','authorization_home'}
+            if (type(receipt) is not dict or set(receipt) != fields
+                    or receipt['schema'] != 'friday.onboarding.v1'
+                    or receipt['binding_sha256'] != scope._fingerprint(binding)
+                    or receipt['authorization_home'] != str(root)
+                    or receipt['directory_identity'] != [stat.st_dev, stat.st_ino]
+                    or not isinstance(receipt['template'], str) or not receipt['template']
+                    or type(receipt['required_secrets']) is not list or not receipt['required_secrets']
+                    or any(not isinstance(n, str) or not n for n in receipt['required_secrets'])):
+                return False
+            import hashlib
+            for name, field in [('config.yaml','config_sha256'), ('SOUL.md','soul_sha256')]:
+                scope._private(home / name)
+                if hashlib.sha256((home / name).read_bytes()).hexdigest() != receipt[field]:
+                    return False
+            gateway = load_config_readonly().get('gateway', {})
+            route = dict(name='friday-' + key, platform='telegram', bot_profile=identity.transport_profile,
+                         user_id=source.user_id, profile=identity.runtime_profile, enabled=True)
+            matches = [r for r in gateway.get('profile_routes', []) if isinstance(r, dict)
+                and r.get('platform') == 'telegram' and (r.get('bot_profile') or 'default') == identity.transport_profile
+                and r.get('user_id') == source.user_id]
+            if gateway.get('multiplex_profiles') is not True or matches != [route]:
+                return False
+            store = runner._pairing_store_for(source)
+            if store is None or store._dir != get_hermes_dir('platforms/pairing','pairing',home=root):
+                return False
+            state = PluginState('friday_rework')
+            with _locked_plugin_state(state.path, lock_deadline=time.monotonic() + .25), store._lock:
+                # Native convenience readers map malformed/unreadable files to {}.
+                # A one-shot preparation must distinguish that from a fresh store.
+                for path in (store._rate_limit_path(), store._pending_path('telegram'),
+                             store._approved_path('telegram')):
+                    if path.exists() or path.is_symlink():
+                        scope._private(path)
+                        if type(json.loads(path.read_text(encoding='utf-8-sig'))) is not dict:
+                            return False
+                row = validate_access(state._read_unlocked().get(KEY, {'schema':KEY,'users':{}}))['users'].get(key)
+                if (not row or row['enabled'] is not False or row['role'] != 'user'
+                        or type(row.get('generation')) is not int or row['generation'] != 1
+                        or tuple(row[k] for k in ('platform','transport_profile','account_id','user_id')) != principal
+                        or store.is_approved('telegram',source.user_id)
+                        or 'telegram:' + source.user_id in store._limits()
+                        or any(r['user_id'] == source.user_id for r in store.list_pending('telegram'))):
+                    return False
+                # Preserve native expiry, max-pending, lockout and rate limiting.
+                return store.generate_code('telegram', source.user_id, source.user_name or '') is not None
