+"""Trusted persistent browser transport, executed only by ProcessRegistry.
+
+Host side owns strict public TCP dials. Namespace side owns a SOCKS endpoint,
+the native Rust daemon and Chromium. The only bridge is a private Unix socket.
+"""
+import contextlib
+import hashlib
+import ipaddress
+import json
+import math
+import os
+from pathlib import Path
+import select
+import socket
+import stat
+import struct
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+
+def read_line(stream, limit=65536):
+    raw = stream.readline(limit + 1)
+    if len(raw) > limit or not raw.endswith(b'\n'):
+        raise RuntimeError('browser_protocol_invalid')
+    return json.loads(raw)
+
+
+def exact(sock, size):
+    out = bytearray()
+    while len(out) < size:
+        data = sock.recv(size - len(out))
+        if not data:
+            raise RuntimeError('browser_proxy_eof')
+        out.extend(data)
+    return bytes(out)
+
+
+def digest(path):
+    with open(path, 'rb') as f:
+        return hashlib.file_digest(f, 'sha256').hexdigest()
+
+
+def isolated_argv(packages, bridge, helper):
+    """Empty root; system toolchain and pinned browser packages are read only.
+
+    No host home/config/profile, /run, systemd bus, /sys or direct network mount.
+    bwrap remains PID namespace init for the complete persistent worker lifetime.
+    """
+    argv = ['/usr/bin/bwrap', '--unshare-user', '--unshare-net', '--unshare-pid',
+            '--unshare-ipc', '--unshare-uts', '--die-with-parent', '--new-session',
+            '--as-pid-1', '--cap-drop', 'ALL', '--clearenv', '--ro-bind', '/usr', '/usr']
+    for alias in ('bin', 'sbin', 'lib', 'lib64'):
+        path = Path('/') / alias
+        if path.exists():
+            target = path.resolve()
+            if not target.is_relative_to('/usr'):
+                raise RuntimeError('browser_toolchain_layout_refused')
+            argv += ['--symlink', str(target), str(path)]
+    argv += ['--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp', '--tmpfs', '/work',
+             '--ro-bind', str(helper), '/browser_gate.py',
+             '--ro-bind', str(helper.with_name('browser_public_transport.py')), '/browser_transport.py',
+             '--ro-bind', str(helper.with_name('browser_native_ipc.py')), '/browser_native_ipc.py',
+             '--ro-bind', bridge, '/bridge']
+    for name, target in (('agent-browser', '/engine'), ('chromium', '/chromium')):
+        row = packages[name]
+        root = Path(row['root'])
+        relative = Path(row['relative'])
+        if (not root.is_absolute() or root.resolve() != root or relative.is_absolute()
+                or '..' in relative.parts or not relative.parts):
+            raise RuntimeError('browser_package_path_refused')
+        if digest(root / relative) != row['sha256']:
+            raise RuntimeError('browser_package_changed')
+        argv += ['--ro-bind', str(root), target]
+    argv += ['--setenv', 'HOME', '/work', '--setenv', 'TMPDIR', '/tmp',
+             '--setenv', 'PATH', '/usr/bin:/bin', '--setenv', 'LANG', 'C.UTF-8',
+             '--setenv', 'PYTHONDONTWRITEBYTECODE', '1', '--chdir', '/work',
+             '--remount-ro', '/', '--', '/usr/bin/python3', '-I', '-B', '/browser_gate.py', '--namespace']
+    return argv
+
+
+def namespace_main():
+    """Long lived namespace init, not one CLI command that would orphan a daemon."""
+    os.umask(0o077)
+    sys.path.insert(0, '/')
+    from browser_transport import relay as namespace_relay
+    from browser_native_ipc import NativeIPC, daemon_environment
+    start = read_line(sys.stdin.buffer)
+    deadline = start['deadline']
+    if type(deadline) not in (int, float) or not math.isfinite(deadline) or time.monotonic() >= deadline:
+        raise RuntimeError('browser_original_deadline')
