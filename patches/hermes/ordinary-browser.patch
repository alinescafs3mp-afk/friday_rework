+def action(name, args):
+    """Closed command mapping; selectors, JavaScript and arbitrary CLI flags are absent."""
+    if name not in TOOLS or type(args) is not dict:
+        raise RuntimeError('browser_action_refused')
+    allowed = {'browser_navigate': {'url'}, 'browser_snapshot': {'full', 'user_task'},
+               'browser_click': {'ref'}, 'browser_type': {'ref', 'text'},
+               'browser_scroll': {'direction'}, 'browser_back': set(), 'browser_press': {'key'}}
+    if set(args) - allowed[name]:
+        raise RuntimeError('browser_action_arguments_refused')
+    if name == 'browser_navigate':
+        url = args.get('url', '')
+        if type(url) is not str or len(url) > 8192 or any(ord(c) < 33 for c in url):
+            raise RuntimeError('browser_url_refused')
+        parsed = urlsplit(url)
+        if (parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username is not None
+                or parsed.password is not None or parsed.port not in (None, 80, 443)
+                or parsed.fragment or '%' in parsed.netloc or '\\' in url):
+            raise RuntimeError('browser_url_refused')
+        from tools.url_safety import sensitive_query_param_name
+        if sensitive_query_param_name(url):
+            raise RuntimeError('browser_credential_url_refused')
+        return 'open', [url]
+    if name == 'browser_snapshot':
+        if type(args.get('full', False)) is not bool:
+            raise RuntimeError('browser_snapshot_refused')
+        return 'snapshot', [] if args.get('full', False) else ['-c']
+    if name in ('browser_click', 'browser_type'):
+        ref = args.get('ref', '')
+        if type(ref) is not str or not re.fullmatch(r'@?e[1-9][0-9]{0,8}', ref):
+            raise RuntimeError('browser_reference_refused')
+        ref = ref if ref.startswith('@') else '@' + ref
+        if name == 'browser_click':
+            return 'click', [ref]
+        text = args.get('text', '')
+        if (type(text) is not str or len(text.encode()) > 32768 or '\x00' in text
+                or text.startswith('-')):
+            raise RuntimeError('browser_text_refused')
+        return 'fill', [ref, text]
+    if name == 'browser_scroll':
+        direction = args.get('direction', 'down')
+        if direction not in ('up', 'down'):
+            raise RuntimeError('browser_scroll_refused')
+        return 'scroll', [direction, '500']
+    if name == 'browser_back':
+        return 'back', []
+    key = args.get('key', '')
+    if key not in {'Enter', 'Tab', 'Escape', 'Backspace', 'Delete', 'ArrowUp', 'ArrowDown',
+                   'ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown', 'Space'}:
+        raise RuntimeError('browser_key_refused')
+    return 'press', [key]
+
