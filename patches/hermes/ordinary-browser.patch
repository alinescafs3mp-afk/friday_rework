+TOOLS = frozenset({'browser_navigate', 'browser_snapshot', 'browser_click', 'browser_type',
+                   'browser_scroll', 'browser_back', 'browser_press'})
+_MAX = 2_000_000
+_OWNERS = {}
+_OWNERS_LOCK = threading.RLock()
