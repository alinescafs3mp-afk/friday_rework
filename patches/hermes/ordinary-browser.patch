+            sock.settimeout(min(30, self._remaining()))
+            sock.connect('/work/socket/scoped.sock')
+            sock.settimeout(min(5, self._remaining()))
+            sock.sendall(wire)
+            raw = bytearray()
+            while b'\n' not in raw:
+                sock.settimeout(min(30, self._remaining()))
+                piece = sock.recv(min(65536, 2_000_002 - len(raw)))
+                if not piece:
+                    raise RuntimeError('browser_native_command_unknown_effect')
+                raw.extend(piece)
+                if len(raw) > 2_000_001:
+                    raise RuntimeError('browser_native_output_too_large')
+            if not raw.endswith(b'\n') or raw.count(b'\n') != 1:
+                raise RuntimeError('browser_native_output_invalid')
+            result = json.loads(raw)
+            if (type(result) is not dict or result.get('id') != request_id
+                    or type(result.get('success')) is not bool or not result['success']):
+                raise RuntimeError('browser_native_command_unknown_effect')
+            self._remaining()
+        except BaseException:
+            # No exception text crosses the authority boundary.
+            raise RuntimeError('browser_native_command_unknown_effect') from None
+        finally:
+            if sock is not None:
+                try:
+                    sock.close()
+                except BaseException:
+                    pass
+        self._poisoned = False
+        return result
