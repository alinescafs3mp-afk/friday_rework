+
+    def accept():
+        while not stop.is_set():
+            try:
+                remaining(); client, _ = listener.accept()
+            except socket.timeout:
+                continue
+            except (OSError, RuntimeError):
+                return
+            if not slots.acquire(False):
+                client.close(); continue
