+def _packages():
+    # Read the selected PM lock/facts and verify complete package entries. No
+    # PATH fallback, downloader, Node wrapper or executable override is used.
+    from pm.install import _facts, _identity, _lockfile, _entry_verified
+    from pm import paths
+    from pm.lock import Facts
+    from pm.registry import get_package
+    from pm.store import current_target, Store
+    result = {}
+    for name, version in (('agent-browser', '0.26.0'), ('chromium', '1208+145.0.7632.6')):
+        package = get_package(name)
+        target = current_target()
+        location = None
+        lockfile = _lockfile()
+        for store_root in dict.fromkeys((paths.store_root(), paths.writable_store_root())):
+            facts = _facts() if store_root == paths.store_root() else Facts(store_root / 'facts.json')
+            fact = facts.get(name)
+            store = Store(store_root)
