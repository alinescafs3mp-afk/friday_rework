+    # config parsing. Supply all launch settings through its exact environment.
+    # No ordinary command enters the native CLI's unconditional retry loop.
+    env = daemon_environment(start['chromium_relative'], port,
+                             max(1, int(remaining() * 1000)))
+    daemon = subprocess.Popen(['/engine/' + start['agent_relative']],
+                              stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                              stderr=subprocess.DEVNULL, env=env, cwd='/work', close_fds=True)
+    try:
+        # Readiness publishes no command bytes. .pid/.version precede bind in
+        # upstream daemon.rs, so wait for the private socket as well. This is
+        # bounded by the ORIGINAL deadline and never spawns a replacement.
+        socket_path = Path('/work/socket/scoped.sock')
+        startup_deadline = min(deadline - 4, time.monotonic() + 10)
+        while True:
+            remaining()
+            if daemon.poll() is not None:
+                raise RuntimeError('browser_native_daemon_start_failed')
+            try:
+                mode = socket_path.lstat().st_mode
+            except FileNotFoundError:
