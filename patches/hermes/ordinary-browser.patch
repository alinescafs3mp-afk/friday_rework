+    while True:
+        call.check()
+        from hermes_cli.friday_user_scope import current
+        current(required=True).check()
+        remaining = min(call.deadline(), session.web_deadline) - time.monotonic() - 4
+        if remaining <= 0 or session.web_stop_requested:
+            raise RuntimeError('browser_original_task_stopped')
