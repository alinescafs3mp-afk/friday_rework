+"""Single-dispatch transport for the pinned agent-browser 0.26.0 Rust daemon.
+
+This uses that daemon's existing Unix JSON-line protocol, not its retrying CLI
+client. The request id correlates a response; the daemon does not deduplicate it.
+Any uncertain exchange poisons this worker. Native ProcessRegistry retains the
+original deadline, cgroup custody and cleanup responsibility.
+"""
+import json
+import re
+import socket
+from urllib.parse import urlsplit
+
+
+def native_request(command, args, request_id):
+    """The seven closed mappings match v0.26.0 cli/src/commands.rs."""
+    if (type(command) is not str or type(args) is not list
+            or any(type(arg) is not str or '\x00' in arg for arg in args)
+            or type(request_id) is not str or not re.fullmatch(r'f[1-9][0-9]{0,18}', request_id)):
+        raise RuntimeError('browser_native_arguments_refused')
+    value = {'id': request_id}
+    if command == 'open' and len(args) == 1:
+        url = args[0]
+        parsed = urlsplit(url)
+        if (len(url) > 8192 or any(ord(c) < 33 for c in url)
+                or parsed.scheme not in ('http', 'https') or not parsed.hostname
+                or parsed.username is not None or parsed.password is not None
+                or parsed.port not in (None, 80, 443) or parsed.fragment
+                or '%' in parsed.netloc or '\\' in url):
+            raise RuntimeError('browser_url_refused')
+        value.update(action='navigate', url=url)
+    elif command == 'snapshot' and args in ([], ['-c']):
+        value['action'] = 'snapshot'
+        if args:
+            value['compact'] = True
+    elif command in ('click', 'fill') and len(args) == (1 if command == 'click' else 2):
+        if not re.fullmatch(r'@e[1-9][0-9]{0,8}', args[0]):
+            raise RuntimeError('browser_reference_refused')
+        value.update(action=command, selector=args[0])
+        if command == 'fill':
+            if len(args[1].encode()) > 32768 or args[1].startswith('-'):
+                raise RuntimeError('browser_text_refused')
+            value['value'] = args[1]
+    elif command == 'scroll' and len(args) == 2 and args[0] in ('up', 'down') and args[1] == '500':
+        value.update(action='scroll', direction=args[0], amount=500)
+    elif command == 'back' and not args:
+        value['action'] = 'back'
+    elif command == 'press' and len(args) == 1 and args[0] in {
+            'Enter', 'Tab', 'Escape', 'Backspace', 'Delete', 'ArrowUp', 'ArrowDown',
+            'ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown', 'Space'}:
+        value.update(action='press', key=args[0])
+    else:
+        raise RuntimeError('browser_native_command_refused')
+    return value
+
+
+def daemon_environment(chromium_relative, proxy_port, idle_ms):
+    """Bypass CLI configuration parsing; supply the same native launch settings.
+
+    AGENT_BROWSER_DAEMON branches before flags/config parsing (main.rs488–499).
+    Only these variables reach the daemon: no credentials, cloud provider, CDP,
+    auto-connect, saved state, extensions or ambient launch configuration.
+    """
+    if (type(chromium_relative) is not str or not chromium_relative
+            or chromium_relative.startswith('/') or '..' in chromium_relative.split('/')
+            or '\x00' in chromium_relative or type(proxy_port) is not int
+            or not 1 <= proxy_port <= 65535 or type(idle_ms) is not int or idle_ms <= 0):
+        raise RuntimeError('browser_native_daemon_config_refused')
+    return {'HOME': '/work', 'TMPDIR': '/tmp', 'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8',
+            'AGENT_BROWSER_DAEMON': '1', 'AGENT_BROWSER_SESSION': 'scoped',
+            'AGENT_BROWSER_SOCKET_DIR': '/work/socket',
+            'AGENT_BROWSER_ENGINE': 'chrome',
+            'AGENT_BROWSER_EXECUTABLE_PATH': '/chromium/' + chromium_relative,
+            'AGENT_BROWSER_PROFILE': '/work/profile',
+            'AGENT_BROWSER_PROXY': 'socks5://127.0.0.1:' + str(proxy_port),
+            'AGENT_BROWSER_PROXY_BYPASS': '<-loopback>',
+            'AGENT_BROWSER_ARGS': '--disable-quic,--force-webrtc-ip-handling-policy=disable_non_proxied_udp',
+            'AGENT_BROWSER_IDLE_TIMEOUT_MS': str(idle_ms)}
+
+
+class NativeIPC:
+    """One connection and one complete JSON frame per admitted command.
+
+    sendall may finish a partial kernel write of the same frame. It never
+    reconnects or resends a complete frame. EOF/timeouts/write/parse failures,
+    wrong ids, negative responses and cancellation poison this client before
+    returning; a later invocation cannot silently replay the uncertain action.
+    """
+    def __init__(self, remaining, socket_factory=None):
+        self._remaining = remaining
+        self._socket_factory = socket_factory or socket.socket
