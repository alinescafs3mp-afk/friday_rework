+            if mode is not None:
+                if (not stat.S_ISSOCK(mode) or stat.S_IMODE(mode) & 0o077
+                        or Path('/work/socket/scoped.version').read_text() != '0.26.0'
+                        or Path('/work/socket/scoped.pid').read_text() != str(daemon.pid)):
+                    raise RuntimeError('browser_native_daemon_identity_refused')
+                break
+            if time.monotonic() >= startup_deadline:
+                raise RuntimeError('browser_native_daemon_start_timeout')
+            time.sleep(min(.01, remaining()))
