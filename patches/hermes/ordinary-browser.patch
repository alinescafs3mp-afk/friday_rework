+            # the host side independently checks authority on every relay tick.
+            namespace_relay(client, remote, remaining)
+        except (OSError, RuntimeError, ValueError, UnicodeError):
+            pass  # Connection refusal contains no secret-bearing exception text.
+        finally:
+            client.close()
+            if remote is not None:
+                remote.close()
