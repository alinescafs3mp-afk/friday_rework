+        print(json.dumps({'ready': True}), flush=True)
+        while True:
+            remaining()
+            request = read_line(sys.stdin.buffer)
+            command, args = request.get('command'), request.get('args')
+            if command not in {'open', 'snapshot', 'click', 'fill', 'scroll', 'back', 'press'} or type(args) is not list:
+                raise RuntimeError('browser_native_command_refused')
+            if any(type(arg) is not str or '\x00' in arg for arg in args):
+                raise RuntimeError('browser_native_arguments_refused')
+            if daemon.poll() is not None:
+                raise RuntimeError('browser_native_daemon_stopped')
+            value = native.exchange(command, args)
+            if daemon.poll() is not None:
+                raise RuntimeError('browser_native_daemon_stopped_unknown_effect')
