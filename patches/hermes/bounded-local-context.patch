+
+    with _relay_aux_call_scope(("compression",), {}):
+        if mode == "async":
+            asyncio.run(run_async())
+        else:
+            with sdk_client(calls) as client:
+                fn = _relay_sync_stream if mode == "stream" else _relay_sync_completion
+                options = {"stream": True} if mode == "stream" else {}
+                result = fn(client, {**kwargs, **options}, provider=PROVIDER, api_mode="chat_completions")
+                if mode == "stream":
+                    list(result)
+                with pytest.raises(BoundedContextError):
