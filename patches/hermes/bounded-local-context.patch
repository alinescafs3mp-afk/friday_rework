+    history = history_rows()
+    fits = protected in {"fits", "tool_fits"}
+    if protected in {"tool", "tool_fits"}:
+        history += [{"role": "user", "content": "Preserve the pending tool exchange."},
+                    {"role": "assistant", "content": None, "tool_calls": [{"id": "pending",
+                     "type": "function", "function": {"name": "session_search",
+                     "arguments": json.dumps({"query": "q" * (50000 if protected == "tool" else 10)})}}]},
+                    {"role": "tool", "tool_call_id": "pending", "content": "Pending result anchor"}]
+    agent._ensure_db_session()
+    agent._flush_messages_to_session_db(history, [])
+    original = copy.deepcopy(history)
+    before = db.get_messages(agent.session_id, include_inactive=True, include_compacted=False)
+    calls = []
+    status = []
+    agent._emit_status = status.append
+    summary_size = 35000 if protected == "summary" else 8500
+    with fixture_client(calls, summary_size) as client:
+        agent.client = client
+        monkeypatch.setattr(agent, "_create_request_openai_client", lambda **kwargs: fixture_client(calls, summary_size))
+        monkeypatch.setattr(auxiliary_client, "resolve_provider_client", lambda *args, **kwargs: (client, MODEL))
+        monkeypatch.setattr(auxiliary_client, "_get_cached_client", lambda *args, **kwargs: (client, MODEL))
+        prompt = "Вызови session_search с query frw_search_anchor и верни контрольное значение."
+        if protected == "user":
+            prompt += " Immutable user anchor. " * 2500
+        result = agent.run_conversation(prompt, conversation_history=history)
+    main = [body for body in calls if body["messages"][0]["role"] == "system"]
+    assert result["completed"] is fits
+    assert len(main) == (2 if fits else 0)
+    for body in calls:
+        agent._bounded_context_policy.check_request(body, compression=body not in main)
+    rows = db.get_messages(agent.session_id, include_inactive=True, include_compacted=False)
+    by_id = {row["id"]: row for row in rows}
+    for row in before:
+        assert (by_id[row["id"]]["role"], by_id[row["id"]]["content"], by_id[row["id"]]["tool_calls"]) == (
+            row["role"], row["content"], row["tool_calls"])
+    assert history == original
+    if main:
+        assert soul.strip() in main[0]["messages"][0]["content"]
+        assert len(main[0]["messages"][0]["content"].encode()) > 9000
+        assert [tool["function"]["name"] for tool in main[0]["tools"]] == ["session_search"]
+        assert main[0]["messages"][0] == main[1]["messages"][0]
+        assert any(row.get("role") == "tool" and "FIXTURE_STORE_VALUE" in row["content"]
