+def history_rows():
+    return [{"role": "user" if i % 2 == 0 else "assistant",
+             "content": f"Fixture row {i}: " + ("Retain the read-only test objective." if i % 2 == 0
+                         else "Disposable engineering observations. " + "x" * 2000)}
+            for i in range(50)]
+
