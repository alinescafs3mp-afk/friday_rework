+def test_unsupported_profile_does_not_admit(path, value):
+    cfg = profile()
+    target = cfg
+    for part in path[:-1]:
+        target = target[part]
+    target[path[-1]] = value
+    with pytest.raises(BoundedContextError):
+        policy_from_config(cfg)
