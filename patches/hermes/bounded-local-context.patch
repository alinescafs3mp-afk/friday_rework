+def fixture_client(calls, summary_size=8500):
+    def respond(req):
+        body = json.loads(req.content)
+        calls.append(body)
+        if body["messages"][0]["role"] != "system":
+            # Similar byte size to the complete 4096-output-cap native summary;
+            # a tiny summary would hide the optional-tail budget mismatch.
+            text = "## Historical task snapshot\nRetain the read-only test objective.\n"
+            text += ("Recorded disposable engineering observations. " * (summary_size // 40 + 1))[:summary_size]
+            msg = {"role": "assistant", "content": text}
+        elif body["messages"][-1]["role"] == "tool":
+            msg = {"role": "assistant", "content": "FIXTURE_STORE_VALUE"}
+        else:
+            msg = {"role": "assistant", "content": None, "tool_calls": [{"id": "fixture_search",
+                   "type": "function", "function": {"name": "session_search",
+                   "arguments": json.dumps({"query": "frw_search_anchor"})}}]}
+        if body.get("stream"):
+            if msg.get("tool_calls"):
+                msg["tool_calls"][0]["index"] = 0
+            chunk = {"id": "fixture", "choices": [{"index": 0, "delta": msg, "finish_reason": "stop"}]}
+            return httpx.Response(200, headers={"content-type": "text/event-stream"},
+                                  content="data: " + json.dumps(chunk) + "\n\ndata: [DONE]\n\n")
+        return httpx.Response(200, json={"id": "fixture", "object": "chat.completion", "model": MODEL,
+            "choices": [{"index": 0, "message": msg, "finish_reason": "stop"}]})
+    return OpenAI(base_url=BASE, api_key="fixture", max_retries=0,
+                  http_client=httpx.Client(transport=httpx.MockTransport(respond)))
+
