+    monkeypatch.setattr(socket.socket, "connect", denied)
+    monkeypatch.setattr(socket, "create_connection", denied)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    config = profile()
+    config["tools"] = {"tool_search": {"enabled": "off"}}
+    budgets = config["providers"]["friday-local"]["models"][MODEL]["bounded_context"]
+    budgets.update(safety_margin_tokens=1024, template_overhead_tokens=2048)
+    atomic_config_write(tmp_path / "config.yaml", config)
+    soul = (Path(__file__).parents[1] / "fixtures/bounded_context/SOUL.md").read_text()
+    (tmp_path / "SOUL.md").write_text(soul)
