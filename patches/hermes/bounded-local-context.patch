+    ("server_max_input_tokens", 50000), ("template_overhead_tokens", False),
+    ("safety_margin_tokens", "512"), ("mode", "production"), ("unknown", 1),
+])
+def test_invalid_capacity_and_policy_fail_closed(field, value):
+    cfg = profile()
+    node = cfg["providers"]["friday-local"]["models"][MODEL]
+    (node if field == "context_length" else node["bounded_context"])[field] = value
+    with pytest.raises(BoundedContextError):
+        policy_from_config(cfg)
+
+
+@pytest.mark.parametrize("path,value", [
+    (("auxiliary", "compression", "model"), "other"),
+    (("auxiliary", "compression", "base_url"), "http://127.0.0.1:9000/v1"),
+    (("auxiliary", "compression", "api_mode"), "codex_responses"),
+    (("model", "context_length"), 64000),
+    (("model", "ollama_num_ctx"), 40960),
+    (("fallback_providers",), [{"provider": "openrouter", "model": "other"}]),
+    (("context",), {"engine": "external"}),
+    (("auxiliary", "compression", "extra_body"), {}),
