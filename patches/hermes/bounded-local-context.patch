+                       for row in main[0]["messages"])
+            assert any(call["id"] == "pending" and json.loads(call["function"]["arguments"])["query"] == "q" * 10
+                       for row in main[0]["messages"] for call in row.get("tool_calls", []))
+        assert any("conservative bytes + template reserve" in message for message in status)
+        assert not any(" tokens" in message for message in status)
+    print("NATIVE_ENVELOPE", {"case": protected, "calls": len(calls), "main_calls": len(main),
+          "compressions": agent.context_compressor.compression_count, "original_rows": len(before),
+          "system_bytes": len(agent._cached_system_prompt.encode()),
+          "tool_schema_bytes": serialized_bytes(agent.tools),
+          "main_request_bytes_plus_template": [serialized_bytes(body) + 2048 for body in main],
+          "budget": 35840})
