+from unittest.mock import patch
+
+import httpx
+from openai import OpenAI, AsyncOpenAI
+import pytest
+
+from agent.bounded_context import (
+    BoundedContextError, bind_agent_policy, build_bounded_summary_prompt,
+    configured_policy, guard_main_request, policy_from_config, serialized_bytes,
+    wire_body, wire_output_tokens,
+)
+from agent.context_compressor import ContextCompressor
+
+BASE = "http://192.168.50.10:8001/v1"
+MODEL = "dispatcher"
+PROVIDER = "custom:friday-local"
+
+
+def profile():
+    return {
+        "model": {"provider": PROVIDER, "default": MODEL, "base_url": BASE, "context_length": 40960},
+        "providers": {"friday-local": {
+            "base_url": BASE, "api_mode": "chat_completions", "api_key": "fixture-only",
+            "models": {MODEL: {"context_length": 40960, "bounded_context": {
+                "mode": "local_test", "server_max_input_tokens": 40954,
+                "main_max_output_tokens": 4096, "compression_max_output_tokens": 4096,
+                "safety_margin_tokens": 512, "template_overhead_tokens": 1024,
+            }}},
+        }},
+        "auxiliary": {"title_generation": {"enabled": False}, "compression": {
+            "provider": PROVIDER, "model": MODEL, "base_url": BASE, "api_mode": "chat_completions",
+            "context_length": 40960, "extra_body": {"max_tokens": 4096}, "fallback_chain": [],
+        }},
+        "fallback_providers": [],
+    }
+
+
+@pytest.fixture
+def configured(tmp_path, monkeypatch):
+    from hermes_cli.config import atomic_config_write
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    config = profile()
+    atomic_config_write(tmp_path / "config.yaml", config)
+    return config
+
+
+def make_agent(config=None):
+    config = config or profile()
+    compressor = ContextCompressor(MODEL, config_context_length=40960, provider=PROVIDER,
+                                   base_url=BASE, api_mode="chat_completions", max_tokens=4096, quiet_mode=True)
+    agent = SimpleNamespace(model=MODEL, provider=PROVIDER, base_url=BASE, api_mode="chat_completions",
+                            max_tokens=4096, context_compressor=compressor, _fallback_chain=[],
+                            _ollama_num_ctx=None, _config_context_length=40960, compression_enabled=True)
+    bind_agent_policy(agent, config)
+    return agent
+
+
+def request(text="hello"):
+    return {"model": MODEL, "messages": [{"role": "user", "content": text}], "max_tokens": 4096}
+
+
+def sdk_client(calls, *, async_mode=False, base=BASE):
+    def response(req):
+        body = json.loads(req.content)
+        calls.append((str(req.url), body))
+        if body.get("stream"):
+            return httpx.Response(200, headers={"content-type": "text/event-stream"},
+                                  content='data: {"id":"fixture","choices":[{"index":0,"delta":{"content":"ok"},"finish_reason":"stop"}]}\n\ndata: [DONE]\n\n')
+        return httpx.Response(200, json={"id": "fixture", "object": "chat.completion", "model": MODEL,
+                                        "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok"},
+                                                     "finish_reason": "stop"}]})
+    if async_mode:
+        return AsyncOpenAI(base_url=base, api_key="fixture", max_retries=0,
+                           http_client=httpx.AsyncClient(transport=httpx.MockTransport(response)))
+    return OpenAI(base_url=base, api_key="fixture", max_retries=0,
+                  http_client=httpx.Client(transport=httpx.MockTransport(response)))
+
+
+def test_native_config_loader_admission_and_profile_isolation(configured, tmp_path, monkeypatch):
+    from agent.bounded_context import _enforce_minimum_context
+    from hermes_cli.config import get_compatible_custom_providers, load_config_readonly
+    policy = configured_policy()
+    assert policy.context_length == 40960
+    assert get_compatible_custom_providers(load_config_readonly())[0]["models"][MODEL]["bounded_context"]
+    agent = make_agent(load_config_readonly())
+    _enforce_minimum_context(agent)
+    agent._bounded_context_policy = None
+    with pytest.raises(ValueError, match="minimum 64,000"):
+        _enforce_minimum_context(agent)
+    agent.provider = "lmstudio"
+    _enforce_minimum_context(agent)  # Existing explicitly pinned LM Studio exception.
+    other = tmp_path / "other"
+    other.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(other))
+    assert configured_policy() is None
+
+
+@pytest.mark.parametrize("host,allowed", [
+    ("127.0.0.1", True), ("[::1]", True), ("10.2.3.4", True), ("172.16.1.2", True),
+    ("192.168.50.10", True), ("localhost", False), ("example.com", False),
+    ("8.8.8.8", False), ("169.254.1.2", False), ("172.32.1.1", False), ("0.0.0.0", False),
+])
+def test_literal_local_route_admission(host, allowed):
+    cfg = profile()
+    base = f"http://{host}:8001/v1"
+    cfg["model"]["base_url"] = cfg["providers"]["friday-local"]["base_url"] = base
+    cfg["auxiliary"]["compression"]["base_url"] = base
+    if allowed:
+        assert policy_from_config(cfg).base_url == base
+    else:
+        with pytest.raises(BoundedContextError):
+            policy_from_config(cfg)
+
+
+@pytest.mark.parametrize("alias", ["api", "url", "baseUrl"])
+def test_native_provider_url_aliases_are_admitted(alias):
+    cfg = profile()
+    entry = cfg["providers"]["friday-local"]
+    entry[alias] = entry.pop("base_url")
+    assert policy_from_config(cfg).base_url == BASE
+
+
+@pytest.mark.parametrize("field,value", [
