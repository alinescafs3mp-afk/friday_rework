+@pytest.mark.parametrize("extra", [{"max_tokens": 2048}, {"max_completion_tokens": 4096}, {"max_tokens": True}])
+def test_extra_body_cannot_contradict_output(extra):
+    with pytest.raises(BoundedContextError):
+        policy_from_config(profile()).check_request({**request(), "extra_body": extra})
+
+
+@pytest.mark.parametrize("field", ["system", "tools", "tool_result", "arguments", "extra_prompt"])
+def test_all_wire_prompt_surfaces_are_counted_without_history_mutation(field):
+    req = request()
+    additions = {
+        "system": {"messages": [{"role": "system", "content": "x" * 40000}] + req["messages"]},
+        "tools": {"tools": [{"type": "function", "function": {"name": "fixed", "description": "x" * 40000}}]},
+        "tool_result": {"messages": req["messages"] + [{"role": "tool", "tool_call_id": "a", "content": "x" * 40000}]},
+        "arguments": {"messages": req["messages"] + [{"role": "assistant", "tool_calls": [{"id": "a", "type": "function",
+            "function": {"name": "fixed", "arguments": json.dumps({"value": "x" * 40000})}}]}]},
+        "extra_prompt": {"extra_body": {"prompt": "x" * 40000}},
+    }
+    req.update(additions[field])
+    before = copy.deepcopy(req)
+    with pytest.raises(BoundedContextError):
+        policy_from_config(profile()).check_request(req)
+    assert req == before
+
+
+@pytest.mark.parametrize("text", ["abcXYZ123_", "русский текст", "中文测试", "\x01\n"])
+def test_unicode_and_dense_text_boundary(text):
+    policy = policy_from_config(profile())
+    req = request(text * 20)
+    estimate = serialized_bytes(wire_body(req)) + policy.template_overhead_tokens
+    policy = replace(policy, server_max_input_tokens=estimate + policy.safety_margin_tokens)
+    assert policy.check_request(req)["estimated_input"] == estimate
+    req["messages"][0]["content"] += "x"
+    with pytest.raises(BoundedContextError):
+        policy.check_request(req)
+    req["messages"][0]["content"] = req["messages"][0]["content"][:-2]
+    assert policy.check_request(req)["tokenizer_verified"] is False
+
+
+def test_extra_body_precedence_and_multimodal_rejection():
+    policy = policy_from_config(profile())
+    req = request("x" * 40000)
+    req["extra_body"] = {"messages": [{"role": "user", "content": "small"}]}
+    assert policy.check_request(req)["estimated_input"] < 2000
+    req["extra_body"]["messages"][0]["content"] = [{"type": "image_url", "image_url": {"url": "fixture"}}]
+    with pytest.raises(BoundedContextError, match="multimodal"):
+        policy.check_request(req)
