+    assert wire_output_tokens(kwargs) == 4096
+
+    async def run_async():
+        async with sdk_client(calls, async_mode=True) as client:
+            await _relay_async_completion(client, kwargs, provider=PROVIDER, api_mode="chat_completions",
+                                         create=lambda value: client.chat.completions.create(**value))
+            with pytest.raises(BoundedContextError):
