+
+def build_update(*, update_id=701, message_id=501, sender_id=111, chat_id=-100123,
+                 chat_type="supergroup", thread_id=17, is_forum=True, is_topic=True,
+                 text="offline fixture brief", reply=True, document=False):
+    chat = {"id": chat_id, "type": chat_type, "title": "Offline fixture", "is_forum": is_forum}
+    if chat_type == "private":
+        chat = {"id": chat_id, "type": chat_type, "first_name": "Offline"}
+    message = {
+        "message_id": message_id, "date": 1791309600, "chat": chat,
+        "from": {"id": sender_id, "is_bot": False, "first_name": "Fixture", "username": "fixture_user"},
+        "text": text, "is_topic_message": is_topic,
+    }
+    if thread_id is not None:
+        message["message_thread_id"] = thread_id
+    if reply:
+        message["reply_to_message"] = {
+            "message_id": 500, "date": 1791309590, "chat": deepcopy(chat),
+            "from": {"id": 222, "is_bot": False, "first_name": "Earlier"},
+            "text": "previous complete message",
+        }
+        message["quote"] = {"text": "complete", "position": 9, "is_manual": True}
+    if document:
+        message.pop("text")
+        message["caption"] = text
+        message["document"] = {"file_id": "OFFLINE_FILE_ID", "file_unique_id": "OFFLINE_UNIQUE_ID",
+                               "file_name": "fixture.txt", "mime_type": "text/plain", "file_size": 14}
+    return Update.de_json({"update_id": update_id, "message": message}, bot=None)
+
+
+def build_native_event(update, *, adapter=None, message_type=None):
+    if adapter is None:
+        adapter = TelegramAdapter(PlatformConfig(enabled=True, extra={}))
+    message = update.effective_message
+    if not isinstance(message, Message):
+        raise ValueError("Update does not contain a real Telegram Message")
+    return adapter._build_message_event(message, message_type or MessageType.TEXT,
+                                        update_id=update.update_id)
+
+
+import json
