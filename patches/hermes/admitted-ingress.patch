+    for key in ("GATEWAY_ALLOW_ALL_USERS", "GATEWAY_ALLOWED_USERS",
+                "TELEGRAM_ALLOW_ALL_USERS", "TELEGRAM_GROUP_ALLOWED_USERS",
+                "TELEGRAM_GROUP_ALLOWED_CHATS"):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setenv("TELEGRAM_ALLOWED_USERS", "111")
+
+
+def _bot(bot_id=123456):
+    bot = Bot(f"{bot_id}:OFFLINE_FIXTURE_NOT_A_CREDENTIAL")
+    bot._bot_user = User(bot_id, "Offline", is_bot=True, username="offline_fixture_bot")
