@@ -0,0 +1,13 @@
+"""Shared per-channel prompt lookup; public compatibility export stays in base."""
+
+def resolve_channel_prompt(config_extra: dict, channel_id: str, parent_id: str | None = None) -> str | None:
+    """Per-channel ephemeral prompt from ``config.extra["channel_prompts"]``: exact *channel_id*
+    first, then *parent_id* (threads inherit the parent prompt). Blank prompts count as absent."""
+    prompts = config_extra.get("channel_prompts") or {}
+    if not isinstance(prompts, dict):
+        return None
+    for key in (channel_id, parent_id):
+        prompt = prompts.get(key) if key else None
+        if prompt is not None and (prompt := str(prompt).strip()):
+            return prompt
+    return None
diff --git a/plugins/platforms/telegram/telegram_ingress.py b/plugins/platforms/telegram/telegram_ingress.py
new file mode 100644
index 00000000..9dcda3c8
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_ingress.py
@@ -0,0 +1,85 @@
+"""Identity from the receiving native Telegram Message, without a network call."""
+from __future__ import annotations
+
+
+def _id(value, *, signed=False):
+    if type(value) is not int or (value == 0 if signed else value <= 0):
+        raise ValueError("unresolved_telegram_identity")
+    return str(value)
+
+
+def _attachment(message):
+    if message is None:
+        return None
+    if message.photo:
+        return message.photo[-1]
+    for name in ("document", "video", "audio", "voice", "sticker", "animation"):
+        value = getattr(message, name, None)
+        if value is not None:
+            return value
+    return None
+
+
+def message_provenance(adapter, event):
+    """Do not infer bot identity or associate merged paths with the first upload.
+
+    Native media caching currently loses each merged item's source. Only an
+    unambiguous single own/replied attachment can carry an origin here. These
+    references still require bounded transfer, staging and byte/hash verification
+    before any worker may consume them.
+    """
+    message = event.raw_message
+    if message is None or event.internal or event._ingress_merged:
+        return None
+    try:
+        bot = message.get_bot()
+        if bot is not adapter._bot:
+            return None
+        source = event.source
+        bot_id = _id(bot.id)
+        message_id = _id(message.message_id)
+        user_id = _id(message.from_user.id)
+        chat_id = _id(message.chat.id, signed=True)
+        update_id = _id(event.platform_update_id)
+        if update_id != _id(event._ingress_update_id):
+            return None
+        thread_id = adapter._effective_message_thread_id(message) or ""
+        if (source.user_id != user_id or source.chat_id != chat_id
+                or (source.thread_id or "") != thread_id
+                or event.message_id != message_id or source.message_id != message_id):
+            return None
+        reply = message.reply_to_message
+        reply_id = _id(reply.message_id) if reply is not None else ""
+        if (event.reply_to_message_id or "") != reply_id:
+            return None
+        paths, types = event.media_urls, event.media_types
+        if len(paths) != len(types) or len(paths) > 64:
+            return None
+        media = []
+        candidates = [(msg, _attachment(msg)) for msg in (message, reply)]
+        candidates = [(msg, file) for msg, file in candidates if file is not None]
+        for path, mime in zip(paths, types):
+            origin = None
+            if len(paths) == 1 and len(candidates) == 1:
+                original, file = candidates[0]
+                original_chat = _id(original.chat.id, signed=True)
+                original_thread = adapter._effective_message_thread_id(original) or ""
+                if original_chat == chat_id and original_thread == thread_id:
+                    origin = {
+                        "bot_id": bot_id, "chat_id": original_chat,
+                        "thread_id": original_thread,
+                        "message_id": _id(original.message_id),
+                        "file_id": file.file_id, "file_unique_id": file.file_unique_id,
+                        "declared_bytes": file.file_size,
+                    }
+            media.append({"local_reference": path, "mime_type": mime, "origin": origin})
+        return {
+            "bot_id": bot_id, "user_id": user_id, "chat_id": chat_id,
+            "thread_id": thread_id, "message_id": message_id,
+            "platform_update_id": update_id, "reply_to_message_id": reply_id,
+            "media": media,
+        }
+    except (AttributeError, RuntimeError, TypeError, ValueError):
+        # Restored/synthetic events have no live SDK identity. Ordinary Hermes
+        # handling continues, but no provenance-dependent effect is authorized.
+        return None
