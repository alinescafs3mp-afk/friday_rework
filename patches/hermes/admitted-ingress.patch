+
+    def make(*, payload=None, **kwargs):
+        update = Update.de_json(payload or build_update(**kwargs).to_dict(), adapter._bot)
+        event = build_native_event(update, adapter=adapter)
+        resolved = resolve_identity(event.source, runner=runner, adapter=adapter)
+        assert identity_of(event.source) is resolved
+        assert resolved.adapter() is adapter
+        return update, event
+
+    return SimpleNamespace(adapter=adapter, runner=runner, make=make)
+
+
+def _register(callback):
+    manager = get_plugin_manager()
+    manager._discovered = True
+    manager._hooks.setdefault("post_gateway_admission", []).append(callback)
+
+
+async def _receipt(native, event, *, source=None):
+    seen = []
+    _register(lambda **payload: seen.append(payload))
+    assert await run_post_admission_hook(
+        native.runner, event, source or event.source, "agent:main:telegram:fixture"
+    ) == (False, None)
+    assert len(seen) == 1, "ordinary hook must still execute when provenance is unavailable"
+    return seen[0]["admitted_ingress"]
+
