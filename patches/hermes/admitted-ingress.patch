+def _media_payload(*, own=False, reply=False, reply_chat=-100123, reply_thread=17):
+    payload = build_update(document=own, reply=reply).to_dict()
+    if reply:
+        msg = payload["message"]["reply_to_message"]
+        msg["chat"]["id"] = reply_chat
+        msg["message_thread_id"] = reply_thread
+        msg["is_topic_message"] = True
+        msg["document"] = {
+            "file_id": "REPLY_FILE_ID", "file_unique_id": "REPLY_UNIQUE_ID",
+            "file_name": "reply.txt", "mime_type": "text/plain", "file_size": 23,
+        }
+    return payload
