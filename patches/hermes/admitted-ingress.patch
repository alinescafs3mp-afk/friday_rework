--- /dev/null
+++ b/gateway/admitted_ingress.py
@@ -0,0 +1,41 @@
+"""Plain provenance for consumers of the existing post-admission hook.
+
+This is called only after gateway authorization. It adds no admission decision,
+transport lookup, SDK object, secret, or conversation content to the hook.
+"""
+from __future__ import annotations
+
+import logging
+
+from gateway.session_identity import identity_of
+
+logger = logging.getLogger(__name__)
+
+
+def admitted_ingress(event, source, session_key):
+    if event.internal or event.source is not source:
+        return None
+    identity = identity_of(source)
+    if identity is None or identity.transport_inferred:
+        return None
+    adapter = identity.adapter()
+    if adapter is None:
+        return None
+    try:
+        provenance = adapter.message_provenance(event)
+    except Exception:  # health: allow BLE001 -- Optional proof fails closed; SDK exception text may contain credentials.
+        # Optional provenance failure cannot suppress ordinary hook consumers.
+        # Fatal/cancellation BaseExceptions still propagate to the native host.
+        logger.warning("Inbound message provenance unavailable")
+        return None
+    if provenance is None:
+        return None
+    # Reuse the already resolved identity; do not choose another bot or profile.
+    return {
+        "platform": source.platform.value,
+        "session_key": session_key,
+        "source_profile": source.profile or "",
+        "transport_profile": identity.transport_profile,
+        "runtime_profile": identity.runtime_profile,
+        "message": provenance,
+    }
