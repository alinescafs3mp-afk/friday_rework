+"""Offline native Telegram ingress contract; no authenticated/live bot claim.
+
+The Update builders are reused from the FRW native PTB fixture. Downloaded
+media paths are cache metadata fixtures; no file transfer or byte verification
+is claimed. Bot identity is seeded locally, never fetched with get_me().
+"""
+import sys
+from copy import deepcopy
+
+# The canonical per-file runner isolates this module. Gateway conftest installs
+# SDK mocks before collection; this contract must exercise the installed PTB.
+if "telegram" in sys.modules and not hasattr(sys.modules["telegram"], "__file__"):
+    for _module in tuple(sys.modules):
+        if _module == "telegram" or _module.startswith("telegram."):
+            del sys.modules[_module]
+
+from telegram import Message, Update
