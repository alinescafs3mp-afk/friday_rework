+"""Fixed trusted entrypoint. Model parameters are stdin data, never executable code."""
+import sys
+from pathlib import Path
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
+
+
+def redacted_response_text(original, response):
+    from agent.redact import redact_sensitive_text
+    return redact_sensitive_text(original(response),force=True)
+
+
+def main():
+    import asyncio
+    import contextlib
+    import json
+    import os
+    # Nothing from the donor/profile is imported until trusted input arrives.
+    line=sys.stdin.buffer.readline(65537)
+    if not line.endswith(b'\n') or len(line)>65536:raise RuntimeError('web_input_invalid')
+    data=json.loads(line)
+    if data.get('tool') not in ('web_search','web_extract') or not isinstance(data.get('args'),dict):
+        raise RuntimeError('web_input_invalid')
+    if data.get('home')!=os.environ.get('HERMES_HOME'):raise RuntimeError('web_home_mismatch')
+    mode=data.get('options',{}).get('PARALLEL_SEARCH_MODE','agentic')
+    if mode not in ('fast','one-shot','agentic'):mode='agentic'
+    os.environ['PARALLEL_SEARCH_MODE']=mode
+    from agent.web_call_context import child_deadline
+    child_deadline(data['deadline'])
+    from agent.secret_scope import set_secret_scope,set_multiplex_active
+    from hermes_constants import get_hermes_home
+    set_multiplex_active(True)
+    set_secret_scope(data['secrets'],profile_home=data['home'])
+    from agent.redact import register_vault_redaction_value
+    for name,value in data['secrets'].items():
+        if name.endswith(('_KEY','_TOKEN','_SECRET')):
+            for raw in (value,value.strip()):
+                register_vault_redaction_value(raw)
+                for ascii_only in (True,False):
+                    register_vault_redaction_value(json.dumps(raw,ensure_ascii=ascii_only)[1:-1])
+    from hermes_cli import friday_user_scope as users
+    cap=data.get('authority')
+    if cap is not None:
+        cap=dict(cap)
+        for key in ('authorization_home','home'):cap[key]=Path(cap[key])
+        for key in ('principal','directory_identity'):cap[key]=tuple(cap[key])
+        cap=users.UserScope(**cap);cap.check();users._CURRENT.set(cap)
+    elif users.policy(get_hermes_home()) is not None:
+        raise RuntimeError('web_user_scope_required')
+    from gateway.session_context import set_current_session_id
+    set_current_session_id(data['session_id'])
+    from tools.approval_context import set_current_session_key
+    set_current_session_key(data['session_key'])
+    args=data['args'];users.guard_tool(data['tool'],args)
+    # Normal plugin selection, SSRF, provider bodies, truncation, extract cache
+    # and spills remain native. Their console/debug text is never the protocol.
+    output=sys.stdout
+    with open(os.devnull,'w') as discard, contextlib.redirect_stdout(discard),contextlib.redirect_stderr(discard):
+        from agent.redact import redact_sensitive_text
+        # Use the native redactor before cache/spill and lossy keyless parsing,
+        # scoped to this dedicated child. Donor provider/extract bodies remain
+        # intact; a provider echo cannot become a persistent raw credential.
+        from tools import web_result_cache, web_tools_truncate
+        original_cache=web_result_cache.extract_cache_put
+        original_spill=web_tools_truncate._store_full_text
+        web_result_cache.extract_cache_put=lambda url,content,title='',**kw:original_cache(
+            url,redact_sensitive_text(content,force=True),redact_sensitive_text(title,force=True),**kw)
+        web_tools_truncate._store_full_text=lambda url,content:original_spill(url,redact_sensitive_text(content,force=True))
+        from plugins.web import keyless_mcp
+        original_text=keyless_mcp._response_text
+        keyless_mcp._response_text=lambda response: redacted_response_text(original_text,response)
+        from tools.web_result_cache import search_memo
+        if data['tool']=='web_search':
+            search_memo.import_query(data.get('search_memo',[]),args.get('query',''),args.get('limit',5))
+        from tools import web_tools
+        if data['tool']=='web_search':
+            value=web_tools.web_search_tool(args.get('query',''),limit=args.get('limit',5))
+            memo=search_memo.export_query(args.get('query',''),args.get('limit',5))
+        else:
+            value=asyncio.run(web_tools.web_extract_tool(
+                args.get('urls',[])[:5] if isinstance(args.get('urls'),list) else [],'markdown',
+                char_limit=args.get('char_limit')))
+            memo=[]
+        from agent.web_call_context import check_web_deadline
+        check_web_deadline()
+        from agent.redact import redact_sensitive_text
+        value=redact_sensitive_text(value,force=True)
+        memo=json.loads(redact_sensitive_text(json.dumps(memo,ensure_ascii=True),force=True))
+        users.current()
+    body=json.dumps({'result':json.dumps({'value':value,'search_memo':memo},ensure_ascii=True)},ensure_ascii=True)
+    if len(body.encode())>2_000_000:raise RuntimeError('web_result_too_large')
+    output.write(body+'\n');output.flush()
+
+
+if __name__=='__main__':
+    try:
+        main()
+    except BaseException:
+        # Unit ExecMainStatus is the outcome, no secret-bearing tracebacks.
+        raise SystemExit(1)
