+"""Ordinary registered web handlers, using the caller-owned native child."""
+import json
+import os
+import time
+
+
+def _scope_payload(home):
+    from agent.secret_scope import current_secret_scope, current_secret_scope_home
+    from tools.web_tools import _web_requires_env
+    bound=current_secret_scope()
+    if bound is None:raise RuntimeError('web_profile_scope_required')
+    if current_secret_scope_home()!=str(home):
+        raise RuntimeError('web_profile_scope_mismatch')
+    names=set(_web_requires_env())|{'SEARXNG_URL','BRAVE_SEARCH_API_KEY','XAI_API_KEY','XAI_BASE_URL'}
+    # Existing per-provider declarations; no sibling dotenv or complete profile
+    # secret dump, and never model/bot/login credentials in the subprocess env.
+    from agent.web_search_registry import list_providers
+    for provider in list_providers():
+        names.update(getattr(provider,'requires_env',()) or ())
+        key=getattr(provider,'KEY_ENV',None)
+        if isinstance(key,str):names.add(key)
+    return {name:value for name in names if (value:=bound.get(name)) is not None}
+
+
+def run_web(name,args,**kw):
+    from agent.web_call_context import current_web_call
+    from tools.process_registry import process_registry
+    from hermes_constants import get_hermes_home
+    from hermes_cli.friday_user_scope import current
+    from dataclasses import asdict
+    call=None
+    lock=None
+    lock_held=False
+    try:
+        call=current_web_call()
+        if kw.get('task_id')!=call.task_id or (kw.get('session_id') or '')!=call.session_id:
+            raise RuntimeError('web_caller_identity_mismatch')
+        home=get_hermes_home();cap=current()
+        authority=None
+        if cap is not None:
+            authority=asdict(cap)
+            for key in ('authorization_home','home'):authority[key]=str(authority[key])
+        payload={'tool':name,'args':args,'home':str(home),'deadline':call.deadline(),
+                 'secrets':_scope_payload(home),'authority':authority,
+                 'options':{'PARALLEL_SEARCH_MODE':os.getenv('PARALLEL_SEARCH_MODE','agentic')},
+                 'task_id':call.task_id,'session_id':call.session_id,'session_key':call.session_key,'call_id':call.call_id}
+        # Keep the donor's SearchMemo and single-flight across per-call execs.
+        # Safety/provider gates still run INSIDE the child before every cache hit.
+        from tools.web_result_cache import search_memo
+        if name=='web_search':
+            lock=search_memo.flight_lock('__native_web_call__',args.get('query',''),args.get('limit',5))
+            remaining=call.deadline()-time.monotonic()-2
+            if remaining<=0 or not lock.acquire(timeout=remaining):raise TimeoutError('web_cache_wait_deadline')
+            lock_held=True
+            payload['search_memo']=search_memo.export_query(args.get('query',''),args.get('limit',5))
+        with call.turn.lock:
+            call.check()
+            session=process_registry.spawn_web(call)
+            call.check()
+        payload['deadline']=session.web_deadline
+        raw=process_registry.web_exchange(session,payload,call)
+        receipt=process_registry.settle_web(session)
+        call.receipt=receipt
+        if receipt['status']!='QUIESCENT':
+            receipt=call.stop()
+            call.turn.stopped.set()
+            if receipt['status']!='QUIESCENT':
+                return json.dumps({'error':'STOP_UNCONFIRMED','native_process_id':session.id})
+            raise RuntimeError('web_result_settlement_failed')
+        with call.turn.lock:call.turn.calls.discard(call)
+        if not receipt.get('native_child_exit_zero'):
+            raise RuntimeError('web_native_child_failed')
+        current()  # Recheck the retained active principal/generation before publication.
+        result=json.loads(raw)
+        if set(result)!= {'value','search_memo'} or not isinstance(result['value'],str):
+            raise RuntimeError('web_result_invalid')
+        if name=='web_search':
+            search_memo.import_query(result['search_memo'],args.get('query',''),args.get('limit',5))
+        call.check()
+        return result['value']
+    except Exception as exc:
+        if call is not None:
+            receipt=call.stop()
+            if receipt['status']!='QUIESCENT':
+                call.turn.stopped.set()
+                return json.dumps({'error':'STOP_UNCONFIRMED','native_process_id':getattr(call.session,'id',None)})
+        # Native/provider bodies format their errors themselves. Parent boundary
+        # exceptions are fixed categories, never argv/input/key/traceback dumps.
+        return json.dumps({'error':'web_timeout' if isinstance(exc,TimeoutError) else 'web_native_boundary_refused',
+                           'detail':str(exc) if str(exc) in ('web_caller_context_required','web_original_deadline_required',
+                             'web_call_stopped','web_systemd_required','web_profile_scope_mismatch','web_profile_scope_required',
+                             'web_hard_deadline_unavailable','web_hard_deadline_unverified') else type(exc).__name__})
+    finally:
+        if lock_held:lock.release()
+
+
+def search_handler(args,**kw):
+    return run_web('web_search',args,**kw)
+
+
+async def extract_handler(args,**kw):
+    # Synchronous foreground adapter; donor async extract runs in the owned
+    # process. registry.dispatch/run_async owns the caller's usual async bridge.
+    return run_web('web_extract',args,**kw)
