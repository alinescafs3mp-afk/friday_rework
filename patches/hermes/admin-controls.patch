diff --git a/hermes_cli/plugins_gateway_control.py b/hermes_cli/plugins_gateway_control.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/plugins_gateway_control.py
@@ -0,0 +1,70 @@
+"""Consented local plugin controls on the existing gateway socket/owner registry."""
+import asyncio
+import concurrent.futures
+import json
+import re
+from hermes_constants import get_process_hermes_home, set_hermes_home_override, reset_hermes_home_override
+
+
+def plugin_control_verb(runner, loop):
+    launch_home = get_process_hermes_home()
+    def handler(params):
+        # Never return native exception messages: a provider may include a token.
+        async def dispatch():
+            def invoke():
+                try:
+                    from hermes_cli.profiles import get_profile_dir
+                    from hermes_cli.plugins import get_plugin_manager
+                    if not isinstance(params, dict) or set(params) != {"profile", "plugin", "control", "arguments"}:
+                        return {"accepted": False, "error": "invalid_admin_control"}
+                    token = set_hermes_home_override(launch_home)
+                    try:
+                        if params["profile"] not in runner.served_profile_names():
+                            return {"accepted": False, "error": "owning_profile_unavailable"}
+                        home = get_profile_dir(params["profile"])
+                    finally:
+                        reset_hermes_home_override(token)
+                    token = set_hermes_home_override(home)
+                    try:
+                        manager = get_plugin_manager()
+                        # Look only at the native registry's ALREADY loaded owner.
+                        # Do not call discover/load: this must never create a host.
+                        loaded = manager._plugins.get(params["plugin"])
+                        entry = manager._gateway_verb_handlers.get(params["plugin"] + ":" + params["control"])
+                        if not loaded or not loaded.enabled or not entry or entry["plugin_key"] != params["plugin"]:
+                            return {"accepted": False, "error": "owning_host_not_loaded"}
+                        arguments = params["arguments"]
+                        if not isinstance(arguments, dict) or "profile" in arguments:
+                            return {"accepted": False, "error": "invalid_owning_arguments"}
+                        result = entry["handler"](json.dumps({"profile": params["profile"], **arguments}))
+                        return result if isinstance(result, dict) else {"accepted": False, "error": "invalid_owning_response", "execution": "UNKNOWN"}
+                    finally:
+                        reset_hermes_home_override(token)
+                except Exception:  # health: allow BLE001 -- Arbitrary owner/plugin failures refuse with UNKNOWN; exception text and tracebacks may expose secrets.
+                    return {"accepted": False, "error": "owning_control_unconfirmed", "execution": "UNKNOWN"}
+            # Same gateway loop/executor; the registered callback separately
+            # restores its actual native owner context and re-verifies authority.
+            return await asyncio.to_thread(invoke)
+        try:
+            future = asyncio.run_coroutine_threadsafe(dispatch(), loop)
+            return future.result(timeout=1.5)
+        except concurrent.futures.TimeoutError:
+            # No future cancellation/false cessation. Stop may still be in flight.
+            return {"accepted": False, "error": "owning_control_pending", "execution": "UNKNOWN"}
+        except Exception:  # health: allow BLE001 -- Gateway scheduling/executor failures cannot confirm execution; expose no SDK or configuration secrets.
+            return {"accepted": False, "error": "owning_gateway_unavailable", "execution": "UNKNOWN"}
+    return handler
+
+
+def register_gateway_control(context, name, handler):
+    """Existing native consent and owner lease, shared by all local-control plugins."""
+    from hermes_cli.config import load_config_readonly
+    entry = (load_config_readonly().get("plugins") or {}).get("entries", {}).get(context.plugin_id, {})
+    if entry.get("allow_gateway_control") is not True:
+        return None
+    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", name) or not callable(handler):
+        raise ValueError("Invalid native gateway control registration")
+    return context._register_entry("gateway_control", context.plugin_id + ":" + name, context._manager._gateway_verb_handlers,
+        {"handler": handler, "plugin": context.manifest.name, "plugin_key": context.plugin_id},
+        "Plugin %s registered protected gateway control: %s", name)
+
