+POLICY = BoundedContextPolicy("custom:local", "dispatcher", "http://192.168.50.10:8001/v1",
+                              40960, 40954, 4096, 4096, 1024, 2048, 4096)
+
+def transcript():
+    return [{"role":"user","content":"Read the architecture."},
+            {"role":"assistant","content":"","tool_calls":[{"id":"read","type":"function",
+                "function":{"name":"read_file","arguments":"{}"}}]},
+            {"role":"tool","tool_call_id":"read","content":"Architecture evidence. "*200},
+            {"role":"assistant","content":"Past completed answer.","reasoning":"Past reasoning. "*200},
+            {"role":"user","content":"Save the previous answer, then confirm."},
+            {"role":"assistant","content":"","tool_calls":[{"id":"write","type":"function",
+                "function":{"name":"write_file","arguments":"{}"}}]},
+            {"role":"tool","tool_call_id":"write","content":"Written."}]
+
+class PostToolContextFitTests(unittest.TestCase):
+    def compressor(self, bounded=True):
+        c=ContextCompressor("dispatcher",config_context_length=40960,provider="custom",
+                            base_url=POLICY.base_url,api_mode="chat_completions",max_tokens=4096,quiet_mode=True)
+        c.bounded_context_policy=POLICY if bounded else None
+        return c
+    def test_window_keeps_first_current_user_and_atomic_pending_round(self):
+        rows=transcript();before=copy.deepcopy(rows);c=self.compressor()
+        self.assertEqual(c._compress_window(rows),(1,4));self.assertEqual(rows,before)
+        self.assertEqual(rows[1]["tool_calls"][0]["id"],rows[2]["tool_call_id"])
+        self.assertEqual(rows[5]["tool_calls"][0]["id"],rows[6]["tool_call_id"])
+    def test_complete_new_tool_group_rechecks_once_without_mutating_rows(self):
+        rows=transcript();before=copy.deepcopy(rows)
+        a=SimpleNamespace(_bounded_context_policy=POLICY,_current_turn_timestamp=1)
+        self.assertFalse(bounded_preflight_tool_progress(a,rows[:5]))
+        self.assertFalse(bounded_preflight_tool_progress(a,rows[:5]))
+        self.assertTrue(bounded_preflight_tool_progress(a,rows))
+        self.assertFalse(bounded_preflight_tool_progress(a,rows));self.assertEqual(rows,before)
+    def test_incomplete_or_orphaned_or_duplicate_results_do_not_recheck(self):
+        rows=transcript()
+        for bad in [rows[:-1],rows[:-1]+[dict(rows[-1],tool_call_id="foreign")],rows+[rows[-1]]]:
+            a=SimpleNamespace(_bounded_context_policy=POLICY,_current_turn_timestamp=1)
+            bounded_preflight_tool_progress(a,rows[:5]);self.assertFalse(bounded_preflight_tool_progress(a,bad))
+    def probe(self, before, after):
+        a = SimpleNamespace(_bounded_context_policy=POLICY, _current_turn_timestamp=1,
+                            attempts=2, deadline=12345)
+        self.assertFalse(bounded_preflight_tool_progress(a, copy.deepcopy(before)))
+        value = bounded_preflight_tool_progress(a, copy.deepcopy(after))
+        self.assertEqual((a.attempts, a.deadline), (2, 12345))
+        return value
+    def test_stale_prefix_changes_and_synthetic_duplicate_groups_never_rearm(self):
