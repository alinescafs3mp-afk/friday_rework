+def bounded_tool_groups(messages: list, *, allow_pending_tail: bool = False):
+    """Validate text tool exchanges without repairing or dropping their evidence.
+
+    A pending group is allowed only at the transcript end. Foreign, repeated,
+    malformed or interleaved results invalidate the entire observation.
+    """
+    if not isinstance(messages, list) or any(not isinstance(m, dict) for m in messages):
+        return None
+    groups, seen_ids = [], set()
+    i = 0
+    while i < len(messages):
+        row = messages[i]
+        if row.get("role") == "tool":
+            return None
+        calls = row.get("tool_calls")
+        if not calls:
+            i += 1
+            continue
+        if row.get("role") != "assistant" or not isinstance(calls, list):
+            return None
+        ids = []
+        for call in calls:
+            if not isinstance(call, dict) or call.get("type") != "function":
+                return None
+            call_id, function = call.get("id"), call.get("function")
+            if not isinstance(call_id, str) or not call_id.strip() or not isinstance(function, dict):
+                return None
+            if not isinstance(function.get("name"), str) or not function["name"].strip():
+                return None
+            try:
+                if not isinstance(function.get("arguments"), str) or not isinstance(json.loads(function["arguments"]), dict):
+                    return None
+            except (ValueError, TypeError):
+                return None
+            ids.append(call_id)
+        if len(set(ids)) != len(ids) or seen_ids.intersection(ids):
+            return None
+        seen_ids.update(ids)
+        end = i + 1
+        while end < len(messages) and messages[end].get("role") == "tool":
+            end += 1
+        results = messages[i + 1:end]
+        result_ids = [m.get("tool_call_id") for m in results]
+        if (any(not isinstance(v, str) or not v for v in result_ids)
+                or len(set(result_ids)) != len(result_ids) or not set(result_ids).issubset(ids)
+                or any(not isinstance(m.get("content"), str) for m in results)):
+            return None
+        complete = len(results) == len(ids)
+        if not complete and not (allow_pending_tail and end == len(messages)):
+            return None
+        material = complete and all(m["content"].strip() for m in results)
+        groups.append((i, end, tuple(ids), complete, bool(material)))
+        i = end
+    return groups
+
+
+def bounded_preflight_tool_progress(agent: Any, messages: list) -> bool:
+    """Reconsider a no-op only for appended, newly completed material exchanges.
+
+    Compare immutable row fingerprints, retain consumed call IDs across compacted
+    snapshots, and permit only complete appended groups or completion of the one
+    previously pending tail. Attempts, deadlines and cooldowns are never reset.
+    """
+    import hashlib
+    if not isinstance(getattr(agent, "_bounded_context_policy", None), BoundedContextPolicy):
+        return False
+    turn = getattr(agent, "_current_turn_timestamp", None)
+    previous = getattr(agent, "_bounded_preflight_tool_progress", None)
+    try:
+        fingerprints = tuple(hashlib.sha256(json.dumps(row, ensure_ascii=False,
+            separators=(",", ":"), sort_keys=True, allow_nan=False).encode("utf-8")).hexdigest()
+            for row in messages)
+    except (TypeError, ValueError):
+        return False
+    groups = bounded_tool_groups(messages, allow_pending_tail=True)
+    same_turn = isinstance(previous, dict) and previous.get("turn") == turn and turn is not None
+    consumed = set(previous["completed_ids"]) if same_turn else set()
+    previous_consumed = set(consumed)
+    if groups is not None:
+        consumed.update(call_id for _, _, ids, complete, _ in groups if complete for call_id in ids)
+    agent._bounded_preflight_tool_progress = {
+        "turn": turn, "rows": fingerprints, "groups": groups,
+        "completed_ids": frozenset(consumed),
+    }
+    if not same_turn or groups is None or previous["groups"] is None:
+        return False
+    old_rows = previous["rows"]
+    if len(fingerprints) <= len(old_rows) or fingerprints[:len(old_rows)] != old_rows:
+        return False
+    start = len(old_rows)
+    if previous["groups"] and not previous["groups"][-1][3]:
+        start = previous["groups"][-1][0]
+    appended = [group for group in groups if group[0] >= start]
+    cursor, progress = start, False
+    for begin, end, ids, complete, material in appended:
+        if begin != cursor or not complete or previous_consumed.intersection(ids):
+            return False
+        cursor = end
+        progress = progress or material
+    return progress and cursor == len(messages)
+
+
+def assert_bounded_protected_rows(original: list, assembled: list, start: int, end: int) -> None:
+    """Check immutable eligibility bounds and exact protected rows after assembly."""
+    if not (0 <= start < end <= len(original)):
+        raise BoundedContextError("bounded_context: invalid immutable compression window")
+    # Native persistence bookkeeping is deliberately swept on compaction so a
+    # child-session flush cannot skip carried rows. All payload/provenance fields
+    # and nested call arguments remain exact; no marker or summary rewrites them.
+    payload = lambda rows: [{k: v for k, v in row.items() if k != "_db_persisted"} for row in rows]
+    tail = original[end:]
+    if (payload(assembled[:start]) != payload(original[:start]) or len(assembled) < start + len(tail)
+            or (tail and payload(assembled[-len(tail):]) != payload(tail))
+            or bounded_tool_groups(assembled) is None):
+        raise BoundedContextError("bounded_context: compression changed protected authority/user/tool evidence")
+
+
+def remember_bounded_protected_rows(compressor: Any, original: list, start: int, end: int) -> None:
+    import copy
+    compressor._bounded_protected_rows = (copy.deepcopy(original[:start]), copy.deepcopy(original[end:]))
+
+
+def assert_bounded_protected_wire(agent: Any, request: dict) -> None:
+    """Recheck protected rows after the real formatter and at physical admission.
+
+    Use the real native projection, including API sidecars and strict call fields.
+    A newer turn replaces this contract on its own successful compaction. The
+    original current ask and completed exchanges remain ordered and indivisible.
+    """
+    actual = wire_body(request).get("messages")
+    if not isinstance(actual, list) or bounded_tool_groups(actual) is None:
+        raise BoundedContextError("bounded_context: formatted protected tool evidence is invalid")
+    contract = getattr(agent.context_compressor, "_bounded_protected_rows", None)
+    if contract is None:
+        return
+    from agent.turn_context import build_api_messages
+    head, tail = contract
+    anchors = head + tail
+    current = next((i for i in range(len(anchors)-1, -1, -1)
+                    if anchors[i].get("role") == "user"), None)
+    expected, _ = build_api_messages(agent, anchors, current_turn_user_idx=current,
+        ext_prefetch_cache="", plugin_user_context="", moa_config=None, active_system_prompt="")
+    # Optional prompt construction may add one system row ahead of stored
+    # authority. Protected stored head/tail projections must remain contiguous.
+    def matches(wanted, candidate):
+        if not isinstance(candidate, dict):
+            return False
+        fields = ("role", "content", "tool_calls", "tool_call_id", "reasoning_content")
+        return all(candidate.get(k) == wanted.get(k) for k in fields)
+    split = len(head)
+    groups = (expected[:split], expected[split:])
+    cursor = 0
+    for group in groups:
+        if not group:
+            continue
+        found = next((i for i in range(cursor, len(actual)-len(group)+1)
+                      if all(matches(w, a) for w, a in zip(group, actual[i:i+len(group)]))), None)
+        if found is None:
+            raise BoundedContextError("bounded_context: formatter removed or rewrote protected authority/user/tool rows")
+        cursor = found + len(group)
