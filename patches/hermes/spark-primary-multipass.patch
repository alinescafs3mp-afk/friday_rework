+def _usage_binding_projection(value: Any) -> Any:
+    """Pure nonsecret projection; never resolve env/key_cmd or emit config data.
+
+    Request/template/tool settings affect pricing. Credentials and their lookup
+    mechanisms do not: headers, env maps, auth/secret/key fields are omitted at
+    every nesting level. Known inline credential syntax is redacted as a final
+    guard for command arguments and URLs in MCP/tool configuration.
+    """
+    import re
+    from agent.context_compressor import _redact_compaction_text
+
+    def credential_key(key):
+        key = re.sub(r"[^a-z0-9]", "", str(key).lower())
+        return (key in {"env", "environment", "envfile", "headers", "extraheaders", "key", "keyenv", "keycmd", "keyfile", "auth", "token"}
+                or key.endswith(("accesstoken", "refreshtoken", "idtoken", "authtoken", "apitoken", "bearertoken", "tokenenv", "tokencmd", "tokenfile"))
+                or any(part in key for part in ("apikey", "credential", "password", "passwd", "secret", "authorization", "authentication")))
+
+    if isinstance(value, dict):
+        return {key: _usage_binding_projection(item) for key, item in value.items()
+                if not credential_key(key)}
+    if isinstance(value, (list, tuple)):
+        result, hide_next = [], False
+        for item in value:
+            if hide_next:
+                result.append("[credential argument omitted]")
+                hide_next = False
+                continue
+            if isinstance(item, str) and item.startswith("-"):
+                flag = item.split("=", 1)[0]
+                if credential_key(flag):
+                    result.append(flag + "=[credential argument omitted]")
+                    hide_next = "=" not in item
+                    continue
+            result.append(_usage_binding_projection(item))
+        return result
+    if isinstance(value, str):
+        # A reference is never evaluated or made part of the fingerprint.
+        value = re.sub(r"\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*", "[environment reference omitted]", value)
+        parsed = urlsplit(value)
+        if parsed.scheme in {"http", "https"} and parsed.hostname:
+            # Keep nonsecret endpoint identity while excluding userinfo and all
+            # query/fragment contents, which can carry credential references.
+            from urllib.parse import urlunsplit
+            host = ("[" + parsed.hostname + "]") if ":" in parsed.hostname else parsed.hostname
+            if parsed.port is not None:
+                host += ":" + str(parsed.port)
+            value = urlunsplit((parsed.scheme, host, parsed.path, "", ""))
+        return _redact_compaction_text(value)
+    return value
+
