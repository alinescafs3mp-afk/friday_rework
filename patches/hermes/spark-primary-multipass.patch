+            current = reduced
+        check()
+        telemetry = getattr(compressor, "_active_compression_telemetry", None)
+        evidence = {"chunk_count": len(chunks), "reduction_depth": depth, "summary_calls": calls,
+                    "checkpoint_cache_hits": cache_hits, "accounting": "utf8_json_bytes_plus_template_reserve",
+                    "tokenizer_verified": False, "elapsed_ms": int((time.monotonic() - started) * 1000),
+                    "calls": events}
