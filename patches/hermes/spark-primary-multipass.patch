+    assert compressed[0] == rows[0] and compressed[-3:] == rows[-3:]
+    assert rows == before and len(compressed) < len(rows)
+    assert fit(compressed) > 0
+    assert 'CURRENT_USER_CONSTRAINT_MUST_STAY' in str(compressed)
