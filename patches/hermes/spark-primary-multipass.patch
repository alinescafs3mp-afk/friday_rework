+def configuration(split=True):
+    providers={}
+    for r,cap in ((MAIN,262144),(COMP,40960)):
+        if not split and r == COMP: continue
+        providers[r[0].split(':')[1]]={'name':r[0].split(':')[1], 'base_url':r[2], 'key_env':r[3],
+            'api_mode':'chat_completions','models':{r[1]:policy(cap)}}
+    def row(r): return {'provider':r[0],'model':r[1],'base_url':r[2],'key_env':r[3],'fallback_chain':[]}
+    compression=row(COMP if split else MAIN)
+    compression.update(api_mode='chat_completions',extra_body={'max_tokens':128},
+        multipass={'enabled':bool(split),'max_calls':64,'max_depth':16,'max_attempt_seconds':1800,'max_call_seconds':180},max_concurrency=1)
+    return {'model':{'provider':MAIN[0],'default':MAIN[1],'base_url':MAIN[2],'key_env':MAIN[3],
+                     'context_length':262144,'reasoning_echo':True},
+        'providers':providers,'custom_providers':[], 'fallback_providers':[],
