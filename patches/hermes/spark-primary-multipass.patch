+        private_write(home/'FRIDAY-PROFILE.json',json.dumps({'schema':'friday.product-profile.v1','kind':'normal_product',
+            'profile':'default','required_scoped_names':{'channels':{'telegram':['TELEGRAM_BOT_TOKEN']},
+                'inference':inference,'web':[],'worker_service':[],'inference_web':inference},
+            'native_dashboard':{'operator':{'user_id':'synthetic-operator'}}}))
