+def handler(request):
+    body=json.loads(request.content)
+    role='compression' if body['model']==COMP[1] else 'main'
+    expected=COMP if role=='compression' else MAIN
+    assert request.url == httpx.URL(expected[2]+'/chat/completions')
+    # Never include credential values or Authorization in evidence/assert output.
+    from hermes_constants import get_hermes_home
+    expected_key=admission.owned_values(get_hermes_home())[expected[3]]
+    assert request.headers.get('authorization') == 'Bearer '+expected_key, 'wrong synthetic role credential'
+    OBSERVED.append({'role':role,'url':str(request.url),'model':body['model'],
+                     'wire_bytes':len(request.content),'contains_tools':'tools' in body,
+                     'private_reasoning':body.get('messages',[{}])[-1].get('reasoning_content')=='PRIVATE_SYNTHETIC'})
+    return httpx.Response(200,json={'id':'fixture','object':'chat.completion','created':0,'model':body['model'],
+        'choices':[{'index':0,'finish_reason':'stop','message':{'role':'assistant','content':'fixture'}}],
+        'usage':{'prompt_tokens':12,'completion_tokens':1,'total_tokens':13}})
+
+def client(role='main',**kw):
