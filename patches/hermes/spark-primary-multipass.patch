+def config(capacity=5000, output=1024):
+    def entry(base, model, context, out):
+        return {'base_url': base, 'api_mode': 'chat_completions', 'api_key': 'offline-fixture', 'models': {
+            model: {'context_length': context, 'bounded_context': {
+                'mode': 'local_test', 'server_max_input_tokens': context,
+                'main_max_output_tokens': out, 'compression_max_output_tokens': out,
+                'safety_margin_tokens': 64, 'template_overhead_tokens': 64}}}}
+    return {'model': {'provider': 'custom:friday-local', 'default': 'spark', 'base_url': MAIN,
+                      'context_length': 262144},
+            'providers': {'friday-local': entry(MAIN, 'spark', 262144, 8192),
+                          'friday-compression': entry(AUX, '27b', capacity, output)},
+            'auxiliary': {'compression': {'provider': 'custom:friday-compression', 'model': '27b',
+                'base_url': AUX, 'api_mode': 'chat_completions', 'context_length': capacity,
+                'extra_body': {'max_tokens': output, 'chat_template_kwargs': {'enable_thinking': False}},
+                'fallback_chain': [], 'max_concurrency': 1, 'multipass': {'enabled': True, 'max_calls': 64, 'max_depth': 16,
+                    'max_attempt_seconds': 1800, 'max_call_seconds': 180}}}, 'fallback_providers': []}
+
+
+def compressor(capacity=5000, output=1024):
+    cfg = config(capacity, output)
+    c = ContextCompressor('spark', provider='custom:friday-local', base_url=MAIN,
+                          api_mode='chat_completions', config_context_length=262144,
+                          max_tokens=8192, quiet_mode=True, threshold_tokens_cap=25344)
+    a = SimpleNamespace(model='spark', provider='custom:friday-local', base_url=MAIN,
+        api_mode='chat_completions', max_tokens=8192, context_compressor=c, _fallback_chain=[])
+    bind_agent_policy(a, cfg)
+    c._bounded_summary_json_headroom = 40000
+    allocate(c, 'mandatory')
+    c._bounded_summary_output_tokens = output
+    c._session_id = 'fixture-session'
+    return c, a
+
