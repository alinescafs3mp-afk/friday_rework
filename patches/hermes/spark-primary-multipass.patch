+def history(n=12, size=400):
+    rows = []
+    for i in range(n):
+        rows.extend([{'role': 'user', 'content': f'goal {i}: ' + 'u' * size},
+                     {'role': 'assistant', 'content': f'completed {i}: ' + 'a' * size,
+                      'reasoning_content': 'PRIVATE_THOUGHT_MUST_NOT_APPEAR'}])
+    return rows
+
+
+def completion(text, finish='stop', refusal=None):
+    return SimpleNamespace(choices=[SimpleNamespace(index=0, finish_reason=finish,
+        message=SimpleNamespace(content=json.dumps({'summary': text}), refusal=refusal, tool_calls=None))])
+
+
+def transport(c, calls, *, text_size=400, fail_at=None, finish='stop', after=None):
+    def send(**kwargs):
+        assert kwargs['provider'] == 'custom:friday-compression'
+        assert kwargs['base_url'] == AUX
+        assert kwargs['model'] == '27b'
+        assert 'api_key' not in kwargs  # no primary credential override
+        assert kwargs['timeout'] <= 180
+        body = {key: value for key, value in kwargs.items() if key in ('model', 'messages', 'max_tokens', 'extra_body')}
+        c.bounded_summary_policy.check_request(body, compression=True)
+        assert 'tools' not in body and 'PRIVATE_THOUGHT_MUST_NOT_APPEAR' not in str(body)
+        guard_format(body, physical=True)
+        calls.append(copy.deepcopy(body))
+        if fail_at and len(calls) == fail_at:
+            raise ConnectionError('offline injected failure')
+        if after:
+            after(len(calls))
+        data = json.loads(kwargs['messages'][0]['content'].split('\n', 1)[1])
+        prefix = ('## Historical Task Snapshot\nNone. This session contains no user-authored turns.\n\n'
+                  if not data['context']['has_real_user'] else '')
+        text = prefix + '## Goal\nOriginal source. Later correction wins. Completed action is history. ' + 'n' * text_size
+        text = text[:kwargs['extra_body']['response_format']['json_schema']['schema']['properties']['summary']['maxLength']]
+        return completion(text, finish)
+    return send
+
+
+def run(c, rows, calls, **kwargs):
+    with patch('agent.context_compressor.call_llm', side_effect=transport(c, calls, **kwargs)):
+        return c._generate_summary(rows, focus_topic='keep goal')
+
