+@contextmanager
+def summary(cfg,task='compression'):
+    p=bounded.compression_policy_from_config(cfg)
+    t=bounded._SUMMARY_POLICY.set(p)
+    try:
+        with aux._relay_aux_call_scope((task,),{}):
+            yield p
+    finally:
+        bounded._SUMMARY_POLICY.reset(t)
