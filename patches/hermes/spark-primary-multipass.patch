+@pytest.mark.parametrize('surface', ['provider_template', 'provider_sampling', 'provider_overrides',
+                                   'toolsets', 'platform_toolsets', 'mcp_add', 'mcp_arguments',
+                                   'main_output_budget', 'safety_margin', 'template_reserve', 'tokenizer_identity'])
+def test_effective_template_and_configured_tool_changes_rebind(surface, tmp_path):
+    from hermes_state import SessionDB
+    cfg = config()
+    cfg['providers']['friday-local']['extra_body'] = {'chat_template_kwargs': {'enable_thinking': False}}
+    cfg['mcp_servers'] = {'docs': {'command': 'uvx', 'args': ['docs-server', '--mode', 'read']}}
+    cfg['toolsets'] = ['file']
+    cfg['platform_toolsets'] = {'telegram': ['file']}
+    before = bounded_usage_route_binding(cfg)
+    changed = copy.deepcopy(cfg)
+    if surface == 'provider_template':
+        changed['providers']['friday-local']['extra_body']['chat_template_kwargs']['enable_thinking'] = True
+    elif surface == 'provider_sampling':
+        changed['providers']['friday-local']['extra_body']['temperature'] = 0.25
+    elif surface == 'provider_overrides':
+        changed['providers']['friday-local']['request_overrides'] = {'extra_body': {'chat_template_kwargs': {'preserve_thinking': True}}}
+    elif surface == 'toolsets':
+        changed['toolsets'].append('web')
+    elif surface == 'platform_toolsets':
+        changed['platform_toolsets']['telegram'].append('web')
+    elif surface in {'main_output_budget', 'safety_margin', 'template_reserve', 'tokenizer_identity'}:
+        node = changed['providers']['friday-local']['models']['spark']
+        if surface == 'tokenizer_identity':
+            node['tokenizer_revision'] = 'synthetic-revision-2'
+        else:
+            field = {'main_output_budget': 'main_max_output_tokens', 'safety_margin': 'safety_margin_tokens',
+                     'template_reserve': 'template_overhead_tokens'}[surface]
+            node['bounded_context'][field] += 1
+    elif surface == 'mcp_add':
+        changed['mcp_servers']['web'] = {'command': 'uvx', 'args': ['web-server']}
+    else:
+        changed['mcp_servers']['docs']['args'][-1] = 'search'
+    assert bounded_usage_route_binding(changed) != before
+    db = SessionDB(tmp_path / 'state.db')
+    try:
+        db.create_session('fixture-session', source='telegram', user_id='alice')
+        c, a = compressor()
+        a._session_db, a.session_id = db, 'fixture-session'
+        bind_agent_policy(a, cfg)
+        rows = [{'role': 'user', 'content': 'same transcript'}]
+        set_usage_anchor(a, capture_usage_anchor(1234, 11, rows))
+        durable = db.get_session_model_config_value(a.session_id, '_usage_anchor')
+        # Already-running route rebind clears both live and durable state.
+        bind_agent_policy(a, changed)
+        assert a._usage_anchor is None
+        assert db.get_session_model_config_value(a.session_id, '_usage_anchor') is None
+        # Ordinary restart cannot restore the old provider/template/tool anchor.
+        db.patch_session_model_config(a.session_id, {'_usage_anchor': durable})
+        restore_usage_anchor(a, rows)
+        assert a._usage_anchor is None
+        # Gateway pre-agent hygiene also refuses the old persisted count.
+        atomic_config_write(tmp_path / 'home' / 'config.yaml', changed)
+        db.patch_session_model_config(a.session_id, {'_usage_anchor': durable})
+        assert persisted_anchor_tokens(db, a.session_id, rows) is None
+    finally:
+        db.close()
