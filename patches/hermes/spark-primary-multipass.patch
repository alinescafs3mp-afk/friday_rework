+def write_config(home,cfg,values=None,user=False):
+    private_write(home/'config.yaml',yaml.safe_dump(cfg,sort_keys=False))
+    values=SECRETS if values is None else values
+    private_write(home/'.env',''.join(k+'='+v+'\n' for k,v in values.items()))
