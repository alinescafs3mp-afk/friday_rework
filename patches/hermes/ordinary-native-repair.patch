+def registered_basic():
+    """Resolve the exact Basic class already loaded from this bundled Source.
+
+    Native plugins have a home-specific module identity. Do not import/reload a
+    plugin or infer its class from the registry object to satisfy this boundary.
+    """
+    import inspect
+    import sys
+    from types import ModuleType
+    from hermes_cli.plugins import LoadedPlugin, get_plugin_manager
+    loaded = get_plugin_manager()._plugins.get('dashboard_auth/basic')
+    require(type(loaded) is LoadedPlugin and loaded.enabled is True
+            and not loaded.error and not loaded.deferred)
+    manifest = loaded.manifest
+    directory = SOURCE / 'plugins/dashboard_auth/basic'
+    origin = directory / '__init__.py'
+    require(manifest.source == 'bundled' and manifest.name == 'basic'
+            and manifest.key == 'dashboard_auth/basic'
+            and Path(manifest.path) == directory
+            and Path(manifest.path).resolve() == directory)
+    module = loaded.module
+    require(type(module) is ModuleType and module.__spec__ is not None
+            and Path(module.__file__) == origin
+            and Path(module.__file__).resolve() == origin
+            and Path(module.__spec__.origin) == origin
+            and sys.modules.get(module.__name__) is module)
+    require(module.BasicAuthProvider.__module__ == module.__name__
+            and Path(inspect.getsourcefile(module.BasicAuthProvider)) == origin)
+    return module
+
+
 def expected(*, registered=False, auth_required=None, host=None, port=None):
