+++ b/tests/agent/test_nonstream_request_budget.py
@@ -0,0 +1,100 @@
+"""The same explicit route budget bounds native non-streaming worker and inline requests."""
+
+import json
+import select
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+import run_agent
+from agent import chat_completion_helpers as helpers
+from agent.request_budget import RequestBudgetExceeded
+
+
+@pytest.mark.parametrize("platform", ["cli", "subagent"])
+@pytest.mark.parametrize("silent", [False, True])
+def test_native_nonstream_request_budget_closes_socket_and_watchdogs(tmp_path, monkeypatch, platform, silent):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text(
+        "providers:\n  friday-local:\n    request_timeout_seconds: 30\n"
+        "    request_budget_seconds: {first_event: 0.8, idle: 0.8, total: 3}\n", encoding="utf-8")
+    requests = []
+    eof, stop = threading.Event(), threading.Event()
+    handlers = []
+
+    class Handler(BaseHTTPRequestHandler):
+        protocol_version = "HTTP/1.1"
+
+        def log_message(self, *_args):
+            pass
+
+        def do_GET(self):
+            self.send_response(404)
+            self.send_header("Content-Length", "0")
+            self.end_headers()
+
+        def do_POST(self):
+            if self.path != "/v1/chat/completions":
+                self.send_response(404)
+                self.send_header("Content-Length", "0")
+                self.end_headers()
+                return
+            handlers.append(threading.current_thread())
+            requests.append(json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0)))))
+            self.close_connection = True
+            if silent:
+                while not stop.is_set():
+                    ready, _, _ = select.select([self.connection], [], [], 0.05)
+                    if ready and self.connection.recv(1) == b"":
+                        eof.set()
+                        return
+                return
+            body = json.dumps({"id": "r", "model": "m", "object": "chat.completion", "created": 1,
+                "choices": [{"index": 0, "message": {"role": "assistant", "content": "done"},
+                             "finish_reason": "stop"}]}).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    server.daemon_threads = True
+    listener = threading.Thread(target=lambda: server.serve_forever(poll_interval=0.05), daemon=True)
+    listener.start()
+    before = set(threading.enumerate())
+    agent = None
+    try:
+        agent = run_agent.AIAgent(
+            api_key="test-key", provider="custom", requested_provider="custom:friday-local", model="m",
+            base_url=f"http://127.0.0.1:{server.server_address[1]}/v1", api_mode="chat_completions",
+            platform=platform, quiet_mode=True, skip_context_files=True, skip_memory=True,
+            skip_background_review=True, enabled_toolsets=[], max_iterations=1,
+        )
+        kwargs = {"model": "m", "messages": [{"role": "user", "content": "hi"}]}
+        if silent:
+            with pytest.raises(RequestBudgetExceeded) as caught:
+                helpers.interruptible_api_call(agent, kwargs)
+            assert caught.value.phase == "first_event"
+            assert not caught.value.cleanup_pending
+            assert eof.wait(3), "provider did not observe the native cancellation"
+        else:
+            response = helpers.interruptible_api_call(agent, kwargs)
+            assert response.choices[0].message.content == "done"
+        assert len(requests) == 1
+        assert getattr(agent, "_active_request_abort", None) is None
+        for thread in set(threading.enumerate()) - before - set(handlers):
+            if thread.name.startswith("direct-api-") or "_call" in thread.name:
+                thread.join(timeout=3)
+                assert not thread.is_alive(), "native request helper thread leaked"
+    finally:
+        stop.set()
+        server.shutdown()
+        server.server_close()
+        listener.join(3)
+        for thread in handlers:
+            thread.join(3)
+            assert not thread.is_alive()
+        if agent is not None:
+            agent.client.close()
