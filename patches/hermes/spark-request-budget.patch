+"""Deadline failures terminate the outer turn and fence clients constructed after cancellation."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from agent.chat_completion_helpers import _InlineRequest, _StreamingCall
+from agent.chat_completion_nonstream import _NonStreamRequest
+from agent.request_budget import RequestBudget, RequestBudgetExceeded
+from agent.turn_api_error import handle_api_error
+from hermes_cli.timeouts import ProviderRequestBudget
+
+
+def _expired_budget():
+    budget = RequestBudget(ProviderRequestBudget(1, 1, 5))
+    budget.started -= 2
+    return budget
+
+
+def test_deadline_returns_terminal_failure_before_retry_rotation_or_fallback(monkeypatch):
+    recovery = Mock(side_effect=AssertionError("deadline must not enter recovery"))
+    monkeypatch.setattr("agent.turn_api_error.recover_before_classification", recovery)
+    spinner = Mock()
+    error = RequestBudgetExceeded("idle", 120)
+    verdict = handle_api_error(
+        SimpleNamespace(thinking_callback=None), api_error=error, _retry=Mock(),
+        thinking_spinner=spinner, messages=[], api_messages=[], api_kwargs={}, system_message=None,
+        active_system_prompt=None, conversation_history=[], approx_tokens=0, retry_count=0,
+        max_retries=3, compression_attempts=0, max_compression_attempts=2, api_call_count=1,
+        api_request_id="request", api_start_time=0, effective_task_id="task", turn_id="turn",
+    )
+    assert verdict.action == "return"
+    assert verdict.result["failure_reason"] == "request_budget_exceeded"
+    assert verdict.result["failure_retryable"] is False
+    assert verdict.result["failed"] is True
+    assert verdict.result["completed"] is False
+    assert verdict.result["api_calls"] == 1
+    recovery.assert_not_called()
+
+
+def test_stream_client_constructed_after_deadline_cannot_dispatch():
+    call = _StreamingCall.__new__(_StreamingCall)
+    call._request_budget = _expired_budget()
+    call._budget_error = None
+    call._request_cancelled = {"value": False}
+    call.clients = Mock()
+    with pytest.raises(RequestBudgetExceeded, match="first_event"):
+        call._budget_before_dispatch()
+    assert call._request_cancelled["value"]
+    call.clients.close_once.assert_called_once_with("request_cancelled_before_dispatch")
+
+
+def test_inline_client_registered_after_deadline_cannot_dispatch():
+    client = Mock()
+    agent = SimpleNamespace(
+        provider="custom", model="m", _create_request_openai_client=Mock(return_value=client),
+        _abort_request_openai_client=Mock(),
+    )
+    request = _InlineRequest(agent, {}, 1, 0)
+    request.request_budget = _expired_budget()
+    with pytest.raises(RequestBudgetExceeded, match="first_event"):
+        request.make_client("test")
+    agent._abort_request_openai_client.assert_called_once()
+    client.chat.completions.create.assert_not_called()
+
+
+def test_nonstream_client_registered_after_deadline_cannot_dispatch():
+    request = _NonStreamRequest.__new__(_NonStreamRequest)
+    client = Mock()
+    request.agent = SimpleNamespace(_create_request_openai_client=Mock(return_value=client))
+    request.api_kwargs = {}
+    request.clients = Mock()
+    request.request_budget = _expired_budget()
+    request.cancelled = False
+    with pytest.raises(RequestBudgetExceeded, match="first_event"):
+        request._make_client("test")
+    request.clients.close_once.assert_called_once_with("request_cancelled_before_dispatch")
+    client.chat.completions.create.assert_not_called()
+
+
+def test_late_finish_chunk_cannot_clear_expired_total_budget():
+    budget = RequestBudget(ProviderRequestBudget(2, 2, 3))
+    budget.last_event = budget.started
+    budget.started -= 4
+    error = budget.expired(event=True)
+    assert error.phase == "total"
+    assert budget.expired() is error
