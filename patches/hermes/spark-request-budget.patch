+"""Named custom-provider budgets cancel real native HTTP streams without replay.
+
+The loopback provider never contacts a model. Its socket observes EOF before
+teardown, proving cancellation reaches the in-flight HTTP connection.
+"""
+
+import json
+import select
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+import pytest
+
+import run_agent
+from agent import chat_completion_helpers as helpers
+from agent.request_budget import RequestBudgetExceeded
+
+
+class _BudgetWire:
+    def __init__(self, scenario):
+        self.scenario = scenario
+        self.requests = []
+        self.sent = []
+        self.peer_eof = threading.Event()
+        self.stop = threading.Event()
+        self.handlers = []
+        wire = self
+
+        class Handler(BaseHTTPRequestHandler):
+            protocol_version = "HTTP/1.1"
+
+            def log_message(self, *_args):
+                pass
+
+            def do_GET(self):
+                self.send_response(404)
+                self.send_header("Content-Length", "0")
+                self.end_headers()
+
+            def _chunk(self, delta, finish=None):
+                chunk = {
+                    "id": "budget-test", "object": "chat.completion.chunk", "created": 1, "model": "m",
+                    "choices": [{"index": 0, "delta": delta, "finish_reason": finish}],
+                }
+                self.wfile.write(b"data: " + json.dumps(chunk).encode() + b"\n\n")
+                self.wfile.flush()
+                wire.sent.append(delta)
+
+            def _saw_eof(self, timeout):
+                ready, _, _ = select.select([self.connection], [], [], timeout)
+                if ready and self.connection.recv(1) == b"":
+                    wire.peer_eof.set()
+                    return True
+                return False
+
+            def _wait_for_eof(self):
+                while not wire.stop.is_set():
+                    if self._saw_eof(0.05):
+                        return
+
+            def do_POST(self):
+                size = int(self.headers.get("Content-Length", "0"))
+                body = json.loads(self.rfile.read(size) or b"{}")
+                if self.path != "/v1/chat/completions":
+                    # Constructor metadata discovery also probes Ollama's
+                    # POST /api/show; it must never enter the completion scenario.
+                    self.send_response(404)
+                    self.send_header("Content-Length", "0")
+                    self.end_headers()
+                    return
+                wire.handlers.append(threading.current_thread())
+                wire.requests.append((self.path, body))
+                self.close_connection = True
+                try:
+                    if wire.scenario == "before_headers":
+                        self._wait_for_eof()
+                        return
+                    self.send_response(200)
+                    self.send_header("Content-Type", "text/event-stream")
+                    self.send_header("Connection", "close")
+                    self.end_headers()
+                    self.wfile.flush()
+                    if wire.scenario == "after_headers":
+                        self._wait_for_eof()
+                        return
+                    if wire.scenario == "keepalives":
+                        while not wire.stop.is_set():
+                            self.wfile.write(b": heartbeat\n\n")
+                            self.wfile.flush()
+                            if self._saw_eof(0.15):
+                                return
+                        return
+                    self._chunk({"content": "hello"})
+                    if wire.scenario == "complete":
+                        self._chunk({}, "stop")
+                        self.wfile.write(b"data: [DONE]\n\n")
+                        self.wfile.flush()
+                        return
+                    if wire.scenario == "partial_tool":
+                        self._chunk({"tool_calls": [{
+                            "index": 0, "id": "incomplete", "type": "function",
+                            "function": {"name": "terminal", "arguments": '{"command":"'},
+                        }]})
+                    if wire.scenario in {"idle", "partial_tool"}:
+                        self._wait_for_eof()
+                        return
+                    while not wire.stop.is_set():
+                        if self._saw_eof(0.15):
+                            return
+                        self._chunk({"content": "."})
+                except (BrokenPipeError, ConnectionResetError):
+                    # A write may lose the race with FIN; still require an actual
+                    # EOF observation instead of accepting the write failure.
+                    try:
+                        self._saw_eof(1.0)
+                    except OSError:
+                        pass
+                except OSError:
+                    if not wire.stop.is_set():
+                        raise
+
+        self.server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.server.daemon_threads = True
+        self.server_thread = threading.Thread(
+            target=lambda: self.server.serve_forever(poll_interval=0.05), daemon=True)
+        self.server_thread.start()
+        self.base_url = f"http://127.0.0.1:{self.server.server_address[1]}/v1"
+
+    def close(self):
+        self.stop.set()
+        self.server.shutdown()
+        self.server.server_close()
+        self.server_thread.join(timeout=3)
+        for handler in self.handlers:
+            handler.join(timeout=3)
+            assert not handler.is_alive(), "loopback request handler leaked"
+        assert not self.server_thread.is_alive(), "loopback listener leaked"
+
+
+@pytest.fixture
+def native_request(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    # These long legacy budgets and enabled retries make expiry of the named
+    # 0.8s/3s policy distinguishable from the old read/stale/retry machinery.
+    monkeypatch.setenv("HERMES_STREAM_STALE_TIMEOUT", "30")
+    monkeypatch.setenv("HERMES_STREAM_READ_TIMEOUT", "30")
+    monkeypatch.setenv("HERMES_STREAM_RETRIES", "2")
+    Path(tmp_path, "config.yaml").write_text(
+        "providers:\n  friday-local:\n    request_timeout_seconds: 30\n"
+        "    request_budget_seconds:\n      first_event: 0.8\n      idle: 0.8\n      total: 3\n",
+        encoding="utf-8",
+    )
+    calls, monitors, wires, agents = [], [], [], []
+    original_init = helpers._StreamingCall.__init__
+    original_monitor = helpers._StreamingCall._monitor_loop
+
+    def capture_init(self, *args, **kwargs):
+        original_init(self, *args, **kwargs)
+        calls.append(self)
+
+    def capture_monitor(self):
+        monitors.append(threading.current_thread())
+        return original_monitor(self)
+
+    monkeypatch.setattr(helpers._StreamingCall, "__init__", capture_init)
+    monkeypatch.setattr(helpers._StreamingCall, "_monitor_loop", capture_monitor)
+
+    def make(scenario, platform):
+        wire = _BudgetWire(scenario)
+        wires.append(wire)
+        deltas = []
+        agent = run_agent.AIAgent(
+            api_key="test-key", base_url=wire.base_url, model="m", provider="custom",
+            requested_provider="custom:friday-local", api_mode="chat_completions", platform=platform,
+            stream_delta_callback=deltas.append, quiet_mode=True, skip_context_files=True,
+            skip_memory=True, skip_background_review=True, enabled_toolsets=[], max_iterations=1,
+        )
+        agents.append(agent)
+        agent._interrupt_requested = False
+        return agent, wire, deltas, calls
+
+    yield make
+    for call in calls:
+        if call.worker is not None:
+            call.worker.join(timeout=3)
+            assert not call.worker.is_alive(), "native request worker leaked after budget cancellation"
+        assert call._call_done.is_set(), "request returned before its worker finished"
+    for monitor in monitors:
+        if monitor is not threading.current_thread():
+            monitor.join(timeout=3)
+            assert not monitor.is_alive(), "native inline monitor leaked"
+    for wire in wires:
+        wire.close()
+    for agent in agents:
+        agent.client.close()
+
+
+def _invoke(agent):
+    return helpers.interruptible_streaming_api_call(
+        agent, {"model": "m", "messages": [{"role": "user", "content": "hi"}]})
+
+
+@pytest.mark.parametrize("platform", ["cli", "subagent"])
+def test_timely_native_stream_completes_under_named_provider_budget(native_request, platform):
+    agent, wire, deltas, calls = native_request("complete", platform)
+    response = _invoke(agent)
+    assert response.choices[0].message.content == "hello"
+    assert "hello" in deltas
+    assert len(wire.requests) == 1
+    assert wire.requests[0][0] == "/v1/chat/completions"
+    assert calls[0]._budget_error is None
+
+
+@pytest.mark.parametrize("platform", ["cli", "subagent"])
+@pytest.mark.parametrize("scenario,phase", [
+    ("before_headers", "first_event"),
+    ("after_headers", "first_event"),
+    ("keepalives", "first_event"),
+    ("idle", "idle"),
+    ("ongoing", "total"),
+    ("partial_tool", "idle"),
+])
+def test_named_budget_cancels_native_socket_without_retry_or_partial_result(
+    native_request, platform, scenario, phase,
+):
+    agent, wire, deltas, calls = native_request(scenario, platform)
+    started = time.monotonic()
+    with pytest.raises(RequestBudgetExceeded) as caught:
+        _invoke(agent)
+    elapsed = time.monotonic() - started
+    assert caught.value.phase == phase
+    assert elapsed < 8.0, f"named {phase} budget was not enforced promptly ({elapsed:.2f}s)"
+    assert len(wire.requests) == 1, "budget expiry replayed a request despite terminal cancellation"
+    assert wire.peer_eof.wait(timeout=3), "provider did not observe socket EOF before teardown"
+    call = calls[0]
+    print(f"{platform}/{scenario}: phase={phase} elapsed={elapsed:.3f}s done={call._call_done.is_set()}")
+    assert caught.value.cleanup_pending is False
+    assert call._call_done.is_set(), "public budget failure returned before native cleanup"
+    assert call.worker is None or not call.worker.is_alive()
+    assert call._budget_error is caught.value
+    assert call.result["response"] is None, "expired stream returned a partial response/tool call"
+    assert call._request_cancelled["value"] is True
+    if scenario in {"before_headers", "after_headers", "keepalives"}:
+        assert deltas == []
+    else:
+        assert "hello" in deltas
+    if scenario == "ongoing":
+        assert len(wire.sent) >= 4, "total expiry was not tested with ongoing parsed chunks"
+    if scenario == "partial_tool":
+        assert any("tool_calls" in delta for delta in wire.sent)
