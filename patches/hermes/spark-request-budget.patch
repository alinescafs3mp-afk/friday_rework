@@ -0,0 +1,567 @@
+"""One generic Telegram bubble, native heartbeat/callbacks and real delivery receipts."""
+import asyncio
+from types import SimpleNamespace
+from contextlib import suppress
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.platforms.event import MessageEvent
+from gateway.run import GatewayRunner
+from gateway.run_turn_runner import TurnRunner
+from gateway.run_turn_status import TelegramTurnStatus
+from gateway.session import SessionSource
+from gateway.turn_context import TurnContext
+
+
+class Clock:
+    def __init__(self):
+        self.now = 100.0
+        self.real_loop = asyncio.get_running_loop()
+
+    def time(self):
+        return self.now
+
+    def call_soon_threadsafe(self, callback, *args):
+        return self.real_loop.call_soon_threadsafe(callback, *args)
+
+
+class CaptureAdapter(BasePlatformAdapter):
+    """The native adapter seam, including its shared chat slot; no transport/network."""
+    def __init__(self, clock=None):
+        super().__init__(PlatformConfig(enabled=True, token="***"), Platform.TELEGRAM)
+        self.clock = clock or asyncio.get_running_loop()
+        self.calls, self.deleted, self.slots = [], [], {}
+        self.send_results, self.edit_results = [], []
+        self.final_result = SendResult(success=True, message_id="final")
+        self.final_entered, self.final_release = asyncio.Event(), asyncio.Event()
+        self.final_release.set()
+
+    async def connect(self, *, is_reconnect=False):
+        return True
+
+    async def disconnect(self):
+        pass
+
+    async def get_chat_info(self, chat_id):
+        return {"id": chat_id}
+
+    def _send_flood_cooldown_remaining(self, chat_id):
+        return None
+
+    def _chat_outbound_slot_remaining(self, chat_id):
+        return max(0.0, self.slots.get(str(chat_id), 0) - self.clock.time())
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        self.calls.append(("send", str(chat_id), content, self.clock.time(), metadata))
+        self.slots[str(chat_id)] = self.clock.time() + 1.0
+        if content == "answer":
+            self.final_entered.set()
+            await self.final_release.wait()
+            if isinstance(self.final_result, Exception):
+                raise self.final_result
+            return self.final_result
+        result = self.send_results.pop(0) if self.send_results else SendResult(success=True, message_id=f"bubble-{chat_id}")
+        if isinstance(result, Exception):
+            raise result
+        return result
+
+    async def edit_message(self, chat_id, message_id, content, **kwargs):
+        self.calls.append(("edit", str(chat_id), content, self.clock.time(), str(message_id)))
+        self.slots[str(chat_id)] = self.clock.time() + 1.0
+        result = self.edit_results.pop(0) if self.edit_results else SendResult(success=True, message_id=message_id)
+        if isinstance(result, Exception):
+            raise result
+        return result
+
+    async def delete_message(self, chat_id, message_id):
+        self.deleted.append((str(chat_id), str(message_id)))
+        return True
+
+    async def send_typing(self, chat_id, metadata=None):
+        pass
+
+    async def stop_typing(self, chat_id, metadata=None):
+        pass
+
+
+def make_turn(adapter, chat="c1", generation=1):
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id=chat, chat_type="dm", thread_id="7")
+    ctx = TurnContext(source=source, session_key=f"session-{chat}", run_generation=generation,
+                      _run_still_current=lambda: True)
+    ctx.agent_holder[0] = SimpleNamespace(is_interrupted=False)
+    runner = object.__new__(GatewayRunner)
+    runner._delivery_adapter_for = lambda source: adapter
+    runner._draining = runner._restart_requested = False
+    return runner, ctx
+
+
+def status_for(adapter, clock, chat="c1"):
+    runner, ctx = make_turn(adapter, chat)
+    status = TelegramTurnStatus(runner, ctx, adapter, {"thread_id": "7", "_interim_send": True})
+    status.loop, status.started, status.task = clock, clock.time(), None
+    ctx._telegram_status = status
+    return status, TurnRunner(runner, ctx)
+
+
+@pytest.mark.asyncio
+async def test_single_initial_send_timer_phase_coalescing_and_no_private_text():
+    clock = Clock()
+    adapter = CaptureAdapter(clock)
+    status, turn = status_for(adapter, clock)
+    await status.publish()
+    assert len(adapter.calls) == 1 and "0:00" in adapter.calls[0][2]
+    assert adapter.calls[0][4]["thread_id"] == "7"
+    # Actual worker callback with tool progress OFF still updates only the closed phase.
+    await asyncio.to_thread(turn.progress_callback, "tool.started", "web_search", "/private/reasoning secret", {"token": "secret"})
+    await asyncio.sleep(0)
+    clock.now += 0.4
+    await status.publish()
+    assert len(adapter.calls) == 1  # coalesced into the chat's next allowed slot
+    await asyncio.to_thread(turn.progress_callback, "tool.started", "read_file", "secret", {"path": "/private/file"})
+    await asyncio.sleep(0)
+    clock.now += 0.6
+    await status.publish()
+    assert "Читаю файл" in adapter.calls[-1][2] and "0:01" in adapter.calls[-1][2]
+    for _ in range(5):
+        clock.now += 1
+        await status.publish()
+    assert [c[0] for c in adapter.calls] == ["send"] + ["edit"] * 6
+    assert all(c[4] == "bubble-c1" for c in adapter.calls[1:])
+    assert all("secret" not in c[2] and "/private" not in c[2] and "read_file" not in c[2] for c in adapter.calls)
+    old_phase = status.phase
+    turn.progress_callback("_thinking", "private reasoning", "raw text", {})
+    await asyncio.sleep(0)
+    assert status.phase == old_phase
+    turn.progress_callback("tool.started", "internal-worker-/sensitive/path", "secret", {})
+    await asyncio.sleep(0)
+    clock.now += 1
+    await status.publish()
+    assert "Выполняю действие" in adapter.calls[-1][2]
+    assert "internal" not in adapter.calls[-1][2]
+
+
+@pytest.mark.asyncio
+async def test_explicit_retry_after_is_shared_and_never_replaced_by_sends():
+    clock = Clock()
+    adapter = CaptureAdapter(clock)
+    first, _ = status_for(adapter, clock)
+    second, _ = status_for(adapter, clock)
+    other, _ = status_for(adapter, clock, "c2")
+    await first.publish()
+    clock.now += 1
+    adapter.edit_results = [SendResult(success=False, retry_after=600, error_kind="rate_limited")]
+    await first.publish()
+    await second.publish()
+    await other.publish()
+    assert len([c for c in adapter.calls if c[1] == "c1"]) == 2
+    assert len([c for c in adapter.calls if c[1] == "c2"]) == 1
+    clock.now += 599
+    await first.publish()
+    assert len(adapter.calls) == 3
+    clock.now += 1
+    await first.publish()
+    assert adapter.calls[-1][0] == "edit" and adapter.calls[-1][4] == "bubble-c1"
+    assert len([c for c in adapter.calls if c[0] == "send" and c[1] == "c1"]) == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("outcome", [TimeoutError("uncertain"), SendResult(success=False), SendResult(success=True)])
+async def test_uncertain_initial_send_is_not_repeated(outcome):
+    clock = Clock()
+    adapter = CaptureAdapter(clock)
+    adapter.send_results = [outcome]
+    status, _ = status_for(adapter, clock)
+    await status.publish()
+    for _ in range(4):
+        clock.now += 10
+        await status.publish()
+    assert len(adapter.calls) == 1 and status.disabled
+    await status.after_delivery(delivery_receipt="unknown")
+    assert adapter.deleted == []
+
+
+@pytest.mark.asyncio
+async def test_uncertain_edit_backoff_skipped_ack_and_terminal_error_preserved():
+    clock = Clock()
+    adapter = CaptureAdapter(clock)
+    status, _ = status_for(adapter, clock)
+    await status.publish()
+    original = status.last_text
+    clock.now += 1
+    adapter.edit_results = [SendResult(success=True, message_id=status.message_id, raw_response={"skipped": True})]
+    await status.publish()
+    assert status.last_text == original
+    clock.now += 1
+    adapter.edit_results = [TimeoutError("request may have landed")]
+    await status.publish()
+    clock.now += 1
+    await status.publish()
+    assert len(adapter.calls) == 3
+    clock.now += 1
+    await status.publish()
+    assert len(adapter.calls) == 4 and adapter.calls[-1][0] == "edit"
+    status.finish({"failed": True})
+    clock.now += 1
+    await status.after_delivery(delivery_receipt="confirmed")
+    assert not adapter.deleted
+    assert "ошибкой" in adapter.calls[-1][2]
+
+
+@pytest.mark.asyncio
+async def test_actual_heartbeat_sends_promptly_and_retains_one_second_timer(monkeypatch):
+    adapter = CaptureAdapter()
+    runner, ctx = make_turn(adapter)
+    monkeypatch.setenv("HERMES_AGENT_NOTIFY_INTERVAL", "180")
+    disp = SimpleNamespace(_display_surface_mode=lambda *a, **k: "generic")
+    task = asyncio.create_task(runner._run_agent_notify_long_running(disp, ctx, [None]))
+    try:
+        for _ in range(100):
+            await asyncio.sleep(0)
+            if adapter.calls:
+                break
+        assert len(adapter.calls) == 1  # no 180 s / 5 s initial delay
+        # A second chat is independent while this one holds its slot.
+        runner2, ctx2 = make_turn(adapter, "c2")
+        task2 = asyncio.create_task(runner2._run_agent_notify_long_running(disp, ctx2, [None]))
+        try:
+            await asyncio.wait_for(_wait_edits(adapter, "c1", 2), 4)
+            c1 = [c for c in adapter.calls if c[1] == "c1"]
+            assert all(b[3] - a[3] >= 0.99 for a, b in zip(c1, c1[1:]))
+            assert any(c[1] == "c2" for c in adapter.calls)
+            # Generation loss stops the old bubble. Late tool events cannot wake it.
+            ctx._run_still_current = lambda: False
+            ctx._telegram_status.wake.set()
+            await asyncio.wait_for(task, 3)
+            assert ctx._telegram_status.phase == "stopped"
+        finally:
+            await ctx2._telegram_status.after_delivery(delivery_receipt="unknown")
+            with suppress(asyncio.CancelledError):
+                await task2
+    finally:
+        await ctx._telegram_status.after_delivery(delivery_receipt="unknown")
+        with suppress(asyncio.CancelledError):
+            await task
+
+
+async def _wait_edits(adapter, chat, count):
+    while len([c for c in adapter.calls if c[0] == "edit" and c[1] == chat]) < count:
+        await asyncio.sleep(0.01)
+
+
+def configure_background(adapter, handler, monkeypatch):
+    adapter._message_handler = handler
+    adapter._start_typing_refresh = MagicMock(return_value=None)
+    adapter._stop_typing_refresh = AsyncMock()
+    adapter._release_turn_marker = AsyncMock()
+    adapter._run_processing_hook = AsyncMock()
+    adapter._flush_text_debounce_now = AsyncMock()
+    adapter._finish_session_task = MagicMock()
