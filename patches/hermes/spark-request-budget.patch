+"""Named route identity, opt-in budget validation, and legacy scalar compatibility."""
+
+import json
+
+import pytest
+
+from hermes_cli.timeouts import get_provider_request_budget, get_provider_request_timeout
+
+
+def _config(tmp_path, monkeypatch, value):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text(json.dumps(value), encoding="utf-8")
+
+
+@pytest.mark.parametrize("route", ["friday-local", "custom:friday-local", "CUSTOM:Friday Local"])
+def test_named_route_budget_and_scalar_are_distinct_from_generic_custom(tmp_path, monkeypatch, route):
+    _config(tmp_path, monkeypatch, {"providers": {
+        "custom": {"request_timeout_seconds": 7},
+        "friday-local": {"request_timeout_seconds": 30,
+                         "request_budget_seconds": {"first_event": 180, "idle": 120, "total": 900}},
+        "independent-27b": {"request_timeout_seconds": 12},
+    }})
+    policy = get_provider_request_budget("custom", "m", route)
+    assert (policy.first_event, policy.idle, policy.total) == (180, 120, 900)
+    assert get_provider_request_timeout("custom", "m", route) == 30
+    assert get_provider_request_timeout("custom", "m") == 7
+    assert get_provider_request_budget("custom", "m", "custom:independent-27b") is None
+    assert get_provider_request_timeout("custom", "m", "custom:independent-27b") == 12
+    assert get_provider_request_budget("custom", "m", "custom:missing") is None
+    assert get_provider_request_timeout("custom", "m", "custom:missing") is None
+
+
+def test_legacy_alias_and_model_policy_precedence(tmp_path, monkeypatch):
+    _config(tmp_path, monkeypatch, {"custom_providers": [{
+        "name": "Legacy Local", "request_timeout_seconds": 31,
+        "request_budget_seconds": {"first_event": 180, "idle": 120, "total": 900},
+        "models": {"m": {"timeout_seconds": 33,
+                         "request_budget_seconds": {"first_event": 80, "idle": 60, "total": 300}}},
+    }]})
+    policy = get_provider_request_budget("custom", "m", "custom:legacy-local")
+    assert (policy.first_event, policy.idle, policy.total) == (80, 60, 300)
+    assert get_provider_request_timeout("custom", "m", "custom:legacy-local") == 33
+
+
+def test_canonical_auto_provider_retains_scalar_and_custom_alias_precedence(tmp_path, monkeypatch):
+    _config(tmp_path, monkeypatch, {"providers": {
