+async def test_actual_final_delivery_receipt_controls_cleanup(monkeypatch, outcome, attachment):
+    clock = Clock()
+    adapter = CaptureAdapter(clock)
+    adapter.final_result = outcome
+    status, _ = status_for(adapter, clock)
+    legacy_calls = []
+    adapter.register_post_delivery_callback(status.ctx.session_key, lambda: legacy_calls.append("called"), generation=1)
+    adapter.register_post_delivery_callback(status.ctx.session_key, status.after_delivery, generation=1)
+    await status.publish()
+    status.finish({"final_response": "answer"})
+    clock.now += 10
+    async def handler(event):
+        return "answer"
+    configure_background(adapter, handler, monkeypatch)
+    # The real final-ledgered send invokes this transport seam; no retry/failure-notice
+    # sends are needed to distinguish a final receipt from an uncertain exception.
+    adapter._send_with_retry = adapter.send
+    if attachment is not None:
+        async def attachments(event, extracted, metadata, **kwargs):
+            kwargs["record_delivery"](attachment)
+        adapter._deliver_attachments = attachments
+    event = MessageEvent(text="request", source=status.ctx.source)
+    guard = asyncio.Event()
+    guard._hermes_run_generation = 1
+    adapter._active_sessions[status.ctx.session_key] = guard
+    await adapter._process_message_background(event, status.ctx.session_key)
+    assert legacy_calls == ["called"]
+    success = bool(isinstance(outcome, SendResult) and outcome.success and outcome.message_id
+                   and not outcome.raw_response and (attachment is None or attachment.success))
+    assert bool(adapter.deleted) == success
+    if not success:
+        assert status.phase in {"failed", "unknown"}
+    assert status.ended and not status.awaiting_delivery
+    assert any(c[2] == "answer" for c in adapter.calls)
