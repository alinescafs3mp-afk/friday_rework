new file mode 100644
--- /dev/null
+++ b/gateway/run_turn_status.py
@@ -0,0 +1,219 @@
+"""Telegram's generic heartbeat, driven by the existing per-turn notification task.
+
+Only closed, host-owned phase labels cross this surface. Tool arguments, previews,
+scratch text and activity descriptions are deliberately never rendered.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import math
+from contextlib import suppress
+
+
+_PHASES = {
+    "working": "⏳ Обрабатываю запрос",
+    "search": "⏳ Ищу информацию",
+    "read": "⏳ Читаю файл",
+    "write": "⏳ Сохраняю файл",
+    "action": "⏳ Выполняю действие",
+    "delivery": "⏳ Отправляю результат",
+    "stopped": "⏸ Выполнение остановлено",
+    "error": "⚠ Запрос завершился с ошибкой",
+    "unknown": "⚠ Доставка результата не подтверждена",
+    "failed": "⚠ Не удалось доставить результат",
+    "delivered": "Результат доставлен",
+}
+_TOOL_PHASES = {
+    "web_search": "search", "web_extract": "search", "browse": "search",
+    "read_file": "read", "write_file": "write", "patch": "write",
+}
+
+
+class TelegramTurnStatus:
+    """One editable bubble; pacing belongs to the native Telegram adapter.
+
+    The notification task stays alive through final delivery, then its existing
+    post-delivery callback stops it. No model calls or independent timer task.
+    """
+
+    def __init__(self, runner, ctx, adapter, metadata):
+        self.runner, self.ctx, self.adapter = runner, ctx, adapter
+        self.metadata = metadata
+        self.loop = asyncio.get_running_loop()
+        self.started = self.loop.time()
+        self.wake = asyncio.Event()
+        self.task = asyncio.current_task()
+        self.phase = "working"
+        self.message_id = None
+        self.last_text = None
+        self.next_attempt = 0.0
+        self.failures = 0
+        self.disabled = self.ended = self.finished = self.awaiting_delivery = False
+        # Reuse the adapter's chat pacing and share ONLY server backoff across
+        # this surface's topics/turns. A long retry_after must not be capped.
+        self.retry_until = adapter.__dict__.setdefault("_telegram_status_retry_until", {})
+
+    def activity(self, event_type, tool_name):
+        """Worker-thread bridge; no raw text/args are queued or retained."""
+        if self.ended or self.finished or tool_name == "_thinking":
+            return
+        if event_type == "tool.started" and tool_name:
+            phase = _TOOL_PHASES.get(tool_name, "action")
+        elif event_type == "tool.completed":
+            phase = "working"
+        else:
+            return
+        self.loop.call_soon_threadsafe(self._set_phase, phase)
+
+    def _set_phase(self, phase):
+        if not self.finished and not self.ended and phase != self.phase:
+            self.phase = phase
+            self.wake.set()
+
+    def finish(self, response):
+        """Worker result is not a delivery receipt. Success waits for the adapter."""
+        if self.finished or self.ended:
+            return
+        self.finished = True
+        agent = self.ctx.agent_holder[0]
+        stopped = bool(agent is not None and getattr(agent, "is_interrupted", False))
+        if stopped or (isinstance(response, dict) and response.get("interrupted")):
+            self.phase = "stopped"
+        elif not isinstance(response, dict) or response.get("failed") or response.get("completed") is False:
+            self.phase = "error"
+        else:
+            self.phase = "delivery"
+            self.awaiting_delivery = True
+        self.wake.set()
+
+    def _remaining(self):
+        now, chat = self.loop.time(), self.ctx.source.chat_id
+        key = str(chat)
+        retry = self.retry_until.get(key, 0.0) - now
+        if retry <= 0:
+            self.retry_until.pop(key, None)
+        cooldown = self.adapter._send_flood_cooldown_remaining(chat) or 0.0
+        return max(0.0, self.next_attempt - now, retry, cooldown,
+                   self.adapter._chat_outbound_slot_remaining(chat))
+
+    def _retry_delay(self, result):
+        value = getattr(result, "retry_after", None)
+        if hasattr(value, "total_seconds"):
+            value = value.total_seconds()
+        try:
+            delay = float(value)
+        except (TypeError, ValueError):
+            return None
+        return max(1.0, delay) if math.isfinite(delay) and delay >= 0 else None
+
+    async def publish(self):
+        """An uncertain edit may retry this ID; it never becomes a new send."""
+        if self.disabled or self._remaining() > 0:
+            return
+        elapsed = max(0, int(self.loop.time() - self.started))
+        text = f"{_PHASES[self.phase]} · {elapsed // 60}:{elapsed % 60:02d}"
+        if text == self.last_text:
+            self.next_attempt = self.loop.time() + 1.0
+            return
+        self.next_attempt = self.loop.time() + 1.0
+        try:
+            if self.message_id:
+                result = await self.adapter.edit_message(self.ctx.source.chat_id, self.message_id, text)
+            else:
+                result = await self.adapter.send(self.ctx.source.chat_id, text, metadata=self.metadata)
+        except asyncio.CancelledError:
+            # A cancelled initial send can already have landed. Never send it again.
+            if not self.message_id:
+                self.disabled = True
+            raise
+        except Exception:
+            result = None
+        retry = self._retry_delay(result)
+        if retry is not None:
+            deadline = self.loop.time() + retry
+            self.retry_until[str(self.ctx.source.chat_id)] = deadline
+            self.next_attempt = deadline
+            return  # explicit refusal: even an initial send may safely retry later
+        if result is not None and getattr(result, "success", False):
+            raw = getattr(result, "raw_response", None)
+            if isinstance(raw, dict) and raw.get("skipped"):
+                return  # native slot deferral is NOT a visible edit receipt
+            if not self.message_id:
+                mid = getattr(result, "message_id", None)
+                if not mid:
+                    self.disabled = True
+                    return
+                self.message_id = str(mid)
+            self.failures, self.last_text = 0, text
+            return
+        if not self.message_id:
+            self.disabled = True  # no receipt/ID: retries could create duplicate bubbles
+            return
+        self.failures += 1
+        self.next_attempt = self.loop.time() + min(30.0, 2.0 ** min(self.failures, 5))
+        if getattr(result, "error_kind", None) in {"forbidden", "not_found"}:
+            self.disabled = True
+
+    async def run(self):
+        while not self.ended and not self.disabled:
+            self.wake.clear()
+            superseded = (not self.ctx._run_still_current()
+                          or getattr(self.runner, "_draining", False)
+                          or getattr(self.runner, "_restart_requested", False))
+            if superseded and self.awaiting_delivery:
+                # A newer generation can replace the adapter callback slot.
+                # This old notification task must not survive that replacement.
+                self.awaiting_delivery, self.phase = False, "unknown"
+            elif not self.finished and (superseded or (
+                self.ctx.agent_holder[0] is not None
+                and getattr(self.ctx.agent_holder[0], "is_interrupted", False)
+            )):
+                self.finish({"interrupted": True})
+            if self.finished and not self.awaiting_delivery:
+                await self._terminal_update()
+                return
+            await self.publish()
+            if self.disabled:
+                return
+            # Server backoff suppresses requests, not ownership/stop checks.
+            delay = max(0.01, min(1.0, self._remaining()))
+            try:
+                await asyncio.wait_for(self.wake.wait(), timeout=delay)
+            except asyncio.TimeoutError:
+                pass
+
+    async def after_delivery(self, *, delivery_receipt="unknown"):
+        """Only the real final text/artifact receipts authorize removal."""
+        if self.ended:
+            return
+        self.ended = True
+        self.awaiting_delivery = False
+        if self.task is not None and self.task is not asyncio.current_task():
+            self.task.cancel()
+            with suppress(asyncio.CancelledError):
+                await self.task
+        if self.phase in {"stopped", "error"}:
+            await self._terminal_update()
+            return
+        if delivery_receipt == "confirmed" and self.message_id:
+            with suppress(Exception):
+                if await self.adapter.delete_message(self.ctx.source.chat_id, self.message_id):
+                    return
+            self.phase = "delivered"
+        else:
+            self.phase = "failed" if delivery_receipt == "failed" else "unknown"
+        await self._terminal_update()
+
+    # Existing callback chains can time out before reaching this cleanup. The
+    # adapter invokes it in its finally as well, with the same transport receipt.
+    after_delivery._post_delivery_finalizer = True
+
+    async def _terminal_update(self):
+        # Never hold final delivery/stop on a long server penalty. The last
+        # acknowledged bubble remains visible if Telegram refuses the update.
+        remaining = self._remaining()
+        if remaining <= 1.0:
+            if remaining:
+                await asyncio.sleep(remaining)
+            await self.publish()
