+@pytest.mark.parametrize("bad", [None, 30, {}, {"first_event": 1, "idle": 1},
+    {"first_event": True, "idle": 1, "total": 10},
+    {"first_event": "1", "idle": 1, "total": 10},
+    {"first_event": float("inf"), "idle": 1, "total": 10},
+    {"first_event": 1, "idle": float("nan"), "total": 10},
+    {"first_event": 1, "idle": 0, "total": 10},
+    {"first_event": 11, "idle": 1, "total": 10},
+    {"first_event": 1, "idle": 11, "total": 10},
+    {"first_event": 1, "idle": 1, "total": 86401},
+    {"first_event": 1, "idle": 1, "total": 10, "extra": 2}])
+def test_explicit_invalid_policy_never_falls_back_to_scalar(tmp_path, monkeypatch, bad):
+    _config(tmp_path, monkeypatch, {"providers": {"friday-local": {
