+@pytest.mark.asyncio
+@pytest.mark.parametrize("earlier,receipt", [
+    ("timeout", "confirmed"), ("timeout", "unknown"),
+    ("raises", "confirmed"), ("self_cancel", "unknown"),
+    ("external_cancel", "unknown"),
+])
+async def test_prior_callback_cannot_orphan_status_or_change_receipt(monkeypatch, earlier, receipt):
+    adapter = CaptureAdapter()
+    runner, ctx = make_turn(adapter)
+    entered, never = asyncio.Event(), asyncio.Event()
+    order = []
+    async def prior():
+        order.append("prior")
+        entered.set()
+        if earlier == "raises":
+            raise RuntimeError("earlier unrelated callback failed")
+        if earlier == "self_cancel":
+            raise asyncio.CancelledError
+        await never.wait()
+    adapter.register_post_delivery_callback(ctx.session_key, prior, generation=1)
+    disp = SimpleNamespace(_display_surface_mode=lambda *a, **k: "generic")
+    heartbeat = asyncio.create_task(runner._run_agent_notify_long_running(disp, ctx, [None]))
+    fire = None
+    try:
+        while ctx._telegram_status is None or not adapter.calls:
+            await asyncio.sleep(0)
+        status = ctx._telegram_status
+        status.finish({"final_response": "answer"})
+        adapter.register_post_delivery_callback(ctx.session_key, lambda: order.append("later"), generation=1)
+        guard = asyncio.Event()
+        guard._hermes_run_generation = 1
+        monkeypatch.setattr("gateway.platforms.base._POST_DELIVERY_CALLBACK_TIMEOUT_SECONDS", 0.05)
+        fire = asyncio.create_task(adapter._fire_post_delivery_callback(
+            ctx.session_key, guard, delivery_receipt=receipt))
+        await asyncio.wait_for(entered.wait(), 3)
+        if earlier == "external_cancel":
+            fire.cancel()
+        if earlier in {"self_cancel", "external_cancel"}:
+            with pytest.raises(asyncio.CancelledError):
+                await fire
+        else:
+            await asyncio.wait_for(fire, 3)
+        assert status.ended and not status.awaiting_delivery and heartbeat.done()
+        assert ctx.session_key not in adapter._post_delivery_callbacks
+        assert bool(adapter.deleted) is (receipt == "confirmed")
+        assert order == (["prior", "later"] if earlier == "raises" else ["prior"])
+        if receipt != "confirmed":
+            assert status.phase == "unknown"
+        # The mandatory finally must not repeat a callback already run by the chain.
+        snapshot = list(adapter.calls), list(adapter.deleted)
+        await status.after_delivery(delivery_receipt="confirmed")
+        assert snapshot == (adapter.calls, adapter.deleted)
+    finally:
+        never.set()
+        if fire is not None and not fire.done():
+            fire.cancel()
+            with suppress(asyncio.CancelledError):
+                await fire
+        if ctx._telegram_status is not None:
+            await ctx._telegram_status.after_delivery(delivery_receipt="unknown")
+        with suppress(asyncio.CancelledError):
+            await heartbeat
+
