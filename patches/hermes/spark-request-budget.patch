diff --git a/agent/request_budget.py b/agent/request_budget.py
new file mode 100644
--- /dev/null
+++ b/agent/request_budget.py
@@ -0,0 +1,117 @@
+"""Explicit request-local deadlines, using the existing native request abort machinery."""
+
+from __future__ import annotations
+
+import contextlib
+import threading
+import time
+
+from hermes_cli.timeouts import get_provider_request_budget
+
+
+class RequestBudgetExceeded(TimeoutError):
+    """A terminal policy decision: automatic replay could duplicate provider effects."""
+
+    def __init__(self, phase: str, seconds: float):
+        self.phase = phase
+        self.seconds = seconds
+        self.cleanup_pending = False
+        super().__init__(f"Provider request budget exceeded: {phase} ({seconds:g}s); request cancelled without retry")
+
+    def mark_cleanup_pending(self):
+        if not self.cleanup_pending:
+            self.cleanup_pending = True
+            self.args = (f"{self.args[0]}; STOP_UNCONFIRMED: request worker still unwinding",)
+
+
+class RequestBudget:
+    def __init__(self, policy):
+        self.policy = policy
+        self.started = time.monotonic()
+        self.last_event = None
+        self.error = None
+        self.lock = threading.Lock()
+
+    @classmethod
+    def for_agent(cls, agent):
+        policy = get_provider_request_budget(
+            getattr(agent, "provider", ""), getattr(agent, "model", None), getattr(agent, "requested_provider", None))
+        return cls(policy) if policy is not None else None
+
+    def expired(self, *, event: bool = False):
+        """Deadline checks and chunk arrival share a lock; a late finish cannot win."""
+        with self.lock:
+            now = time.monotonic()
+            if self.error is None:
+                phase = "total" if now - self.started >= self.policy.total else None
+                if phase is None and self.last_event is None and now - self.started >= self.policy.first_event:
+                    phase = "first_event"
+                if phase is None and self.last_event is not None and now - self.last_event >= self.policy.idle:
+                    phase = "idle"
+                if phase is not None:
+                    self.error = RequestBudgetExceeded(phase, getattr(self.policy, phase))
+            if event and self.error is None:
+                self.last_event = now
+            return self.error
+
+
+class BudgetedStream:
+    """Mixin for the native streaming request; no extra watchdog thread or scheduler."""
+
+    def _budget_event(self):
+        if self._request_budget is not None:
+            error = self._request_budget.expired(event=True)
+            if error is not None:
+                self._budget_error = error
+                self._request_cancelled["value"] = True
+                raise error
+
+    def _budget_before_dispatch(self):
+        error = self._request_budget.expired() if self._request_budget is not None else None
+        if error is not None:
+            self._budget_error = error
+            self._request_cancelled["value"] = True
+        if self._request_cancelled["value"]:
+            self.clients.close_once("request_cancelled_before_dispatch")
+            raise self._budget_error or InterruptedError("Request cancelled before provider dispatch")
+
+    def _check_request_budget(self) -> bool:
+        budget = self._request_budget
+        if budget is None:
+            return False
+        error = budget.expired()
+        if error is None:
+            return False
+        self._budget_error = error
+        # Publish cancellation before shutting down: the worker must never reconnect.
+        self._request_cancelled["value"] = True
+        response = self._attempt_stream_response
+        self._cancel_current_stream_attempt("request_budget_exceeded")
+        with contextlib.suppress(Exception):
+            self.clients.close_once("request_budget_exceeded")
+        self._shutdown_stale_attempt_socket(response)
+        if self.worker is not None:
+            self.worker.join(timeout=2.0)
+            if self.worker.is_alive():
+                error.mark_cleanup_pending()
+        return True
+
+
+def main_request_timeout(agent):
+    """Request-local timeout lookup. Auxiliary clients retain their own timeout resolution."""
+    from hermes_cli.timeouts import get_provider_request_timeout
+    policy = get_provider_request_budget(agent.provider, agent.model, getattr(agent, "requested_provider", None))
+    if policy is not None:
+        return policy.total
+    return get_provider_request_timeout(agent.provider, agent.model, getattr(agent, "requested_provider", None))
+
+
+def request_budget_failure(error, messages, api_call_count):
+    return {
+        "final_response": str(error), "messages": messages, "api_calls": api_call_count,
+        "completed": False, "failed": True, "error": str(error),
+        "failure_reason": "request_budget_exceeded", "failure_retryable": False,
+        "request_budget_phase": error.phase,
+        "cleanup_pending": error.cleanup_pending,
+        "request_cleanup": "STOP_UNCONFIRMED" if error.cleanup_pending else "QUIESCENT",
+    }
