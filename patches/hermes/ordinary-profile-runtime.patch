+def onboarded_gateway_profile(home):
+    """Recognize native onboarding homes for inert gateway inventory only.
+
+    Discovery runs before any message/UserScope exists, including disabled
+    incomplete setup. It grants no listener, inference, worker or user authority.
+    The installation remains the sole receiving deployment; native per-event
+    admission and retained generations still govern every user operation.
+    """
+    from hermes_cli import friday_user_scope as user
+    from hermes_cli.friday_product_access import current_access, principal_id
+    from hermes_cli.friday_ordinary_gateway import check
+    home = Path(home)
+    root = SOURCE.parent
+    if home == root or not any((home / name).exists() or (home / name).is_symlink()
+                               for name in (user.ONBOARDING, user.MARKER)):
+        return False
+    require(home == root / 'profiles' / home.name and home.resolve() == home,
+            'user_inventory_home_mismatch')
+    user._private(home.parent, directory=True)
+    st = user._private(home, directory=True)
+    retained = user._CURRENT.get()
+    if retained is not None:
+        require(retained.home == home and retained.authorization_home == root,
+                'user_inventory_scope_mismatch')
+        retained.check()
+    require(not any((home / name).exists() or (home / name).is_symlink()
+                    for name in ('FRIDAY-INSTALL.json', 'FRIDAY-PROFILE.json', 'gateway.json')),
+            'user_inventory_receiving_contract_refused')
+    # Run the unchanged full root source/configuration/history/role checks under
+    # its own secret scope. Never treat a preparation receipt as an install.
+    with scoped(root):
+        check(root)
+        active = user.policy(root)
+        rows = [] if active is None else [b for b in active['bindings']
+                                         if b['runtime_profile'] == home.name]
+        require(len(rows) == 1, 'user_inventory_binding_missing')
+        binding = rows[0]
+        require(binding['platform'] == 'telegram' and binding['transport_profile'] == 'default',
+                'user_inventory_transport_refused')
+        key = principal_id(*(binding[k] for k in
+                           ('platform', 'transport_profile', 'account_id', 'user_id')))
+        row = current_access()['users'].get(key)
+        require(row is not None and row['role'] == 'user'
+                and type(row.get('generation')) is int and row['generation'] >= 1,
+                'user_inventory_access_missing')
+        cfg = configuration(root)
+        templates = cfg['plugins']['entries']['friday_rework']['settings'].get(
+            'onboarding', {}).get('templates', {})
+    raw = read_owned(home / user.ONBOARDING, private=True)
+    receipt = json.loads(raw)
+    require(type(receipt) is dict and set(receipt) == {
+                'schema', 'binding_sha256', 'config_sha256', 'soul_sha256',
+                'required_secrets', 'directory_identity', 'template', 'authorization_home'}
+            and receipt['schema'] == 'friday.onboarding.v1'
+            and receipt['binding_sha256'] == user._fingerprint(binding)
+            and receipt['authorization_home'] == str(root)
+            and receipt['directory_identity'] == [st.st_dev, st.st_ino]
+            and isinstance(receipt['template'], str) and receipt['template'] in templates
+            and isinstance(receipt['required_secrets'], list) and bool(receipt['required_secrets'])
+            and all(isinstance(n, str) and n.isidentifier() for n in receipt['required_secrets'])
+            and len(set(receipt['required_secrets'])) == len(receipt['required_secrets']),
+            'user_inventory_preparation_changed')
+    for name, field in (('config.yaml', 'config_sha256'), ('SOUL.md', 'soul_sha256')):
+        require(hashlib.sha256(read_owned(home / name, private=True)).hexdigest() == receipt[field],
+                'user_inventory_preparation_changed')
+    cfg = configuration(home)
+    require(not any(cfg.get(name) for name in ('dashboard', 'gateway', 'platforms', 'telegram')),
+            'user_inventory_receiving_config_refused')
+    for name in ('memories', 'workspace'):
+        user._private(home / name, directory=True)
+    if (home / 'skills').exists() or (home / 'skills').is_symlink():
+        user._private(home / 'skills', directory=True)
+    marker_path = home / user.MARKER
+    marker_present = marker_path.exists() or marker_path.is_symlink()
+    require(not row['enabled'] or marker_present, 'user_inventory_activation_missing')
+    if marker_present:
+        marker = json.loads(read_owned(marker_path, private=True))
+        require(marker == {'schema': 'friday.user-home.v1', 'principal': key,
+                    'profile': home.name, 'binding_sha256': user._fingerprint(binding),
+                    'onboarding_sha256': hashlib.sha256(raw).hexdigest()},
+                'user_inventory_activation_changed')
+    if row['enabled']:
+        user.check_onboarding_home(root, home, binding)
+    return True
+
+
