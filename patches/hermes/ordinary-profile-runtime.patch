+# Identity construction is synchronous and has no admission effect. Verify its
+# complete source once, at the end of the outer identity computation, before
+# returning any proof. Context isolation prevents sharing a pending validation
+# between requests; calls outside this computation retain immediate verification.
+_SOURCE_CHECKS = ContextVar("friday_identity_source_checks", default=None)
+
+
+@contextmanager
+def _source_check_scope():
+    # Every public identity entry owns a new proof, even in a copied context.
+    # Only explicit private delegation within that synchronous entry shares it.
+    pending = {}
+    scope = {'thread': get_ident(), 'pending': pending, 'active': True}
+    token = _SOURCE_CHECKS.set(scope)
+    try:
+        yield
+        for source, files, receipt in pending.values():
+            _verify_source_files(source, files, receipt)
+    finally:
+        scope['active'] = False
+        pending.clear()
+        _SOURCE_CHECKS.reset(token)
+
+
+def _verify_source_files(source, files, receipt):
+    for name, row in files.items():
+        p = Path(name)
+        require(not p.is_absolute() and '..' not in p.parts and name == str(p))
+        data = read_owned(source / name)
+        require(sha(data) == row['sha256'] and len(data) == row['bytes']
+                and bool((source / name).stat().st_mode & 0o111) == (row['mode'] == '100755'))
+    require(not (source / '.env').exists() and not (source / '.env').is_symlink())
+    generated = ('.hermes/', 'node_modules/', 'ui-tui/node_modules/', 'web/node_modules/',
+                 'ui-tui/dist/', 'hermes_cli/web_dist/')
+    for p in source.rglob('*.py'):
+        name = str(p.relative_to(source))
+        require(name in files or name.startswith(generated))
+    require(read_owned(source.parent / 'hermes-agent.source.json', private=True) == receipt)
+
+
