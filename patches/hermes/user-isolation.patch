+def scoped_file(name, args):
+    """Existing native file tool entrypoint, confined descriptor operations.
+
+    ShellFileOperations cannot confine arbitrary shell reads. Product text I/O
+    uses the same tool names but a descriptor-only local backend; complex native
+    file/shell operations stay explicitly unaccepted until sandbox composition.
+    """
+    cap = current()
+    if cap is None:
+        return None
+    guard_tool(name, args)
+    raw = args.get('path')
+    if not isinstance(raw, str) or not raw or '\x00' in raw:
+        raise ScopeDenied()
+    root = cap.home / 'workspace'
+    path = Path(raw)
+    if path.is_absolute():
+        try:
+            path = path.relative_to(root)
+        except ValueError:
+            raise ScopeDenied() from None
+    parts = path.parts
+    if not parts or any(p in ('.', '..') or p.startswith('.') for p in parts):
+        raise ScopeDenied()
+    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        for component in parts[:-1]:
+            next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+            os.close(fd); fd = next_fd
+            st = os.fstat(fd)
+            if st.st_uid != os.getuid() or st.st_mode & 0o077:
+                raise ScopeDenied()
+        cap.check()
+        if name == 'read_file':
+            item = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
+            try:
+                st = os.fstat(item)
+                if (not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_uid != os.getuid()
+                        or st.st_mode & 0o077 or st.st_size > 1000000):
+                    raise ScopeDenied()
+                data = os.read(item, 1000001)
+            finally:
+                os.close(item)
+            cap.check()
+            lines = data.decode('utf-8').splitlines()
+            offset = args.get('offset', 1); limit = args.get('limit', 2000)
+            if type(offset) is not int or type(limit) is not int or not 1 <= offset <= 1000000 or not 1 <= limit <= 2000:
+                raise ScopeDenied()
+            content = '\n'.join(f'{n+1}: {s}' for n,s in enumerate(lines) if offset-1 <= n < offset-1+limit)[:100000]
+            return json.dumps({'success': True, 'content': content, 'total_lines': len(lines),
+                               'path': str(path), 'scope': 'own_user_workspace'})
+        if name != 'write_file':
+            raise ScopeDenied()
+        content = args.get('content')
+        if not isinstance(content, str) or len(content.encode()) > 1000000:
+            raise ScopeDenied()
+        # Create-only text write avoids in-place hardlink/symlink/inode races.
+        # Existing-file edits require the reviewed native CAS/patch join.
+        item = os.open(parts[-1], os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd)
+        with os.fdopen(item, 'w') as f:
+            f.write(content); f.flush(); os.fsync(f.fileno())
+        cap.check()
+        return json.dumps({'success': True, 'path': str(path), 'bytes_written': len(content.encode()),
+                           'scope': 'own_user_workspace', 'create_only': True})
+    except (OSError, ValueError):
+        raise ScopeDenied() from None
+    finally:
+        os.close(fd)
