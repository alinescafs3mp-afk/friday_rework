+def cli_host_phase(home, *, full=False):
+    """A finite CLI segment grants only a classic single-query invocation."""
+    from hermes_cli.friday_dashboard_owner import read_owned
+    import sys, time, math, argparse
+    marker = json.loads(read_owned(Path(home) / 'FRIDAY-INSTALL.json', private=True))
+    stage = marker.get('completion_stage')
+    if stage is None:
+        return
+    require(stage == 'CLI_HOST_ONLY', 'unknown_completion_stage')
+    require(not full and marker.get('state') == 'INSTALLED_TEMPLATE_INCOMPLETE'
+            and marker.get('home') == str(home) and marker.get('runtime_ready') is False
+            and marker.get('worker_state') == 'BOTH_WORKERS_PREPARATION_PENDING',
+            'cli_host_full_start_refused')
+    claim = marker.get('original_attempt', {})
+    segment = marker.get('cli_segment')
+    if segment is not None:
+        require(type(segment) is dict and set(segment) == {'clock','request','intent_sha256','original_claim_sha256'},
+                'cli_host_segment_required')
+        clock = segment['clock']
+        intent_raw = read_owned(Path(home)/'FRIDAY-INSTALL.cli-segment.intent.json', private=True)
+        original_raw = read_owned(Path(home)/'FRIDAY-INSTALL.json.original-cli-segment', private=True)
+        import hashlib
+        intent = json.loads(intent_raw)
+        require(hashlib.sha256(intent_raw).hexdigest() == segment['intent_sha256']
+                and hashlib.sha256(original_raw).hexdigest() == segment['original_claim_sha256']
+                and json.loads(original_raw) == claim
+                and intent == {'state':'CONSUMED_NOT_COMPLETE','clock':clock,
+                               'request':segment['request'],'original_attempt':claim}
+                and segment['request']['current_input']['sha256'] == marker.get('input_sha256'),
+                'cli_host_segment_history_changed')
+        require(type(clock) is dict and set(clock) == {'schema','seconds','cleanup_seconds','started_mono',
+                'deadline_mono','useful_deadline_mono','boot_id','gnu_pid','gnu_starttime_ticks'}
+                and clock['schema'] == 'friday.cli-segment-clock.v1' and clock['seconds'] == 900
+                and clock['cleanup_seconds'] == 90 and type(clock['started_mono']) in (int,float)
+                and math.isfinite(clock['started_mono'])
+                and clock['deadline_mono'] == clock['started_mono'] + 900
+                and clock['useful_deadline_mono'] == clock['started_mono'] + 810,
+                'cli_host_segment_clock_invalid')
+        require(clock['started_mono'] <= time.monotonic()
+                and type(clock['gnu_pid']) is int and clock['gnu_pid'] > 1
+                and type(clock['gnu_starttime_ticks']) is int and clock['gnu_starttime_ticks'] > 0,
+                'cli_host_segment_clock_invalid')
+        deadline = clock['useful_deadline_mono']; boot = clock['boot_id']
+    else:
+        deadline = claim.get('deadline_mono'); boot = claim.get('boot_id')
+    require(boot == Path('/proc/sys/kernel/random/boot_id').read_text().strip()
+            and type(deadline) in (int, float) and math.isfinite(deadline)
+            and time.monotonic() < deadline, 'cli_host_clock_expired')
+    class Parser(argparse.ArgumentParser):
