+++ b/tests/hermes_cli/test_plugin_state_budget.py
@@ -0,0 +1,152 @@
+"""Cumulative acquisition budgets exclude work and preserve original state semantics."""
+from contextvars import ContextVar, copy_context
+import threading
+import time
+
+import pytest
+
+from hermes_cli import plugins_state as state_module
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+
+
+@pytest.fixture
+def state(tmp_path):
+    token = set_hermes_home_override(tmp_path / 'profile')
+    value = state_module.PluginState('acquisition-budget-test')
+    value.set('original', {'keep': True})
+    yield value
+    reset_hermes_home_override(token)
+
+
+@pytest.mark.parametrize('seconds', [True, -1, float('nan'), float('inf'), 'later'])
+def test_invalid_budget(seconds):
+    with pytest.raises(ValueError):
+        state_module.LockAcquisitionBudget(seconds)
+
+
+def test_exhausted_and_ambiguous_budget_cannot_mutate(state):
+    before = state.path.read_bytes()
+    with pytest.raises(TimeoutError):
+        state.set('original', 9, lock_budget=state_module.LockAcquisitionBudget(0))
+    with pytest.raises(ValueError):
+        state.set('original', 9, lock_budget=state_module.LockAcquisitionBudget(1),
+                  lock_deadline=time.monotonic() + 1)
+    with pytest.raises(ValueError):
+        state.set('original', 9, lock_budget=object())
+    assert state.path.read_bytes() == before
+
+
+def test_slow_filesystem_and_time_between_calls_do_not_spend_acquisition_budget(state, monkeypatch):
+    budget = state_module.LockAcquisitionBudget(.1)
+    original = state._read_unlocked
+    def slow_read():
+        threading.Event().wait(.15)
+        return original()
+    monkeypatch.setattr(state, '_read_unlocked', slow_read)
+    state.set('first', 1, lock_budget=budget)
+    threading.Event().wait(.15)
+    assert state.get('first', lock_budget=budget) == 1
+    state.set('second', 2, lock_budget=budget)
+    assert state.get('original') == {'keep': True}
+
+
+@pytest.mark.platforms('posix')
+def test_guard_then_real_flock_spend_one_allowance(state, monkeypatch):
+    import fcntl
+    budget = state_module.LockAcquisitionBudget(.25)
+    guard = state_module._PLUGIN_STATE_LOCKS_GUARD
+    held, release = threading.Event(), threading.Event()
+    def holder():
+        with guard:
+            held.set()
+            assert release.wait(3)
+    holder_thread = threading.Thread(target=holder)
+    holder_thread.start()
+    assert held.wait(3)
+    fd = state.path.with_name('.state.json.lock').open('a+b')
+    fcntl.flock(fd, fcntl.LOCK_EX)
+    original = state_module._acquire_state_file
+    remaining = []
+    def acquire(handle, deadline):
+        remaining.append(deadline - time.monotonic())
+        return original(handle, deadline)
+    monkeypatch.setattr(state_module, '_acquire_state_file', acquire)
+    # Start release only when the real guard acquisition begins.
+    class Guard:
+        def acquire(self, **kwargs):
+            timer.start()
+            return guard.acquire(**kwargs)
+        def release(self):
+            guard.release()
+    timer = threading.Timer(.12, release.set)
+    monkeypatch.setattr(state_module, '_PLUGIN_STATE_LOCKS_GUARD', Guard())
+    before = state.path.read_bytes()
+    try:
+        with pytest.raises(TimeoutError):
+            state.set('original', 'must not write', lock_budget=budget)
+        assert len(remaining) == 1 and 0 < remaining[0] < .15
+        assert state.path.read_bytes() == before
+        # Unlocking later never revives the exhausted shared allowance.
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        with pytest.raises(TimeoutError):
+            state.get('original', lock_budget=budget)
+    finally:
+        release.set()
+        holder_thread.join(3)
+        if timer.ident is not None:
+            timer.join(3)
+        fd.close()
+        assert not holder_thread.is_alive()
+
+
+def test_copied_context_cannot_share_or_reset_budget_across_threads(state):
+    budget = state_module.LockAcquisitionBudget(.25)
+    errors = []
+    def attempt():
+        try:
+            state.set('foreign-thread', True, lock_budget=budget)
+        except Exception as error:
+            errors.append(error)
+    thread = threading.Thread(target=copy_context().run, args=(attempt,))
+    thread.start()
+    thread.join(3)
+    assert not thread.is_alive() and len(errors) == 1 and isinstance(errors[0], RuntimeError)
+    assert state.get('foreign-thread') is None
+    # Refusal did not replenish or corrupt the owner's allowance.
+    state.set('owner', True, lock_budget=budget)
+    assert state.get('owner', lock_budget=budget) is True
+
+
+def test_overlapping_acquisition_scope_refused(state):
+    budget = state_module.LockAcquisitionBudget(.25)
+    with budget.acquiring():
+        with pytest.raises(RuntimeError, match='sequential'):
+            state.set('nested', True, lock_budget=budget)
+    assert state.get('nested') is None
+
+
+def test_exited_creator_cannot_transfer_budget_through_copied_context(state):
+    slot = ContextVar('exited-creator-budget')
+    captured = {}
+
+    def creator():
+        slot.set(state_module.LockAcquisitionBudget(.25))
+        captured['context'] = copy_context()
+
+    owner = threading.Thread(target=copy_context().run, args=(creator,))
+    owner.start()
+    owner.join(3)
+    assert not owner.is_alive()
+
+    def successor():
+        try:
+            state.set('foreign-thread', True, lock_budget=slot.get())
+        except Exception as error:
+            captured['error'] = error
+
+    replacement = threading.Thread(target=captured['context'].run, args=(successor,))
+    replacement.start()
+    replacement.join(3)
+    assert not replacement.is_alive()
+    assert isinstance(captured.get('error'), RuntimeError)
+    assert state.get('foreign-thread') is None
