+"""Opt-in bounded native state retains its writer and thread/process exclusion."""
+from contextvars import copy_context
+import os
+import threading
+import time
+
+import pytest
+
+from hermes_cli import plugins_state as state_module
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+
+
+@pytest.fixture
+def state(tmp_path):
+    token = set_hermes_home_override(tmp_path / 'profile')
+    value = state_module.PluginState('bounded-test')
+    value.set('original', {'keep': True})
+    yield value
+    reset_hermes_home_override(token)
+
+
+@pytest.mark.platforms('posix')
+@pytest.mark.parametrize('layer', ['guard', 'thread', 'file'])
+@pytest.mark.parametrize('operation', ['get', 'set'])
+def test_contended_lock_times_out_before_holder_release(state, layer, operation):
+    path = state.path.with_name('.state.json.lock')
+    lock = (state_module._PLUGIN_STATE_LOCKS_GUARD if layer == 'guard' else
+            state_module._PLUGIN_STATE_LOCKS[str(path.resolve())])
+    held, release, done = threading.Event(), threading.Event(), threading.Event()
+    errors = []
+    before = state.path.read_bytes()
+    def holder():
+        if layer == 'file':
+            import fcntl
+            with path.open('a+b') as fd:
+                fcntl.flock(fd, fcntl.LOCK_EX)
+                held.set()
+                assert release.wait(5)
+        else:
+            with lock:
+                held.set()
+                assert release.wait(5)
+    def reader():
+        try:
+            if operation == 'get':
+                state.get('original', lock_deadline=time.monotonic() + .1)
+            else:
+                state.set('original', 'changed', lock_deadline=time.monotonic() + .1)
+        except BaseException as error:
+            errors.append(error)
+        finally:
+            done.set()
+    holding = threading.Thread(target=holder)
+    stopping = threading.Thread(target=copy_context().run, args=(reader,))
+    holding.start()
+    try:
+        assert held.wait(3)
+        stopping.start()
+        assert done.wait(3), 'bounded operation must finish with holder still locked'
+        assert len(errors) == 1 and isinstance(errors[0], TimeoutError)
+        assert state.path.read_bytes() == before
+    finally:
+        release.set()
+        holding.join(3)
+        if stopping.ident is not None:
+            stopping.join(3)
+        assert not holding.is_alive() and not stopping.is_alive()
+    state.set('next', 1, lock_deadline=time.monotonic() + 2)
+    assert state.get('original') == {'keep': True}
+    assert state.get('next') == 1
+
+
+@pytest.mark.parametrize('deadline', [True, float('nan'), float('inf'), 'later'])
+def test_invalid_deadline_cannot_mutate(state, deadline):
+    before = state.path.read_bytes()
+    with pytest.raises(ValueError):
+        state.set('original', 9, lock_deadline=deadline)
+    assert state.path.read_bytes() == before
+
+
+def test_expired_deadline_and_bounded_quota_use_original_writer(state, monkeypatch):
+    before = state.path.read_bytes()
+    with pytest.raises(TimeoutError):
+        state.set('original', 9, lock_deadline=time.monotonic() - 1)
+    monkeypatch.setattr(state_module, '_PLUGIN_STATE_QUOTA_BYTES', 10)
+    with pytest.raises(ValueError, match='quota'):
+        state.set('large', 'x' * 100, lock_deadline=time.monotonic() + 2)
+    assert state.path.read_bytes() == before
+    assert os.stat(state.path).st_mode & 0o777 == 0o600
