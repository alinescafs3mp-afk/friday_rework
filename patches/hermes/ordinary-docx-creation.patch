diff --git a/hermes_cli/friday_workspace_docx.py b/hermes_cli/friday_workspace_docx.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/friday_workspace_docx.py
@@ -0,0 +1,183 @@
+"""Short plain DOCX creation only; no rich editing or binary overwrite grant.
+
+The checked-in OPC template is built with python-docx 1.2.0 using its normal
+Document/save pattern, also used by the native MIT productivity/docx skill.
+Only stdlib ZIP/XML is used at runtime. See build_template.py provenance.
+"""
+from io import BytesIO
+from pathlib import Path
+import hashlib
+import base64
+import json
+import os
+import stat
+import uuid
+from xml.etree import ElementTree as ET
+from zipfile import ZipFile, ZIP_DEFLATED
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check, _move
+
+MAX_TEXT = 100000
+MAX_OUTPUT = 1000000
+MAX_PARAGRAPHS = 2000
+_TEMPLATE_SHA = '884478f7f60cfe75d88872eda9c7001084423f92f7c448bfe5446403da198ef4'
+_W = '{http://schemas.openxmlformats.org/wordprocessingml/2006/main}'
+_XML_SPACE = '{http://www.w3.org/XML/1998/namespace}space'
+
+
+def render(content):
+    if not isinstance(content,str): raise ScopeDenied()
+    # Bound before encoding or constructing XML; reject non-XML Unicode early.
+    if len(content)>MAX_TEXT: raise ScopeDenied()
+    if any(not (ord(c) in (9,10,13) or 0x20<=ord(c)<=0xD7FF
+                or 0xE000<=ord(c)<=0xFFFD or 0x10000<=ord(c)<=0x10FFFF) for c in content):
+        raise ScopeDenied()
+    if len(content.encode('utf-8'))>MAX_TEXT: raise ScopeDenied()
+    lines=content.replace('\r\n','\n').replace('\r','\n').split('\n')
+    if len(lines)>MAX_PARAGRAPHS: raise ScopeDenied()
+    # Text-only native overlay preserves the exact checked template bytes.
+    with Path(__file__).with_name('friday_plain_docx_template.b64').open('rb') as resource:
+        encoded=resource.read(48762)
+    if len(encoded)!=48761 or not encoded.endswith(b'\n'):raise ScopeDenied()
+    try:template=base64.b64decode(encoded[:-1],validate=True)
+    except ValueError:raise ScopeDenied() from None
+    if hashlib.sha256(template).hexdigest()!=_TEMPLATE_SHA: raise ScopeDenied()
+    result=BytesIO()
+    with ZipFile(BytesIO(template)) as source, ZipFile(result,'w',compression=ZIP_DEFLATED) as target:
+        for info in source.infolist():
+            data=source.read(info.filename)
+            if info.filename=='word/document.xml':
+                document=ET.fromstring(data)
+                # The plain template uses no extension elements. ElementTree
+                # drops unused prefix declarations; remove the now-inapplicable
+                # mc:Ignorable prefix list instead of leaving unbound names.
+                document.attrib.pop('{http://schemas.openxmlformats.org/markup-compatibility/2006}Ignorable',None)
+                body=document.find(_W+'body')
+                if body is None: raise ScopeDenied()
+                section=body.find(_W+'sectPr')
+                for node in list(body): body.remove(node)
+                for line in lines:
+                    para=ET.SubElement(body,_W+'p');run=ET.SubElement(para,_W+'r')
+                    text=ET.SubElement(run,_W+'t',{_XML_SPACE:'preserve'});text.text=line
+                if section is not None: body.append(section)
+                data=ET.tostring(document,encoding='utf-8',xml_declaration=True)
+            target.writestr(info,data)
+    data=result.getvalue()
+    if len(data)>MAX_OUTPUT: raise ScopeDenied()
+    return data
+
+
+def _snapshot(item,fd,leaf):
+    before=os.fstat(item)
+    fields=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_uid')
+    def identity(st): return tuple(getattr(st,k) for k in fields)
+    if (not stat.S_ISREG(before.st_mode) or before.st_nlink!=1 or before.st_uid!=os.getuid()
+            or before.st_mode&0o077 or before.st_size>MAX_OUTPUT): raise ScopeDenied()
+    os.lseek(item,0,os.SEEK_SET); chunks=[];size=0
+    while chunk:=os.read(item,min(65536,MAX_OUTPUT+1-size)):
+        size+=len(chunk);chunks.append(chunk)
+        if size>MAX_OUTPUT:raise ScopeDenied()
+    after=os.fstat(item);named=os.stat(leaf,dir_fd=fd,follow_symlinks=False)
+    if size!=before.st_size or identity(before)!=identity(after) or identity(after)!=identity(named):
+        raise ScopeDenied()
+    return b''.join(chunks),identity(after)
+
+
+def _check_parent(cap, fd, path):
+    """Reopen the retained logical parent; a moved descriptor grants no path."""
+    check(cap)
+    from hermes_cli.friday_user_scope import _workspace_directory
+    relative = Path(path)
+    if relative.is_absolute() or not relative.parts or any(
+            part in ('.','..') or part.startswith('.') for part in relative.parts):
+        raise ScopeDenied()
+    fresh = _workspace_directory(cap)
+    try:
+        for part in relative.parts[:-1]:
+            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fresh)
+            os.close(fresh)
+            fresh = child
+        named, held = os.fstat(fresh), os.fstat(fd)
+        if (named.st_dev, named.st_ino) != (held.st_dev, held.st_ino):
+            raise ScopeDenied()
+    finally:
+        os.close(fresh)
+    check(cap)
+
+
+def create(cap,fd,leaf,path,content):
+    """Complete private bytes then Linux atomic NOREPLACE publication.
+
+    Never removes an uncertain published name: post-publication errors report
+    unknown effects and suppress blind retry through native reply accounting.
+    """
+    _check_parent(cap,fd,path)
+    data=render(content)
+    _check_parent(cap,fd,path)
+    stage='.friday-docx-'+uuid.uuid4().hex
+    item=None;published=False;uncertain=False;cleanup_failed=False
+    try:
+        # Existing files, directories, symlinks and binary documents all win.
+        try:os.stat(leaf,dir_fd=fd,follow_symlinks=False)
+        except FileNotFoundError:pass
+        else:return json.dumps({'success':False,'error':'document_already_exists','path':path})
+        item=os.open(stage,os.O_RDWR|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=fd)
+        _check_parent(cap,fd,path)
+        with os.fdopen(os.dup(item),'wb') as stream:
+            stream.write(data);stream.flush();os.fsync(stream.fileno())
+        staged,version=_snapshot(item,fd,stage)
+        if staged!=data:raise ScopeDenied()
+        _check_parent(cap,fd,path)
+        # Mark uncertain before syscall: a wrapper may raise after rename.
+        uncertain=True
+        _move(fd,stage,fd,leaf)
+        published=True;uncertain=False
+        os.fsync(fd)
+        _check_parent(cap,fd,path)
+        actual,after=_snapshot(item,fd,leaf)
+        # Rename may change ctime only; byte hash and all other fields agree.
+        if actual!=data or version[:4]+version[5:]!=after[:4]+after[5:]:raise ScopeDenied()
+        _check_parent(cap,fd,path)
+        result = json.dumps({'success':True,'format':'docx','path':path,
+            'scope':'own_user_workspace','create_only':True,'verified':True,
+            'bytes_written':len(data),'sha256':hashlib.sha256(data).hexdigest()})
+    except (OSError,ScopeDenied,RuntimeError,TimeoutError) as error:
+        # If publication raised, descriptor identity determines actual effect.
+        if uncertain and item is not None:
+            # A different/missing final name cannot disprove a completed rename:
+            # another writer may already have replaced or removed our publication.
+            try:
+                named=os.stat(leaf,dir_fd=fd,follow_symlinks=False);held=os.fstat(item)
+                if (named.st_dev,named.st_ino)==(held.st_dev,held.st_ino):
+                    published=True
+            except OSError:pass
+            if not published:
+                try:
+                    remaining, remaining_version = _snapshot(item,fd,stage)
+                    if remaining == data and remaining_version == version:
+                        uncertain=False  # Original private stage is provably unchanged.
+                except (OSError,ScopeDenied):pass
+        unknown=published or uncertain
+        if unknown:
+            from agent.web_call_context import _current
+            call=_current.get()
+            if call is not None and hasattr(call,'agent'):call.agent._friday_reply_effect_unknown=True
+        result = json.dumps({'success':False,'error':'document_publication_uncertain' if unknown else 'document_not_created',
+                           'effect_disposition':'unknown' if unknown else 'none'})
+    finally:
+        if item is not None:
+            # Stage is removed only when its name still identifies our inode.
+            try:
+                named=os.stat(stage,dir_fd=fd,follow_symlinks=False);held=os.fstat(item)
+                if (named.st_dev,named.st_ino)==(held.st_dev,held.st_ino):
+                    os.unlink(stage,dir_fd=fd);os.fsync(fd)
+            except FileNotFoundError:pass
+            except OSError:
+                cleanup_failed=True
+            finally:os.close(item)
+    if cleanup_failed:
+        from agent.web_call_context import _current
+        call=_current.get()
+        if call is not None and hasattr(call,'agent'):call.agent._friday_reply_effect_unknown=True
+        return json.dumps({'success':False,'error':'document_cleanup_incomplete','effect_disposition':'unknown'})
+    return result
