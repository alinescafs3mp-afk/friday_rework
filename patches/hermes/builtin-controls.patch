+"""Retired native ownership and exception escape hatches with offline ingress."""
+import asyncio
+from dataclasses import replace
+from unittest.mock import MagicMock
+
+import pytest
+
+from gateway.session_identity import identity_of
+from hermes_cli.plugins import PluginContext, PluginManifest, _plugin_home_scope, get_plugin_manager
+from tests.gateway.test_native_plugin_controls import (
+    builtin as builtin_fixture, control as control_fixture,
+    native as native_fixture, offline_boundary as boundary_fixture,
+)
+
+builtin = builtin_fixture
+control = control_fixture
+native = native_fixture
+offline_boundary = boundary_fixture
+
+
+def registration(builtin):
+    return next(item for item in reversed(builtin.manager._registration_order)
+                if item.kind == "command" and item.key == "task-control")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("retire", ["dispose", "unload"])
+@pytest.mark.parametrize("replacement", ["native", "ordinary", "none"])
+async def test_retired_generation_survives_reregistration(native, builtin, retire, replacement):
+    if retire == "dispose":
+        registration(builtin).dispose()
+    else:
+        builtin.manager.unload()
+    seen = []
+    if replacement == "native":
+        builtin.register(lambda args: seen.append(builtin.context.get_command_context()) or "new owner")
+    elif replacement == "ordinary":
+        builtin.context.register_command("task-control", lambda args: seen.append(args) or "ordinary")
+    _, event = native.make(text="/stop")
+    result = await native.runner._handle_message(event)
+    assert "UNKNOWN" in result
+    assert len(seen) == int(replacement == "native")
+    assert builtin.observed == []
+    if seen:
+        assert seen[0]["native_operation"] == "stop"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("dispose_newest", [False, True])
+async def test_disposal_restores_only_live_generation_and_keeps_retired_unknown(native, builtin, dispose_newest):
+    first = registration(builtin)
+    seen = []
+    second = builtin.register(lambda args: seen.append(args) or "second")
+    (second if dispose_newest else first).dispose()
+    _, event = native.make(text="/stop")
+    result = await native.runner._handle_message(event)
+    assert "UNKNOWN" in result
+    assert len(builtin.observed) == int(dispose_newest)
+    assert len(seen) == int(not dispose_newest)
+    first.dispose()
+    second.dispose()
+    _, event = native.make(text="/new")
+    result = await native.runner._handle_message(event)
+    assert "UNKNOWN" in result
+    assert len(builtin.observed) == int(dispose_newest)
+    assert len(seen) == int(not dispose_newest)
+
+
+@pytest.mark.asyncio
+async def test_retired_ownership_does_not_cross_profile_or_operation(native, builtin, tmp_path):
+    home = tmp_path / "satellite"
+    home.mkdir()
+    with _plugin_home_scope(home):
+        manager = get_plugin_manager()
+        manager._discovered = True
+        context = PluginContext(PluginManifest(name="retired-satellite", source="user"), manager)
+    seen = []
+    handle = context.register_command("task-control", lambda args: seen.append(args),
+                                      gateway_control=True, native_controls=("stop",))
+    handle.dispose()
+    _, event = native.make(text="/stop")
+    result = await native.runner._handle_message(event)
+    assert "UNKNOWN" not in result
+    assert len(builtin.observed) == 1
+    event.source.profile = "satellite"
+    event.source._identity = replace(identity_of(event.source), runtime_profile="satellite", runtime_home=home)
+    result = await native.runner._handle_stop_command(event)
+    assert "UNKNOWN" in result
+    _, reset = native.make(text="/new")
+    reset.source.profile = "satellite"
+    reset.source._identity = replace(identity_of(reset.source), runtime_profile="satellite", runtime_home=home)
+    result = await native.runner._handle_reset_command(reset)
+    assert "UNKNOWN" not in result
+    assert seen == [] and len(builtin.observed) == 1
+    manager.unload()
+
+
+@pytest.mark.asyncio
+async def test_disposal_during_native_attempt_refuses_captured_callback(native, builtin):
+    handle = registration(builtin)
+    original = native.runner._clear_conversation_scope
+    def clear(key, *, reason):
+        original(key, reason=reason)
+        handle.dispose()
+    native.runner._clear_conversation_scope = clear
+    _, event = native.make(text="/new")
+    result = await native.runner._handle_message(event)
+    assert "UNKNOWN" in result and builtin.observed == []
+    native.runner.session_store.reset_session.assert_called_once()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", ["storage", "native_cancel"])
+@pytest.mark.parametrize("callback", ["success", "error", "self_cancel", "timeout"])
+async def test_exception_notification_preserves_original_error_and_once_only(native, builtin, failure, callback, monkeypatch):
+    from gateway import run_native_controls
+    monkeypatch.setattr(run_native_controls, "_NATIVE_CONTROL_TIMEOUT", 0.05)
+    original = OSError("storage-original") if failure == "storage" else asyncio.CancelledError("native-original")
+    native.runner.session_store.reset_session.side_effect = original
+    seen = []
+    revoked = []
