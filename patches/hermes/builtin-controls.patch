+        if busy: await native.runner._busy_new_command(event,builtin.key,event.source)
+        else: await native.runner._handle_reset_command(event)
+    assert observed.value is original, 'preserve original native exception'
+    if busy: agent.interrupt.assert_called_once()
+    assert builtin.key not in native.runner._running_agents
+    print('RESET ERROR:', busy, 'native error preserved; callbacks=',len(builtin.observed))
+    assert len(builtin.observed)==1, 'native reset storage error skips the only external stop callback'
+
