@@ -0,0 +1,424 @@
+"""Native /stop and /new fire sites with real offline PTB provenance and guards."""
+import asyncio
+import threading
+from datetime import datetime
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from tests.gateway.test_plugin_control_commands import (
+    control as control_fixture, native as native_fixture, offline_boundary as boundary_fixture,
+)
+
+control = control_fixture
+native = native_fixture
+offline_boundary = boundary_fixture
+from tests.gateway.test_admitted_ingress import _bot
+from gateway.config import Platform
+from gateway.platforms.base import EphemeralReply
+from gateway.run import _AGENT_PENDING_SENTINEL
+from gateway.session import SessionEntry
+from hermes_cli.config import atomic_config_write
+
+
+@pytest.fixture
+def builtin(native, control):
+    runner = native.runner
+    _, event = native.make(text="/stop")
+    key = runner._session_key_for_source(event.source)
+    entry = SessionEntry(session_key=key, session_id="old-session", created_at=datetime.now(),
+                         updated_at=datetime.now(), platform=Platform.TELEGRAM, chat_type="group")
+    fresh = SessionEntry(session_key=key, session_id="new-session", created_at=datetime.now(),
+                         updated_at=datetime.now(), platform=Platform.TELEGRAM, chat_type="group")
+    runner.session_store.get_or_create_session.return_value = entry
+    runner.session_store.reset_session.return_value = fresh
+    runner.session_store._entries = {key: entry}
+    runner._session_db = None
+    runner.hooks = SimpleNamespace(emit=AsyncMock(), loaded_hooks=False)
+    runner._reset_notice_session_info = lambda source: ""
+    runner._telegram_topic_new_header = lambda source: None
+    runner._is_telegram_topic_lane = lambda source: False
+    runner._is_telegram_topic_root_lobby = lambda source: False
+    runner._read_user_config = lambda: {"approvals": {"destructive_slash_confirm": False}}
+    context, manager, seen, _ = control
+    observed = []
+
+    def register(handler=None):
+        def callback(args):
+            proof = context.get_command_context()
+            assert key not in runner._running_agents
+            observed.append((args, proof))
+            return "External task stopped; quiescence verified."
+        return context.register_command("task-control", handler or callback, gateway_control=True,
+                                        native_controls=("stop", "new"))
+
+    register()
+    return SimpleNamespace(key=key, context=context, manager=manager, observed=observed, register=register)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("command", ["stop", "new", "reset"])
+@pytest.mark.parametrize("state", ["idle", "pending", "busy"])
+async def test_native_routes_action_then_callback_once(native, builtin, command, state):
+    from hermes_cli.commands import resolve_command
+    # Exercise every actual reset alias, without inventing another dispatcher.
+    definition = resolve_command(command)
+    assert definition is not None
+    _, event = native.make(text=f"/{command}")
+    agent = MagicMock()
+    if state != "idle":
+        native.runner._session_state(builtin.key).turn.agent = (
+            _AGENT_PENDING_SENTINEL if state == "pending" else agent)
+        native.adapter._pending_messages[builtin.key] = native.make(text="stale human input")[1]
+    result = await native.runner._handle_message(event)
+    if command != "stop" or state != "idle":
+        assert isinstance(result, EphemeralReply)
+    assert "External task stopped; quiescence verified." in result
+    assert len(builtin.observed) == 1
+    args, receipt = builtin.observed[0]
+    assert args == ""
+    expected = "stop" if command == "stop" else "new"
+    assert receipt["command"] == receipt["native_operation"] == expected
+    assert receipt["control_command"] == "task-control"
+    assert receipt["admitted_ingress"]["message"]["platform_update_id"] == "701"
+    assert receipt["source"]["thread_id"] == "17"
+    if state == "busy":
+        agent.interrupt.assert_called_once()
+    if command != "stop":
+        native.runner.session_store.reset_session.assert_called_once_with(builtin.key)
+    native.runner._handle_message_with_agent.assert_not_awaited()
+    assert builtin.context.get_command_context() is None
+
+
+@pytest.mark.asyncio
+async def test_confirm_preserves_original_proof_and_only_fires_after_yes(native, builtin):
+    callbacks = []
+    async def request(**kwargs):
+        callbacks.append(kwargs["handler"])
+        return "confirmation pending"
+    native.runner._read_user_config = lambda: {"approvals": {"destructive_slash_confirm": True}}
+    native.runner._request_slash_confirm = request
+    _, event = native.make(text="/reset")
+    assert await native.runner._handle_message(event) == "confirmation pending"
+    assert builtin.observed == []
+    native.runner.session_store.reset_session.assert_not_called()
+    assert "cancel" in str(await callbacks[0]("cancel")).lower()
+    assert builtin.observed == []
+    # Simulate later receipt/source mutation: the original proof/route is already bound.
+    event.source.thread_id = "88"
+    event.platform_update_id = 999
+    result = await callbacks[0]("once")
+    assert "External task stopped" in result
+    assert len(builtin.observed) == 1
+    receipt = builtin.observed[0][1]
+    assert receipt["source"]["thread_id"] == "17"
+    assert receipt["admitted_ingress"]["message"]["platform_update_id"] == "701"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("fault", ["bot", "user", "chat", "topic", "profile", "revoked", "unload"])
+@pytest.mark.parametrize("busy", [False, True])
+async def test_native_provenance_and_consent_fail_closed(native, builtin, fault, busy):
+    _, event = native.make(text="/stop")
+    actions = {
+        "bot": lambda: event.raw_message.set_bot(_bot(987654)),
+        "user": lambda: setattr(event.source, "user_id", "999"),
+        "chat": lambda: setattr(event.source, "chat_id", "-100999"),
+        "topic": lambda: setattr(event.source, "thread_id", "99"),
+        "profile": lambda: setattr(event.source, "profile", "foreign"),
+        "revoked": lambda: atomic_config_write(builtin.manager.home_path / "config.yaml", {
+            "plugins": {"entries": {"control-fixture": {"allow_gateway_control": False}}}}),
+        "unload": builtin.manager.unload,
+    }
+    actions[fault]()
+    if busy:
+        native.runner._session_state(builtin.key).turn.agent = MagicMock()
+    await native.runner._handle_message(event)
+    assert builtin.observed == []
+    native.runner._handle_message_with_agent.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("kind", ["sync", "async", "sync_returns_async", "error", "cancel", "noop"])
+async def test_callback_results_do_not_replace_native_action(native, builtin, kind):
+    calls = []
+    def body(args):
+        calls.append(builtin.context.get_command_context())
+        assert builtin.key not in native.runner._running_agents
+        if kind == "error":
+            raise ValueError("secret-not-for-output")
+        if kind == "cancel":
+            raise asyncio.CancelledError()
+        return None if kind == "noop" else "external stopped"
+    async def async_body(args):
+        return body(args)
+    handler = {"async": async_body, "cancel": async_body,
+               "sync_returns_async": lambda args: async_body(args)}.get(kind, body)
+    builtin.register(handler)
+    agent = MagicMock()
+    native.runner._session_state(builtin.key).turn.agent = agent
+    _, event = native.make(text="/stop")
+    result = await native.runner._handle_message(event)
+    agent.interrupt.assert_called_once()
+    assert len(calls) == 1
+    assert "stopped" in str(result).lower()
+    assert ("UNKNOWN" in result) == (kind in ("error", "cancel"))
+    assert "secret-not-for-output" not in result
+    assert builtin.context.get_command_context() is None
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("kind", ["sync", "async"])
+async def test_slow_callback_deadline_revokes_lease_after_native_stop(native, builtin, kind, monkeypatch):
+    from gateway import run_native_controls
+    monkeypatch.setattr(run_native_controls, "_NATIVE_CONTROL_TIMEOUT", 0.05)
+    release = threading.Event()
+    entered = threading.Event()
