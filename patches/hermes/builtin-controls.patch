+"""Post-action bindings of existing plugin controls to native escape hatches."""
+from __future__ import annotations
+
+import asyncio
+from contextlib import contextmanager
+from contextvars import ContextVar
+from copy import deepcopy
+from dataclasses import dataclass
+from functools import wraps
+import logging
+
+from gateway.run_plugin_commands import _control_managers, _control_scope, _entry_for_source, _invoke, _receipt
+from gateway.session_identity import replace_source
+
+logger = logging.getLogger(__name__)
+_NATIVE_CONTROL_TIMEOUT = 2.0
+_UNKNOWN = "External plugin work: UNKNOWN (control unavailable, failed or timed out)."
+_binding = ContextVar("native_control_binding", default=None)
+
+
+@dataclass(frozen=True)
+class _Binding:
+    operation: str
+    source: object
+    targets: tuple
+
+
+def capture_native_control(runner, event, operation):
+    """Bind native provenance before an action/confirmation, without calling plugins."""
+    if operation not in ("stop", "new"):
+        return None
+    targets = []
+    source = event.source
+    try:
+        scope = _control_scope(source)
+        for manager in _control_managers():
+            if manager.scope_key != scope:
+                continue
+            if any(operation in owner[2] for owner in tuple(manager._retired_native_controls.values())):
+                targets.append((None, None, None, None))
+            for name, entry in tuple(manager._plugin_commands.items()):
+                if operation not in entry.get("native_controls", ()):
+                    continue
+                if _entry_for_source(name, source) != (manager, entry):
+                    continue
+                receipt = None
+                if (runner._is_user_authorized_for_source(source)
+                        and runner._check_slash_access(source, operation) is None):
+                    receipt = _receipt(runner, event, source, operation)
+                if receipt is not None:
+                    receipt = deepcopy(receipt)
+                    receipt.update(native_operation=operation, control_command=name)
+                targets.append((manager, name, entry, receipt))
+        return _Binding(operation, replace_source(source) if targets else source, tuple(targets))
+    except Exception:  # health: allow BLE001 -- Optional preparation must never suppress a native escape hatch.
+        logger.warning("Native plugin control provenance unavailable")
+        return _Binding(operation, source, ((None, None, None, None),))
+
+
+@contextmanager
+def native_control_scope(event, binding, *, running=False):
+    token = _binding.set((event, binding, running))
+    try:
+        yield
+    finally:
+        _binding.reset(token)
+
+
+def _consume_completion(task):
+    if not task.cancelled():
+        task.exception()  # A timed-out coroutine may finish later; never leak its exception text.
+
+
+async def _notify(runner, event, binding, target):
+    manager, name, entry, receipt = target
+    if receipt is None:
+        return _UNKNOWN
+    active = True
+    task = asyncio.create_task(_invoke(
+        runner, event, binding.source, name, manager, entry, receipt,
+        args="", valid=lambda: active,
+    ))
+    try:
+        done, _ = await asyncio.wait((task,), timeout=_NATIVE_CONTROL_TIMEOUT)
+        if not done or task.cancelled():
+            return _UNKNOWN
+        result = task.result()
+        from gateway.run_plugin_commands import _REFUSED
+        return _UNKNOWN if result == _REFUSED else result
+    except Exception:  # health: allow BLE001 -- Native response survives callback failure without exposing plugin secrets.
+        logger.warning("Native plugin control callback failed")
+        return _UNKNOWN
+    finally:
+        # Executor threads cannot be killed. Revoke their context immediately;
+        # UNKNOWN explicitly does not claim that external work has quiesced.
+        active = False
+        if not task.done():
+            task.cancel()
+            task.add_done_callback(_consume_completion)
+
+
+async def _append_results(runner, event, binding, result):
+    if binding is None or not binding.targets:
+        return result
+    notices = await asyncio.gather(*(_notify(runner, event, binding, target)
+                                    for target in binding.targets))
+    notices = [notice for notice in notices if notice]
+    if not notices:
+        return result
+    text = "\n\n".join([str(result or ""), *notices]).lstrip()
+    from gateway.platforms.base import EphemeralReply
+    if isinstance(result, EphemeralReply):
+        return EphemeralReply(text, ttl_seconds=result.ttl_seconds)
+    return text
+
+
+def native_control(operation):
+    """Wrap real fire sites; a nested busy-new → reset emits exactly once."""
+    def decorate(handler):
+        @wraps(handler)
+        async def execute(runner, event, *args, **kwargs):
+            current = _binding.get()
+            if (current is not None and current[0] is event and current[1] is not None
+                    and current[1].operation == operation):
+                if current[2]:
+                    return await handler(runner, event, *args, **kwargs)
+                binding = current[1]
+            else:
+                binding = capture_native_control(runner, event, operation)
+            try:
+                with native_control_scope(event, binding, running=True):
+                    result = await handler(runner, event, *args, **kwargs)
+            except (Exception, asyncio.CancelledError):
+                # Storage failure or native cancellation must not skip the
+                # independent escape hatch, or lose the original native error.
+                try:
+                    await _append_results(runner, event, binding, None)
+                except (Exception, asyncio.CancelledError):  # health: allow BLE001 -- Preserve the original native error without leaking plugin exception secrets.
+                    logger.warning("Native plugin control notification interrupted after native failure")
+                raise
+            return await _append_results(runner, event, binding, result)
+        return execute
+    return decorate
