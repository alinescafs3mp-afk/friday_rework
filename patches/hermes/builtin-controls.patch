+@pytest.mark.parametrize('busy', [False, True])
+async def test_fresh_native_event_reports_unknown_after_retirement(native, builtin, retirement, command, busy):
+    registration = next(r for r in reversed(builtin.manager._registration_order)
+                        if r.kind == "command" and r.key == "task-control")
+    if retirement == 'dispose': registration.dispose()
+    else: builtin.manager.unload()
+    _, event = native.make(text='/' + command)  # A fresh event, first seen after retirement.
+    agent = MagicMock()
+    if busy: native.runner._session_state(builtin.key).turn.agent = agent
+    response = await native.runner._handle_message(event)
+    if busy: agent.interrupt.assert_called_once()
+    assert builtin.observed == []
+    native.runner._handle_message_with_agent.assert_not_awaited()
+    print('RETIRED:', retirement, command, busy, repr(str(response)))
+    assert 'UNKNOWN' in response, 'retired external binding silently becomes bare native success/no-active'
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('busy', [False, True])
+async def test_native_reset_storage_failure_still_notifies_original_binding(native, builtin, busy):
