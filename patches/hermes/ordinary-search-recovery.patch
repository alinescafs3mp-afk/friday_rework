+def _bounded_search_response(response: dict, original: str) -> Optional[str]:
+    """Keep small/native responses exact; bound oversized search JSON with recovery.
+
+    The saved original includes every result, rank, citation and provider/error
+    field. No result-count reduction or provider retry happens here. As with
+    extraction, a failed write or the existing storage ceiling is explicit.
+    """
+    import json
+    import uuid
+    from agent.bounded_context import bounded_tool_result_budget, serialized_bytes
+    budget = bounded_tool_result_budget()
+    if budget is None or serialized_bytes(original) <= budget:
+        return None
+    # Unique storage identity also prevents the unmanaged cache fallback from
+    # replacing evidence from an earlier search. Admitted users use private I/O.
+    path = _store_full_text("https://web-search.invalid/" + uuid.uuid4().hex, original)
+    from hermes_cli.friday_user_scope import ordinary_file_scope
+    scoped = ordinary_file_scope() is not None
+    incomplete = (len(original.encode("utf-8")) > MAX_SCOPED_STORED_BYTES if scoped
+                  else len(original) > MAX_STORED_TEXT_CHARS)
+    data = response.get("data")
+    web = data.get("web", []) if isinstance(data, dict) else []
+    count = len(web) if isinstance(web, list) else 0
+    envelope = {"success": response.get("success", False), "data": {"web": []},
+                "result_count": count, "inline_result_count": 0, "partial": True,
+                "stored_copy": ("partial" if incomplete else "complete") if path else "unavailable",
+                "read_file": {"path": path, "offset": 1, "char_offset": 0, "limit": 200} if path else None,
+                "note": ("Search returned all result_count results. Read saved original JSON for every ranked "
+                         "result, citation and provider/error field; follow read_file next_offset/next_char_offset. "
+                         + ("Stored copy is incomplete at the existing storage limit." if incomplete and path
+                            else "Original could not be saved; retry a narrower search." if not path
+                            else "Saved original is complete."))}
+    # Preserve bounded scalar error/policy/provider metadata when it fits. The
+    # exact original remains the authority for fields too large to send inline.
+    encode = lambda value: json.dumps(value, ensure_ascii=False, separators=(",", ":"))
+    for key, value in response.items():
+        if key not in envelope and key != "data":
+            candidate = {**envelope, key: value}
+            if serialized_bytes(encode(candidate)) <= budget:
+                envelope = candidate
+    # Keep an ordered shortlist when it fits; count and partial describe the
+    # preview separately from the unchanged provider result count. Only the
+    # stored original carries complete snippets and arbitrary provider fields.
+    for row in web if isinstance(web, list) else []:
+        if not isinstance(row, dict):
+            break
+        preview = {key: row[key] for key in ("title", "url", "position", "rank") if key in row}
+        for key in ("description", "snippet"):
+            if isinstance(row.get(key), str):
+                preview[key] = row[key][:96]
+        rows = envelope["data"]["web"] + [preview]
+        candidate = {**envelope, "data": {"web": rows}, "inline_result_count": len(rows)}
+        if serialized_bytes(encode(candidate)) > budget:
+            break
+        envelope = candidate
+    value = encode(envelope)
+    if serialized_bytes(value) > budget:
+        # Extremely long workspace paths cannot escape the aggregate ceiling.
+        value = encode({"success": False, "data": {"web": []}, "result_count": count,
+                        "partial": True, "stored_copy": "unavailable",
+                        "error": "capacity: recovery envelope exceeds inline budget"})
+    return value
 
 
