+def _validate_search_query(query: str) -> Optional[str]:
+    """Apply the existing credential boundary before search logs/cache/providers.
+
+    This identifies recognizable keys and credential-bearing URLs, not private
+    meaning in ordinary prose. Queries still require an appropriate user intent.
+    """
+    from agent.redact import _PREFIX_RE
+    from urllib.parse import unquote
+
+    if not isinstance(query, str):
+        return _extract_error_json('Search query must be a string')
+    decoded = unquote(query)
+    if _PREFIX_RE.search(query) or _PREFIX_RE.search(decoded):
+        return _extract_error_json('Blocked: Search query contains what appears to be an API key or token.')
+    # Keep literal URL syntax intact: decoding its query could turn ordinary
+    # facet data into a new token parameter. Decode only an encoded URL scheme,
+    # after splitting literal prose delimiters, retaining encoded value spaces.
+    urls = []
+    for token in re.findall(r'[^\s<>"\']+', query):
+        match = re.search(r'https?://', token, flags=re.IGNORECASE)
+        candidate = token if match else unquote(token)
+        match = match or re.search(r'https?://', candidate, flags=re.IGNORECASE)
+        if match:
+            urls.append(candidate[match.start():])
+    if urls:
+        _, _, _, blocked = _validate_extract_urls(urls)
+        if blocked is not None:
+            return blocked
+    return None
 
 
