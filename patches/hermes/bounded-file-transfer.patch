@@ -0,0 +1,256 @@
+"""Bound native PTB downloads and record byte identity before cache consumers run."""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import logging
+import os
+import re
+import stat
+import threading
+from contextvars import ContextVar
+
+logger = logging.getLogger("plugins.platforms.telegram.adapter")
+_TRANSFER = ContextVar("telegram_file_transfer", default=None)
+
+
+def byte_limit(adapter):
+    from gateway.platforms.base import get_inbound_media_max_bytes
+    host = get_inbound_media_max_bytes()
+    adapter_limit = adapter._max_doc_bytes
+    if type(adapter_limit) is not int or adapter_limit <= 0 or host < 0:
+        raise ValueError("Invalid Telegram inbound byte limit")
+    return min(adapter_limit, host) if host else adapter_limit
+
+
+def declared_size(source, file_obj, limit):
+    sizes = [getattr(obj, "file_size", None) for obj in (source, file_obj)]
+    sizes = [value for value in sizes if type(value) is int and value > 0]
+    if any(value > limit for value in sizes):
+        raise ValueError("Telegram declared file size exceeds inbound limit")
+    if len(set(sizes)) > 1:
+        raise ValueError("Telegram file size declarations disagree")
+    return sizes[0] if sizes else None
+
+
+def checked_size(size, limit, declared=None, *, final=False):
+    if size > limit or (declared is not None and size > declared):
+        raise ValueError("Telegram file body exceeds inbound limit or declared size")
+    if final and declared is not None and size != declared:
+        raise ValueError("Telegram file body does not match declared size")
+
+
+async def read_response(response, limit, declared):
+    if response.headers.get("content-encoding", "identity").lower() not in ("", "identity"):
+        raise ValueError("Encoded Telegram file body is not supported")
+    header = response.headers.get("content-length")
+    expected = None
+    if header is not None:
+        try:
+            expected = int(header)
+        except ValueError:
+            raise ValueError("Invalid Telegram file Content-Length") from None
+        if expected < 0:
+            raise ValueError("Invalid Telegram file Content-Length")
+        checked_size(expected, limit, declared)
+    data = bytearray()
+    async for chunk in response.aiter_raw():
+        checked_size(len(data) + len(chunk), limit, declared)
+        data.extend(chunk)
+    checked_size(len(data), limit, declared, final=True)
+    if expected is not None and len(data) != expected:
+        raise ValueError("Telegram file body does not match Content-Length")
+    return bytes(data)
+
+
+def file_request_class(base_class, adapter):
+    """PTB's supported request slot; POST/polling retain the upstream implementation."""
+    from telegram.request import BaseRequest
+    from telegram._utils.defaultvalue import DefaultValue
+    from telegram.error import NetworkError, TimedOut
+    import httpx
+
+    class BoundedFileRequest(base_class):
+        async def do_request(self, url, method, request_data=None,
+                             read_timeout=BaseRequest.DEFAULT_NONE,
+                             write_timeout=BaseRequest.DEFAULT_NONE,
+                             connect_timeout=BaseRequest.DEFAULT_NONE,
+                             pool_timeout=BaseRequest.DEFAULT_NONE):
+            if method != "GET":
+                return await super().do_request(
+                    url, method, request_data, read_timeout, write_timeout, connect_timeout, pool_timeout)
+            limit, declared = _TRANSFER.get() or (byte_limit(adapter), None)
+            values = {"read": read_timeout, "write": write_timeout,
+                      "connect": connect_timeout, "pool": pool_timeout}
+            timeout = httpx.Timeout(**{key: getattr(self._client.timeout, key)
+                                      if isinstance(value, DefaultValue) else value
+                                      for key, value in values.items()})
+            try:
+                async with self._client.stream(
+                    method, url, headers={"User-Agent": self.USER_AGENT, "Accept-Encoding": "identity"},
+                    timeout=timeout,
+                ) as response:
+                    data = await read_response(response, limit, declared if response.is_success else None)
+                    return response.status_code, data
+            except httpx.TimeoutException:
+                raise TimedOut("Telegram file transfer timed out") from None
+            except httpx.HTTPError:
+                raise NetworkError("Telegram file transfer failed") from None
+
+    return BoundedFileRequest
+
+
+def _read_local(path, limit, declared, stopped):
+    """Bound disk reads in the worker; cancellation stops at the next chunk."""
+    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode):
+            raise ValueError("Telegram local file is not regular")
+        checked_size(info.st_size, limit, declared, final=True)
+        data = bytearray()
+        while not stopped.is_set():
+            chunk = os.read(fd, min(65536, limit - len(data) + 1))
+            if not chunk:
+                break
+            checked_size(len(data) + len(chunk), limit, declared)
+            data.extend(chunk)
+        checked_size(len(data), limit, declared, final=True)
+        return bytes(data)
+    finally:
+        os.close(fd)
+
+
+async def read_local(path, limit, declared):
+    """Read only the SDK-returned local file, never whole-file read_bytes()."""
+    stopped = threading.Event()
+    try:
+        return await asyncio.to_thread(_read_local, path, limit, declared, stopped)
+    finally:
+        stopped.set()
+
+
+async def download_file(adapter, file_obj, source):
+    limit = byte_limit(adapter)
+    declared = declared_size(source, file_obj, limit)
+    token = _TRANSFER.set((limit, declared))
+    try:
+        path = getattr(file_obj, "file_path", None)
+        if isinstance(path, str) and await asyncio.to_thread(os.path.isfile, path):
+            return await read_local(path, limit, declared)
+        data = await file_obj.download_as_bytearray()
+        checked_size(len(data), limit, declared, final=True)
+        return data
+    finally:
+        _TRANSFER.reset(token)
+
+
+def stamp_media(event, message, path, data=None, *, content=None):
+    from .telegram_ingress import _attachment, _id
+    if content is None and data is None:
+        return
+    if content is None:
+        content = {"size_bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}
+    file = _attachment(message)
+    try:
+        origin = {"bot_id": _id(message.get_bot().id), "chat_id": _id(message.chat.id, signed=True),
+                  "message_id": _id(message.message_id),
+                  "file_id": file.file_id, "file_unique_id": file.file_unique_id,
+                  "declared_bytes": file.file_size}
+    except (AttributeError, RuntimeError, TypeError, ValueError):
+        return  # synthetic/legacy events cannot acquire a native source receipt
+    event._telegram_media_receipts[path] = {"origin": origin, "content": dict(content)}
+
+
+async def cache_inbound_document(self, msg, event) -> bool:
+    """Cache a document attachment (image → photo path, video, else generic media + text injection).
+    Returns True when the event was already dispatched/routed so the caller must return."""
+    from .adapter import (
+        MessageType, SUPPORTED_DOCUMENT_TYPES, SUPPORTED_VIDEO_TYPES,
+        SUPPORTED_IMAGE_DOCUMENT_TYPES, _TELEGRAM_IMAGE_MIME_TO_EXT,
