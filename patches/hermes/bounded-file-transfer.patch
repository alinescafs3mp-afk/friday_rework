+def sdk(adapter, body, headers=None, *, request_kwargs=None):
+    calls = []
+    def transport(request):
+        calls.append(request)
+        if request.method == 'GET':
+            return httpx.Response(200, headers=headers, stream=body)
+        method = request.url.path.rsplit('/', 1)[-1]
+        result = {'id': 123, 'is_bot': True, 'first_name': 'Offline'}
+        if method == 'getFile':
+            result = {'file_id': 'f', 'file_unique_id': 'u', 'file_path': 'docs/test.py'}
+        elif method == 'getUpdates':
+            result = []
+        return httpx.Response(200, json={'ok': True, 'result': result})
+    request = boundary.file_request_class(HTTPXRequest, adapter)(
+        httpx_kwargs={'transport': httpx.MockTransport(transport)}, **(request_kwargs or {}))
+    bot = Bot('123:offline', request=request, get_updates_request=request,
+              base_url='https://offline.invalid/bot', base_file_url='https://files.invalid/file/bot')
+    adapter._bot = bot
+    return bot, request, calls
