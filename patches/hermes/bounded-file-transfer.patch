+def media_provenance(adapter, event, message, reply, bot_id, chat_id, thread_id):
+    """A source-bound cache receipt can disambiguate own and replied attachments."""
+    candidates = [(msg, _attachment(msg)) for msg in (message, reply)]
+    candidates = [(msg, file) for msg, file in candidates if file is not None]
+    media = []
+    for path, mime in zip(event.media_urls, event.media_types):
+        receipt = event._telegram_media_receipts.get(path)
+        matches = []
+        for original, file in candidates:
+            origin = {
+                "bot_id": bot_id, "chat_id": _id(original.chat.id, signed=True),
+                "thread_id": adapter._effective_message_thread_id(original) or "",
+                "message_id": _id(original.message_id), "file_id": file.file_id,
+                "file_unique_id": file.file_unique_id, "declared_bytes": file.file_size,
+            }
+            if origin["chat_id"] != chat_id or origin["thread_id"] != thread_id:
+                continue
+            if receipt is not None:
+                if receipt["origin"] == {k: v for k, v in origin.items() if k != "thread_id"}:
+                    matches.append(origin)
+            elif len(event.media_urls) == 1 and len(candidates) == 1:
+                matches.append(origin)
+        item = {"local_reference": path, "mime_type": mime,
+                "origin": matches[0] if len(matches) == 1 else None}
+        if receipt is not None and len(matches) == 1:
+            item["content"] = dict(receipt["content"])
+        media.append(item)
+    return media
