+    file = File('f', 'u', file_path='https://files.invalid/file/bot123:offline/x', file_size=declared)
+    file.set_bot(bot)
+    try:
+        with pytest.raises(Exception, match='(limit|declared|Content-Length)'):
+            await boundary.download_file(adapter, file, SimpleNamespace(file_size=declared))
+        assert body.closed
+        assert len(calls) == 1
+    finally:
+        await request.shutdown()
