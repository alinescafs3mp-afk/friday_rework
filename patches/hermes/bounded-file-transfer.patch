+@pytest.mark.asyncio
+async def test_local_cancellation_closes_worker_file(adapter, monkeypatch, tmp_path):
+    import os
+    import threading
+    path = tmp_path / 'cancel.py'; path.write_bytes(b'abc')
+    real_read, real_close = os.read, os.close
+    started, release, closed = threading.Event(), threading.Event(), threading.Event()
+    observed = []
+    def paused_read(fd, size):
+        observed.append(fd); started.set()
+        assert release.wait(5)
+        return real_read(fd, size)
+    def close(fd):
+        real_close(fd)
+        if fd in observed:
+            closed.set()
+    monkeypatch.setattr(boundary.os, 'read', paused_read)
+    monkeypatch.setattr(boundary.os, 'close', close)
+    file = File('f', 'u', file_path=str(path), file_size=3)
+    task = asyncio.create_task(boundary.download_file(adapter, file, file))
+    try:
+        assert await asyncio.to_thread(started.wait, 5)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+    finally:
+        release.set()
+    assert await asyncio.to_thread(closed.wait, 5)
+    assert boundary._TRANSFER.get() is None
