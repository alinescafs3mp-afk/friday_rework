+@pytest.mark.asyncio
+async def test_local_regular_file_replaced_with_fifo_cannot_block_open(adapter, monkeypatch, tmp_path):
+    import os
+    path = tmp_path / 'race.py'; path.write_bytes(b'abc')
+    original_open, original_close = os.open, os.close
+    descriptors, closed, flags_seen = [], [], []
+    def swap_then_open(name, flags, *args, **kwargs):
+        if str(name) == str(path):
+            path.unlink(); os.mkfifo(path); flags_seen.append(flags)
+        fd = original_open(name, flags, *args, **kwargs)
+        descriptors.append(fd)
+        return fd
+    def close(fd):
+        original_close(fd); closed.append(fd)
+    monkeypatch.setattr(boundary.os, 'open', swap_then_open)
+    monkeypatch.setattr(boundary.os, 'close', close)
+    file = File('f', 'u', file_path=str(path), file_size=3)
+    with pytest.raises(ValueError, match='not regular'):
+        await asyncio.wait_for(boundary.download_file(adapter, file, file), 2)
+    assert flags_seen and flags_seen[0] & os.O_NONBLOCK
+    assert descriptors and all(fd in closed for fd in descriptors)
+
