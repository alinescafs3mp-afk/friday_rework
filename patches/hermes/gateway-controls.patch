diff --git a/gateway/run_plugin_commands.py b/gateway/run_plugin_commands.py
new file mode 100644
--- /dev/null
+++ b/gateway/run_plugin_commands.py
@@ -0,0 +1,185 @@
+"""Opt-in plugin controls on the existing authorized inline command path."""
+from __future__ import annotations
+
+import asyncio
+import logging
+import inspect
+
+from gateway.session_identity import identity_of
+
+logger = logging.getLogger(__name__)
+_REFUSED = "Plugin control unavailable."
+
+
+def _control_managers():
+    # Read existing registrations only: intake must never load plugins or select an
+    # ambient profile.
+    from hermes_cli import plugins
+    with plugins._plugin_managers_lock:
+        managers = list(plugins._plugin_managers_by_home.values())
+        if plugins._plugin_manager is not None and plugins._plugin_manager not in managers:
+            managers.append(plugins._plugin_manager)
+    return managers
+
+
+def _control_entries(name):
+    return [(manager, entry) for manager in _control_managers()
+            if (entry := manager._plugin_commands.get(name)) and entry.get("gateway_control") is True]
+
+
+def is_control_candidate(event):
+    name = (event.get_command() or "").replace("_", "-")
+    if not name:
+        return False
+    from hermes_cli.commands import resolve_command
+    if resolve_command(name) is not None:
+        return False  # Native owner controls always keep their existing meaning.
+    # The per-profile manager retains names after disposal/unload. A fresh
+    # message for a retired control must refuse, never steer/interrupt an agent.
+    from hermes_constants import hermes_home_key
+    identity = identity_of(event.source)
+    managers = _control_managers()
+    if identity is not None:
+        scope = hermes_home_key(identity.runtime_home)
+        managers = [manager for manager in managers if manager.scope_key == scope]
+    # Missing native identity cannot authorize execution; recognize known names
+    # conservatively so malformed controls cannot become ordinary agent input.
+    known = any(name in manager._gateway_control_names for manager in managers)
+    # Never let an active control fall through to the ordinary dispatcher under
+    # an unresolved/foreign home. A genuine ordinary entry in the canonical home
+    # retains its own meaning even if another profile uses the same name.
+    local_ordinary = any((entry := manager._plugin_commands.get(name))
+                         and entry.get("gateway_control") is not True for manager in managers)
+    known = known or (not local_ordinary and bool(_control_entries(name)))
+    if getattr(event, "_plugin_control_command", None) == name or known:
+        event._plugin_control_command = name
+        return True
+    return False
+
+
+def should_dispatch_inline(event):
+    from hermes_cli.commands import should_bypass_active_session
+    return should_bypass_active_session(event.get_command()) or is_control_candidate(event)
+
+
+def _entry_for_source(name, source):
+    from hermes_constants import hermes_home_key
+    identity = identity_of(source)
+    if identity is None or identity.transport_inferred or identity.adapter() is None:
+        return None
+    if (source.profile or identity.runtime_profile) != identity.runtime_profile:
+        return None
+    scope = hermes_home_key(identity.runtime_home)
+    return next(((manager, entry) for manager, entry in _control_entries(name)
+                 if manager.scope_key == scope), None)
+
+
+def _allowed(manager, entry, name):
+    from hermes_cli.plugins import _plugin_home_scope, _plugin_settings_entry, load_config_readonly
+    context = entry["control_context"]
+    if (manager._plugin_commands.get(name) is not entry or context._load_abandoned
+            or getattr(manager, "_gateway_unloading", False)):
+        return False
+    with _plugin_home_scope(manager.home_path):
+        config = load_config_readonly() or {}
+    return (_plugin_settings_entry(config, context.plugin_id) or {}).get("allow_gateway_control") is True
+
+
+def _complete_message_proof(proof, source, event):
+    message = proof.get("message") if isinstance(proof, dict) else None
+    if not isinstance(message, dict):
+        return False
+    if any(not isinstance(message.get(key), str) or not message[key]
+           for key in ("bot_id", "user_id", "chat_id", "message_id", "platform_update_id")):
+        return False
+    return (message["user_id"] == source.user_id and message["chat_id"] == source.chat_id
+            and message.get("thread_id") == (source.thread_id or "")
+            and message["message_id"] == event.message_id)
+
+
+def _receipt(runner, event, source, name):
+    from gateway.admitted_ingress import admitted_ingress
+    identity = identity_of(source)
+    if (event.internal or not event.allow_gateway_control or event.source is not source
+            or runner._intake_adapter_for(source) is not identity.adapter()):
+        return None
+    key = runner._session_key_for_source(source)
+    proof = admitted_ingress(event, source, key)
+    if not _complete_message_proof(proof, source, event):
+        return None
+    return {"command": name, "session_key": key, "admitted_ingress": proof,
+            "source": {"platform": source.platform.value, "user_id": source.user_id,
+                       "chat_id": source.chat_id, "chat_type": source.chat_type,
+                       "thread_id": source.thread_id or "", "profile": identity.runtime_profile}}
+
+
+def _still_allowed(runner, manager, entry, name):
+    try:
+        return (getattr(runner, "_running", None) is not False
+                and not getattr(runner, "_executor_closing", False)
+                and not getattr(runner, "_draining", False) and _allowed(manager, entry, name))
+    except Exception:  # health: allow BLE001 -- Revoked/unreadable consent invalidates retained invocation context.
+        return False
+
+
+def _call_sync(runner, manager, entry, name, args):
+    # Unload/revocation may race the executor thread starting after admission.
+    if not _still_allowed(runner, manager, entry, name):
+        return _REFUSED
+    return entry["handler"](args)
+
+
+async def _invoke(runner, event, source, name, manager, entry, receipt):
+    from gateway.run import _async_profile_runtime_scope
+    from gateway.session import build_session_context
+    from hermes_cli.plugin_command_context import _command_context
+    async with _async_profile_runtime_scope(manager.home_path):
+        if not _still_allowed(runner, manager, entry, name):
+            return _REFUSED
+        context = build_session_context(source, runner.config)
+        context.session_key = receipt["session_key"]
+        with runner._session_env_scope(context), _command_context(
+            entry["control_context"], receipt,
+            valid=lambda: _still_allowed(runner, manager, entry, name),
+        ):
+            handler = entry["handler"]
+            args = event.get_command_args().strip()
+            if inspect.iscoroutinefunction(handler):
+                result = await handler(args)
+            else:
+                result = await runner._run_in_executor_with_context(_call_sync, runner, manager, entry, name, args)
+                if asyncio.iscoroutine(result):
+                    if not _still_allowed(runner, manager, entry, name):
+                        result.close()
+                        return _REFUSED
+                    result = await result
+        return str(result) if result else None
+
+
+async def dispatch_control(runner, event, source):
+    """Called after native user/bot admission, before either busy or idle dispatch.
+
+    Recognized controls are consumed on every refusal/failure; they cannot turn
+    into a model prompt or interrupt a native turn. Ordinary plugin commands keep
+    their existing idle behavior.
+    """
+    if not is_control_candidate(event):
+        return False, None
+    name = event._plugin_control_command
+    try:
+        found = _entry_for_source(name, source)
+        if found is None:
+            return True, _REFUSED
+        denied = runner._check_slash_access(source, name)
+        if denied is not None:
+            return True, denied
+        receipt = _receipt(runner, event, source, name)
+        if receipt is None:
+            return True, _REFUSED
+        manager, entry = found
+        return True, await _invoke(runner, event, source, name, manager, entry, receipt)
+    except asyncio.CancelledError:
+        raise
+    except Exception:  # health: allow BLE001 -- Fail closed without logging handler/SDK exception secrets.
+        logger.warning("Plugin control dispatch failed")
+        return True, _REFUSED
