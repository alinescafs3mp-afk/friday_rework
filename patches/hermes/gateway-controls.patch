@@ -0,0 +1,483 @@
+"""Offline controls through the installed PTB SDK and real native gateway guards.
+
+Synthetic Updates and a locally seeded Bot are fixtures, never live Telegram proof.
+"""
+import asyncio
+import threading
+from dataclasses import replace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from tests.gateway.test_admitted_ingress import (
+    _bot, native as native_fixture, offline_boundary as boundary_fixture,
+)
+
+native = native_fixture
+offline_boundary = boundary_fixture
+from gateway.platforms.base import SendResult
+from gateway.session_identity import identity_of
+from hermes_cli.plugin_command_context import get_command_context, _command_context
+from hermes_cli.plugins import PluginContext, PluginManifest, get_plugin_manager
+from hermes_cli.config import atomic_config_write
+
+
+@pytest.fixture
+def control(native):
+    manager = get_plugin_manager()
+    manager._discovered = True
+    context = PluginContext(PluginManifest(name="control-fixture", source="user"), manager)
+    config = {"plugins": {"entries": {"control-fixture": {"allow_gateway_control": True}}}}
+    atomic_config_write(manager.home_path / "config.yaml", config)
+    seen = []
+
+    def handler(args):
+        seen.append((args, context.get_command_context()))
+        return "controlled"
+
+    registration = context.register_command("task-control", handler, gateway_control=True)
+    native.adapter._message_handler = native.runner._handle_message
+    native.adapter.send = AsyncMock(return_value=SendResult(success=True, message_id="900"))
+    yield context, manager, seen, registration
+    native.runner._shutdown_executor(drain_timeout=2)
+    manager.unload()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("busy", [False, True])
+@pytest.mark.parametrize("verb", ["status", "stop", "pause"])
+async def test_actual_guard_idle_busy_parity(native, control, busy, verb):
+    context, manager, seen, _ = control
+    _, event = native.make(text=f"/task_control {verb} id-7")
+    key = native.runner._session_key_for_source(event.source)
+    guard = asyncio.Event()
+    if busy:
+        native.adapter._active_sessions[key] = guard
+        native.adapter._session_tasks[key] = asyncio.current_task()
+        native.runner._session_state(key).turn.agent = object()
+        await native.adapter.handle_message(event)
+        assert native.adapter._active_sessions[key] is guard
+        assert not guard.is_set()
+        assert key not in native.adapter._pending_messages
+    else:
+        assert await native.runner._handle_message(event) == "controlled"
+    assert len(seen) == 1
+    args, proof = seen[0]
+    assert args == f"{verb} id-7"
+    assert proof["source"] == {"platform": "telegram", "user_id": "111", "chat_id": "-100123",
+                               "chat_type": "group", "thread_id": "17", "profile": "default"}
+    assert proof["admitted_ingress"]["message"]["bot_id"] == "123456"
+    assert proof["admitted_ingress"]["message"]["platform_update_id"] == "701"
+    assert proof["session_key"] == key
+    assert context.get_command_context() is None
+    assert get_command_context() is None
+    native.runner._handle_message_with_agent.assert_not_awaited()
+    assert not native.runner.session_store.get_or_create.called
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("busy", [False, True])
+@pytest.mark.parametrize("guard", ["emergency_pause", "draining"])
+async def test_controls_keep_native_pause_and_drain_policy(native, control, busy, guard):
+    from agent import estop
+
+    context, manager, seen, registration = control
+    _, event = native.make(text="/task-control stop id-7")
+    key = native.runner._session_key_for_source(event.source)
+    if busy:
+        native.runner._session_state(key).turn.agent = object()
+    if guard == "emergency_pause":
+        estop.engage("offline control boundary")
+    else:
+        native.runner._draining = True
+    try:
+        response = await native.runner._handle_message(event)
+        # Native emergency pause permits controls of an already running turn.
+        allowed = guard == "emergency_pause" and busy
+        assert len(seen) == int(allowed)
+        assert (response == "controlled") is allowed
+        assert context.get_command_context() is None
+        native.runner._handle_message_with_agent.assert_not_awaited()
+    finally:
+        if guard == "emergency_pause":
+            estop.disengage()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("failure", ["bot", "inferred", "identity", "profile", "topic", "chat_type",
+                                     "update", "revoked", "shutdown", "unload", "slash", "user"])
+@pytest.mark.parametrize("busy", [False, True])
+async def test_controls_refuse_without_model_or_interrupt(native, control, failure, busy):
+    context, manager, seen, registration = control
+    _, event = native.make(text="/task-control stop id-7")
+    from gateway.run_plugin_commands import is_control_candidate
+    assert is_control_candidate(event)
+    def forget_identity():
+        del event.source._identity
+        del event.source._transport_adapter_ref
+        event.raw_message = None
+    def revoke():
+        atomic_config_write(manager.home_path / "config.yaml", {"plugins": {"entries": {
+            "control-fixture": {"allow_gateway_control": False}}}})
+    mutations = {
+        "bot": lambda: event.raw_message.set_bot(_bot(987654)),
+        "inferred": lambda: setattr(event.source, "_identity", replace(identity_of(event.source), transport_inferred=True)),
+        "identity": forget_identity,
+        "profile": lambda: setattr(event.source, "profile", "foreign"),
+        "topic": lambda: setattr(event.source, "thread_id", "99"),
+        "chat_type": lambda: setattr(event.source, "chat_type", "dm"),
+        "update": lambda: setattr(event, "platform_update_id", 702),
+        "revoked": revoke,
+        "shutdown": lambda: setattr(native.runner, "_executor_closing", True),
+        "unload": registration.dispose,
+        "slash": lambda: native.adapter.config.extra.update(group_allow_admin_from=["222"]),
+        "user": lambda: setattr(event.source, "user_id", "999"),
+    }
+    mutations[failure]()
+    if busy:
+        key = native.runner._session_key_for_source(event.source)
+        guard = asyncio.Event()
+        native.adapter._active_sessions[key] = guard
+        native.adapter._session_tasks[key] = asyncio.current_task()
+        native.runner._session_state(key).turn.agent = object()
+        await native.adapter.handle_message(event)
+        assert native.adapter._active_sessions[key] is guard
+        assert not guard.is_set()
+        assert key not in native.adapter._pending_messages
+    else:
+        await native.runner._handle_message(event)
+    assert seen == []
+    assert get_command_context() is None
+    native.runner._handle_message_with_agent.assert_not_awaited()
