+++ b/hermes_cli/plugin_command_context.py
@@ -0,0 +1,39 @@
+"""Invocation-local authenticated provenance for native gateway plugin controls.
+
+The receipt proves message admission, never ownership of a plugin's task. Consumers
+must compare bot, user, chat, topic and profile to their own original task owner.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from copy import deepcopy
+
+_current = ContextVar("plugin_command_context", default=None)
+
+
+def get_command_context(context=None):
+    """Return a detached receipt during this invocation, otherwise None.
+
+    Child tasks inherit the lease, which is revoked when the handler exits.
+    No SDK handles, credentials, command arguments or conversation text are exposed.
+    """
+    lease = _current.get()
+    if lease is None or not lease["active"]:
+        return None
+    if context is not None and lease["owner"] is not context:
+        return None
+    if lease["valid"] is not None and not lease["valid"]():
+        return None
+    return deepcopy(lease["receipt"])
+
+
+@contextmanager
+def _command_context(context, receipt, *, valid=None):
+    lease = {"active": True, "owner": context, "receipt": receipt, "valid": valid}
+    token = _current.set(lease)
+    try:
+        yield
+    finally:
+        lease["active"] = False
+        _current.reset(token)
