+async def test_context_revokes_during_suspended_handler(native, control, revoke):
+    context, manager, seen, _ = control
+    entered, release = asyncio.Event(), asyncio.Event()
+    observed = []
+    async def handler(args):
+        observed.append(context.get_command_context())
+        entered.set()
+        try:
+            await release.wait()
+        except asyncio.CancelledError:
+            # A copied background reader loses proof once dispatch unwinds.
+            async def late_reader():
+                await release.wait()
+                observed.append(context.get_command_context())
+            seen.append(asyncio.create_task(late_reader()))
+            raise
+        observed.append(context.get_command_context())
+    context.register_command("task-control", handler, gateway_control=True)
+    _, event = native.make(text="/task-control stop")
+    work = asyncio.create_task(native.runner._handle_message(event))
+    await asyncio.wait_for(entered.wait(), 3)
+    actions = {
+        "unload": manager.unload,
+        "consent": lambda: atomic_config_write(manager.home_path / "config.yaml", {"plugins": {"entries": {
+            "control-fixture": {"allow_gateway_control": False}}}}),
+        "shutdown": lambda: setattr(native.runner, "_executor_closing", True),
+        "cancel": work.cancel,
+    }
+    actions[revoke]()
+    if revoke == "cancel":
+        with pytest.raises(asyncio.CancelledError):
+            await work
+        release.set()
+        await seen[0]
+    else:
+        release.set()
+        await work
+    assert observed[0] is not None
+    assert observed[1] is None
+    assert get_command_context() is None
