+"""Register native plugin commands while retaining retired control names."""
+from contextlib import suppress
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def register_command(context, name, handler, description, args_hint, argument_mode, gateway_control):
+    clean = name.lower().strip().lstrip("/").replace(" ", "-")
+    if not clean:
+        logger.warning("Plugin '%s' tried to register a command with an empty name.", context.manifest.name)
+        return
+    with suppress(Exception):  # reject if it conflicts with a built-in command
+        from hermes_cli.commands import resolve_command
+        if resolve_command(clean) is not None:
+            logger.warning("Plugin '%s' tried to register command '/%s' which conflicts "
+                           "with a built-in command. Skipping.", context.manifest.name, clean)
+            return
+    hint = (args_hint or "").strip()
+    entry = {
+        "handler": handler, "description": description or "Plugin command",
+        "gateway_control": gateway_control is True, "control_context": context if gateway_control is True else None,
+        "plugin": context.manifest.name, "plugin_key": context.plugin_id, "args_hint": hint,
+        "argument_mode": argument_mode if argument_mode in {"options", "text", "mixed"}
+        else ("text" if hint else None),
+    }
+    registration = context._register_entry("command", clean, context._manager._plugin_commands, entry,
+                                         "Plugin %s registered command: /%s", clean)
+    if registration is not None and gateway_control is True:
+        context._manager._gateway_control_names.add(clean)
+    return registration
