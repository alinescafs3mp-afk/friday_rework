+            for call in row["tool_calls"]:
+                call_id, name = tool_call_identity(call)
+                if not call_id or not name or call_id in calls:
+                    return True
+                calls[call_id] = name
+        elif row.get("role") == "tool":
+            call_id = row.get("tool_call_id")
