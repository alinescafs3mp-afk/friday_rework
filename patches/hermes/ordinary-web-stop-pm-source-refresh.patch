+    document = tomllib.loads((root / "pyproject.toml").read_text(encoding="utf-8-sig"))
+    settings = document.get("tool", {}).get("uv", {})
+    workspace = settings.get("workspace")
+    if workspace is not None:
+        members = workspace.get("members", []) if isinstance(workspace, dict) else []
+        if (set(workspace) != {"members"} or not members
+                or any(not isinstance(member, str) or not member.startswith("plugin-sources/")
+                       or ".." in Path(member).parts for member in members)):
+            raise ValueError("source refresh cannot normalize a non-generated workspace")
+        settings.pop("workspace")
+    _core_release_quarantine(document, root / "uv.lock")
+    return json.dumps(document, sort_keys=True, separators=(",", ":")).encode()
+
+
+def source_identity(project_root: Path | None = None) -> str:
+    """Measure regular core files selected by the native workspace copier.
+
+    Dependency resolution has its own stamp. The generated workspace member table and
+    formatting do not change core identity; all remaining build metadata and shipped
+    package files (including nested dist assets) do. No asserted receipt is trusted.
+    """
+    from pm.workspace import core_input_files
+
+    root = (paths.repo_root() if project_root is None else Path(project_root)).resolve()
+    for name in ("pyproject.toml", "uv.lock"):
+        metadata = root / name
+        if not metadata.is_file() or metadata.is_symlink():
+            raise ValueError(f"core source {name} must be a regular file")
+    h = hashlib.sha256(b"hermes-core-source-v1\0")
