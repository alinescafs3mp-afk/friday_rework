+    """Exact regular core files copied by the native workspace builder."""
+    directories, result, ignore = _core_input_layout(source)
+    for entry in directories:
+        for directory, dirs, names in os.walk(entry):
+            dirs[:] = sorted(set(dirs) - set(ignore(directory, dirs)))
+            for name in sorted(set(names) - set(ignore(directory, names))):
+                file = Path(directory) / name
+                if file.is_file():
+                    result[file.relative_to(source).as_posix()] = file
+    return result
+
+
+def _copy_core_inputs(source: Path, destination: Path) -> None:
+    """Build from a writable snapshot, never from signed/read-only source."""
+    directories, files, ignore = _core_input_layout(source, destination=destination)
+    for entry in directories:
+        # Preserve namespace directories and their metadata, including empty directories.
+        shutil.copytree(entry, destination / entry.name, ignore=ignore)
+    for name, entry in files.items():
         target = destination / name
         target.parent.mkdir(parents=True, exist_ok=True)
         shutil.copy2(entry, target)
