     async def _handle_help_command(self, event: MessageEvent) -> str:
         """Handle /help command - list available commands."""
+        from hermes_cli.friday_user_scope import ordinary_presentation
+        if ordinary_presentation(event.source):
+            prefix = self._typed_command_prefix_for(event.source.platform)
+            commands = (
+                ("help", "помощь"),
+                ("status", "состояние задачи и очереди"),
+                ("stop", "остановить текущую задачу"),
+                ("cancel", "остановить текущую задачу"),
+                ("new", "начать новый разговор"),
+                ("reset", "начать новый разговор"),
+                ("queue", "посмотреть очередь сообщений"),
+                ("memory", "посмотреть сохранённую память"),
+            )
+            lines = [f"{prefix}{name} — {description}" for name, description in commands
+                     if self._check_slash_access(event.source, name) is None]
+            return "Доступные команды:\n" + "\n".join(lines) + "\n\nЗадачу можно написать обычным сообщением."
         return self._telegramized_command_reply(
             event, _execute("help", options=self._catalog_options(event)).text)
 
