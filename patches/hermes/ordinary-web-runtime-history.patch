+    if error == 'web_timeout':
+        message = 'Не удалось завершить проверку в интернете за отведённое время.'
+    elif cleanup == 'unconfirmed':
+        message = 'Проверка в интернете не завершена; её остановка пока не подтверждена.'
+    elif detail == 'web_call_stopped':
+        message = 'Проверка в интернете остановлена.'
