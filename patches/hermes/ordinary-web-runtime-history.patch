+                row.get(k) for k in ('content', 'raw_content', 'text', 'read_file')))
+            for row in rows):
+        return False
+    if body.get('success') is False or body.get('error'):
+        return True
+    return (isinstance(rows, list) and bool(rows)
+            and all(isinstance(row, dict) and row.get('error') for row in rows))
 
 
