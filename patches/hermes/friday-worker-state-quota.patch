+"""Finite Friday-only state quota; files are isolated and synthetic."""
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from hermes_cli.plugins_state import PluginState
+
+
+class FridayWorkerStateQuotaTests(unittest.TestCase):
+    def test_exact_plugin_id_only(self):
+        self.assertEqual(PluginState('friday_rework').quota_bytes, 64 * 1024**2)
+        for name in ('other', 'Friday_rework', 'xfriday_rework', 'friday_rework_other'):
+            self.assertEqual(PluginState(name).quota_bytes, 10 * 1024**2)
+
+    def test_bounded_state_write_and_read_preserve_prior_rows(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            # Only the home resolver is replaced; native read/write/lock/quota
+            # code executes on local synthetic files, outside a real profile.
+            class IsolatedState(PluginState):
+                @property
+                def data_dir(self):
+                    return root
+            state = IsolatedState('friday_rework')
+            state.set('retained', {'observation': 'kept'})
+            state.set('worker_fixture', 'x' * (10 * 1024**2))
+            self.assertEqual(state.get('retained'), {'observation': 'kept'})
+            self.assertGreater(state.path.stat().st_size, 10 * 1024**2)
+            self.assertEqual(len(state.get('worker_fixture')), 10 * 1024**2)
+            previous = state.path.read_bytes()
+            with self.assertRaises(ValueError):
+                state.set('oversize', 'x' * (64 * 1024**2))
+            self.assertEqual(state.path.read_bytes(), previous)
+            with self.assertRaises(ValueError):
+                state.set('../foreign', {})
+            self.assertEqual(state.path.read_bytes(), previous)
+            other = IsolatedState('other')
+            with self.assertRaises(ValueError):
+                other.set('refused', True)
+            self.assertEqual(state.path.read_bytes(), previous)
+            self.assertEqual(json.loads(previous)['retained'], {'observation': 'kept'})
+
+
+if __name__ == '__main__':
+    unittest.main()
