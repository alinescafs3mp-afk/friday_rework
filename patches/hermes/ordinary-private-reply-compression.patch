+def _bounded_fingerprint(value: Any) -> dict:
+    """Private structural telemetry: hashes/lengths only, never payload text."""
+    encoded = (value.encode("utf-8") if isinstance(value, str) else
+               json.dumps(value, ensure_ascii=False, separators=(",", ":"),
+                          sort_keys=True, allow_nan=False).encode("utf-8"))
+    return {"present": value is not None, "utf8_bytes": len(encoded),
+            "sha256": hashlib.sha256(encoded).hexdigest()}
+
