+def _bounded_row_diagnostic(row: Any) -> dict:
+    if not isinstance(row, dict):
+        return {"mapping": False}
+    role = row.get("role")
+    return {"role": role if role in {"system", "developer", "user", "assistant", "tool"} else "invalid",
+            "row": _bounded_fingerprint(row), "content": _bounded_fingerprint(row.get("content")),
+            "api_content": _bounded_fingerprint(row.get("api_content")),
+            "tool_calls": _bounded_fingerprint(row.get("tool_calls")),
+            "tool_call_id": _bounded_fingerprint(row.get("tool_call_id"))}
