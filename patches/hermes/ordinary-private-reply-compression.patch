+def _emit_bounded_compaction_refusal(agent: Any, exc: Exception, *, rows_restored: bool) -> None:
+    """Project this typed precommit outcome only, after the caller's rollback.
+
+    The exception and traceback stay in the existing private logger. Audience
+    selection is presentation only and grants no capability or retry authority.
+    """
+    logger.warning("Compression refused before commit; rows_restored=%s: %s",
+                   rows_restored, exc, exc_info=True)
+    from hermes_cli.friday_user_scope import ordinary_presentation
+    if ordinary_presentation():
+        message = ("Не удалось безопасно сократить историю. Исходная переписка сохранена."
+                   if rows_restored else
+                   "Не удалось безопасно сократить историю. Сохранность исходной переписки "
+                   "не подтверждена. Проверьте её перед повтором.")
+    else:
+        message = f"Compression refused before commit: {exc}. Saved conversation rows are unchanged."
+    agent._emit_warning(message)
 
 
