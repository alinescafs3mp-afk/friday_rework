+def startup_identity(app):
+    """Prove the claimed administrative host before choosing startup services.
+
+    This owner serves authenticated product plugin APIs, not a stdio user
+    ingress. No CLI principal is created or inherited for its background work.
+    The configured port is pinned before uvicorn has published the bound port.
+    """
+    boot = getattr(app.state, 'friday_dashboard_owner', None)
+    if boot is None:
+        require(not enabled())
+        return None
+    from gateway import host_rendezvous as hr
+    require(hr.owns_host_lock(hr.ROLE_SERVE))
+    current = expected(registered=True, auth_required=app.state.auth_required,
+                       host=app.state.bound_host, port=boot['port'])
+    require(current == boot)
+    return boot
+
+
