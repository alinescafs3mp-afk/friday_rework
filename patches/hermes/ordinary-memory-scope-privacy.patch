diff --git a/tools/write_approval.py b/tools/write_approval.py
--- a/tools/write_approval.py
+++ b/tools/write_approval.py
@@ -43,8 +43,59 @@
 
 # --- Config resolution ---
 
+
+def scoped_memory_approval(*, enabled=None):
+    """Native per-user runtime preference; None is only a standalone donor.
+
+    Same state_meta/registry as onboarding flags, never the signed config.
+    Failed/invalid reads propagate so an unknown gate cannot become disabled.
+    """
+    from hermes_cli.friday_user_scope import MARKER, ScopeDenied, check_database, current, policy
+    from hermes_constants import get_default_hermes_root
+    cap = current()
+    if cap is None:
+        home = get_hermes_home()
+        if (home / MARKER).exists() or (home / MARKER).is_symlink() or policy(get_default_hermes_root(home=home)) is not None:
+            raise ScopeDenied()
+        return None
+    if enabled is not None and type(enabled) is not bool:
+        raise ValueError('memory_preference_boolean_required')
+    check_database(cap)
+    from hermes_state_registry import acquire
+    db = acquire(cap.home / 'state.db')
+    try:
+        cap.check()
+        key = 'memory.write_approval'
+        if enabled is not None:
+            db.set_meta(key, '1' if enabled else '0')
+        raw = db.get_meta(key)
+        cap.check()
+        if enabled is not None and raw != ('1' if enabled else '0'):
+            raise RuntimeError('memory_preference_commit_unconfirmed')
+        if raw is None:
+            from hermes_cli.config import load_config_readonly, cfg_get
+            return _normalize_enabled(cfg_get(load_config_readonly(), MEMORY, CONFIG_KEY, default=False))
+        if raw not in {'0', '1'}:
+            raise RuntimeError('memory_preference_state_unconfirmed')
+        return raw == '1'
+    finally:
+        db.close()
+
+
+def set_scoped_memory_approval(enabled):
+    value = scoped_memory_approval(enabled=enabled)
+    if value is None:
+        from hermes_cli.friday_user_scope import ScopeDenied
+        raise ScopeDenied()
+    return value
+
+
 def write_approval_enabled(subsystem: str) -> bool:
     """Read ``<subsystem>.write_approval``; any unset/invalid value means gate off."""
+    if subsystem == MEMORY:
+        scoped = scoped_memory_approval()
+        if scoped is not None:
+            return scoped
     if subsystem == SKILLS and _fio.active() is not None:
         from hermes_cli.config import load_config_readonly, cfg_get
         return _normalize_enabled(cfg_get(load_config_readonly(), subsystem, CONFIG_KEY, default=False))
