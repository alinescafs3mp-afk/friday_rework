+def _bounded_extract_response(results: List[dict], originals: Optional[List[dict]] = None) -> Optional[str]:
+    """Bound the whole embedded result in the opt-in byte-accounted lane.
+
+    Store original clean pages before reducing any inline evidence. A final
+    manifest fallback also retains metadata; failed storage is explicit partial.
+    Ordinary unbounded profiles keep the native response unchanged.
+    """
+    import json
+    from agent.bounded_context import bounded_tool_result_budget, serialized_bytes
+    budget = bounded_tool_result_budget()
+    if budget is None:
+        return None
+    encode = lambda value: json.dumps(value, ensure_ascii=False, separators=(",", ":"))
+    original = encode({"results": _trim_results(results)})
+    if serialized_bytes(original) <= budget:
+        return original
+    rows = []
+    for result, source in zip(results, originals if originals is not None else results):
+        content = source.get("raw_content", "") or source.get("content", "")
+        clean = convert_base64_images_to_links(content)
+        path = _store_full_text(result.get("url", ""), clean) if clean and not result.get("error") else None
+        partial = bool(path and len(clean.encode("utf-8")) > MAX_SCOPED_STORED_BYTES)
+        rows.append({"url": result.get("url", ""), "title": result.get("title", ""),
+                     "content": "", "error": result.get("error"), "partial": True,
+                     **({"blocked_by_policy": result["blocked_by_policy"]} if "blocked_by_policy" in result else {}),
+                     "stored_copy": "partial" if partial else "complete" if path else "unavailable",
+                     "read_file": {"path": path, "offset": 1, "limit": 200} if path else None})
+    base = {"results": rows, "partial": True, "note": "Inline preview; read_file pages retained source text."}
+    if serialized_bytes(encode(base)) > budget:
+        manifest_text = encode(base)
+        manifest = _store_full_text("https://web-extract.invalid/results", manifest_text)
+        response = {"results": [], "partial": True, "error": "capacity: result metadata exceeds inline budget",
+                    "stored_copy": ("partial" if len(manifest_text.encode()) > MAX_SCOPED_STORED_BYTES else "complete") if manifest else "unavailable",
+                    "read_file": {"path": manifest, "offset": 1, "limit": 200} if manifest else None}
+        value = encode(response)
+        if serialized_bytes(value) > budget:
+            return encode({"results": [], "partial": True, "error": "capacity: no recoverable result envelope fits"})
+        return value
+    # Fair aggregate allocation, priced after both JSON serializations. URLs,
+    # titles, paths and errors remain exact; only recoverable previews shrink.
+    low, high = 0, max((len(r.get("content", "")) for r in results), default=0)
+    while low < high:
+        mid = (low + high + 1) // 2
+        for row, source in zip(rows, results):
+            row["content"] = source.get("content", "")[:mid]
+        if serialized_bytes(encode(base)) <= budget:
+            low = mid
+        else:
+            high = mid - 1
+    for row, source in zip(rows, results):
+        row["content"] = source.get("content", "")[:low]
+    return encode(base)
