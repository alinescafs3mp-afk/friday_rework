diff --git a/hermes_cli/friday_ordinary_gateway.py b/hermes_cli/friday_ordinary_gateway.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/friday_ordinary_gateway.py
@@ -0,0 +1,310 @@
+"""Ordinary Telegram phase over the installed native owner and user policies.
+
+This is a receiving/admin scope, never worker readiness or release acceptance.
+The installer binds deployment data once; native onboarding retains its own
+operator sessions, config CAS, disabled-first setup, pairing and generations.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import sys
+
+STAGE = 'TELEGRAM_ORDINARY'
+SCHEMA = 'friday.ordinary-telegram.v1'
+_UNIT_BIRTH = None
+
+
+def require(ok, code):
+    from hermes_cli.friday_credential_admission import require as check
+    check(ok, 'ordinary_gateway_' + code)
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def normalized_configuration(cfg):
+    """Only native onboarding's committed identity collections are mutable.
+
+    Channel, local route, templates/tools, operator and every other setting stay
+    in the deployment binding. Removed fields are checked relationally below.
+    """
+    value = copy.deepcopy(cfg)
+    gateway = value.setdefault('gateway', {})
+    gateway.pop('profile_routes', None)
+    settings = value['plugins']['entries']['friday_rework']['settings']
+    settings.pop('user_isolation', None)
+    settings['admin'].pop('profiles', None)
+    for row in settings['product_access']['accounts']:
+        row.pop('runtime_profiles', None)
+    return sha(json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode())
+
+
+def dynamic_configuration(cfg, base):
+    """Check native prepare's route/account/profile references, including tombstones.
+
+    This does not enable a user. Native product state, PairingStore, profile
+    setup and per-event retained generation checks remain the authority.
+    """
+    from hermes_cli.friday_product_access import principal_id, profile_name
+    settings = cfg['plugins']['entries']['friday_rework']['settings']
+    policy = settings['product_access']
+    require(policy.get('enabled') is True, 'product_access_required')
+    accounts = policy['accounts']
+    require(type(accounts) is list and len(accounts) == 1, 'single_telegram_account_required')
+    account = accounts[0]
+    require(set(account) == {'platform','transport_profile','account_id','runtime_profiles'}
+            and account['platform'] == 'telegram' and account['transport_profile'] == 'default'
+            and isinstance(account['account_id'], str) and bool(account['account_id']), 'account_scope_changed')
+    isolation = settings.get('user_isolation')
+    if isolation is None:
+        bindings = []
+    else:
+        require(type(isolation) is dict and set(isolation) == {'enabled','bindings'}
+                and isolation['enabled'] is True and type(isolation['bindings']) is list,
+                'isolation_required')
+        bindings = isolation['bindings']
+    require(len(bindings) <= 10000, 'isolation_limit')
+    profiles = []; routes = []; users = set()
+    from hermes_cli.friday_user_scope import SAFE
+    for row in bindings:
+        require(type(row) is dict and set(row) == {'platform','transport_profile','account_id','user_id','runtime_profile','tools'}
+                and all(row[k] == account[k] for k in ('platform','transport_profile','account_id')),
+                'binding_account_mismatch')
+        profile = profile_name(row['runtime_profile'])
+        require(profile != 'default' and profile not in profiles and row['user_id'] not in users
+                and type(row['tools']) is list and bool(row['tools'])
+                and len(set(row['tools'])) == len(row['tools']) and set(row['tools']) <= SAFE,
+                'binding_scope_mismatch')
+        profiles.append(profile); users.add(row['user_id'])
+        key = principal_id('telegram', 'default', account['account_id'], row['user_id'])
+        routes.append(dict(name='friday-' + key, platform='telegram', bot_profile='default',
+                           user_id=row['user_id'], profile=profile, enabled=True))
+    require(type(base) is dict and set(base) == {'runtime_profiles','admin_profiles','telegram_allowed_users'}
+            and type(base['runtime_profiles']) is list and type(base['admin_profiles']) is list,
+            'baseline_required')
+    for name in base['runtime_profiles'] + base['admin_profiles']:
+        profile_name(name)
+    require(account['runtime_profiles'] == base['runtime_profiles'] + profiles
+            and settings['admin']['profiles'] == base['admin_profiles'] + profiles
+            and cfg['gateway'].get('profile_routes', []) == routes, 'onboarding_relations_changed')
+    return profiles
+
+
+def configuration_contract(cfg, base):
+    from hermes_cli.friday_credential_admission import local_route, profile_policy
+    from hermes_constants import get_hermes_home
+    contract = profile_policy(get_hermes_home(), cfg)
+    require(contract is not None and contract['profile'] == 'default'
+            and set(contract['required_scoped_names']['channels']) == {'telegram'}, 'receiving_scope_changed')
+    local_route(cfg)
+    settings = cfg['plugins']['entries']['friday_rework']['settings']
+    require(settings.get('runtime') == {'enabled': False}
+            and 'worker_requirements' not in settings,
+            'workers_not_disabled')
+    telegram = cfg['platforms']['telegram']
+    require(telegram.get('enabled') is True and telegram.get('extra', {}).get('drop_pending_on_cold_boot') is False
+            and telegram.get('extra', {}).get('unauthorized_dm_behavior') == 'pair'
+            and not telegram.get('webhook_url') and not telegram.get('webhook_secret')
+            and not telegram.get('extra', {}).get('webhook_url')
+            and not telegram.get('extra', {}).get('webhook_secret')
+            and 'telegram' not in cfg and 'telegram' not in cfg['gateway']
+            and 'platforms' not in cfg['gateway'],
+            'pending_preservation_required')
+    require(cfg['gateway'].get('multiplex_profiles') is True
+            and cfg['gateway'].get('systemd_watchdog_seconds') == 30, 'native_notify_owner_required')
+    dynamic_configuration(cfg, base)
+    return contract
+
+
+def invocation(home, contract, phase):
+    """Admit the native service's run role and exact ordinary operator commands."""
+    args = list(sys.argv[1:])
+    if args[:1] in (['-p'], ['--profile']):
+        require(args[1:2] == ['default'], 'foreign_profile')
+        args = args[2:]
+    exact = [
+        ['gateway','install','--no-start-now','--no-start-on-login'],
+        ['gateway','start'], ['gateway','status'], ['gateway','stop'], ['gateway','uninstall'], ['gateway','restart'],
+        ['gateway','run'],
+    ]
+    dash = contract['native_dashboard']
+    exact.append(['dashboard','--host',dash['host'],'--port',str(dash['port']),'--no-open'])
+    if args not in exact:
+        entry = phase['operator_entry']
+        from hermes_cli.friday_dashboard_owner import read_owned
+        require(type(entry) is dict and set(entry) == {'script','input'}
+                and Path(sys.argv[0]).resolve() == Path(entry['script']['path'])
+                and len(args) == 5 and args[:2] == ['start-telegram','--input']
+                and args[2] == entry['input']['path'] and args[3] == '--deadline'
+                and re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', args[4]) is not None, 'native_role_required')
+        require(all(type(ref) is dict and set(ref) == {'path','sha256'}
+                    and sha(read_owned(Path(ref['path']), private=name == 'input')) == ref['sha256']
+                    for name,ref in entry.items()), 'operator_entry_changed')
+    if args == ['gateway','restart']:
+        restart_inputs(home)
+    if args == ['gateway','run']:
+        from hermes_cli import gateway
+        expected = gateway.get_service_name() + '.service'
+        rows = Path('/proc/self/cgroup').read_text().splitlines()
+        global _UNIT_BIRTH
+        birth = (os.getpid(), Path('/proc/self/stat').read_text().rsplit(')',1)[1].split()[19], expected)
+        require(len(rows) == 1 and rows[0].startswith('0::/')
+                and rows[0].rsplit('/',1)[-1] == expected
+                and (_UNIT_BIRTH == birth or (_UNIT_BIRTH is None
+                    and re.fullmatch('[0-9a-f]{32}', os.environ.get('INVOCATION_ID','')) is not None)),
+                'native_user_unit_required')
+        _UNIT_BIRTH = birth  # Native dotenv deliberately removes nonglobal environment names.
+
+
+def check(home, marker=None, *, role=True):
+    from hermes_cli import friday_dashboard_owner as owner
+    from hermes_cli.friday_credential_admission import configuration
+    home = Path(home)
+    require(home == owner.SOURCE.parent and home.resolve() == home, 'authorization_home_required')
+    marker = marker if marker is not None else json.loads(owner.read_owned(home/'FRIDAY-INSTALL.json', private=True))
+    require(marker.get('completion_stage') == STAGE and marker.get('state') == 'INSTALLED_TEMPLATE_INCOMPLETE'
+            and marker.get('runtime_ready') is False
+            and marker.get('worker_state') == 'BOTH_WORKERS_PREPARATION_PENDING', 'phase_scope_changed')
+    phase = marker.get('ordinary_gateway')
+    require(type(phase) is dict and set(phase) == {'schema','scope','configuration_sha256',
+            'credential_files','profile_sha256','source_receipt_sha256','baseline','history','operator_entry'}
+            and phase['schema'] == SCHEMA and phase['scope'] == 'TELEGRAM_RECEIVER_AND_AUTHENTICATED_ONBOARDING_ONLY',
+            'deployment_binding_required')
+    require(phase['source_receipt_sha256'] == marker.get('source_receipt_sha256')
+            and owner.source_identity(home)['receipt'] == phase['source_receipt_sha256'], 'source_changed')
+    require(sha(owner.read_owned(home/'FRIDAY-PROFILE.json', private=True)) == phase['profile_sha256'], 'profile_changed')
+    require(type(phase['credential_files']) is dict and set(phase['credential_files']) == {'.env','auth.json'},
+            'credential_inventory_required')
+    for name, expected in phase['credential_files'].items():
+        path = home/name
+        current = (credential_identity(home)[0] if name == '.env' else
+                   sha(owner.read_owned(path, private=True)) if path.exists() or path.is_symlink() else None)
+        require(current == expected, 'credentials_changed')
+    history = phase['history']
+    require(type(history) is dict and 'preparation/ordinary-gateway/before/FRIDAY-INSTALL.json' in history,
+            'history_required')
+    for name, pin in history.items():
+        path = Path(name)
+        require(not path.is_absolute() and '..' not in path.parts
+                and (name.startswith('preparation/ordinary-gateway/before/')
+                     or (len(path.parts) == 1 and name.startswith('FRIDAY-INSTALL.')
+                         and name != 'FRIDAY-INSTALL.json')), 'history_path_refused')
+        require(sha(owner.read_owned(home/path, private=True)) == pin, 'history_changed')
+    old = json.loads(owner.read_owned(home/'preparation/ordinary-gateway/before/FRIDAY-INSTALL.json', private=True))
+    require(old.get('completion_stage') == 'CLI_HOST_ONLY'
+            and old.get('original_attempt') == marker.get('original_attempt')
+            and old.get('cli_segment') == marker.get('cli_segment'), 'historical_scope_changed')
+    allowlist_current(home, phase['baseline']['telegram_allowed_users'])
+    cfg = configuration(home)
+    require(normalized_configuration(cfg) == phase['configuration_sha256'], 'configuration_changed')
+    contract = configuration_contract(cfg, phase['baseline'])
+    if role:
+        invocation(home, contract, phase)
+    return phase
+
+
+def admin_profiles(home, cfg, value):
+    """Permit exactly the profiles written by native operator onboarding."""
+    phase = check(home, role=False)
+    dynamic_configuration(cfg, phase['baseline'])
+    admin = cfg['plugins']['entries']['friday_rework']['settings']['admin']
+    return admin == {'enabled':True, 'operators':[value['operator']], 'profiles':admin['profiles']}
+
+
+def configuration_identity(home):
+    """Stable native identify binding across validated onboarding commits."""
+    phase = check(home, role=False)
+    return phase['configuration_sha256']
+
+
+def credential_identity(home):
+    """Bind all secret values; native pairing alone may mirror its allowlist."""
+    from hermes_cli.friday_credential_admission import owned_values
+    from gateway.pairing import _split_allowlist
+    values = owned_values(Path(home))
+    users = _split_allowlist(values.pop('TELEGRAM_ALLOWED_USERS',''))
+    require('*' not in users, 'wildcard_allowlist_refused')
+    return sha(json.dumps(values,sort_keys=True,separators=(',', ':')).encode()), users
+
+
+def allowlist_current(home, baseline):
+    from hermes_constants import get_hermes_dir
+    from hermes_cli.friday_dashboard_owner import read_owned
+    _binding, users = credential_identity(home)
+    path = get_hermes_dir('platforms/pairing','pairing',home=Path(home))/'telegram-approved.json'
+    approved = json.loads(read_owned(path,private=True)) if path.exists() or path.is_symlink() else {}
+    require(type(approved) is dict and type(baseline) is list
+            and all(isinstance(k,str) and k and k != '*' for k in [*baseline,*approved]),
+            'native_allowlist_invalid')
+    require(set(users) <= set(baseline) | set(approved), 'native_allowlist_grant_missing')
+
+
+def receiving_pairing_store(runner, source):
+    """Friday ordinary pairings belong to the bot's receiving authorization home.
+
+    Runtime routing cannot move or invent a grant. Non-Friday/native deployments
+    retain their donor store selection. No store is created by this read path.
+    """
+    from gateway.session_identity import identity_of
+    from hermes_cli import friday_dashboard_owner as owner
+    from hermes_constants import get_hermes_dir
+    identity = identity_of(source)
+    if identity is None:
+        return False, None
+    root = Path(identity.authorization_home)
+    marker_path = root/'FRIDAY-INSTALL.json'
+    if not marker_path.exists() and not marker_path.is_symlink():
+        return False, None
+    marker = json.loads(owner.read_owned(marker_path,private=True))
+    if marker.get('completion_stage') != STAGE:
+        return False, None
+    if (root != owner.SOURCE.parent or identity.transport_profile != 'default'
+            or not identity.multiplexed or identity.transport_inferred
+            or getattr(getattr(source,'platform',None),'value',None) != 'telegram'):
+        return True, None
+    stores = getattr(runner,'pairing_stores',None) or {}
+    store = stores.get(identity.transport_profile) or getattr(runner,'pairing_store',None)
+    expected = get_hermes_dir('platforms/pairing','pairing',home=root)
+    if store is None or getattr(store,'_dir',None) != expected:
+        return True, None
+    return True, store
+
+
+def restart_inputs(home):
+    """Restart only the exact existing native user unit and proved owner.
+
+    The donor then keeps its graceful drain, planned stop, replacement and
+    token-lock lifecycle. Refuse adoption/refresh of a foreign unit or owner.
+    This preflight has no start, restart, signal, unit write or grant effect.
+    """
+    from hermes_cli import gateway as gw
+    from gateway import host_rendezvous as hr
+    from hermes_cli.friday_dashboard_owner import read_owned
+    unit = gw.get_systemd_unit_path(system=False)
+    dropins = unit.parent / (unit.name + '.d')
+    require(gw.supports_systemd_services() and unit.exists()
+            and not gw.get_systemd_unit_path(system=True).exists()
+            and not gw.has_legacy_hermes_units() and not gw.has_conflicting_systemd_units()
+            and not dropins.is_symlink() and (not dropins.exists() or not any(dropins.iterdir())),
+            'restart_native_user_unit_required')
+    actual = read_owned(unit).decode('utf-8-sig')
+    norm = lambda text: gw._normalize_service_definition(gw._strip_optional_systemd_directives(text))
+    require(not unit.stat().st_mode & 0o022 and gw._hermes_home_pinned_by_unit(unit) == str(home)
+            and norm(actual) == norm(gw.generate_systemd_unit(system=False)), 'restart_foreign_unit_refused')
+    record = hr.read_record(hr.ROLE_GATEWAY,include_stale=True)
+    require(record is not None and record.home == str(home) and 'default' in record.profiles
+            and record.protocol_version == 1 and record.start_time is not None
+            and hr.liveness_is_proven(record) and hr.record_token_is_consistent(record),
+            'restart_native_owner_unproved')
+    props = gw._read_systemd_unit_properties(system=False,
+        properties=('ActiveState','SubState','MainPID','InvocationID'))
+    require(props.get('ActiveState') == 'active' and props.get('SubState') == 'running'
+            and props.get('MainPID') == str(record.pid)
+            and re.fullmatch('[0-9a-f]{32}',props.get('InvocationID','')) is not None,
+            'restart_native_incarnation_unproved')
