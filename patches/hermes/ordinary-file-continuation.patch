+def _absolute_directory(path):
+    """Pin every component; O_NOFOLLOW on just the leaf misses parent escapes."""
+    from hermes_cli.friday_user_scope import ScopeDenied
+    path = Path(path)
+    if not path.is_absolute() or any(p in {'.', '..'} for p in path.parts):
+        raise ScopeDenied()
+    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        for part in path.parts[1:]:
+            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+            os.close(fd)
+            fd = child
+        _owned(os.fstat(fd), directory=True)
+        return fd
+    except BaseException:
+        os.close(fd)
+        raise
+
+
+def _verified_bytes(directory, parts, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    fd = os.dup(directory)
+    try:
+        for part in parts[:-1]:
+            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+            os.close(fd)
+            fd = child
+            _owned(os.fstat(fd), directory=True)
+        item = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
+        try:
+            before = os.fstat(item)
+            _owned(before)
+            if before.st_size != content['size_bytes']:
+                raise ScopeDenied()
+            data = bytearray()
+            while len(data) <= content['size_bytes']:
+                chunk = os.read(item, min(65536, content['size_bytes'] + 1 - len(data)))
+                if not chunk:
+                    break
+                data.extend(chunk)
+            after = os.fstat(item)
+            _owned(after)
+            if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
+                    after.st_size, after.st_mtime_ns, after.st_ctime_ns):
+                raise ScopeDenied()
+            if len(data) != content['size_bytes'] or hashlib.sha256(data).hexdigest() != content['sha256']:
+                raise ScopeDenied()
+            return bytes(data)
+        finally:
+            os.close(item)
+    finally:
+        os.close(fd)
+
+
+def _publish_received(directory, name, data, content):
+    """Publish complete bytes without replacing an existing user file."""
+    temporary = 'incoming_' + uuid.uuid4().hex
+    item = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+                   0o600, dir_fd=directory)
+    try:
+        with os.fdopen(item, 'wb') as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        try:
+            os.link(temporary, name, src_dir_fd=directory, dst_dir_fd=directory, follow_symlinks=False)
+        except FileExistsError:
+            pass
+    finally:
+        os.unlink(temporary, dir_fd=directory)
+    # Also verifies an existing deterministic name on retries; never trust an
+    # existing pathname just because its name contains a digest.
+    _verified_bytes(directory, (name,), content)
+    os.fsync(directory)
