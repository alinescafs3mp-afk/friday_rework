+        if (identity is None or identity.transport_inferred or identity.runtime_home != cap.home
+                or identity.runtime_profile != cap.profile or identity.transport_profile != cap.principal[1]
+                or source.user_id != cap.principal[3] or runner is None
+                or str(getattr(getattr(adapter, '_bot', None), 'id', '')) != cap.principal[2]):
+            raise ValueError('original_source_required')
+        route = freeze_route({'transport_profile': identity.transport_profile,
+                              'runtime_profile': cap.profile, 'bot_id': cap.principal[2],
+                              'source': {key: getattr(source, key) for key in
+                                  ('chat_id', 'chat_type', 'user_id', 'thread_id', 'message_id')} |
+                                        {'platform': source.platform.value}})
+        retained = getattr(source, '_friday_document_route', None)
+        if retained is None or freeze_route(retained) != route:
+            raise ValueError('native_original_route_required')
+        route = freeze_route(retained)
+        context = SimpleNamespace(_manager=SimpleNamespace(home_path=cap.home))
+        _, live_adapter = resolve_document_route(runner, context, route)
+        if live_adapter is not adapter:
+            raise ValueError('original_adapter_replaced')
