+def attester_reap_child(pid, deadline, pidfd=None):
+    """Exact-child wait even if pidfd allocation failed; never wait unbounded."""
+    pause = select.poll()
+    while True:
+        waited, status = os.waitpid(pid, os.WNOHANG)
+        if waited == pid:
+            return status
+        require(waited == 0, 'route_attester_reap_unconfirmed')
+        attester_remaining(deadline)
+        if pidfd is not None:
+            attester_poll(pidfd, deadline)
+        else:
+            pause.poll(max(1, min(10, int(attester_remaining(deadline) * 1000))))
