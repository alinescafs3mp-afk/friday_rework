+                              'parent', 'snapshot', 'executable', 'attester', 'checked_monotonic_ns'}
+                and proof['schema'] == 'friday.a0.preexec-proof.v1' and proof['stage'] == stage
+                and type(proof['challenge']) is str and re.fullmatch('[0-9a-f]{32}', proof['challenge'])
+                and proof['challenge'] not in challenges
+                and proof['context_sha256'] == hashlib.sha256(canonical(context).encode()).hexdigest()
+                and proof['request_sha256'] == context['request_sha256'] and proof['nonce'] == request['nonce']
+                and proof['parent'] == context['parent'] and proof['attester'] == descriptor['identity']
+                and proof['snapshot'] == {'child': receipt['daemon'], 'namespaces': receipt['namespaces'], 'mappings': receipt['mappings']}
+                and set(proof['executable']) == {'path', 'sha256', 'file'}
+                and proof['executable']['path'] == str(tool_paths()['rootlesskit'])
+                and proof['executable']['sha256'] == request['tools']['rootlesskit']
+                and type(proof['executable']['file']) is list and len(proof['executable']['file']) == 2
+                and all(type(x) is int and x > 0 for x in proof['executable']['file'])
