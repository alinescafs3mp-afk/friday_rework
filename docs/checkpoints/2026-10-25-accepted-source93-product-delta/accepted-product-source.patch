+def attester_original_gone(identity):
+    """A pidfd exit notification alone still permits an unreaped zombie."""
+    try:
+        current = proc_identity(identity['pid'])
+    except FileNotFoundError:
+        try:
+            Path('/proc', str(identity['pid'])).lstat()
+        except FileNotFoundError:
+            return True
+        require(False, 'route_attester_reap_unconfirmed')
+    require(current['boot'] == identity['boot'], 'route_attester_reap_unconfirmed')
+    return current['start'] != identity['start']
