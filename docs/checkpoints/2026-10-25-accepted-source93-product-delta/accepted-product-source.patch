+def attester_wait_gone(pidfd, identity, deadline):
+    """Require exit and disappearance of this exact original process."""
+    poll = select.poll(); poll.register(pidfd, select.POLLIN | select.POLLHUP)
+    events = poll.poll(max(1, int(attester_remaining(deadline) * 1000)))
+    require(any(fd == pidfd and flags & (select.POLLIN | select.POLLHUP)
+                and not flags & (select.POLLERR | select.POLLNVAL)
+                for fd, flags in events), 'route_attester_exit_unconfirmed')
+    if attester_original_gone(identity):
+        attester_remaining(deadline)
+        return
+    # Ignore level-triggered exit readability while the manager still owns a
+    # zombie. A reaped pidfd delivers HUP; /proc independently confirms it.
+    poll.modify(pidfd, 0)
+    events = poll.poll(max(1, int(attester_remaining(deadline) * 1000)))
+    require(any(fd == pidfd and flags & select.POLLHUP
+                and not flags & (select.POLLERR | select.POLLNVAL)
+                for fd, flags in events), 'route_attester_reap_unconfirmed')
+    require(attester_original_gone(identity), 'route_attester_reap_unconfirmed')
+    attester_remaining(deadline)
