+        message = {'schema': 'friday.a0.preexec-query.v1', 'stage': stage, 'challenge': os.urandom(16).hex(),
+                   'context_sha256': hashlib.sha256(canonical(self.context).encode()).hexdigest(), 'snapshot': snapshot}
+        attester_packet(self.sock, self.deadline, message)
+        proof = attester_packet(self.sock, self.deadline)
+        require(set(proof) == {'schema', 'stage', 'challenge', 'context_sha256', 'request_sha256', 'nonce',
+                              'parent', 'snapshot', 'executable', 'attester', 'checked_monotonic_ns'}
+                and proof['schema'] == 'friday.a0.preexec-proof.v1'
+                and all(proof[k] == message[k] for k in ('stage', 'challenge', 'context_sha256'))
+                and proof['request_sha256'] == self.context['request_sha256'] and proof['nonce'] == self.request['nonce']
+                and proof['parent'] == parent and proof['snapshot'] == snapshot
+                and proof['attester'] == self.context['attester']['identity']
+                and type(proof['executable']) is dict and set(proof['executable']) == {'path', 'sha256', 'file'}
+                and proof['executable']['path'] == str(tool_paths()['rootlesskit'])
+                and proof['executable']['sha256'] == self.request['tools']['rootlesskit']
+                and type(proof['executable']['file']) is list and len(proof['executable']['file']) == 2
