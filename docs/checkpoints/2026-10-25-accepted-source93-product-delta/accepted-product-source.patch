+def attester_packet(sock, deadline, value=None):
+    sock.settimeout(attester_remaining(deadline))
+    if value is not None:
+        data = canonical(value).encode()
+        require(len(data) <= ATTESTER_PACKET_LIMIT and sock.send(data) == len(data), 'route_attester_packet_write')
+        return
+    data, ancillary, flags, _ = sock.recvmsg(ATTESTER_PACKET_LIMIT)
+    require(data and not ancillary and flags == 0, 'route_attester_packet_shape')
+    return exact_json(data.decode())
