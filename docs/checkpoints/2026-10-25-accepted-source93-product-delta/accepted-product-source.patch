+def start_parent_attester(context, request, manager):
+    deadline = min(time.monotonic_ns() + 20*10**9,
+                   request['accepted_monotonic_ns'] + (request['original_budget_seconds'] - 25)*10**9)
+    attester_remaining(deadline)
