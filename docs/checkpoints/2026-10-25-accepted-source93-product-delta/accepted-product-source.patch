+    middle = None; middle_reaped = False
+    try:
+        ready_r, ready_w = os.pipe2(os.O_CLOEXEC)
+        go_r, go_w = os.pipe2(os.O_CLOEXEC)
+        middle = os.fork()
+        if middle == 0:
+            try:
+                os.close(ready_r); os.close(go_w)
+                helper = os.fork()
+                if helper != 0: os._exit(0)
+                # Only the two private pipes and standard I/O survive here.
+                for fd in list(map(int, os.listdir('/proc/self/fd'))):
+                    if fd > 2 and fd not in (ready_w, go_r):
+                        try: os.close(fd)
+                        except OSError: pass
+                try:
+                    parent_attester_server(context, request, manager, ready_w, go_r, deadline)
+                except BaseException:
+                    os._exit(1)
+                os._exit(0)
+            except BaseException:
+                os._exit(1)
+        os.close(ready_w); ready_w = -1
+        os.close(go_r); go_r = -1
+        middle_fd = os.pidfd_open(middle)
+        status = attester_reap_child(middle, deadline, middle_fd)
+        middle_reaped = True
+        require(os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0, 'route_attester_fork_failed')
+        attester_remaining(deadline)
+        require(os.write(go_w, b'G') == 1, 'route_attester_go_failed')
+        os.close(go_w); go_w = -1
+        attester_poll(ready_r, deadline)
+        descriptor = exact_json(os.read(ready_r, 4096).decode())
+        checked_attester_descriptor(dict(context, attester=descriptor))
+        require(descriptor['deadline_monotonic_ns'] == deadline and descriptor['reaper'] == manager
+                and proc_identity(descriptor['identity']['pid']) == descriptor['identity']
+                and descriptor['identity']['ppid'] == manager['pid']
+                and attester_socket_identity(context, UID) == descriptor['socket_identity'], 'route_attester_ready_binding')
+        return descriptor
+    finally:
+        # Closing GO also releases a not-yet-ready helper on every failed start.
+        close_failed = False
+        for fd in (ready_r, ready_w, go_r, go_w):
+            if fd >= 0:
+                try: os.close(fd)
+                except OSError: close_failed = True
+        try:
+            if middle is not None and middle > 0 and not middle_reaped:
+                attester_reap_child(middle, deadline, middle_fd if middle_fd >= 0 else None)
+        finally:
+            if middle_fd >= 0:
+                try: os.close(middle_fd)
+                except OSError: close_failed = True
+        require(not close_failed, 'route_attester_fd_cleanup_unconfirmed')
