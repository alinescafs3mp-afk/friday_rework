+            and descriptor['identity']['ppid'] == descriptor['reaper']['pid'] == context['parent']['ppid']
+            and descriptor['identity']['cgroup'] == context['parent']['cgroup']
+            and descriptor['identity']['boot'] == descriptor['reaper']['boot'] == context['parent']['boot']
+            and type(descriptor['deadline_monotonic_ns']) is int
+            and request['accepted_monotonic_ns'] < descriptor['deadline_monotonic_ns']
+            <= request['accepted_monotonic_ns'] + (request['original_budget_seconds'] - 25)*10**9
