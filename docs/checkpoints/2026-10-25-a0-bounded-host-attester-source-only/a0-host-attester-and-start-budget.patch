+def checked_attestation_receipt(receipt):
+    """Join retained evidence; live authority still comes from host rechecks."""
+    context, request = receipt['context'], receipt['request']
+    descriptor = checked_attester_descriptor(context); proofs = receipt['parent_attestations']
+    require(set(descriptor) == {'schema', 'identity', 'reaper', 'socket_identity', 'deadline_monotonic_ns'}
+            and descriptor['schema'] == 'friday.a0.preexec-attester.v1'
+            and descriptor['identity']['ppid'] == descriptor['reaper']['pid'] == context['parent']['ppid']
+            and descriptor['identity']['cgroup'] == context['parent']['cgroup']
+            and descriptor['identity']['boot'] == descriptor['reaper']['boot'] == context['parent']['boot']
+            and type(descriptor['deadline_monotonic_ns']) is int
+            and request['accepted_monotonic_ns'] < descriptor['deadline_monotonic_ns']
+            <= request['accepted_monotonic_ns'] + (request['original_budget_seconds'] - 25)*10**9
+            and type(proofs) is list and len(proofs) == 2, 'guard_attestation_shape')
+    challenges = set(); checked = 0
+    for stage, proof in zip(('before_policy', 'after_policy'), proofs):
+        require(set(proof) == {'schema', 'stage', 'challenge', 'context_sha256', 'request_sha256', 'nonce',
+                              'parent', 'snapshot', 'executable', 'attester', 'checked_monotonic_ns'}
+                and proof['schema'] == 'friday.a0.preexec-proof.v1' and proof['stage'] == stage
+                and type(proof['challenge']) is str and re.fullmatch('[0-9a-f]{32}', proof['challenge'])
+                and proof['challenge'] not in challenges
+                and proof['context_sha256'] == hashlib.sha256(canonical(context).encode()).hexdigest()
+                and proof['request_sha256'] == context['request_sha256'] and proof['nonce'] == request['nonce']
+                and proof['parent'] == context['parent'] and proof['attester'] == descriptor['identity']
+                and proof['snapshot'] == {'child': receipt['daemon'], 'namespaces': receipt['namespaces'], 'mappings': receipt['mappings']}
+                and set(proof['executable']) == {'path', 'sha256', 'file'}
+                and proof['executable']['path'] == str(tool_paths()['rootlesskit'])
+                and proof['executable']['sha256'] == request['tools']['rootlesskit']
+                and type(proof['executable']['file']) is list and len(proof['executable']['file']) == 2
+                and all(type(x) is int and x > 0 for x in proof['executable']['file'])
