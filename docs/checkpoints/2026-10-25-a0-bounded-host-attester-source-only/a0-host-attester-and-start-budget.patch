+def attester_socket_identity(context, uid):
+    attester_state(context, uid)
+    path = STATE / ATTESTER_SOCKET
+    require(len(os.fsencode(path)) < 108 and path.parent == STATE, 'route_attester_path_length')
+    st = path.lstat()
+    require(stat.S_ISSOCK(st.st_mode) and st.st_uid == uid
+            and stat.S_IMODE(st.st_mode) == 0o600 and st.st_nlink == 1, 'route_attester_socket_changed')
+    return [st.st_dev, st.st_ino]
