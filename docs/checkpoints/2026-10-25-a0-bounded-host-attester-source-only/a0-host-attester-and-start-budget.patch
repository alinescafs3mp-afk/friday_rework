+def attester_poll(fd, deadline):
+    poll = select.poll(); poll.register(fd, select.POLLIN | select.POLLHUP | select.POLLERR)
+    require(bool(poll.poll(max(1, int(attester_remaining(deadline) * 1000)))), 'route_attester_timeout')
+
