+def parent_attester_server(context, request, manager, ready, go, deadline):
+    """One adopted host helper, one client, two ordered checks; never a worker."""
+    listener = connection = None; socket_identity = None
+    def expired(*_): raise TimeoutError('route_attester_deadline')
+    signal.signal(signal.SIGALRM, expired)
+    signal.setitimer(signal.ITIMER_REAL, attester_remaining(deadline))
+    try:
+        attester_poll(go, deadline); require(os.read(go, 1) == b'G', 'route_attester_parent_missing')
+        os.close(go); go = -1
+        me = proc_identity(os.getpid())
+        require(me['ppid'] == manager['pid'] and proc_identity(manager['pid']) == manager
+                and me['cgroup'] == context['parent']['cgroup'], 'route_attester_not_adopted')
+        with namespaces(os.getpid()) as (ns, _):
+            require(ns == context['host_namespaces'], 'route_attester_not_host')
+        attester_state(context, UID)
+        path = STATE / ATTESTER_SOCKET
+        require(not path.exists() and not path.is_symlink() and len(os.fsencode(path)) < 108, 'route_attester_prior_socket')
+        listener = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET | socket.SOCK_CLOEXEC)
+        listener.bind(str(path)); os.chmod(path, 0o600)
+        socket_identity = attester_socket_identity(context, UID)
+        listener.listen(1)
+        descriptor = {'schema': 'friday.a0.preexec-attester.v1', 'identity': me, 'reaper': manager,
+                      'socket_identity': socket_identity, 'deadline_monotonic_ns': deadline}
+        context = dict(context, attester=descriptor)
+        data = canonical(descriptor).encode()
+        require(len(data) <= 4096 and os.write(ready, data) == len(data), 'route_attester_ready_write')
+        os.close(ready); ready = -1
+        listener.settimeout(attester_remaining(deadline)); connection, _ = listener.accept()
+        peer = attester_peer(connection)
+        require(peer[1:] == (UID, UID), 'route_attester_peer_uid')
+        # No pathname survives authentication. The connected kernel endpoint is
+        # the sole channel and later clients cannot consume the second stage.
+        attester_snapshot(peer[0], context)
+        attester_unlink(context, socket_identity); socket_identity = None
+        listener.close(); listener = None
+        challenges = set()
+        for stage in ('before_policy', 'after_policy'):
+            message = attester_packet(connection, deadline)
+            proof = attester_reply(context, request, descriptor, message, peer, stage)
+            require(proof['challenge'] not in challenges, 'route_attester_replayed_challenge')
+            challenges.add(proof['challenge'])
+            attester_packet(connection, deadline, proof)
+    finally:
+        if connection is not None: connection.close()
+        if listener is not None: listener.close()
+        if socket_identity is not None: attester_unlink(context, socket_identity)
+        if ready >= 0: os.close(ready)
+        if go >= 0: os.close(go)
+        signal.setitimer(signal.ITIMER_REAL, 0)
+
