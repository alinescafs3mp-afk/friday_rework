+def attester_state(context, uid):
+    # RootlessKit's /run copy-up may alias an ancestor. As in write_guard,
+    # accept only the held, non-symlink leaf with the host-pinned identity.
+    fd = os.open(STATE, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    try:
+        st = os.fstat(fd); named = STATE.lstat()
+        require(stat.S_ISDIR(st.st_mode) and st.st_uid == uid
+                and stat.S_IMODE(st.st_mode) == 0o700
+                and [st.st_dev, st.st_ino] == context['state_identity']
+                and (named.st_dev, named.st_ino, named.st_mode, named.st_uid)
+                == (st.st_dev, st.st_ino, st.st_mode, st.st_uid), 'route_attester_state_changed')
+    finally:
+        os.close(fd)
+
