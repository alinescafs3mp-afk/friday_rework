+def attester_original_gone(identity):
+    """A pidfd exit notification alone still permits an unreaped zombie."""
+    try:
+        current = proc_identity(identity['pid'])
+    except FileNotFoundError:
+        try:
+            Path('/proc', str(identity['pid'])).lstat()
+        except FileNotFoundError:
+            return True
+        require(False, 'route_attester_reap_unconfirmed')
+    require(current['boot'] == identity['boot'], 'route_attester_reap_unconfirmed')
+    return current['start'] != identity['start']
+
+
+def attester_wait_gone(pidfd, identity, deadline):
+    """Require exit and disappearance of this exact original process."""
+    poll = select.poll(); poll.register(pidfd, select.POLLIN | select.POLLHUP)
+    events = poll.poll(max(1, int(attester_remaining(deadline) * 1000)))
+    require(any(fd == pidfd and flags & (select.POLLIN | select.POLLHUP)
+                and not flags & (select.POLLERR | select.POLLNVAL)
+                for fd, flags in events), 'route_attester_exit_unconfirmed')
+    if attester_original_gone(identity):
+        attester_remaining(deadline)
+        return
+    # Ignore level-triggered exit readability while the manager still owns a
+    # zombie. A reaped pidfd delivers HUP; /proc independently confirms it.
+    poll.modify(pidfd, 0)
+    events = poll.poll(max(1, int(attester_remaining(deadline) * 1000)))
+    require(any(fd == pidfd and flags & select.POLLHUP
+                and not flags & (select.POLLERR | select.POLLNVAL)
+                for fd, flags in events), 'route_attester_reap_unconfirmed')
+    require(attester_original_gone(identity), 'route_attester_reap_unconfirmed')
+    attester_remaining(deadline)
+
+
+def attester_reap_child(pid, deadline, pidfd=None):
+    """Exact-child wait even if pidfd allocation failed; never wait unbounded."""
+    pause = select.poll()
+    while True:
+        waited, status = os.waitpid(pid, os.WNOHANG)
+        if waited == pid:
+            return status
+        require(waited == 0, 'route_attester_reap_unconfirmed')
+        attester_remaining(deadline)
+        if pidfd is not None:
+            attester_poll(pidfd, deadline)
+        else:
+            pause.poll(max(1, min(10, int(attester_remaining(deadline) * 1000))))
+
+
+def start_parent_attester(context, request, manager):
+    deadline = min(time.monotonic_ns() + 20*10**9,
+                   request['accepted_monotonic_ns'] + (request['original_budget_seconds'] - 25)*10**9)
+    attester_remaining(deadline)
+    ready_r = ready_w = go_r = go_w = middle_fd = -1
+    middle = None; middle_reaped = False
+    try:
+        ready_r, ready_w = os.pipe2(os.O_CLOEXEC)
+        go_r, go_w = os.pipe2(os.O_CLOEXEC)
+        middle = os.fork()
+        if middle == 0:
+            try:
+                os.close(ready_r); os.close(go_w)
+                helper = os.fork()
+                if helper != 0: os._exit(0)
+                # Only the two private pipes and standard I/O survive here.
+                for fd in list(map(int, os.listdir('/proc/self/fd'))):
+                    if fd > 2 and fd not in (ready_w, go_r):
+                        try: os.close(fd)
+                        except OSError: pass
+                try:
+                    parent_attester_server(context, request, manager, ready_w, go_r, deadline)
+                except BaseException:
+                    os._exit(1)
+                os._exit(0)
+            except BaseException:
+                os._exit(1)
+        os.close(ready_w); ready_w = -1
+        os.close(go_r); go_r = -1
+        middle_fd = os.pidfd_open(middle)
+        status = attester_reap_child(middle, deadline, middle_fd)
+        middle_reaped = True
+        require(os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0, 'route_attester_fork_failed')
+        attester_remaining(deadline)
+        require(os.write(go_w, b'G') == 1, 'route_attester_go_failed')
+        os.close(go_w); go_w = -1
+        attester_poll(ready_r, deadline)
+        descriptor = exact_json(os.read(ready_r, 4096).decode())
+        checked_attester_descriptor(dict(context, attester=descriptor))
+        require(descriptor['deadline_monotonic_ns'] == deadline and descriptor['reaper'] == manager
+                and proc_identity(descriptor['identity']['pid']) == descriptor['identity']
+                and descriptor['identity']['ppid'] == manager['pid']
+                and attester_socket_identity(context, UID) == descriptor['socket_identity'], 'route_attester_ready_binding')
+        return descriptor
+    finally:
+        # Closing GO also releases a not-yet-ready helper on every failed start.
+        close_failed = False
+        for fd in (ready_r, ready_w, go_r, go_w):
+            if fd >= 0:
+                try: os.close(fd)
+                except OSError: close_failed = True
+        try:
+            if middle is not None and middle > 0 and not middle_reaped:
+                attester_reap_child(middle, deadline, middle_fd if middle_fd >= 0 else None)
+        finally:
+            if middle_fd >= 0:
+                try: os.close(middle_fd)
+                except OSError: close_failed = True
+        require(not close_failed, 'route_attester_fd_cleanup_unconfirmed')
+
