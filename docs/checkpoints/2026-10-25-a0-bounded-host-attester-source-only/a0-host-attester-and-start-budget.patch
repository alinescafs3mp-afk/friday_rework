+class ParentAttester:
+    def __init__(self, context, request):
+        self.context, self.request, self.sock, self.pidfd = context, request, None, None
+        self.proofs = []
+
+    def __enter__(self):
+        descriptor = checked_attester_descriptor(self.context); self.deadline = descriptor['deadline_monotonic_ns']
+        try:
+            require(proc_identity(descriptor['identity']['pid']) == descriptor['identity']
+                    and attester_socket_identity(self.context, 0) == descriptor['socket_identity'], 'route_attester_endpoint_changed')
+            self.pidfd = os.pidfd_open(descriptor['identity']['pid'])
+            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET | socket.SOCK_CLOEXEC)
+            self.sock.settimeout(attester_remaining(self.deadline)); self.sock.connect(str(STATE / ATTESTER_SOCKET))
+            require(attester_peer(self.sock) == (descriptor['identity']['pid'], 0, 0)
+                    and proc_identity(descriptor['identity']['pid']) == descriptor['identity'], 'route_attester_peer_changed')
+            return self
+        except BaseException:
+            self.close(); raise
+
+    def verify(self, parent, stage):
+        require(stage == ('before_policy', 'after_policy')[len(self.proofs)]
+                and parent == self.context['parent'], 'route_attester_stage_changed')
+        snapshot = attester_snapshot(os.getpid(), self.context)
+        message = {'schema': 'friday.a0.preexec-query.v1', 'stage': stage, 'challenge': os.urandom(16).hex(),
+                   'context_sha256': hashlib.sha256(canonical(self.context).encode()).hexdigest(), 'snapshot': snapshot}
+        attester_packet(self.sock, self.deadline, message)
+        proof = attester_packet(self.sock, self.deadline)
+        require(set(proof) == {'schema', 'stage', 'challenge', 'context_sha256', 'request_sha256', 'nonce',
+                              'parent', 'snapshot', 'executable', 'attester', 'checked_monotonic_ns'}
+                and proof['schema'] == 'friday.a0.preexec-proof.v1'
+                and all(proof[k] == message[k] for k in ('stage', 'challenge', 'context_sha256'))
+                and proof['request_sha256'] == self.context['request_sha256'] and proof['nonce'] == self.request['nonce']
+                and proof['parent'] == parent and proof['snapshot'] == snapshot
+                and proof['attester'] == self.context['attester']['identity']
+                and type(proof['executable']) is dict and set(proof['executable']) == {'path', 'sha256', 'file'}
+                and proof['executable']['path'] == str(tool_paths()['rootlesskit'])
+                and proof['executable']['sha256'] == self.request['tools']['rootlesskit']
+                and type(proof['executable']['file']) is list and len(proof['executable']['file']) == 2
+                and all(type(x) is int and x > 0 for x in proof['executable']['file'])
+                and type(proof['checked_monotonic_ns']) is int
+                and self.deadline - 20*10**9 < proof['checked_monotonic_ns'] <= time.monotonic_ns() < self.deadline
+                and proc_identity(parent['pid']) == parent
+                and attester_snapshot(os.getpid(), self.context) == snapshot, 'route_attester_proof_changed')
+        self.proofs.append(proof)
+        return True
+
+    def close(self):
+        if self.sock is not None: self.sock.close(); self.sock = None
+        if self.pidfd is not None: os.close(self.pidfd); self.pidfd = None
+
+    def __exit__(self, kind, value, traceback):
+        try:
+            if kind is None:
+                require(len(self.proofs) == 2, 'route_attester_incomplete')
+                attester_wait_gone(self.pidfd, self.context['attester']['identity'], self.deadline)
+                require(not (STATE / ATTESTER_SOCKET).exists() and not (STATE / ATTESTER_SOCKET).is_symlink(), 'route_attester_cleanup_missing')
+        finally:
+            self.close()
+
