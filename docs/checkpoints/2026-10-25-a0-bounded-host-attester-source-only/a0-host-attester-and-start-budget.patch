+def parent_executable_checked(parent, request):
+    """Observe the current process executable, not merely a pinned binary FD."""
+    require(proc_identity(parent['pid']) == parent, 'route_parent_reused')
+    proc = Path('/proc', str(parent['pid']), 'exe')
+    path = tool_paths()['rootlesskit']
+    require(proc.resolve(strict=True) == path, 'route_parent_executable')
+    fd = os.open(proc, os.O_RDONLY | os.O_CLOEXEC)
+    try:
+        before = os.fstat(fd); named = path.stat()
+        key = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+        require(stat.S_ISREG(before.st_mode) and 0 < before.st_size <= 64*1024*1024
+                and key(before) == key(named), 'route_parent_executable_identity')
+        digest = hashlib.sha256(); count = 0
+        while True:
+            block = os.read(fd, 1024*1024)
+            if not block: break
+            count += len(block)
+            require(count <= 64*1024*1024, 'route_parent_executable_size')
+            digest.update(block)
+        require(count == before.st_size and digest.hexdigest() == request['tools']['rootlesskit']
+                and key(before) == key(os.fstat(fd)) == key(proc.stat()) == key(path.stat())
+                and proc.resolve(strict=True) == path and proc_identity(parent['pid']) == parent,
+                'route_parent_executable_drift')
+        return {'path': str(path), 'sha256': digest.hexdigest(), 'file': [before.st_dev, before.st_ino]}
+    finally:
+        os.close(fd)
