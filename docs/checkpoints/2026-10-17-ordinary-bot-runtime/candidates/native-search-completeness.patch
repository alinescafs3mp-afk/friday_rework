+_MAX_DATABASE_BYTES = 16 * 1024 * 1024
+_MAX_MESSAGES = 200
+_MAX_CONTENT_BYTES = 4 * 1024 * 1024
+_MAX_SECONDS = 5.0
+_MAX_VM_STEPS = 500_000
