+    def fetchone(self):
+        return self._call(self._cursor.fetchone)
+
+    def fetchall(self):
+        return self._call(self._cursor.fetchall)
+
+    def fetchmany(self, *args):
+        return self._call(self._cursor.fetchmany, *args)
+
+    def __iter__(self):
+        while (row := self.fetchone()) is not None:
+            yield row
+
+
