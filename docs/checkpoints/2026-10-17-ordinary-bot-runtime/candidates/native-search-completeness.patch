+        # tolerance is useful for display, but cannot establish complete recall.
+        # Validate only rows actually hydrated; visibility/role filters remain
+        # native filters and never become synthetic "decode failures".
+        try:
+            raw = dict(row)
+            content = raw.get('content')
+            if isinstance(content, str) and content.startswith(self._CONTENT_JSON_PREFIX):
+                json.loads(content[len(self._CONTENT_JSON_PREFIX):])
+            if raw.get('tool_calls'):
+                json.loads(raw['tool_calls'])
