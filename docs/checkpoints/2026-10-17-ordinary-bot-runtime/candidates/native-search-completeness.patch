+
+def _sql_shape(sql):
+    return ' '.join(sql.replace('IF NOT EXISTS ', '').split()).rstrip(';')
+
+
+def _schema(conn):
+    expected = {}
+    for ddl in (FTS_SQL, FTS_TRIGRAM_SQL, FTS_CJK_TABLE_SQL):
+        for sql, name in re.findall(r'(CREATE (?:VIRTUAL TABLE|VIEW) IF NOT EXISTS (\w+)\b[^;]+);', ddl):
+            expected[name] = _sql_shape(sql)
+    rows = conn.execute("SELECT type,name,sql FROM sqlite_schema WHERE name IN "
+        "('messages','sessions','messages_fts','messages_fts_src','messages_fts_trigram',"
+        "'messages_fts_trigram_src','messages_fts_cjk','messages_fts_cjk_src') ORDER BY name").fetchall()
+    found = {r[1]: r for r in rows}
+    _require(all(name in found and found[name][0] == 'table' for name in ('messages', 'sessions')),
+             'source_tables_unsupported')
+    cjk = 'messages_fts_cjk' in found
+    _require(cjk == ('messages_fts_cjk_src' in found), 'cjk_schema_incomplete')
+    _require(all(name in found for name in ('messages_fts', 'messages_fts_src')), 'base_index_missing')
+    trigram = 'messages_fts_trigram' in found
+    _require(trigram == ('messages_fts_trigram_src' in found), 'trigram_schema_incomplete')
+    for name, row in found.items():
+        if name in expected:
+            _require(_sql_shape(row[2] or '') == expected[name], 'index_projection_unsupported')
+    return (['messages_fts'] + (['messages_fts_trigram'] if trigram else [])
+            + (['messages_fts_cjk'] if cjk else [])), hashlib.sha256(_canonical([list(r) for r in rows])).hexdigest()
+
+
+class _Budget:
+    def __init__(self):
+        self.started = time.monotonic()
+        self.deadline = self.started + _MAX_SECONDS
+        self.steps = 0
+        self.failed = None
+
+    def check(self):
+        _require(time.monotonic() <= self.deadline, 'time_budget_exceeded')
+        _require(self.failed is None, self.failed or 'query_failed')
+
+    def progress(self):
+        self.steps += 1000
+        if self.steps > _MAX_VM_STEPS or time.monotonic() > self.deadline:
+            self.failed = 'execution_budget_exceeded'
+            return 1
+        return 0
