+    def execute(self, *args):
+        self._budget.check()
+        try:
+            cursor = self._conn.execute(*args)
+        except Exception:
+            self._budget.failed = self._budget.failed or 'query_failed'
+            raise
+        self._budget.check()
+        return _CheckedCursor(cursor, self._budget)
