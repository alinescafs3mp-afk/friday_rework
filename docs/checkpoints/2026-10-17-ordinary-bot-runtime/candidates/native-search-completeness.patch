+        except Exception:
+            self._budget.failed = self._budget.failed or 'discovery_data_failed'
+            raise
+
+    def flush_token_counts(self, *args, **kwargs):
+        return True  # No source writer or deferred queue exists on this snapshot.
+
+    def _enter_fts_fail_open(self, *args, **kwargs):
+        self._budget.failed = 'query_failed'
+        raise SnapshotUnsupported('query_failed')
+
+    def _execute_write(self, *args, **kwargs):
+        self._budget.failed = 'snapshot_write_refused'
+        raise SnapshotUnsupported('snapshot_write_refused')
+
+    def close(self):
+        pass  # Owning context closes the sole source or RAM connection.
+
+    def __del__(self):
+        pass
