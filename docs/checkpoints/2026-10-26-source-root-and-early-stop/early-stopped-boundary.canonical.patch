+def _early_stopped_boundary(request, budget, home):
+    # Refusal only: authenticate the receiving principal before touching the
+    # existing A0 slot. Full source/config/admission and native custody remain
+    # at their original boundaries; this releases its slot before history.
+    from scripts import friday_install as f
+    fields = {'schema', 'request_id', 'seconds', 'home', 'profile', 'source',
+        'previous_input', 'current_input', 'native_unit', 'before', 'retained', 'launcher_before'}
+    if _registered(request):
+        fields |= {'predecessor','once_grant','original_clock','source_update_ancestry'}
+    if _both_profiles(request): fields.add('previous_source_successor')
+    require(set(request) == fields and request['schema'] in
+        (APPLY_SCHEMA,REGISTERED_SCHEMA,EMBEDDING_REGISTERED_SCHEMA,SERVICE_REGISTERED_SCHEMA)
+        and type(request['request_id']) is str
+        and re.fullmatch(r'[A-Za-z0-9_-]{1,64}',request['request_id'])
+        and type(request['profile']) is str
+        and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,63}',request['profile'])
+        and request['profile'] != 'default', 'worker_declaration_exact_apply_request_required')
+    require(os.environ.get('HERMES_HOME') == str(home),
