+ATTESTER_FAILURE_SCHEMA = 'friday.a0.preexec-failure.v1'
+ATTESTER_FAILURE_PHASES = ('parent_wait', 'host_identity', 'endpoint', 'ready',
+                           'accept', 'peer', 'receive', 'verify', 'challenge', 'send')
+ATTESTER_FAILURE_CLASSES = (RuntimeError, TimeoutError, OSError, ValueError,
+                            TypeError, KeyError, PermissionError, FileNotFoundError)
+
+
+def attester_failure_record(context, stage, phase, exc):
+    """Fixed labels and validated digests only; cleanup has not been observed."""
+    request_digest = context.get('request_sha256')
+    require(type(request_digest) is str and re.fullmatch('[0-9a-f]{64}', request_digest),
+            'route_attester_failure_request')
+    digest = hashlib.sha256(canonical(context).encode()).hexdigest()
+    return {'schema': ATTESTER_FAILURE_SCHEMA, 'request_sha256': request_digest,
+            'context_sha256': digest,
+            'stage': stage if type(stage) is str and stage in ('startup', 'before_policy', 'after_policy') else 'UNKNOWN',
+            'phase': phase if type(phase) is str and phase in ATTESTER_FAILURE_PHASES else 'UNKNOWN',
+            'exception_class': type(exc).__name__ if any(type(exc) is kind for kind in ATTESTER_FAILURE_CLASSES) else 'UNKNOWN',
+            'cleanup': 'UNKNOWN'}
+
+
+def attester_failure_checked(value, context, stage):
+    require(type(context.get('attester_failure_diagnostics')) is str
+            and context['attester_failure_diagnostics'] == ATTESTER_FAILURE_SCHEMA
+            and type(value) is dict and all(type(k) is str for k in value)
+            and all(type(v) is str for v in value.values())
+            and type(stage) is str and stage in ('startup', 'before_policy', 'after_policy')
+            and set(value) == {'schema', 'request_sha256', 'context_sha256',
+                'stage', 'phase', 'exception_class', 'cleanup'}
+            and value['schema'] == ATTESTER_FAILURE_SCHEMA
+            and type(value['request_sha256']) is str and re.fullmatch('[0-9a-f]{64}', value['request_sha256'])
+            and value['request_sha256'] == context['request_sha256']
+            and value['context_sha256'] == hashlib.sha256(canonical(context).encode()).hexdigest()
+            and value['stage'] == stage
+            and value['phase'] in (*ATTESTER_FAILURE_PHASES, 'UNKNOWN')
+            and value['exception_class'] in (*[x.__name__ for x in ATTESTER_FAILURE_CLASSES], 'UNKNOWN')
+            and value['cleanup'] == 'UNKNOWN', 'route_attester_failure_shape')
+    return dict(value)
+
+
+def attester_failure_raise(value, context, stage):
+    diagnostic = attester_failure_checked(value, context, stage)
+    exc = RuntimeError('route_attester_failed')
+    exc._frw_attester_diagnostic = diagnostic
+    raise exc
+
+
+def attester_failure_transport(exc, context, stage, reason):
+    diagnostic = attester_failure_record(context, stage, 'UNKNOWN', Exception())
+    diagnostic['transport'] = reason
+    exc._frw_attester_diagnostic = diagnostic
+
+
+def attester_failure_send(context, stage, phase, exc, deadline, ready, connection):
+    """One nonblocking best-effort write, under the original deadline."""
+    try:
+        if (type(context.get('attester_failure_diagnostics')) is not str
+                or context['attester_failure_diagnostics'] != ATTESTER_FAILURE_SCHEMA):
+            return
+        attester_remaining(deadline)
+        data = canonical(attester_failure_record(context, stage, phase, exc)).encode()
+        require(len(data) <= 1024, 'route_attester_failure_size')
+        attester_remaining(deadline)
+        if ready >= 0:
+            os.set_blocking(ready, False)
+            os.write(ready, data)
+        elif connection is not None:
+            connection.setblocking(False)
+            connection.send(data, socket.MSG_DONTWAIT | socket.MSG_NOSIGNAL)
+    except BaseException:
+        pass  # Reporting never replaces the failure or its original cleanup.
 
 
