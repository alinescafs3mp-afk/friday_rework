+def _schedule_snapshot_readonly(path, normalize):
+    """Bounded observation; no cron repair, lock creation, chmod or execution DB.
+
+    The caller supplies the native current store and its existing pure normalizer.
+    A missing store is an observed empty store, never a repair instruction.
+    Refuse corrupt or changing input instead of presenting it as an empty list.
+    """
+    import json, math
+    limit = 8 * 1024 * 1024
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    except FileNotFoundError:
+        # Recheck absence: a concurrent appearance is not an empty snapshot.
+        if os.path.lexists(path):
+            raise RuntimeError("native_schedule_changed_during_read")
+        return []
+    try:
+        before = os.fstat(fd)
+        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > limit:
+            raise ValueError("regular_bounded_native_schedule_required")
+        with os.fdopen(fd, 'rb', closefd=False) as stream:
+            raw = stream.read(limit + 1)
+        after = os.fstat(fd)
+        witness = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+        named = os.stat(path, follow_symlinks=False)
+        if len(raw) > limit or witness(before) != witness(after) or witness(after) != witness(named):
+            raise RuntimeError("native_schedule_changed_during_read")
+    finally:
+        os.close(fd)
+    # Strict JSON: malformed data is refused, never silently repaired or dropped.
+    def pairs(items):
+        value = {}
+        for key, item in items:
+            if key in value:
+                raise ValueError("duplicate_native_schedule_key")
+            value[key] = item
+        return value
+    def reject_constant(value):
+        raise ValueError("nonfinite_native_schedule_value")
+    def finite_float(value):
+        parsed = float(value)
+        if not math.isfinite(parsed):
+            raise ValueError("nonfinite_native_schedule_value")
+        return parsed
+    value = json.loads(raw.decode('utf-8-sig'), object_pairs_hook=pairs,
+                       parse_constant=reject_constant, parse_float=finite_float)
+    rows = value.get('jobs') if isinstance(value, dict) else value
+    if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
+        raise ValueError("native_schedule_store_unreadable")
+    ids = [row.get('id') for row in rows]
+    if any(not isinstance(key, str) or not key for key in ids) or len(ids) != len(set(ids)):
+        raise ValueError("unique_native_schedule_ids_required")
+    return [{key: row.get(key) for key in ('id', 'name', 'schedule', 'enabled', 'state', 'next_run_at', 'paused_reason')}
+            for row in (normalize(copy.deepcopy(row)) for row in rows[:200])]
+
