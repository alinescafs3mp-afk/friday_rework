+            # nft omits explicit protocol guards already implied by typed
+            # payload expressions. Restore only those logical consequences;
+            # never discard or overwrite any explicit (including wrong) guard.
+            payloads = [e['match']['left']['payload'] for e in normalized
+                        if type(e) is dict and set(e) == {'match'}
+                        and type(e['match']) is dict
+                        and type(e['match'].get('left')) is dict
+                        and set(e['match']['left']) == {'payload'}
+                        and type(e['match']['left']['payload']) is dict
+                        and set(e['match']['left']['payload']) == {'protocol', 'field'}]
+            meta_keys = [e['match']['left']['meta'].get('key') for e in normalized
+                         if type(e) is dict and set(e) == {'match'}
+                         and type(e['match']) is dict
+                         and type(e['match'].get('left')) is dict
+                         and set(e['match']['left']) == {'meta'}
+                         and type(e['match']['left']['meta']) is dict]
+            implied = []
