+def _read_current_nft_ct_receipt(home, reference, expected):
+    """Read only the owned published NFT receipt; grants stay strictly 0600."""
+    expected_home = _absolute(R399_SOURCE_SUCCESSOR['path']).parents[2]
+    require(_absolute(str(home)) == expected_home
+        and type(reference) is dict and set(reference) == {'path','sha256'}
+        and type(expected) is dict,
+        'worker_nft_ct_receipt_exact_home_reference_required')
+    path = _absolute(reference['path'])
+    require(re.fullmatch(re.escape(str(expected_home)) +
+        r'/preparation/worker-declarations-successor-[0-9a-f]{64}/service-source-receipt\.json', str(path))
+        and type(reference['sha256']) is str
+        and re.fullmatch('[0-9a-f]{64}', reference['sha256'])
+        and reference['sha256'] != '0' * 64,
+        'worker_nft_ct_receipt_exact_published_path_required')
+    def identity(info):
+        return tuple(getattr(info, 'st_'+key) for key in
+            ('dev','ino','mode','uid','gid','nlink','size','mtime_ns','ctime_ns'))
+    def pairs(rows):
+        result = {}
+        for key, value in rows:
+            require(key not in result, 'worker_nft_ct_receipt_duplicate_json_key')
+            result[key] = value
+        return result
+    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
+    limit = 32 * 1024 * 1024
+    uid = os.getuid()
+    with contextlib.ExitStack() as stack:
+        parent = os.open('/', flags | os.O_DIRECTORY)
+        stack.callback(os.close, parent)
+        root = os.fstat(parent)
+        require(stat.S_ISDIR(root.st_mode) and root.st_uid in (0,uid)
+            and not stat.S_IMODE(root.st_mode) & 0o022,
+            'worker_nft_ct_receipt_protected_root_required')
+        directories = [(None, '/', parent, root)]
+        protected = root.st_uid == uid and stat.S_IMODE(root.st_mode) == 0o700
+        for index, part in enumerate(path.parts[1:-1], 1):
+            named = os.stat(part, dir_fd=parent, follow_symlinks=False)
+            child = os.open(part, flags | os.O_DIRECTORY, dir_fd=parent)
+            stack.callback(os.close, child)
+            info = os.fstat(child)
+            require(identity(info) == identity(named) and stat.S_ISDIR(info.st_mode)
+                and info.st_uid in (0,uid)
+                and (protected or not stat.S_IMODE(info.st_mode) & 0o022),
+                'worker_nft_ct_receipt_owned_directory_required')
+            if index >= len(expected_home.parts) - 1:
+                require(info.st_uid == uid and stat.S_IMODE(info.st_mode) == 0o700,
+                    'worker_nft_ct_receipt_private_publication_directory_required')
+            protected = protected or (info.st_uid == uid and stat.S_IMODE(info.st_mode) == 0o700)
+            directories.append((parent, part, child, info))
+            parent = child
+        named = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
+        fd = os.open(path.name, flags, dir_fd=parent)
+        stack.callback(os.close, fd)
+        before = os.fstat(fd)
+        require(identity(before) == identity(named) and stat.S_ISREG(before.st_mode)
+            and before.st_uid == uid and before.st_nlink == 1
+            and stat.S_IMODE(before.st_mode) in (0o400,0o600)
+            and 0 < before.st_size <= limit,
+            'worker_nft_ct_receipt_owned_private_regular_file_required')
+        chunks = []
+        size = 0
+        while True:
+            chunk = os.read(fd, min(1024 * 1024, limit + 1 - size))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            size += len(chunk)
+            require(size <= limit, 'worker_nft_ct_receipt_too_large')
+        raw = b''.join(chunks)
+        require(size == before.st_size and hashlib.sha256(raw).hexdigest() == reference['sha256'],
+            'worker_nft_ct_receipt_digest_changed')
+        value = json.loads(raw, object_pairs_hook=pairs,
+            parse_constant=lambda _: (_ for _ in ()).throw(
+                DeclarationError('worker_nft_ct_receipt_nonfinite_json')))
+        require(type(value) is dict and _same(value, expected),
+            'worker_nft_ct_receipt_checked_content_changed')
+        require(identity(before) == identity(os.fstat(fd)) ==
+            identity(os.stat(path.name, dir_fd=parent, follow_symlinks=False)),
+            'worker_nft_ct_receipt_file_identity_changed')
+        for parent_fd, name, directory_fd, first in reversed(directories):
+            named = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
+            require(identity(first) == identity(os.fstat(directory_fd)) == identity(named),
+                'worker_nft_ct_receipt_directory_identity_changed')
+        return value
+
