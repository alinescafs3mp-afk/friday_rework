      "expired_partial_state_exception": false,
      "gate_depth": 1,
      "line": 722,
      "prefix_text": "{\n u32 i,nt=0,nf=0,nb=0; int rc;\n /* This remains a retired-only transfer, distinct from whole-epoch close.\n  * Its one externally precharged batch must stay alive until native disposal. */\n rc=frwk_admission_locked(e); if (rc) return rc;\n if (!frwk_original_custody_locked(e) || !frwk_hold_layout_locked(e) ||\n     !frwk_batch_empty(b) || b==&e->final_refs || e->retired_batch) return -EUCLEAN;\n if (ktime_get_ns()>=e->final_ns) return -ETIME;\n if (frwk_source_disposal_lifetime!=FRWK_REQUIRED) return -EOPNOTSUPP;",
