      "line": 891,
      "prefix_text": "{\n unsigned long flags;u32 i,nt,nb,nf;enum frwk_batch_kind kind;int rc;\n if (!e || !b) return -EINVAL;\n /* The still-missing native custodian must hold original epoch/batch memory\n  * alive and supply real sleepable, exclusive lifetime. Context predicates\n  * reject atomic callers; they do not manufacture that missing qualification. */\n if (in_atomic() || irqs_disabled()) return -EWOULDBLOCK;\n raw_spin_lock_irqsave(&e->lock,flags);\n if (!frwk_bounds_locked(e) || !frwk_batch_bound_locked(e,b)) {rc=-ESTALE;goto unlock;}\n if (b->state!=FRWK_BATCH_READY) {rc=-EALREADY;goto unlock;}\n if (!frwk_batch_layout(b) || b->put_inflight || b->tasks_i || b->tables_i ||\n     b->files_i || b->owner_issued || b->scope_issued) {rc=-EUCLEAN;goto unlock;}\n if (ktime_get_ns()>=b->final_ns) {rc=frwk_partial_locked(e,b,-ETIME);goto unlock;}\n if (frwk_source_disposal_lifetime!=FRWK_REQUIRED) {rc=-EOPNOTSUPP;goto unlock;}",
      "refusal": "EOPNOTSUPP"
    },
    "frwk_take_epoch_refs_locked": {
      "actual_lifetime_constant": 0,
      "body_byte_offset": 829,
      "custody_mutations_before_gate": 0,
      "expired_partial_state_exception": true,
      "gate_depth": 1,
      "line": 784,
      "prefix_text": "{\n struct frwk_reference_batch *b;u32 i,nt=0,nb=0,nf=0;\n if (!e) return -EINVAL;\n if (e->close_state!=FRWK_EPOCH_CLOSING) return -EALREADY;\n if (!e->close_final_ns || e->close_hi!=e->hi || e->close_lo!=e->lo ||\n     e->close_final_ns!=e->final_ns || !frwk_original_custody_locked(e) ||\n     !frwk_hold_layout_locked(e)) return -EUCLEAN;\n b=&e->final_refs;\n if (!frwk_batch_empty(b) || e->retired_batch) return -EBUSY;\n if (ktime_get_ns()>=e->close_final_ns) {\n  e->close_state=FRWK_EPOCH_PARTIAL;return -ETIME;\n }\n /* This actual absent native precondition is fail-closed, not a fabricated\n  * detach fence. The bounded transfer below is a Source facility, UNATTACHED.\n  * A lost epoch is not required to regain coverage/current/scope permission.\n  * Real hook exclusion and original epoch memory lifetime are still missing. */\n if (frwk_source_disposal_lifetime!=FRWK_REQUIRED) return -EOPNOTSUPP;",
