+            # cannot complete; never refetch or leak a foreign exception body.
+            raise KeylessMCPError("keyless text bound") from None
+    if time.monotonic() >= deadline:
+        raise KeylessMCPError("keyless timeout")
+    if not isinstance(text, str) or len(text) > 15000:
+        raise KeylessMCPError("keyless text bound")
+    return text
