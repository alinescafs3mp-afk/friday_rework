+
+import json
+import re
+import time
+
+
+def validate_arguments(tool, arguments, KeylessMCPError):
+    if tool not in ("web_search_exa", "web_fetch_exa"):
+        raise KeylessMCPError("keyless tool refused")
+    if not isinstance(arguments, dict): raise KeylessMCPError("keyless arguments refused")
+    if tool == 'web_search_exa':
+        if (set(arguments) != {'query','numResults'} or not isinstance(arguments['query'], str)
+                or not 1 <= len(arguments['query']) <= 4096
+                or type(arguments['numResults']) is not int or not 1 <= arguments['numResults'] <= 20):
+            raise KeylessMCPError("keyless search bounds refused")
+    else:
+        from urllib.parse import urlsplit
+        import ipaddress
+        urls = arguments.get('urls')
+        if set(arguments) != {'urls'} or not isinstance(urls,list) or len(urls) != 1:
+            raise KeylessMCPError("keyless fetch bounds refused")
+        url_value = urls[0]
+        if not isinstance(url_value,str) or len(url_value)>2048: raise KeylessMCPError("keyless URL refused")
+        u = urlsplit(url_value)
+        try: ipaddress.ip_address(u.hostname or '')
+        except ValueError: pass
+        else: raise KeylessMCPError("keyless IP URL refused")
+        if (u.scheme != 'https' or u.username or u.password or u.port or u.fragment
+                or not u.hostname or '.' not in u.hostname or u.hostname.endswith(('.local','.internal'))
+                or any(ord(c)<=32 for c in url_value) or '\\' in url_value):
+            raise KeylessMCPError("keyless URL refused")
+
