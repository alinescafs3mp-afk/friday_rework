+    if response.headers.get('Content-Encoding','identity') != 'identity':
+        raise KeylessMCPError('keyless encoding refused')
+    if int(response.headers.get('Content-Length', '0')) > 1000000:
+        raise KeylessMCPError("keyless response bound")
+    # The pinned requests/urllib3 native socket is re-bounded to the
+    # remaining whole call time before every bounded read. Refuse
+    # an unsupported transport instead of reading without a bound.
+    sock = response.raw._fp.fp.raw._sock
+    parts = []; size = 0
+    while True:
+        left = deadline - time.monotonic()
+        if left <= 0: raise KeylessMCPError("keyless timeout")
