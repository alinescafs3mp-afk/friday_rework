+    # result before returning bytes to the provider/model pipeline. No raw large
+    # string is released to an ordinary caller of this transport.
+    if time.monotonic() >= deadline:
+        raise KeylessMCPError("keyless timeout")
+    if text_handler is not None:
+        try:
+            text = text_handler(text, deadline)
+        except Exception:
