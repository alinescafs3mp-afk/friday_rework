+def _worker_preparation_location(root, home, binding, generation, checked, *, current_main):
+    """Separate an authenticated fresh secondary from same-owner replacement.
+
+    The native caller supplies current admission; the pinned source bundle must
+    independently name this exact secondary binding and generation. The existing
+    transaction formula is retained, including any consumed or partial attempt.
+    """
+    from .worker_declarations import _read_reference, load_declaration_source
+    identity = _read_reference(checked['receipt']['source']['identity'])
+    if (identity.get('binding') == binding or identity.get('profile') == str(home)
+            or current_main is None):
+        return _worker_successor_location(root, home, binding, generation, checked)[0], False
+    bundle, _, verified_identity = load_declaration_source(checked['receipt']['source'])
+    if verified_identity != identity:
+        raise PermissionError('worker_successor_source_identity_changed')
+    secondary = bundle.get('secondary_profile')
+    expected = {'home': str(home), 'profile': binding['runtime_profile'],
+        'binding_sha256': scope._fingerprint(binding)}
+    if (current_main != expected or home != root / 'profiles' / binding['runtime_profile']
+            or type(secondary) is not dict or secondary.get('binding') != binding
+            or type(generation) is not int or type(secondary.get('generation')) is not int
+            or secondary['generation'] != generation or generation <= 0
+            or any(type(secondary.get(key)) is not dict
+                or secondary[key].get('path') != str(home / name)
+                for key, name in (('configuration', 'config.yaml'),
+                    ('onboarding', scope.ONBOARDING), ('user_marker', scope.MARKER)))):
+        raise PermissionError('worker_successor_exact_fresh_secondary_required')
+    old = identity['source_refs']['stale_attachment']
+    key = scope._fingerprint({'attachment': old, 'current_input': checked['receipt']['current_input'],
+        'binding': binding, 'generation': generation})
+    parent = root / 'preparation'; scope._private(parent, directory=True)
+    return parent / ('ordinary-worker-preparation-' + key), True
+
