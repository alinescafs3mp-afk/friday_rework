+def dashboard_environment(home, contract, values=None):
+    """Keep only the declared installed SPA for the exact native no-build start.
+
+    This is deployment data after ordinary source/configuration admission, not
+    a credential or another command's authority. Native Dashboard ownership,
+    authentication, TLS and frontend validation still run in their normal path.
+    """
+    args = list(sys.argv[1:])
+    if args[:1] in (['-p'], ['--profile']):
+        require(args[1:2] == ['default'], 'foreign_profile')
+        args = args[2:]
+    dash = contract['native_dashboard']
+    if args != ['dashboard','--host',dash['host'],'--port',str(dash['port']),
+                '--no-open','--skip-build']:
+        return frozenset()
+    from hermes_cli.friday_dashboard_owner import SOURCE, read_owned
+    require(Path(home) == SOURCE.parent and Path(home).resolve() == Path(home),
+            'authorization_home_required')
+    dist = SOURCE/'hermes_cli/web_dist'
+    require(os.environ.get('HERMES_WEB_DIST') == str(dist)
+            and dist.resolve() == dist and dist.is_dir(),
+            'dashboard_installed_web_dist_required')
+    read_owned(dist/'index.html')  # No symlink/foreign file and no recovery build.
+    require(values is None or 'HERMES_WEB_DIST' not in values,
+            'dashboard_web_dist_not_credential')
+    return frozenset(('HERMES_WEB_DIST',))
+
+
