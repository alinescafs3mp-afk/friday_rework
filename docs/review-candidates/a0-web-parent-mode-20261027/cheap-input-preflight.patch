+def _apply_inputs_structure(request):
+    """Reject impossible request data before any input/history file is read.
+
+    This is only a necessary structural check, never custody or admission.
+    The complete dynamic inventories, physical pins/absence, history, locks
+    and current authority/CAS checks still run at their original boundaries.
+    """
+    def reference(ref, error, *, source=False):
+        require(type(ref) is dict and set(ref) == {'path', 'sha256'}, error)
+        path = _absolute(ref['path'])
+        require(type(ref['sha256']) is str
+            and re.fullmatch('[0-9a-f]{64}', ref['sha256'])
+            and (not source or ref['sha256'] != '0' * 64),
+            'worker_declaration_exact_digest_required' if source else error)
+        return path
+
+    def relative(name):
+        require(type(name) is str, 'worker_declaration_retained_relative_path_required')
+        path = Path(name)
+        require(not path.is_absolute() and path.parts
+            and all(p not in ('.', '..') for p in path.parts)
+            and str(path) == name and not any(ord(c) < 32 for c in name),
+            'worker_declaration_retained_relative_path_required')
+
+    home = _absolute(request['home'])
+    prefix = 'profiles/' + request['profile'] + '/'
+    for key in ('previous_input', 'current_input', 'native_unit', 'launcher_before'):
+        reference(request[key], 'worker_declaration_exact_reference_required')
+    source = request['source']
+    require(type(source) is dict and set(source) == {'bundle', 'worker_inputs', 'identity'},
+        'worker_declaration_exact_source_companion_required')
+    for ref in source.values():
+        reference(ref, 'worker_declaration_exact_reference_required', source=True)
+    if _registered(request):
+        for key in ('once_grant', 'original_clock'):
+            reference(request[key], 'worker_declaration_exact_reference_required')
+    if _both_profiles(request):
+        reference(request['previous_source_successor'], 'worker_declaration_exact_reference_required')
+    before = request['before']
+    names = {'config.yaml', 'FRIDAY-INSTALL.json', STAGED_LAUNCHER,
+        prefix+'config.yaml', prefix+'.friday-onboarding.json', prefix+'.friday-user-scope.json'}
+    if _service(request): names.add(SERVICE_RUNTIME)
+    if _web_probe_service(request): names.add(SERVICE_WEB)
+    if _both_profiles(request):
+        names.update('profiles/'+SECONDARY_PROFILE+'/'+n
+            for n in ('config.yaml', '.friday-onboarding.json', '.friday-user-scope.json'))
+    require(type(before) is dict and names <= set(before),
+        'worker_declaration_exact_publication_inventory_required')
+    for name, ref in before.items():
+        relative(name)
+        if name == SERVICE_MEMORY:
+            require(ref is None, 'worker_declaration_memory_source_must_be_absent')
+        else:
+            require(reference(ref, 'worker_declaration_exact_private_beforeimage_required') == home/name,
+                'worker_declaration_exact_private_beforeimage_required')
+    retained = request['retained']
+    required = {'FRIDAY-PROFILE.json', 'hermes-agent.source.json', 'hermes-agent/install-stamp.json',
+        'hermes-agent/.hermes/bin/hermes', 'SOUL.md', prefix+'SOUL.md', '.env', prefix+'.env',
+        'auth.json', prefix+'auth.json', prefix+'workers/attachment.json', prefix+'workers/current.json',
+        *SERVICE_ATTEMPTS}
+    absent = {'auth.json', prefix+'auth.json', prefix+'workers/attachment.json',
+        prefix+'workers/current.json', *SERVICE_ATTEMPTS}
+    if _both_profiles(request):
+        required.update('profiles/'+SECONDARY_PROFILE+'/'+n for n in
+            ('SOUL.md', '.env', 'auth.json', 'workers/attachment.json', 'workers/current.json', 'gateway.pid'))
+        absent.update('profiles/'+SECONDARY_PROFILE+'/'+n for n in
+            ('auth.json', 'workers/attachment.json', 'workers/current.json', 'gateway.pid'))
+    require(type(retained) is dict and required <= set(retained) and not set(retained) & set(before),
+        'worker_declaration_retained_native_inventory_required')
+    for name, ref in retained.items():
+        relative(name)
+        if ref is None:
+            require(name in absent or _parent_mode_database_sidecar_absence(request, name),
+                'worker_declaration_retained_absence_changed')
+        else:
+            require(reference(ref, 'worker_declaration_retained_pin_changed') == home/name,
+                'worker_declaration_retained_pin_changed')
+
