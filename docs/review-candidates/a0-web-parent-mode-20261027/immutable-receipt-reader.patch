+def _r481_native_immutable_ref(ref):
+    """Only the two current bound native transaction receipts may be 0400."""
+    binding = R469_QUALIFICATION_BINDING
+    if type(binding) is not dict:
+        return False
+    receipt = binding.get('service_receipt'); committed = binding.get('service_commit')
+    if not all(type(pin) is dict and set(pin) == {'path','sha256'}
+               and type(pin['path']) is str for pin in (receipt, committed)):
+        return False
+    transaction = Path(receipt['path']).parent
+    prefix = 'worker-declarations-successor-'
+    suffix = transaction.name.removeprefix(prefix)
+    return (ref in (receipt, committed)
+            and transaction.parent == NATIVE_HOME/'preparation'
+            and transaction.name.startswith(prefix) and len(suffix) == 64
+            and all(c in '0123456789abcdef' for c in suffix)
+            and receipt['path'] == str(transaction/'service-source-receipt.json')
+            and committed['path'] == str(transaction/'committed.json'))
+
+
