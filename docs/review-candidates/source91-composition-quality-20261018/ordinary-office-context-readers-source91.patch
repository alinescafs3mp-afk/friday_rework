+def main():
+    # The parent supplies its selected installed package location, never a user
+    # document path. -I prevents ambient PYTHONPATH/CWD injection in this child.
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    resource.setrlimit(resource.RLIMIT_CPU, (3, 3))
