+"""Catalog endpoint probing with retained admission and timeout guards."""
+from __future__ import annotations
+from typing import Any, Optional, TypeGuard
+
+def _origin():
+    from hermes_cli import models
+    return models
+
+def _probe_neg_key(base_url: str) -> Optional[str]:
+    """``host:port`` for *base_url* (both URL candidates share one entry), or None without a host."""
+    from utils import base_url_origin
+
+    _, host, port = base_url_origin(base_url)
+    return f"{host}:{port}" if host else None
+
+
+def _probe_result(
+    models, probed_url, resolved_base_url, suggested_base_url=None, used_fallback=False
+) -> dict[str, Any]:
+    return {
+        "models": models,
+        "probed_url": probed_url,
+        "resolved_base_url": resolved_base_url,
+        "suggested_base_url": suggested_base_url,
+        "used_fallback": used_fallback}
+
+
+def probe_api_models(
+    api_key: Optional[str], base_url: Optional[str], timeout: float = 5.0,
+    api_mode: Optional[str] = None, request_headers: Optional[dict[str, str]] = None,
+) -> dict[str, Any]:
+    """Probe a ``/models`` endpoint with light URL heuristics (``base`` then ``base±/v1``).
+    ``anthropic_messages`` mode sends ``x-api-key`` + ``anthropic-version`` instead of a bearer; the
+    ``data[].id`` response shape is identical. ``models`` is None when no candidate answered."""
+    from hermes_cli.model_switch_providers import _picker_scope
+    _picker_scope()
+    cap = _picker_scope()
+    authority = _origin()._model_catalog_authority_guard(base_url, api_key)
+    def result(*args):
+        value = _origin()._probe_result(*args)
+        if authority is not None:
+            authority()
+        return value
+    if cap is not None:
+        from hermes_cli.friday_credential_admission import route_inputs, extensions
+        route_inputs(base_url=base_url, api_key=api_key)
+        extensions(request_headers)
+    normalized = (base_url or "").strip().rstrip("/")
+    if not normalized:
+        return result(None, None, "")
+    if _origin()._is_github_models_base_url(normalized):
+        models = _origin()._fetch_github_models(api_key=api_key, timeout=timeout)
+        return result(models, _origin().COPILOT_MODELS_URL, _origin().COPILOT_BASE_URL)
+
+    # Managed admission is for the configured catalog only. Legacy heuristics
+    # must never turn a local timeout into an unadmitted alternate-path effect.
+    alternate_base, candidates = _probe_candidates(normalized, cap is not None)
+
+    tried: list[str] = []
+    _neg_key = _origin()._probe_neg_key(normalized)
+    if _neg_key is not None:
+        _neg_seen = _origin()._probe_neg_cache.get(_neg_key)
+        if _neg_seen is not None and (_origin().time.monotonic() - _neg_seen) < _origin()._PROBE_NEG_TTL:
+            return result(
+                None, normalized.rstrip("/") + "/models", normalized,
+                alternate_base if alternate_base != normalized else None)
+    headers = _probe_headers(normalized, api_key, api_mode, request_headers)
+
+    # Only thread ssl_context when a per-provider TLS override applies; public endpoints keep the
+    # original 2-arg call so existing call-seam mocks stay valid.
+    request_guard, _open_kwargs = _probe_transport_options(normalized, base_url, api_key, headers, authority)
+    all_timed_out = True
+    for candidate_base, is_fallback in candidates:
+        _picker_scope()
+        url = candidate_base.rstrip("/") + "/models"
+        tried.append(url)
+        try:
+            data = _origin()._get_json(url, timeout=timeout, headers=headers, **_open_kwargs)
+        except Exception as exc:
+            if request_guard is not None:
+                request_guard()
+                from hermes_cli.friday_user_scope import ScopeDenied
+                from hermes_cli.friday_credential_admission import CredentialDenied
+                if isinstance(exc, (ScopeDenied, CredentialDenied)):
+                    raise
+            # TLS, authentication and parsing failures must not hide corrected settings.
+            cause = exc.reason if isinstance(exc, _origin().urllib.error.URLError) else exc
+            all_timed_out = all_timed_out and isinstance(cause, TimeoutError)
+            continue
+        _picker_scope()
+        if request_guard is not None:
+            request_guard()
+        if _neg_key is not None:
+            _origin()._probe_neg_cache.pop(_neg_key, None)
+        from hermes_cli.chat_catalog import note_catalog_item
+
+        probed = []
+        for item in data.get("data", []):
+            observed = isinstance(item, dict) and note_catalog_item(item)
+            if authority is not None:
+                authority()
+            if not observed:
+                probed.append(item.get("id", ""))
+                if authority is not None:
+                    authority()
+        return result(
+            probed, url, candidate_base.rstrip("/"),
+            alternate_base if alternate_base != candidate_base else normalized, is_fallback)
+
+    if request_guard is not None:
+        request_guard()
+    if _neg_key is not None and all_timed_out:
+        _origin()._probe_neg_cache[_neg_key] = _origin().time.monotonic()
+    return result(
+        None, tried[0] if tried else normalized.rstrip("/") + "/models", normalized,
+        alternate_base if alternate_base != normalized else None)
+
+
+def _probe_headers(normalized, api_key, api_mode, request_headers):
+    headers: dict[str, str] = {"User-Agent": _origin()._HERMES_USER_AGENT}
+    if _origin().urllib.parse.urlparse(normalized).hostname == "generativelanguage.googleapis.com":
+        headers["X-Goog-Api-Client"] = f"hermes-agent/{_origin().get_version_info().base_version}"
+    if api_key and api_mode == "anthropic_messages":
+        headers["x-api-key"] = api_key
+        headers["anthropic-version"] = "2023-06-01"
+    elif api_key:
+        headers["Authorization"] = f"Bearer {api_key}"
+    if normalized.startswith(_origin().COPILOT_BASE_URL):
+        headers.update(_origin().copilot_default_headers())
+    if isinstance(request_headers, dict):
+        # Per-provider custom headers can contain secrets: merge last so endpoint config wins; never log.
+        from hermes_cli.config import normalize_extra_headers
+
+        headers.update(normalize_extra_headers(request_headers))
+    return headers
+
+def _probe_candidates(normalized, managed):
+    alternate_base = None if managed else (normalized[:-3].rstrip("/") if normalized.endswith("/v1") else normalized + "/v1")
+    candidates: list[tuple[str, bool]] = [(normalized, False)]
+    if alternate_base and alternate_base != normalized:
+        candidates.append((alternate_base, True))
+    return alternate_base, candidates
+
+def _probe_transport_options(normalized, base_url, api_key, headers, authority):
+    _open_kwargs: dict[str, Any] = {}
+    if authority is not None:
+        authority()
+    request_guard = _origin()._model_catalog_request_guard(base_url, api_key, headers)
+    _ssl_context = _origin()._custom_provider_ssl_context(normalized)
+    if _ssl_context is not None:
+        _open_kwargs["ssl_context"] = _ssl_context
+    if request_guard is not None:
+        _open_kwargs["request_guard"] = request_guard
+    return request_guard, _open_kwargs
