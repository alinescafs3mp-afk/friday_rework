+def _complete_request_already_fits(self, canonical_messages, telemetry):
+    """Probe the already protected request without changing summary allocation."""
+    if hasattr(self, "_bounded_protected_rows"):
+        from agent.bounded_context import BoundedContextError
+        fit = getattr(self, "_bounded_summary_fit_callback", None)
+        if callable(fit):
