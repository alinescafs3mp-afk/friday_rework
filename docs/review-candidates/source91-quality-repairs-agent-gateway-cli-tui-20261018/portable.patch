+"""Admission of an existing native CLI child before ordinary startup effects."""
+import os
+import sys
+
+
+def try_native_entrypoint():
+    """Return ownership plus its result; an expired adopted child must never fall through."""
+    if os.name != "posix":
+        return False, None
+    from hermes_cli.friday_cli_binding import current_binding, BindingUnbound
+    try:
+        current_binding()
+    except BindingUnbound:
+        module = sys.modules.get("hermes_cli.friday_cli_entrypoint")
+        if module is not None and module.current_child() is not None:
+            raise
+    else:
+        from hermes_cli.friday_cli_entrypoint import current_child, own_existing_entrypoint
+        if current_child() is None:
+            return True, own_existing_entrypoint()
+    return False, None
