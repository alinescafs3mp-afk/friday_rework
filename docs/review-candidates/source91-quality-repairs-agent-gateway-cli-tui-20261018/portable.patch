+"""Current product and installed pairing intersection, before native grants."""
+from __future__ import annotations
+
+
+def native_product_authorized(runner, source):
+    # Product admission is an intersection, before every native grant (including
+    # trusted/role/group/wildcard grants). Read current native state, not a cache.
+    from hermes_cli.friday_product_access import gateway_allowed
+    from gateway.session_identity import identity_of
+    identity = identity_of(source)
+    if identity is not None:
+        transport_profile = identity.transport_profile
+        runtime_profile = identity.runtime_profile
+    elif getattr(getattr(runner, "config", None), "multiplex_profiles", False):
+        transport_profile = runtime_profile = None  # unknown product identity; native legacy remains unchanged
+    else:
+        from hermes_cli.profiles import get_active_profile_name
+        transport_profile = get_active_profile_name() or "default"
+        runtime_profile = source.profile or transport_profile
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    access_token = (set_hermes_home_override(str(identity.authorization_home))
+                    if identity is not None else None)
+    try:
+        product_allowed = gateway_allowed(source, transport_profile=transport_profile, runtime_profile=runtime_profile)
+    finally:
+        if access_token is not None:
+            reset_hermes_home_override(access_token)
+    if not product_allowed:
+        return False
+    from hermes_cli.friday_ordinary_gateway import receiving_pairing_store
+    ordinary, store = receiving_pairing_store(runner, source)
+    if ordinary and (store is None or not store.is_approved('telegram', source.user_id)):
+        return False  # Native allowlists never replace this installed pairing grant.
+
+    return True
