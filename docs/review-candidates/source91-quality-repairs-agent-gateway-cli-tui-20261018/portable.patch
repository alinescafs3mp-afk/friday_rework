+"""Executor-future custody during manual compression cancellation and owner unwind."""
+from __future__ import annotations
+
+import asyncio
+
+
+async def drain_manual_compression_worker(worker):
+    """Observe terminal failure without replacing the owner's exception or cancellation."""
+    completion = asyncio.gather(worker, return_exceptions=True)
+    while not completion.done():
+        try:
+            await asyncio.shield(completion)
+        except asyncio.CancelledError:
+            continue
+    if not worker.cancelled():
+        worker.exception()
+
+
+async def settle_manual_compression_worker(worker, agent):
+    """Retain the raw worker even when post-submit registration failed."""
+    if worker is None:
+        return
+    if worker.done():
+        if not worker.cancelled():
+            worker.exception()
+        return
+    from agent.interrupt_compat import request_hard_interrupt
+    try:
+        request_hard_interrupt(agent, "manual compression owner unwinding")
+    finally:
+        await drain_manual_compression_worker(worker)
