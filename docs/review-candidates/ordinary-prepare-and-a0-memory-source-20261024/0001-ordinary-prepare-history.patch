+class _HistoryWalk:
+    """Completed exact graph facts owned by one bounded source-check invocation.
+
+    No instance is retained by a module, receipt or caller-visible result.
+    Evidence is physically checked on the first completed visit; a reused fact
+    is not a new physical observation. Public checkers always make a new walk; an ordinary prepare owns its
+    private walk only until that original prepare returns or raises.
+    """
+    def __init__(self, *, budget=None):
+        self._budget = budget
+        self._completed = {}
+        self._active = set()
+        self._hits = 0
+        self._misses = 0
+
+    @staticmethod
+    def _key(kind, arguments):
+        def plain(value):
+            if value is None or type(value) in (str, bool, int):
+                return True
+            if type(value) is list:
+                return all(plain(item) for item in value)
+            if type(value) is dict:
+                return all(type(key) is str and plain(item) for key, item in value.items())
+            return False
+        if not plain(arguments):
+            return None
+        return json.dumps([kind, arguments], sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+    def _check_budget(self):
+        if self._budget is not None:
+            self._budget.check()
+
+    def _checked(self, kind, arguments, checker):
+        self._check_budget()
+        key = self._key(kind, arguments)
+        if key is None:
+            checked = checker()
+            self._check_budget()
+            return checked
+        if key in self._active:
+            raise ValueError('ordinary_preflight_history_cycle')
+        if key in self._completed:
+            self._hits += 1
+            return copy.deepcopy(self._completed[key])
+        self._misses += 1
+        self._active.add(key)
+        try:
+            checked = checker()
+            self._check_budget()
+            self._completed[key] = copy.deepcopy(checked)
+            return copy.deepcopy(checked)
+        finally:
+            self._active.remove(key)
+
+
