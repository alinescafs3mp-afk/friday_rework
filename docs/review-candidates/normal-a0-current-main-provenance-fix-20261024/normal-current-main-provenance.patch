+def _checked_current_main_publication(home, checked, target, *, _budget=None):
+    """Reconcile only one freshly admitted target's exact supported native reseal.
+
+    Returns exact pins from the validated read bytes, never refreshed history.
+    Immutable history is never rewritten. The caller supplies current native
