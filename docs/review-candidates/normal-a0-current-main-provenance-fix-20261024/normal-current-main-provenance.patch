+    f.require(f.directory(f.canonical(target['home'])) == home / 'profiles' / target['profile'],
+        'ordinary_a0_current_main_target_changed')
+    prefix = 'profiles/' + target['profile'] + '/'
+    names = {prefix + n for n in ('config.yaml', '.friday-onboarding.json', '.friday-user-scope.json')}
+    after = checked['committed']['after']
+    f.require(names <= set(after), 'ordinary_a0_current_main_historical_target_required')
+    stage = Path(checked['transaction']) / 'stage'
+    previous = {}; current = {}
+    for name in names:
+        check_budget()
+        previous[name] = f.owned_file(stage / name, private=True)
+        f.require(f.digest(previous[name]) == after[name], 'ordinary_a0_current_main_history_changed')
+        current[name] = f.owned_file(home / name, private=True)
+    from hermes_cli.config import fast_safe_load
+    from scripts.friday_ordinary_install import _historical_yaml_parse
+    from _friday_install_validation_plugins.friday_rework.onboarding import current_main_config
+    config_name = prefix + 'config.yaml'; proof_name = prefix + '.friday-onboarding.json'
+    marker_name = prefix + '.friday-user-scope.json'
+    old_config = _historical_yaml_parse(previous[config_name].decode('utf-8-sig'), fast_safe_load)
+    config = fast_safe_load(current[config_name].decode('utf-8-sig'))
+    old_proof = json.loads(previous[proof_name], object_pairs_hook=f.unique)
+    old_marker = json.loads(previous[marker_name], object_pairs_hook=f.unique)
+    f.require(old_proof.get('binding_sha256') == target['binding_sha256']
+        and old_proof.get('config_sha256') == f.digest(previous[config_name])
+        and old_marker.get('profile') == target['profile']
+        and old_marker.get('binding_sha256') == target['binding_sha256']
+        and old_marker.get('onboarding_sha256') == f.digest(previous[proof_name]),
+        'ordinary_a0_current_main_historical_binding_changed')
+    selected = current_main_config(old_config, old_proof['required_secrets'])
+    f.require(json.dumps(config, sort_keys=True, allow_nan=False) == json.dumps(selected, sort_keys=True, allow_nan=False),
+        'ordinary_a0_current_main_config_changed')
