+def requires_original_source(source: Any) -> bool:
+    """Preserve managed ingress shape before admission; this grants no authority.
+
+    A declared isolated runtime needs the real SDK event for later file proof.
+    Never recover a different thread or merge transport messages on its behalf.
+    Unknown policy preserves the input; normal admission still has to succeed.
+    """
+    if getattr(source, "_friday_user_scope", None) is not None:
+        return True
+    identity = identity_of(source)
+    if identity is None:
+        return False
+    try:
+        from hermes_cli.friday_user_scope import policy
+        active = policy(identity.authorization_home)
+        return active is not None and any(
+            row["runtime_profile"] == identity.runtime_profile
+            for row in active["bindings"])
+    except Exception:  # Policy failure must not authorize an irreversible source rewrite.
+        return True
+
