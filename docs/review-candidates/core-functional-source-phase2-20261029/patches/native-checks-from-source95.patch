+"""Ordinary web stop scope and browser input cancellation contracts.
+
+Prepared source only for the integrated candidate; native subprocess settlement
+is represented at its existing registry boundary, without launching a service.
+"""
+from types import SimpleNamespace
+import time
+
+import pytest
+
+from agent.web_call_context import WebCall, WebTurn
+from tools import browser_scoped, interrupt
+from tools.process_registry_web import WebProcessMixin
+
+
+@pytest.fixture(autouse=True)
+def clear_test_thread_interrupt():
+    interrupt.set_interrupt(False)
+    try:
+        yield
+    finally:
+        interrupt.set_interrupt(False)
+
+
+class SettledRegistry(WebProcessMixin):
+    def __init__(self):
+        self.stopped = []
+
+    def settle_web(self, session, *, stop=False):
+        if stop:
+            self._latch_web_stop(session)
+            self.stopped.append(session)
+        return {'status': 'QUIESCENT', 'session_id': session.id}
+
+
+def retained_web_call(turn, registry, name):
+    call = WebCall(turn, time.monotonic() + 60, 'task', 'session', name)
+    call.uses_web = True
+    call.registry = registry
+    call.session = SimpleNamespace(
+        id=name, web_stop_requested=False, web_call_stop_event=call.stopped,
+        web_stop_events=(call.stopped, turn.stopped),
+    )
+    return call
+
+
+def test_confirmed_web_failure_keeps_safe_tools_and_blocks_web_retry():
+    registry = SettledRegistry()
+    turn = WebTurn()
+    failed_web = retained_web_call(turn, registry, 'web')
+    safe_call = WebCall(turn, time.monotonic() + 60, 'task', 'session', 'file')
+
+    result = turn.fail({'success': False, 'retry_allowed': False, 'cleanup': 'confirmed'})
+
+    assert result['cleanup'] == 'confirmed'
+    assert registry.stopped == [failed_web.session]
+    assert failed_web.session.web_stop_requested
+    assert failed_web.stopped.is_set()
+    assert not turn.stopped.is_set()
+    safe_call.check()
+    retry = WebCall(turn, time.monotonic() + 60, 'task', 'session', 'retry')
+    retry.uses_web = True
+    with pytest.raises(RuntimeError, match='web_call_stopped'):
+        retry.check()
+
+
+def test_explicit_turn_stop_still_stops_all_owned_web_and_safe_calls():
+    registry = SettledRegistry()
+    turn = WebTurn()
+    web_calls = [retained_web_call(turn, registry, name) for name in ('web', 'browser')]
+    safe_call = WebCall(turn, time.monotonic() + 60, 'task', 'session', 'file')
+
+    receipt = turn.stop()
+
+    assert receipt['status'] == 'QUIESCENT'
+    assert {session.id for session in registry.stopped} == {'web', 'browser'}
+    assert turn.stopped.is_set()
+    assert all(call.stopped.is_set() for call in web_calls)
+    with pytest.raises(RuntimeError, match='web_call_stopped'):
+        safe_call.check()
+
+
+def test_browser_input_is_not_written_when_interrupt_wins_publication(monkeypatch):
+    from hermes_cli import friday_user_scope as users
+
+    turn = WebTurn()
+    call = WebCall(turn, time.monotonic() + 60, 'task', 'session', 'browser')
+    stdin = SimpleNamespace(fileno=lambda: 11)
+    stdout = SimpleNamespace(fileno=lambda: 12)
+    session = SimpleNamespace(
+        process=SimpleNamespace(stdin=stdin, stdout=stdout),
+        web_deadline=call.deadline(), web_stop_requested=False,
+    )
+    writes = []
+
+    def write(fd, data):
+        writes.append((fd, data))
+        return len(data)
