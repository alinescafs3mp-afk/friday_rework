+"""Original-source routing and native FIFO contracts; prepared, not executed."""
+from types import SimpleNamespace
+
+from gateway.config import Platform
+from gateway.platforms.event import MessageEvent, MessageType
+from gateway.run_busy import GatewayBusySessionMixin
+from gateway.run_topics import GatewayTopicThreadsMixin
+from gateway.session import SessionSource
+from gateway.session_identity import RoutingIdentity, requires_original_source
+
+
+def source(tmp_path, profile="managed"):
+    value = SessionSource(platform=Platform.TELEGRAM, chat_id="42", user_id="42",
+                          chat_type="dm", thread_id=None, message_id="101")
+    value._identity = RoutingIdentity("default", profile, tmp_path,
+                                      tmp_path / "profiles" / profile)
+    return value
+
+
+def topic_runner():
+    return SimpleNamespace(
+        _is_telegram_dm=lambda source: True,
+        _telegram_topic_mode_enabled=lambda source: True,
+        _TELEGRAM_GENERAL_TOPIC_IDS={"", "1"},
+        _telegram_topic_profile_name=lambda source: "managed",
+        _sync_session_db=lambda: SimpleNamespace(
+            list_telegram_topic_bindings_for_chat=lambda **kw: [
+                {"user_id": "42", "thread_id": "99"}]))
+
+
+def test_managed_lobby_keeps_sdk_lane_and_unmanaged_recovery_still_works(tmp_path, monkeypatch):
+    from hermes_cli import friday_user_scope
+    monkeypatch.setattr(friday_user_scope, "policy", lambda home: {
+        "bindings": [{"runtime_profile": "managed"}]})
+    original = source(tmp_path)
+    identity = original._identity
+    assert GatewayTopicThreadsMixin._recover_telegram_topic_thread_id(topic_runner(), original) is None
+    assert original.thread_id is None and original._identity is identity
+    assert not hasattr(original, "_friday_user_scope")
+    original.thread_id = "77"
+    assert GatewayTopicThreadsMixin._recover_telegram_topic_thread_id(topic_runner(), original) is None
+    assert original.thread_id == "77" and original._identity is identity
+    unmanaged = source(tmp_path, "operator")
+    assert GatewayTopicThreadsMixin._recover_telegram_topic_thread_id(topic_runner(), unmanaged) == "99"
+
+
+def test_policy_uncertainty_preserves_source_without_minting_authority(tmp_path, monkeypatch):
+    from hermes_cli import friday_user_scope
+    def unavailable(home):
+        raise ValueError("invalid policy")
+    monkeypatch.setattr(friday_user_scope, "policy", unavailable)
+    original = source(tmp_path)
+    assert requires_original_source(original) is True
+    assert original.thread_id is None
+    assert not hasattr(original, "_friday_user_scope")
+    assert not hasattr(original, "_friday_document_route")
+
+
+def test_managed_photo_followups_retain_each_event_in_native_fifo(tmp_path):
+    first = MessageEvent(text="first", source=source(tmp_path), message_type=MessageType.PHOTO,
+                         media_urls=["one.png"], media_types=["image/png"])
+    second = MessageEvent(text="second", source=source(tmp_path), message_type=MessageType.PHOTO,
+                          media_urls=["two.png"], media_types=["image/png"])
+    first.source._friday_user_scope = object()
+    second.source._friday_user_scope = object()
+    adapter = SimpleNamespace(_pending_messages={"lane": first})
+    state = SimpleNamespace(conversation=SimpleNamespace(queued_events=[]))
+    runner = SimpleNamespace(
+        _delivery_adapter_for=lambda source: adapter,
+        _SECURITY_METADATA_KEYS=(), _BUSY_QUEUE_MAX_PENDING=10,
+        _queue_depth=lambda key, adapter=None: 1,
+        _session_state=lambda key: state)
+    runner._enqueue_fifo = lambda key, event, owner: GatewayBusySessionMixin._enqueue_fifo(
+        runner, key, event, owner)
+    GatewayBusySessionMixin._queue_or_replace_pending_event(runner, "lane", second)
+    assert adapter._pending_messages["lane"] is first
+    assert state.conversation.queued_events == [second]
+    assert first.media_urls == ["one.png"] and second.media_urls == ["two.png"]
+    assert not first._ingress_merged and not second._ingress_merged
diff --git a/hermes-agent/tests/hermes_cli/test_friday_workspace_text_atomic.py b/hermes-agent/tests/hermes_cli/test_friday_workspace_text_atomic.py
