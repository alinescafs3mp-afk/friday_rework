+    def no_external_effect(*args, **kwargs):
+        pytest.fail('recovery tried to launch or stop a native process')
+
+    monkeypatch.setattr(subprocess, 'Popen', no_external_effect)
+    monkeypatch.setattr(module, '_stop_systemd_unit', no_external_effect)
+    recovered = ProcessRegistry()
+    assert recovered.recover_from_checkpoint() == 1
+    new = recovered._running[old.id]
+    assert new.detached and new.process is None
+    assert new._scope_stop_pending and new.web_unconfirmed
+    assert (new.cwd, new.task_id, new.owner_task_id, new.session_key, new.web_turn_id,
+            new.web_tool_call_id, new.web_deadline, new.systemd_unit, new.web_boot_id) == (
+        old.cwd, old.task_id, old.owner_task_id, old.session_key, old.web_turn_id,
+        old.web_tool_call_id, old.web_deadline, old.systemd_unit, old.web_boot_id)
+    assert new.web_stop_requested is stopped
+    assert not hasattr(new, 'web_call_stop_event')
+    recovered._latch_web_stop(new)
+    recovered._write_checkpoint(strict=True)
+    assert json.loads(path.read_text())[0]['web_stop_requested'] is True
+    assert recovered.web_custody_receipt()['status'] == 'STOP_UNCONFIRMED'
