+"""Per-origin Telegram batching retains real events; prepared, not executed."""
+from types import SimpleNamespace
+
+import asyncio
+import pytest
+
+from gateway.config import Platform
+from gateway.platforms.event import MessageEvent, MessageType
+from gateway.session import SessionSource
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+def event(message_id):
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="42", user_id="42",
+                           chat_type="dm", message_id=str(message_id))
+    source._friday_user_scope = object()
+    return MessageEvent(text="request", source=source, message_type=MessageType.TEXT,
+                        message_id=str(message_id), platform_update_id=message_id + 100)
+
+
+def adapter():
+    return SimpleNamespace(_canonicalize=lambda source: None,
+                           _event_session_key=lambda event: "same-native-session",
+                           _apply_topic_recovery=lambda event: None,
+                           _text_batch_delay_seconds=0.3, _text_batch_split_delay_seconds=1.0,
+                           _SPLIT_THRESHOLD=4000, _TEXT_BATCH_FAST_LEN=50,
+                           _TEXT_BATCH_FAST_DELAY_S=0.1, _TEXT_BATCH_SHORT_LEN=500,
+                           _TEXT_BATCH_SHORT_DELAY_S=0.2)
+
+
+def test_text_and_album_keys_keep_original_message_boundaries():
+    owner = adapter()
+    first, second = event(101), event(102)
+    album = SimpleNamespace(media_group_id="album")
+    assert TelegramAdapter._text_batch_key(owner, first) != TelegramAdapter._text_batch_key(owner, second)
+    assert TelegramAdapter._photo_batch_key(owner, first, album) != TelegramAdapter._photo_batch_key(owner, second, album)
+    assert first.source.message_id == first.message_id == "101"
+    assert second.source.message_id == second.message_id == "102"
+    assert not first._ingress_merged and not second._ingress_merged
+
+
+def test_original_text_uses_equal_delay_for_split_sized_and_short_messages():
+    owner = adapter()
+    first, second = event(101), event(102)
+    first.text = "x" * 4096
+    first._last_chunk_len = 4096
+    second._last_chunk_len = len(second.text)
+    assert TelegramAdapter._text_batch_delay_for(owner, first) == 0.3
+    assert TelegramAdapter._text_batch_delay_for(owner, second) == 0.3
+
+
+@pytest.mark.asyncio
+async def test_document_album_uses_existing_maps_without_combining_receipts():
+    owner = adapter()
+    first, second = event(101), event(102)
+    first.media_urls, second.media_urls = ["one.docx"], ["two.docx"]
+    first.media_types = second.media_types = ["application/octet-stream"]
+    first._telegram_media_receipts = {"one.docx": {"origin": "first"}}
+    second._telegram_media_receipts = {"two.docx": {"origin": "second"}}
+    owner._media_group_events, owner._media_group_tasks = {}, {}
+    owner._should_drop_delayed_delivery = lambda: False
+    owner._accept_update = lambda: None
+    owner._merge_caption = TelegramAdapter._merge_caption
+    owner._merge_into_pending = lambda pending, key, item: TelegramAdapter._merge_into_pending(
+        owner, pending, key, item)
+    flushed = []
+    async def flush(key):
+        flushed.append(key)
+    owner._flush_media_group_event = flush
+    await TelegramAdapter._queue_media_group_event(owner, "album", first)
+    await TelegramAdapter._queue_media_group_event(owner, "album", second)
+    await asyncio.gather(*owner._media_group_tasks.values())
+    assert len(flushed) == 2 and len(set(flushed)) == 2
+    assert list(owner._media_group_events.values()) == [first, second]
+    assert first._telegram_media_receipts == {"one.docx": {"origin": "first"}}
+    assert second._telegram_media_receipts == {"two.docx": {"origin": "second"}}
+    assert not first._ingress_merged and not second._ingress_merged
