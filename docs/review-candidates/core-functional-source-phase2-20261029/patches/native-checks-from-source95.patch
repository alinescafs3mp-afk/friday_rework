@@ -0,0 +1,95 @@
+"""Descriptor aliases retain native test-home protection; synthetic paths only."""
+import os
+
+import pytest
+
+from tests.home_io_guard import HomeIOGuard
+
+
+def duplicate(fd, method, target):
+    return os.dup(fd) if method == 'dup' else os.dup2(fd, target)
+
+
+@pytest.mark.parametrize('method', ['dup', 'dup2'])
+def test_descriptor_alias_retains_directory_after_original_close(tmp_path, monkeypatch, method):
+    (tmp_path / 'value').write_bytes(b'isolated fixture')
+    guard = HomeIOGuard(lambda: ())
+    guard.install(monkeypatch)
+    source = os.open(tmp_path, os.O_RDONLY | os.O_DIRECTORY)
+    target = os.open(tmp_path, os.O_RDONLY | os.O_DIRECTORY)
+    alias = duplicate(source, method, target)
+    os.close(source)
+    try:
+        item = os.open('value', os.O_RDONLY, dir_fd=alias)
+        try:
+            assert os.read(item, 100) == b'isolated fixture'
+        finally:
+            os.close(item)
+    finally:
+        os.close(alias)
+        if alias != target:
+            os.close(target)
+    assert alias not in guard.directories
+
+
+@pytest.mark.parametrize('method', ['dup', 'dup2'])
+def test_descriptor_alias_does_not_bypass_protected_home(tmp_path, monkeypatch, method):
+    protected = []
+    guard = HomeIOGuard(lambda: protected)
+    guard.install(monkeypatch)
+    source = os.open(tmp_path, os.O_RDONLY | os.O_DIRECTORY)
+    target = os.open(tmp_path, os.O_RDONLY | os.O_DIRECTORY)
+    alias = duplicate(source, method, target)
+    os.close(source)
+    protected.append(tmp_path)
+    try:
+        with pytest.raises(AssertionError, match='REAL hermes home'):
+            os.open('secret', os.O_WRONLY | os.O_CREAT, 0o600, dir_fd=alias)
+        with pytest.raises(AssertionError, match='REAL hermes home'):
+            os.stat('secret', dir_fd=alias)
+    finally:
+        os.close(alias)
+        if alias != target:
+            os.close(target)
+    protected.clear()
+    assert not (tmp_path / 'secret').exists()
+
+
+@pytest.mark.parametrize('method', ['dup', 'dup2'])
+def test_unknown_descriptor_alias_remains_fail_closed(tmp_path, monkeypatch, method):
+    # A descriptor obtained outside this guard must not inherit a stale target
+    # mapping when dup2 replaces a previously tracked directory.
+    source = os.open(tmp_path, os.O_RDONLY | os.O_DIRECTORY)
+    guard = HomeIOGuard(lambda: ())
+    guard.install(monkeypatch)
+    target = os.open(tmp_path, os.O_RDONLY | os.O_DIRECTORY)
+    alias = duplicate(source, method, target)
+    try:
+        with pytest.raises(AssertionError, match='untracked dir_fd'):
+            os.open('secret', os.O_WRONLY | os.O_CREAT, 0o600, dir_fd=alias)
+    finally:
+        os.close(source)
+        os.close(alias)
+        if alias != target:
+            os.close(target)
+    assert not (tmp_path / 'secret').exists()
+
+
+def test_unknown_dup_cannot_inherit_closed_stream_mapping(tmp_path, monkeypatch):
+    source = os.open(tmp_path, os.O_RDONLY | os.O_DIRECTORY)
+    guard = HomeIOGuard(lambda: ())
+    guard.install(monkeypatch)
+    stale = os.open(tmp_path / 'decoy', os.O_WRONLY | os.O_CREAT, 0o600)
+    # Stream close does not call Python's wrapped os.close. The next dup
+    # reuses that number, and must erase the previous descriptor's mapping.
+    with os.fdopen(stale, 'wb'):
+        pass
+    alias = os.dup(source)
+    try:
+        assert alias == stale
+        with pytest.raises(AssertionError, match='untracked dir_fd'):
+            os.open('secret', os.O_WRONLY | os.O_CREAT, 0o600, dir_fd=alias)
+    finally:
+        os.close(source)
+        os.close(alias)
+    assert not (tmp_path / 'secret').exists()
