+@pytest.mark.parametrize('kind', ['browser', 'web'])
+@pytest.mark.parametrize('fence', ['interrupt', 'call', 'turn', 'session'])
+def test_stop_winning_last_check_prevents_real_pipe_publication(kind, fence, monkeypatch):
+    reply = b'{"success":true}\n' if kind == 'browser' else b'{"result":"ok"}\n'
+    with real_pipes(reply) as (proc, read_fd):
+        call, session = call_and_session(proc)
+        original_check = call.check
+        checked = 0
+
+        def check_then_stop():
+            nonlocal checked
+            original_check()
+            checked += 1
+            if checked == 2:
+                if fence == 'interrupt':
+                    interrupt.set_interrupt(True)
+                elif fence == 'call':
+                    call.stopped.set()
+                elif fence == 'turn':
+                    call.turn.stopped.set()
+                else:
+                    session.web_stop_requested = True
+
+        monkeypatch.setattr(call, 'check', check_then_stop)
+        with pytest.raises(RuntimeError, match='stopped'):
+            exchange(kind, session, call, {'command': 'click', 'args': ['@e1']})
+        with pytest.raises(BlockingIOError):
+            os.read(read_fd, 65536)
+
+
+@pytest.mark.parametrize('kind', ['browser', 'web'])
+@pytest.mark.parametrize('payload,error', [
+    ({'value': 'x' * 65536}, RuntimeError),
