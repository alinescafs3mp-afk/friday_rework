index 0000000000000000000000000000000000000000..e8e5ff3fe3f09ecdd032b4243e1f5503657b6c4a
--- /dev/null
+++ b/hermes-agent/tests/hermes_cli/test_friday_workspace_text_atomic.py
@@ -0,0 +1,359 @@
+"""Ordinary TXT publication against real private descriptors and Linux renameat2.
+
+Admission policy is outside this narrow publisher regression: TmpCapability
+represents an admitted temp home. Parent inode/permissions, file I/O, fsync,
+NOREPLACE, and the native cancellation/deadline context all remain real.
+"""
+from dataclasses import dataclass
+from io import BytesIO
+import errno
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import time
+from types import SimpleNamespace
+from xml.etree import ElementTree as ET
+from zipfile import ZipFile
+
+import pytest
+
+from agent.web_call_context import WebCall, WebTurn, bind_web_call
+from hermes_cli import friday_user_scope as scope
+from hermes_cli import friday_workspace_docx as publisher
+from hermes_cli import friday_workspace_revision as revision
+
+
+pytestmark = pytest.mark.platforms("linux")
+
+
+@dataclass
+class TmpCapability:
+    home: Path
+    directory_identity: tuple
+    revoked: bool = False
+    key: str = "test-principal"
+    admission_generation: int = 1
+
+    def check(self):
+        if self.revoked:
+            raise scope.ScopeDenied()
+        return self
+
+
+@pytest.fixture
+def workspace(tmp_path):
+    home = tmp_path / "admitted-home"
+    home.mkdir(mode=0o700)
+    root = home / "workspace"
+    root.mkdir(mode=0o700)
+    identity = home.stat()
+    cap = TmpCapability(home, (identity.st_dev, identity.st_ino))
+    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    call = WebCall(WebTurn(), time.monotonic() + 30, "test-task", "test-session", "test-call")
+    call.agent = SimpleNamespace(_friday_reply_effect_unknown=False)
+    try:
+        with bind_web_call(call):
+            yield SimpleNamespace(cap=cap, root=root, fd=fd, call=call)
+    finally:
+        os.close(fd)
+
+
+def write(workspace, content="Полный текст 🌍\n", leaf="result.txt"):
+    return json.loads(revision.write(workspace.cap, workspace.fd, leaf, leaf, content, "test-task"))
+
+
+def private_file(path, data):
+    with path.open("xb") as stream:
+        stream.write(data)
+    path.chmod(0o600)
+
+
+def assert_clean(root, *expected):
+    assert set(item.name for item in root.iterdir()) == set(expected)
+
+
+@pytest.mark.parametrize("content", ["", "Привет, мир!\n🌍\tfin\n", "А🌍\n" * 16000], ids=["empty", "utf8", "multiple_chunks"])
+def test_txt_is_complete_private_utf8_at_atomic_publish(workspace, monkeypatch, content):
+    expected = content.encode("utf-8")
+    real_move = publisher._move
+    seen = []
+
+    def observe_publish(source_fd, source, target_fd, target):
+        assert not (workspace.root / target).exists()
+        stage = workspace.root / source
+        assert stage.read_bytes() == expected
+        info = stage.stat()
+        assert stat.S_IMODE(info.st_mode) == 0o600
+        assert info.st_nlink == 1 and info.st_uid == os.getuid()
+        real_move(source_fd, source, target_fd, target)
+        assert (workspace.root / target).read_bytes() == expected
+        seen.append(target)
+
+    monkeypatch.setattr(publisher, "_move", observe_publish)
+    result = write(workspace, content)
+    assert result["success"] is True
+    assert result["format"] == "text"
+    assert result["create_only"] is True and result["verified"] is True
+    assert result["bytes_written"] == len(expected)
+    assert result["sha256"] == hashlib.sha256(expected).hexdigest()
+    assert (workspace.root / "result.txt").read_bytes() == expected
+    assert stat.S_IMODE((workspace.root / "result.txt").stat().st_mode) == 0o600
+    assert seen == ["result.txt"]
+    assert_clean(workspace.root, "result.txt")
+    assert workspace.call.agent._friday_reply_effect_unknown is False
+
+
+@pytest.mark.parametrize("kind", ["file", "directory", "symlink"])
+def test_noreplace_preserves_a_foreign_name_created_at_publish(workspace, monkeypatch, kind):
+    real_move = publisher._move
+    target = workspace.root / "result.txt"
+    foreign = b"Other writer's complete bytes\n"
+    if kind == "symlink":
+        private_file(workspace.root / "foreign.txt", foreign)
+    observed_errno = []
+
+    def collide(source_fd, source, target_fd, target_leaf):
+        if kind == "file":
+            private_file(target, foreign)
+        elif kind == "directory":
+            target.mkdir(mode=0o700)
+        else:
+            target.symlink_to("foreign.txt")
+        try:
+            real_move(source_fd, source, target_fd, target_leaf)
+        except OSError as error:
+            observed_errno.append(error.errno)
+            raise
+
+    monkeypatch.setattr(publisher, "_move", collide)
+    result = write(workspace)
+    assert result["success"] is False and result["effect_disposition"] == "none"
+    assert observed_errno == [errno.EEXIST]
+    if kind == "file":
+        assert target.read_bytes() == foreign
+    elif kind == "directory":
+        assert target.is_dir() and list(target.iterdir()) == []
+    else:
+        assert target.is_symlink() and os.readlink(target) == "foreign.txt"
+        assert target.read_bytes() == foreign
+    assert_clean(workspace.root, *(["result.txt", "foreign.txt"] if kind == "symlink" else ["result.txt"]))
+    assert workspace.call.agent._friday_reply_effect_unknown is False
+
+
+def test_existing_txt_keeps_revision_full_read_requirement(workspace):
+    private_file(workspace.root / "result.txt", b"Original version\n")
+    result = write(workspace)
+    assert result["success"] is False
+    assert result["error"] == "file_revision_requires_current_full_read"
+    assert (workspace.root / "result.txt").read_bytes() == b"Original version\n"
+    assert_clean(workspace.root, "result.txt")
+
+
+def test_native_cancellation_before_entry_creates_no_file(workspace):
+    workspace.call.stopped.set()
+    with pytest.raises(RuntimeError, match="web_call_stopped"):
+        write(workspace)
+    assert_clean(workspace.root)
+    assert workspace.call.agent._friday_reply_effect_unknown is False
+
+
+@pytest.mark.parametrize("cause", ["cancel", "deadline", "revoked"])
+def test_prepublication_rejection_removes_only_private_stage(workspace, monkeypatch, cause):
+    real_snapshot = publisher._snapshot
+
+    def stop_after_complete_stage(item, fd, leaf):
+        result = real_snapshot(item, fd, leaf)
+        assert (workspace.root / leaf).read_bytes() == "Полный текст 🌍\n".encode()
+        if cause == "cancel":
+            workspace.call.stopped.set()
+        elif cause == "deadline":
+            workspace.call.base_deadline = time.monotonic() - 1
+        else:
+            workspace.cap.revoked = True
+        return result
+
+    monkeypatch.setattr(publisher, "_snapshot", stop_after_complete_stage)
+    result = write(workspace)
+    assert result == {"success": False, "error": "document_not_created", "effect_disposition": "none"}
+    assert_clean(workspace.root)
+    assert workspace.call.agent._friday_reply_effect_unknown is False
+
+
+def test_failed_syscall_with_unchanged_stage_is_known_absent(workspace, monkeypatch):
+    def reject_move(*args):
+        raise OSError(errno.EIO, "injected before rename")
+
+    monkeypatch.setattr(publisher, "_move", reject_move)
+    result = write(workspace)
+    assert result["effect_disposition"] == "none" and result["success"] is False
+    assert_clean(workspace.root)
+    assert workspace.call.agent._friday_reply_effect_unknown is False
+
+
+@pytest.mark.parametrize("failure", ["raised_wrapper", "cancel", "directory_fsync"])
+def test_failure_after_real_rename_retains_complete_final_and_unknown(workspace, monkeypatch, failure):
+    real_move = publisher._move
+    real_fsync = publisher.os.fsync
+    did_move = False
+
+    def move_then_fail(*args):
+        nonlocal did_move
+        real_move(*args)
+        did_move = True
+        if failure == "raised_wrapper":
+            raise OSError(errno.EIO, "injected after rename")
+        if failure == "cancel":
+            workspace.call.stopped.set()
+
+    def fsync_after_publish(fd):
+        if failure == "directory_fsync" and did_move and fd == workspace.fd:
+            raise OSError(errno.EIO, "injected directory fsync failure")
+        return real_fsync(fd)
+
+    monkeypatch.setattr(publisher, "_move", move_then_fail)
+    monkeypatch.setattr(publisher.os, "fsync", fsync_after_publish)
+    result = write(workspace)
+    assert result == {"success": False, "error": "document_publication_uncertain", "effect_disposition": "unknown"}
+    assert workspace.call.agent._friday_reply_effect_unknown is True
+    assert (workspace.root / "result.txt").read_bytes() == "Полный текст 🌍\n".encode()
+    assert_clean(workspace.root, "result.txt")
+
+
+@pytest.mark.parametrize("later_state", ["missing", "foreign_replacement"])
+def test_missing_or_foreign_final_cannot_disprove_completed_rename(workspace, monkeypatch, later_state):
+    real_move = publisher._move
+    foreign = b"Foreign replacement"
+
+    def move_then_other_writer(*args):
+        real_move(*args)
+        target = workspace.root / "result.txt"
+        if later_state == "missing":
+            target.unlink()
+        else:
+            target.rename(workspace.root / "retained-own.txt")
+            private_file(target, foreign)
+        raise OSError(errno.EIO, "injected after later writer")
+
+    monkeypatch.setattr(publisher, "_move", move_then_other_writer)
+    result = write(workspace)
+    assert result["success"] is False and result["effect_disposition"] == "unknown"
+    assert workspace.call.agent._friday_reply_effect_unknown is True
+    if later_state == "missing":
+        assert_clean(workspace.root)
+    else:
+        assert (workspace.root / "result.txt").read_bytes() == foreign
+        assert (workspace.root / "retained-own.txt").read_bytes() == "Полный текст 🌍\n".encode()
+        assert_clean(workspace.root, "result.txt", "retained-own.txt")
+
+
+def test_cleanup_does_not_unlink_another_inode_reusing_stage_name(workspace, monkeypatch):
+    real_snapshot = publisher._snapshot
+    foreign = b"Another inode owns this private name"
+    replaced = []
+
+    def replace_stage_then_cancel(item, fd, leaf):
+        result = real_snapshot(item, fd, leaf)
+        path = workspace.root / leaf
+        path.rename(workspace.root / "retained-own.txt")
+        private_file(path, foreign)
+        replaced.append(path)
+        workspace.call.stopped.set()
+        return result
+
+    monkeypatch.setattr(publisher, "_snapshot", replace_stage_then_cancel)
+    result = write(workspace)
+    assert result["success"] is False and result["effect_disposition"] == "none"
+    assert not (workspace.root / "result.txt").exists()
+    assert len(replaced) == 1 and replaced[0].read_bytes() == foreign
+    assert (workspace.root / "retained-own.txt").read_bytes() == "Полный текст 🌍\n".encode()
+    assert_clean(workspace.root, "retained-own.txt", replaced[0].name)
+
+
+def test_cleanup_failure_is_unknown_and_retains_private_recovery_bytes(workspace, monkeypatch):
+    real_unlink = publisher.os.unlink
+
+    def fail_unlink(path, *args, **kwargs):
+        if isinstance(path, str) and path.startswith(".friday-docx-"):
+            raise OSError(errno.EIO, "injected stage unlink failure")
+        return real_unlink(path, *args, **kwargs)
+
+    def reject_move(*args):
+        raise OSError(errno.EIO, "injected before rename")
+
+    with monkeypatch.context() as patch:
+        patch.setattr(publisher, "_move", reject_move)
+        patch.setattr(publisher.os, "unlink", fail_unlink)
+        result = write(workspace)
+    assert result == {"success": False, "error": "document_cleanup_incomplete", "effect_disposition": "unknown"}
+    assert workspace.call.agent._friday_reply_effect_unknown is True
+    assert not (workspace.root / "result.txt").exists()
+    remaining = list(workspace.root.iterdir())
+    assert len(remaining) == 1
+    assert remaining[0].read_bytes() == "Полный текст 🌍\n".encode()
+    assert stat.S_IMODE(remaining[0].stat().st_mode) == 0o600
+    remaining[0].unlink()
+    assert_clean(workspace.root)
+
+
+def test_parent_move_between_stage_and_publish_denies_retained_descriptor(workspace, monkeypatch):
+    real_snapshot = publisher._snapshot
+
+    def relocate_parent(item, fd, leaf):
+        result = real_snapshot(item, fd, leaf)
+        workspace.root.rename(workspace.cap.home / "detached")
+        workspace.root.mkdir(mode=0o700)
+        return result
+
+    monkeypatch.setattr(publisher, "_snapshot", relocate_parent)
+    result = write(workspace)
+    assert result["success"] is False and result["effect_disposition"] == "none"
+    assert_clean(workspace.root)
