+
+def test_ansi_unicode_pages_reconstruct_displayed_text_and_bound_neighbors(tmp_path):
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("past", source="cli")
+        db.append_message("past", role="user", content="neighbor" * 1200)
+        displayed = "аб🦊\n" * 2200
+        original = "\x1b[31m" + displayed + "\x1b[0m"
+        mid = db.append_message("past", role="tool", content=original, tool_name="read_file")
+        offset, pieces = 0, []
+        for _ in range(4):
+            result = json.loads(session_search(session_id="past", around_message_id=mid,
+                                               content_offset=offset, db=db))
+            assert result["success"], result
+            assert all(len(row["content"]) <= 4001 for row in result["messages"])
+            row = next(row for row in result["messages"] if row["id"] == mid)
+            assert row["original_content_chars"] == len(displayed)
+            pieces.append(row["content"].removesuffix("…") if "next_content_offset" in row else row["content"])
+            if "next_content_offset" not in row:
+                break
+            offset = row["next_content_offset"]
+        assert "".join(pieces) == displayed
+        assert db.get_messages("past")[-1]["content"] == original
