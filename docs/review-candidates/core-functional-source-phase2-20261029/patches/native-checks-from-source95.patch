+"""Local transport and retained recovery contracts; no browser/model/network launch."""
+
+from contextlib import contextmanager
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from agent.web_call_context import WebCall, WebTurn
+from tools import browser_scoped, interrupt
+from tools.process_registry import ProcessRegistry, ProcessSession
+from tools.process_registry_web import WebProcessMixin
+
+
+@pytest.fixture(autouse=True)
+def scoped_exchange(monkeypatch):
+    from hermes_cli import friday_user_scope as users
+
+    monkeypatch.setattr(users, 'current', lambda **kwargs: SimpleNamespace(check=lambda: None))
+    interrupt.set_interrupt(False)
+    try:
+        yield
+    finally:
+        interrupt.set_interrupt(False)
+
+
+def call_and_session(proc, *, seconds=30):
+    call = WebCall(WebTurn(), time.monotonic() + seconds, 'task', 'session', 'call')
+    session = SimpleNamespace(process=proc, web_deadline=call.deadline(), web_stop_requested=False)
+    return call, session
+
+
+@contextmanager
+def local_child(code, home):
+    proc = subprocess.Popen(
+        [sys.executable, '-I', '-B', '-u', '-c', code],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        env={'PATH': os.defpath, 'HOME': str(home), 'HERMES_HOME': str(home)},
+        cwd=home, start_new_session=True,
+    )
+    try:
+        yield proc
+    finally:
+        if proc.poll() is None:
+            proc.terminate()
+        try:
+            proc.wait(timeout=3)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            proc.wait(timeout=3)
+        for stream in (proc.stdin, proc.stdout, proc.stderr):
+            stream.close()
+        assert proc.poll() is not None
+
+
+@contextmanager
+def real_pipes(reply=b'{"success": true}\n'):
+    input_read, input_write = os.pipe()
+    output_read, output_write = os.pipe()
+    stdin = os.fdopen(input_write, 'wb', buffering=0)
+    stdout = os.fdopen(output_read, 'rb', buffering=0)
+    os.set_blocking(input_read, False)
+    try:
+        if reply:
+            os.write(output_write, reply)
+        os.close(output_write)
+        output_write = None
+        yield SimpleNamespace(stdin=stdin, stdout=stdout), input_read
+    finally:
+        stdin.close()
+        stdout.close()
+        os.close(input_read)
+        if output_write is not None:
+            os.close(output_write)
+
+
+def exchange(kind, session, call, payload):
+    if kind == 'browser':
+        return browser_scoped.exchange(None, session, call, payload)
+    return WebProcessMixin().web_exchange(session, payload, call)
+
+
+def test_persistent_browser_exchange_uses_same_real_child_without_deadline_reset(tmp_path):
+    code = (
+        'import json,os,sys\n'
+        'for number,line in enumerate(sys.stdin,1):\n'
+        ' value=json.loads(line)\n'
+        ' print(json.dumps({"success":True,"number":number,"pid":os.getpid(),"command":value["command"]}),flush=True)\n'
+    )
+    with local_child(code, tmp_path) as proc:
+        call, session = call_and_session(proc)
+        original = session.web_deadline
+        one = exchange('browser', session, call, {'command': 'snapshot', 'args': []})
+        two = exchange('browser', session, call, {'command': 'back', 'args': []})
+        assert (one['number'], two['number']) == (1, 2)
+        assert one['pid'] == two['pid'] == proc.pid
+        assert (one['command'], two['command']) == ('snapshot', 'back')
+        assert session.web_deadline == call.deadline() == original
+        assert proc.poll() is None
+
+
+def test_web_exchange_real_child_receives_one_payload_and_closes_input(tmp_path):
+    code = (
+        'import json,sys\n'
+        'value=json.loads(sys.stdin.read())\n'
+        'print(json.dumps({"result":json.dumps(value)}),flush=True)\n'
+    )
+    with local_child(code, tmp_path) as proc:
+        call, session = call_and_session(proc)
+        payload = {'operation': 'extract', 'input': 'local transport only'}
+        assert json.loads(exchange('web', session, call, payload)) == payload
+        assert proc.stdin.closed
+        assert proc.wait(timeout=3) == 0
+
