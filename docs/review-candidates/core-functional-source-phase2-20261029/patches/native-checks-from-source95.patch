+    monkeypatch.setattr(module, 'CHECKPOINT_PATH', path)
+    registry = ProcessRegistry()
+    old = retained_session(home, web_stop_requested=stopped)
+    old.web_call_stop_event = threading.Event()
+    old.web_stop_events = (old.web_call_stop_event, threading.Event())
+    registry._running[old.id] = old
+    registry._write_checkpoint(strict=True)
+    stored = json.loads(path.read_text())
