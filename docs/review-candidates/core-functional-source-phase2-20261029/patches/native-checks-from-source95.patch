+def retained_session(home, sid='proc_0123456789ab', **kwargs):
+    return ProcessSession(
+        id=sid, command='native browser', task_id='task', owner_task_id='task',
+        session_key='conversation', parent_session_id='parent', cwd=str(home),
+        started_at=time.time(), web_custody=True,
+        systemd_unit='hermes-worker-web-' + sid + '.service',
+        web_deadline=time.monotonic() + 60,
+        web_boot_id=Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
+        web_tool_call_id='call', web_turn_id='turn', **kwargs,
+    )
+
+
+@pytest.mark.parametrize('stopped', [False, True])
+def test_checkpoint_recovery_preserves_original_owner_clock_without_events_or_spawn(tmp_path, monkeypatch, stopped):
+    from tools import process_registry as module
+
+    home = tmp_path / 'profile'
+    home.mkdir(mode=0o700)
