+from tools.registry import registry
+from tools.session_search_tool import SESSION_SEARCH_SCHEMA, session_search
+
+
+def private_json(path, value):
+    path.write_text(json.dumps(value), encoding="utf-8")
+    path.chmod(0o600)
+
+
+@pytest.fixture
+def managed(tmp_path):
+    auth = tmp_path / "authority"
+    home = tmp_path / "own"
+    for path in (auth, home):
+        path.mkdir(mode=0o700)
+    binding = dict(platform="telegram", transport_profile="default", account_id="fixture-bot",
+                   user_id="fixture-user", runtime_profile="own", tools=["session_search", "memory"])
+    principal = tuple(binding[k] for k in ("platform", "transport_profile", "account_id", "user_id"))
+    settings = {"product_access": {"enabled": True, "accounts": [
+        dict(platform="telegram", transport_profile="default", account_id="fixture-bot",
+             runtime_profiles=["own", "foreign"])]},
+        "user_isolation": {"enabled": True, "bindings": [binding]}}
+    private_json(auth / "config.yaml", {"plugins": {"entries": {"friday_rework": {"settings": settings}}}})
+    private_json(home / "config.yaml", {})
+    for name in ("memories", "workspace"):
+        (home / name).mkdir(mode=0o700)
+    key = users.principal_id(*principal)
+    private_json(home / users.MARKER, dict(schema="friday.user-home.v1", principal=key,
+                                         profile="own", binding_sha256=users._fingerprint(binding)))
+    access = {"schema": "product_access.v1", "users": {key: {
+        **dict(zip(("platform", "transport_profile", "account_id", "user_id"), principal)),
+        "enabled": True, "role": "user"}}}
+    with users.authority(auth):
+        PluginState("friday_rework").set("product_access.v1", access)
+    st = home.stat()
+    cap = users.UserScope(auth, home, "own", principal, binding, (st.st_dev, st.st_ino), 1)
+    with users.authority(home):
+        db = SessionDB(home / "state.db")
+        db.create_session("past", source="telegram", user_id="fixture-user", profile_name="own",
+                          origin_json=json.dumps({"friday_account_origin": {
+                              "schema": "friday.account_origin.v1", "platform": "telegram",
+                              "transport_profile": "default", "account_id": "fixture-bot"}}))
+        anchor = db.append_message("past", role="tool", content="section " * 1300, tool_name="read_file")
+    (home / "state.db").chmod(0o600)
+
+    @contextmanager
+    def scope():
+        with users.authority(home):
+            token = users._CURRENT.set(cap)
+            try:
+                cap.check()
+                yield
+            finally:
+                users._CURRENT.reset(token)
+
+    yield SimpleNamespace(auth=auth, home=home, cap=cap, db=db, anchor=anchor,
+                          scope=scope, access=access, key=key)
+    db.close()
+
+
+def test_real_scoped_profile_link_registry_schema_and_inline_cursor(managed):
+    m = managed
+    with m.scope():
+        schema = users.ordinary_session_schema(SESSION_SEARCH_SCHEMA)
+        assert schema["parameters"]["properties"]["content_offset"]["type"] == "integer"
+        result = json.loads(registry.get_entry("session_search").handler(
+            {"session_id": "@session:own/past", "around_message_id": m.anchor}, db=m.db))
+        assert result["success"], result
+        row = next(row for row in result["messages"] if row["id"] == m.anchor)
+        projected = users.ordinary_tool_metadata("session_search", result)
+        assert projected["messages"] == result["messages"]
+        assert row["next_content_offset"] == 4000
+        agent = SimpleNamespace(_get_session_db_for_recall=lambda: m.db, session_id="current")
+        page2 = json.loads(_session_search(agent, {"session_id": "@session:own/past",
+            "around_message_id": m.anchor, "content_offset": row["next_content_offset"]}, None))
+        assert page2["success"], page2
+        row2 = next(row for row in page2["messages"] if row["id"] == m.anchor)
+        assert row2["content_offset"] == 4000
+        assert row2["next_content_offset"] == 8000
+        discovered = json.loads(session_search(query="section", role_filter="tool", db=m.db))
+        assert discovered["success"] and discovered["count"] == 1, discovered
+        assert discovered["results"][0]["session_id"] == "past"
