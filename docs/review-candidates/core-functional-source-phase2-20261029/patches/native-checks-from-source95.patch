+
+@pytest.mark.parametrize("hint_kind", ["tool_stub", "footer"])
+def test_recovery_hint_then_anchor_recovers_current_compacted_tool_original(tmp_path, hint_kind):
+    from agent.context_compressor import _build_recovery_footer, _lean_recovery_stub
+
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("current", source="cli")
+        mid = db.append_message("current", role="tool", content="needle retained exact details", tool_name="read_file")
+        db.archive_and_compact("current", [{"role": "assistant", "content": "summary"}])
+        hint = (_lean_recovery_stub("read_file", 29, "current") if hint_kind == "tool_stub"
+                else _build_recovery_footer("current", 1))
+        # Interpret the actual emitted call, substituting only its query placeholder.
+        recipe = re.search(r"session_search\(([^)]+)\)", hint).group(0)
+        call = ast.parse(recipe, mode="eval").body
+        args = {kw.arg: ast.literal_eval(kw.value) for kw in call.keywords}
+        args["query"] = "needle"
+        result = json.loads(session_search(**args, current_session_id="current", db=db))
+        assert result["success"] and result["count"] == 1, result
+        hit = result["results"][0]
+        assert hit["session_id"] == "current"
+        assert hit["match_message_id"] == mid
+        recovered = json.loads(session_search(session_id="@session:current", around_message_id=mid,
