+"""Use the real baseline adapter under private test-only admission custody."""
+import json
+import os
+
+import pytest
+
+from agent import friday_baseline_bridge as bridge
+from tests.conftest import _REAL_BASELINE_COORDINATOR
+
+
+def test_real_begin_end_and_session_guards_use_only_test_coordinator(tmp_path):
+    assert bridge.COORDINATOR == tmp_path / "baseline-admission"
+    assert os.environ[bridge.ENV] == str(bridge.COORDINATOR)
+    token = bridge._call("begin", "test-client", "test-task")
+    assert token
+    path = bridge.COORDINATOR / "state.json"
+    state = json.loads(path.read_text())
+    assert state["foreground"][token]["task_id"] == "test-task"
+    bridge._call("end", token)
+    assert json.loads(path.read_text())["foreground"] == {}
+    bridge._call("session_guard_change", "synthetic", None, "guard", False)
+    assert json.loads(path.read_text())["foreground"]["friday-session-synthetic"]["guards"] == ["guard"]
+    bridge._call("session_guard_change", "synthetic", "guard", None, False)
+    assert json.loads(path.read_text())["foreground"] == {}
+
+
+def test_adapter_failure_faults_only_private_slot_and_real_slot_io_is_denied():
+    bridge._call("missing-test-operation")
+    assert (bridge.COORDINATOR / "FAULT").read_text().startswith("friday_bridge:")
+    with pytest.raises(AssertionError, match="REAL hermes home"):
+        (_REAL_BASELINE_COORDINATOR / "state.json").read_bytes()
