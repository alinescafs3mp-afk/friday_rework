+# The native source owns the regular ``tools`` package. These repository
+# rendering helpers are standalone scripts, loaded by exact path as in
+# test_web_profile; never replace or extend the native tools namespace.
+def _renderer(name):
+    path = Path(__file__).resolve().parents[1] / 'tools' / (name + '.py')
+    spec = importlib.util.spec_from_file_location('onboarding_' + name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
