@@ -0,0 +1,173 @@
+"""Real native Telegram consumer, temporary private state, no external SDK calls."""
+import asyncio
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from test_ordinary_document_delivery import own, private
+from gateway import run_plugin_delivery as delivery
+from gateway.config import PlatformConfig
+from hermes_cli import friday_user_scope as scopes
+from hermes_cli.plugins_state import PluginState
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+@pytest.fixture
+def native(own, monkeypatch):
+    import inspect
+    expected = Path(delivery.__file__).parent.parent / 'plugins/platforms/telegram/adapter.py'
+    assert Path(inspect.getfile(TelegramAdapter.send)).resolve() == expected.resolve()
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token='offline-test'))
+    adapter._running = True
+    adapter.gateway_runner = own.adapter.gateway_runner
+    adapter._bot = SimpleNamespace(id=101)
+    adapter._bot.send_document = AsyncMock(side_effect=OSError('PRIVATE SDK lost ack'))
+    adapter._bot.send_message = AsyncMock(return_value=SimpleNamespace(
+        message_id=505, chat=SimpleNamespace(id=202), message_thread_id=17))
+    own.source.thread_id = '17'; own.pin()
+    monkeypatch.setattr(delivery, 'resolve_document_route', lambda *args: (own.source, adapter))
+    own.adapter = adapter
+    return own
+
+
+def journal():
+    return PluginState('friday_rework').get(delivery._ORDINARY_DOCUMENTS)
+
+
+def test_actual_sdk_outcome_preserves_original_reply_topic_and_independent_ack(native):
+    path = private(native.work/'requested.md')
+    assert asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path]))
+    bot = native.adapter._bot
+    assert bot.send_document.await_count == bot.send_message.await_count == 1
+    kwargs = bot.send_message.call_args.kwargs
+    assert kwargs['chat_id'] == 202 and kwargs['reply_to_message_id'] == 303
+    assert kwargs['message_thread_id'] == 17 and kwargs.get('parse_mode') is None
+    assert 'PRIVATE' not in kwargs['text'] and len(kwargs['text']) < 1024
+    assert next(iter(journal()['outcomes'].values()))['state'] == 'CONFIRMED'
+    assert next(iter(journal()['files'].values()))['state'] == 'UNKNOWN'
+    assert asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path]))
+    assert bot.send_document.await_count == bot.send_message.await_count == 1
+
+
+def test_caption_missing_requested_file_still_gets_ordinary_outcome(native):
+    path = str(native.work/'missing.md')
+    assert asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path], caption='Done.'))
+    assert native.adapter._bot.send_document.await_count == 0
+    assert native.adapter._bot.send_message.await_count == 1
+    assert next(iter(journal()['outcomes'].values()))['state'] == 'CONFIRMED'
+
+
+@pytest.mark.parametrize('error', ['thread not found', 'reply message not found', 'PRIVATE timeout'])
+def test_sdk_error_does_not_fallback_retry_or_claim_failed_delivery(native, error):
+    native.adapter._bot.send_message.side_effect = OSError(error)
+    path = private(native.work/'requested.md')
+    asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path]))
+    assert next(iter(journal()['outcomes'].values()))['state'] == 'UNKNOWN'
+    assert native.adapter._bot.send_message.await_count == 1
+    asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path]))
+    assert native.adapter._bot.send_document.await_count == native.adapter._bot.send_message.await_count == 1
+
+
+@pytest.mark.parametrize('effect', ['document', 'outcome'])
+@pytest.mark.parametrize('change', ['revoked', 'source-retarget', 'bot-replaced', 'adapter-replaced', 'metadata-retarget'])
+def test_final_authority_rechecked_after_native_route_preparation(native, monkeypatch, effect, change):
+    bot = native.adapter._bot
+    prepare = native.adapter._media_send_kwargs
+    def kwargs(chat, reply, metadata):
+        result = prepare(chat, reply, metadata)
+        if change == 'revoked':
+            def denied(): raise scopes.ScopeDenied()
+            monkeypatch.setattr(native.cap, 'check', denied)
+        elif change == 'source-retarget':
+            native.source.message_id = '999'; native.pin()
+        elif change == 'bot-replaced':
+            native.adapter._bot = SimpleNamespace(id=999, send_message=AsyncMock(), send_document=AsyncMock())
+        elif change == 'adapter-replaced':
+            monkeypatch.setattr(delivery, 'resolve_document_route', lambda *args: (native.source, object()))
+        else:
+            key = '_friday_document_outcome' if effect == 'outcome' else '_friday_document_authority'
+            metadata[key][1]['source']['message_id'] = '999'
+            native.source.message_id = '999'; native.pin()
+        return result
+    monkeypatch.setattr(native.adapter, '_media_send_kwargs', kwargs)
+    path = private(native.work/'refused.md')
+    if effect == 'document':
+        assert not asyncio.run(delivery.deliver_ordinary_document(native.adapter, native.source, path)).success
+    else:
+        asyncio.run(delivery._ordinary_document_outcome(native.adapter, native.source, path, None))
+    assert bot.send_document.await_count == bot.send_message.await_count == 0
+
+
+def test_outcome_immutable_marker_survives_current_state_loss(native):
+    path = private(native.work/'requested.md')
+    asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path]))
+    PluginState('friday_rework').set(delivery._ORDINARY_DOCUMENTS, None)
+    asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path]))
+    assert native.adapter._bot.send_document.await_count == native.adapter._bot.send_message.await_count == 1
+
+
+def test_outcome_commit_unknown_never_sends_or_replays(native, monkeypatch):
+    path = private(native.work/'requested.md')
+    original = delivery._ordinary_commit
+    def uncertain(state, value, previous, **kwargs):
+        original(state, value, previous, **kwargs)
+        if value.get('outcomes'):
+            raise OSError('PRIVATE commit return unavailable')
+    monkeypatch.setattr(delivery, '_ordinary_commit', uncertain)
+    asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path]))
+    assert next(iter(journal()['outcomes'].values()))['state'] == 'PENDING'
+    monkeypatch.setattr(delivery, '_ordinary_commit', original)
+    asyncio.run(delivery.deliver_ordinary_files(native.adapter, native.source, [path]))
+    assert native.adapter._bot.send_document.await_count == 1
+    assert native.adapter._bot.send_message.await_count == 0
+
+
+@pytest.mark.parametrize('fence', ['degraded', 'flood', 'paced-revoked', 'queued-revoked'])
+def test_native_mutable_send_fences_prevent_outcome_effect(native, monkeypatch, fence):
+    from contextlib import asynccontextmanager
+    def denied(): raise scopes.ScopeDenied()
+    if fence == 'degraded':
+        native.adapter._send_path_degraded = True
+    elif fence == 'flood':
+        monkeypatch.setattr(native.adapter, '_send_flood_cooldown_remaining', lambda chat: 5)
+    elif fence == 'paced-revoked':
+        monkeypatch.setattr(native.adapter, '_chat_outbound_slot_remaining', lambda chat: 0.01)
+        async def pace(delay): monkeypatch.setattr(native.cap, 'check', denied)
+        monkeypatch.setattr(asyncio, 'sleep', pace)
+    else:
+        @asynccontextmanager
+        async def locked(chat):
+            monkeypatch.setattr(native.cap, 'check', denied)
+            yield
+        monkeypatch.setattr(native.adapter, '_chat_send_lock', locked)
+    asyncio.run(delivery._ordinary_document_outcome(native.adapter, native.source, str(native.work/'file.md'), None))
+    assert native.adapter._bot.send_message.await_count == 0
+
+
+@pytest.mark.parametrize('ack', ['missing-id', 'wrong-chat', 'wrong-topic'])
+def test_malformed_sdk_ack_is_unknown_and_does_not_confirm_reply_clock(native, ack):
+    message = native.adapter._bot.send_message.return_value
+    if ack == 'missing-id': message.message_id = None
+    elif ack == 'wrong-chat': message.chat.id = 999
+    else: message.message_thread_id = 999
+    recorded = []
+    asyncio.run(delivery._ordinary_document_outcome(native.adapter, native.source,
+        str(native.work/'file.md'), recorded.append))
+    assert native.adapter._bot.send_message.await_count == 1
+    assert len(recorded) == 1 and recorded[0].success is False
+    assert recorded[0].error == 'document_outcome_UNKNOWN'
+    assert next(iter(journal()['outcomes'].values()))['state'] == 'UNKNOWN'
+
+
+def test_sdk_retry_after_arms_shared_cooldown_without_repeating_effect(native):
+    class RetryAfter(Exception):
+        retry_after = 30
+    native.adapter._bot.send_message.side_effect = RetryAfter('PRIVATE rate limit')
+    async def run():
+        await delivery._ordinary_document_outcome(native.adapter, native.source, str(native.work/'first.md'), None)
+        assert native.adapter._send_flood_cooldown_remaining('202') > 0
+        await delivery._ordinary_document_outcome(native.adapter, native.source, str(native.work/'second.md'), None)
+    asyncio.run(run())
+    assert native.adapter._bot.send_message.await_count == 1
