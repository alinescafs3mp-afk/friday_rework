+def _postboot_dsh_current_policy(web, home, profile, declared, now):
+    """Current authority is separate from the immutable transaction policy."""
+    from .worker_web import web_policy
+    current = web_policy(web, str(home), profile, now)
+    _postboot_dsh_need(type(current['expires_unix']) is type(declared['expires_unix'])
+        and _postboot_dsh_same(current, dict(declared, expires_unix=current['expires_unix'])),
+        'postboot_dsh_current_policy_changed')
+    return current
+
+
+def _postboot_dsh_historical_policy(web, home, profile, checkpoint, issued):
+    """Validate recorded expiry authority at its transaction, not at today."""
+    import math
+    import stat
+    from dataclasses import replace
+    from .worker_web import web_policy_declaration
+    previous = web_policy_declaration(web, str(home), profile)
+    reference = checkpoint['effective_policy']
+    policy = web_policy_declaration(replace(web, egress_evidence=_pin(reference)), str(home), profile)
+    _postboot_dsh_need(type(issued) in (int, float) and math.isfinite(issued)
+        and issued < policy['expires_unix'], 'postboot_dsh_effective_policy_changed')
+    if reference == {'path': str(web.egress_evidence.path), 'sha256': web.egress_evidence.sha256}:
+        return policy
+    renewal = checkpoint['expiry_renewal']
+    root = web.egress_evidence.path.parent
+    from hermes_cli import friday_user_scope as scope
+    directory = scope._private(root, directory=True)
+    record = scope._private(Path(renewal['path']))
+    _postboot_dsh_need(stat.S_IMODE(directory.st_mode) == 0o700
+        and stat.S_IMODE(record.st_mode) in (0o400, 0o600) and record.st_size <= 16000,
+        'postboot_dsh_effective_policy_changed')
+    grant = _postboot_dsh_document(renewal)
+    _postboot_dsh_need(renewal['path'] == str(root / ('web-policy-renewal-' + web.egress_evidence.sha256 + '.json'))
+        and reference['path'] == str(root / ('web-policy-successor-' + reference['sha256'] + '.json'))
+        and type(grant) is dict and set(grant) == {'schema', 'predecessor', 'successor', 'issued_unix'}
+        and grant['schema'] == 'friday.worker-web.expiry-grant.v1'
+        and grant['predecessor'] == {'path': str(web.egress_evidence.path), 'sha256': web.egress_evidence.sha256}
+        and grant['successor'] == reference
+        and type(grant['issued_unix']) in (int, float) and math.isfinite(grant['issued_unix'])
+        and previous['expires_unix'] <= grant['issued_unix'] <= issued < policy['expires_unix'] <= grant['issued_unix'] + 86400
+        and type(policy['expires_unix']) is type(previous['expires_unix'])
+        and _postboot_dsh_same(policy, dict(previous, expires_unix=policy['expires_unix'])),
+        'postboot_dsh_effective_policy_changed')
+    return policy
+
+
