+"""Finite two-source XLSX revision merge; pure rendering and protected publication.
+
+Inline-text keys, integer revisions, dense rows and row-local scalar formulas.
+Preserve the base package; unsupported cross-row structures refuse. No engine.
+"""
+from copy import deepcopy
+from decimal import Decimal
+from io import BytesIO
+import json
+import os
+from pathlib import Path
+import re
+from xml.etree import ElementTree as ET
+from hermes_cli.friday_workspace_xlsx_recalculate import Book, S, R, TOKEN, _formula, _numeric, RecalculationRefused
+
+MAX_ROWS = 512
+MAX_COLS = 64
+TAGS = frozenset('worksheet sheetPr outlinePr pageSetUpPr dimension sheetViews sheetView selection sheetFormatPr sheetData row c f v is t pageMargins'.split())
+CELL_REF = re.compile(r'\$?([A-Za-z]{1,3})(\$?)([1-9][0-9]*)')
+
+
+class MergeRefused(ValueError):
+    """Finite public refusal; no user contents or paths."""
+
+
+def deny(reason='xlsx_merge_unsupported'):
+    raise MergeRefused(reason)
+
+
+def colname(n):
+    value = ''
+    while n:
+        n, rem = divmod(n-1, 26); value = chr(65+rem)+value
+    return value
+
+
+def worksheet(root):
+    attrs={
+        'worksheet':set(), 'sheetPr':set(), 'outlinePr':{'summaryBelow','summaryRight'},
+        'pageSetUpPr':set(), 'dimension':{'ref'}, 'sheetViews':set(),
+        'sheetView':{'workbookViewId'}, 'selection':{'activeCell','sqref'},
+        'sheetFormatPr':{'baseColWidth','defaultRowHeight'}, 'sheetData':set(),
+        'row':{'r'}, 'c':{'r','s','t'}, 'f':set(), 'v':set(), 'is':set(),
+        't':{'{http://www.w3.org/XML/1998/namespace}space'},
+        'pageMargins':{'left','right','top','bottom','header','footer'},
+    }
+    children={
+        'worksheet':{'sheetPr','dimension','sheetViews','sheetFormatPr','sheetData','pageMargins'},
+        'sheetPr':{'outlinePr','pageSetUpPr'}, 'sheetViews':{'sheetView'},
+        'sheetView':{'selection'}, 'sheetData':{'row'}, 'row':{'c'},
+        'c':{'f','v','is'}, 'is':{'t'},
+    }
+    if root.tag!=S+'worksheet':deny()
+    for node in root.iter():
+        if node.tag not in {S+t for t in TAGS}:deny()
+        tag=node.tag[len(S):]
+        if set(node.attrib)-attrs[tag]:deny('xlsx_merge_attributes_unsupported')
+        if tag not in {'t','f','v'} and (node.text or '').strip():deny('xlsx_merge_mixed_xml')
+        if (node.tail or '').strip():deny('xlsx_merge_mixed_xml')
+        allowed={S+t for t in children.get(tag,set())}
+        if any(child.tag not in allowed for child in node):deny()
+        if tag not in {'sheetData','row'} and len({n.tag for n in node})!=len(node):deny()
+        if tag=='row' and set(node.attrib)!={'r'}:deny()
+    if len(root.findall(S+'sheetData'))!=1 or len(root.findall(S+'dimension'))>1:deny()
+
+
+def local_formula(text, old_row, new_row):
+    tokens = _formula(text)
+    for kind, value in tokens:
+        match = CELL_REF.fullmatch(value)
+        if kind != 'ref' or not match or match[2] or int(match[3]) != old_row: deny('xlsx_merge_nonlocal_formula')
+    pieces=[];offset=0
+    while offset<len(text.rstrip()):
+        token=TOKEN.match(text,offset)
+        if token is None: deny()
+        if token.lastgroup=='ref':
+            value=token.group('ref');m=CELL_REF.fullmatch(value)
+            pieces.append(text[offset:token.start('ref')]+value[:-len(m[3])]+str(new_row))
+        else: pieces.append(text[offset:token.end()])
+        offset=token.end()
+    pieces.append(text[offset:])
+    return ''.join(pieces)
+
+
+def cell_value(cell, row):
+    typ = cell.get('t','n'); fs=cell.findall(S+'f'); vs=cell.findall(S+'v'); ins=cell.findall(S+'is')
+    attrs = tuple(sorted((k,v) for k,v in cell.attrib.items() if k not in {'r','t'}))
+    if fs:
+        if typ!='n' or len(fs)!=1 or fs[0].attrib or len(fs[0]) or ins or len(vs)>1: deny()
+        # Caches never participate in equality and are cleared in output.
+        f=local_formula(fs[0].text,row,1)
+        return ('formula',re.sub(r'\s+','',f).upper(),attrs)
+    if typ=='inlineStr':
+        if vs or len(ins)!=1 or ins[0].attrib or len(ins[0])!=1 or ins[0][0].tag!=S+'t' or len(ins[0][0]): deny()
+        if set(ins[0][0].attrib)-{'{http://www.w3.org/XML/1998/namespace}space'}: deny()
+        return ('text',ins[0][0].text or '',attrs)
+    if ins or len(vs)!=1 or len(vs[0]) or vs[0].attrib: deny()
+    if typ=='n': return ('number',_numeric(vs[0].text),attrs)
+    if typ=='b' and vs[0].text in ('0','1'): return ('boolean',vs[0].text,attrs)
+    deny()
+
+
+def data_rows(book, sheet, key, revision):
+    if sheet not in book.sheets: deny('xlsx_merge_sheet_missing')
+    root=book.roots[book.sheets[sheet]]; worksheet(root)
+    rows=root.find(S+'sheetData'); count=len(rows)
+    if not 2<=count<=MAX_ROWS+1: deny('xlsx_merge_row_limit')
+    width=len(rows[0])
+    if not 1<=width<=MAX_COLS or count*width>4096: deny()
+    values=[]
+    for index,row in enumerate(rows,1):
+        book.checkpoint()
+        if row.get('r')!=str(index) or len(row)!=width: deny('xlsx_merge_dense_rows_required')
+        if any(c.get('r')!=colname(i)+str(index) for i,c in enumerate(row,1)): deny()
+        values.append(tuple(cell_value(c,index) for c in row))
+    headers=values[0]
+    if any(v[0]!='text' or not v[1] for v in headers) or len({v[1] for v in headers})!=width: deny('xlsx_merge_headers')
+    names=[v[1] for v in headers]
+    if key not in names or revision not in names or key==revision: deny('xlsx_merge_columns')
+    ki=names.index(key); ri=names.index(revision); records=[]
+    for index,vals in enumerate(values[1:],2):
+        k=vals[ki]; rev=vals[ri]
+        if k[0]!='text' or not 1<=len(k[1])<=256 or k[1]!=k[1].strip(): deny('xlsx_merge_text_key_required')
+        if rev[0]!='number' or rev[1]<0 or rev[1]!=rev[1].to_integral_value() or rev[1]>Decimal('1e15'): deny('xlsx_merge_integer_revision_required')
+        records.append((k[1],rev[1],vals,rows[index-1],index))
+    return root,headers,records
+
+
+def render_merge(base, update, sheet, key, revision, *, checkpoint=lambda:None):
+    """Return NEW package bytes plus finite provenance, without executing formulas."""
+    if any(not isinstance(v,str) or not 1<=len(v)<=64 for v in (sheet,key,revision)): deny()
+    try:
+        left=Book(base,checkpoint=checkpoint);right=Book(update,checkpoint=checkpoint)
+        if set(left.parts)!=set(right.parts) or left.sheets!=right.sheets: deny('xlsx_merge_package_mismatch')
+        if any(p.startswith(('xl/tables/','xl/drawings/','xl/charts/')) or p=='xl/sharedStrings.xml' for p in left.parts): deny('xlsx_merge_crossrow_structure')
+        if left.names or right.names: deny('xlsx_merge_crossrow_structure')
+        for book in (left,right):
+            styles=book.roots.get('xl/styles.xml')
+            xfs=styles.findall(S+'cellXfs') if styles is not None else []
+            if len(xfs)!=1 or not 1<=len(xfs[0])<=256 or any(n.tag!=S+'xf' for n in xfs[0]):deny('xlsx_merge_styles_unsupported')
+            if xfs[0].get('count',str(len(xfs[0])))!=str(len(xfs[0])):deny('xlsx_merge_styles_unsupported')
+            for cells in book.cells.values():
+                for cell in cells.values():
+                    style=cell.get('s','0')
+                    if not re.fullmatch(r'[0-9]{1,3}',style) or int(style)>=len(xfs[0]):deny('xlsx_merge_style_reference')
+            workbook=book.roots['xl/workbook.xml']
+            attrs={'workbook':set(),'workbookPr':set(),'workbookProtection':set(),'bookViews':set(),
+                'workbookView':set('visibility minimized showHorizontalScroll showVerticalScroll showSheetTabs tabRatio firstSheet activeTab autoFilterDateGrouping'.split()),
+                'sheets':set(),'sheet':{'name','sheetId','state',R+'id'},'definedNames':set(),
+                'calcPr':{'calcId','fullCalcOnLoad','forceFullCalc','calcMode'}}
+            children={'workbook':{'workbookPr','workbookProtection','bookViews','sheets','definedNames','calcPr'},'bookViews':{'workbookView'},'sheets':{'sheet'}}
+            for node in workbook.iter():
+                if node.tag not in {S+t for t in attrs}:deny('xlsx_merge_workbook_structure')
+                tag=node.tag[len(S):]
+                if (set(node.attrib)-attrs[tag] or (node.text or '').strip() or (node.tail or '').strip()
+                        or any(n.tag not in {S+t for t in children.get(tag,set())} for n in node)):
+                    deny('xlsx_merge_workbook_structure')
+                if tag!='sheets' and len({n.tag for n in node})!=len(node):deny('xlsx_merge_workbook_structure')
+            if any(n.get('state','visible')!='visible' for n in workbook.findall(S+'sheets/'+S+'sheet')): deny('xlsx_merge_hidden_sheet')
+        part=left.sheets.get(sheet)
+        for p,raw in left.parts.items():
+            if p!=part and not p.startswith('docProps/') and raw!=right.parts[p]: deny('xlsx_merge_package_mismatch')
+        for book in (left,right):
+            for p in book.sheets.values():
+                raw=book.parts[p]
+                if b'<!--' in raw or b'<![CDATA[' in raw or b'<?' in re.sub(br'^<\?xml[^>]*\?>',b'',raw): deny('xlsx_merge_markup_unsupported')
+        lroot,headers,lrows=data_rows(left,sheet,key,revision)
+        rroot,rheaders,rrows=data_rows(right,sheet,key,revision)
+        if headers!=rheaders: deny('xlsx_merge_headers')
+        # Non-data settings are inherited only when identical, excluding dimension.
+        def settings(root):
+            return [ET.tostring(n) for n in root if n.tag not in {S+'sheetData',S+'dimension'}]
+        if settings(lroot)!=settings(rroot): deny('xlsx_merge_sheet_settings')
+        chosen={};order=[];deduplicated=0;replaced=0;seen_versions={}
+        for source,records in (('base',lrows),('update',rrows)):
+            for k,rev,vals,row,index in records:
+                checkpoint()
+                if (k,rev) in seen_versions and seen_versions[k,rev]!=vals: deny('xlsx_merge_equal_revision_conflict')
+                seen_versions[k,rev]=vals
+                if k not in chosen:
+                    order.append(k);chosen[k]=(rev,vals,row,index,source)
+                else:
+                    old=chosen[k]
+                    if rev==old[0]:
+                        if vals!=old[1]: deny('xlsx_merge_equal_revision_conflict')
+                        deduplicated+=1
+                    elif rev>old[0]:
+                        chosen[k]=(rev,vals,row,index,source);replaced+=1
+        if len(order)>MAX_ROWS or (len(order)+1)*len(headers)>4096: deny('xlsx_merge_row_limit')
+        changed={};root=deepcopy(lroot);sd=root.find(S+'sheetData');header=deepcopy(sd[0]);sd.clear();sd.append(header)
+        provenance=[]
+        for newrow,k in enumerate(order,2):
+            checkpoint();rev,vals,oldrow,oldindex,source=chosen[k];row=deepcopy(oldrow);row.set('r',str(newrow))
+            for i,c in enumerate(row,1):
+                c.set('r',colname(i)+str(newrow));f=c.find(S+'f')
+                if f is not None:
+                    f.text=local_formula(f.text,oldindex,newrow)
+                    for v in c.findall(S+'v'): c.remove(v)
+            sd.append(row);provenance.append({'key':k,'source':source,'source_row':oldindex,'output_row':newrow,'revision':str(rev)})
+        dimension=root.find(S+'dimension')
+        if dimension is not None: dimension.set('ref','A1:'+colname(len(headers))+str(len(order)+1))
+        changed[part]=ET.tostring(root,encoding='utf-8',xml_declaration=True)
+        # Only explicit whole-data-column SUM summaries can follow added rows.
+        # No arbitrary formula translation, range inference, or formula evaluation.
+        for name,p in left.sheets.items():
+            if name==sheet: continue
+            old=left.roots[p];worksheet(old);new=deepcopy(old);modified=False
+            for cell in new.iter(S+'c'):
+                fs=cell.findall(S+'f')
+                if not fs:
+                    cell_value(cell,int(re.search(r'[0-9]+$',cell.get('r',''))[0]));continue
+                values=cell.findall(S+'v')
+                if (len(fs)!=1 or fs[0].attrib or len(fs[0]) or cell.get('t','n')!='n'
+                        or cell.findall(S+'is') or len(values)>1 or any(v.attrib or len(v) for v in values)):deny()
+                formula=fs[0].text or ''
+                qualified="(?:"+re.escape(sheet)+"|'"+re.escape(sheet.replace("'","''"))+"')"
+                match=re.fullmatch(r'(?i:SUM)\('+qualified+r'!(?P<column>[A-Z]{1,3})2:(?P=column)'+str(len(lrows)+1)+r'\)',formula)
+                if not match or match[1] not in [colname(i) for i in range(1,len(headers)+1)]: deny('xlsx_merge_summary_unsupported')
