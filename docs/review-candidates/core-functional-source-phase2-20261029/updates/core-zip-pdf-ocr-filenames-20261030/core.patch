+            raise LocalOCRFailure(payload['error'] if payload['error'] in allowed else 'local_ocr_failed')
+        if (set(payload) != {'text', 'metadata'} or not isinstance(payload['text'], str)
+                or not isinstance(payload['metadata'], dict)):
+            raise LocalOCRFailure('local_ocr_invalid_output')
