+        after = os.fstat(fd)
+        named = os.stat(path, follow_symlinks=False)
+        fields = ('st_dev', 'st_ino', 'st_mode', 'st_uid', 'st_nlink', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
+        identity = lambda value: tuple(getattr(value, field) for field in fields)
+        if (len(data) != before.st_size or identity(before) != identity(after)
+                or identity(after) != identity(named)):
+            raise LocalOCRFailure('local_ocr_invalid_output')
+        return data
+    finally:
+        os.close(fd)
+
+
+def extract_local_pdf(data):
+    if not isinstance(data, bytes) or not 0 < len(data) <= MAX_INPUT:
+        raise LocalOCRFailure('input_limit')
+    toolchain = _toolchain()
+    work = Path(tempfile.mkdtemp(prefix='friday-local-ocr-'))
+    try:
+        work.chmod(0o700)
+        (work / 'input.pdf').write_bytes(data)
+        (work / 'input.pdf').chmod(0o600)
