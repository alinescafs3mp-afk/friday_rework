+        if (not -1 <= confidence <= 100 or len(text) > 4096
+                or any(ord(ch) < 32 for ch in text)):
+            raise LocalOCRFailure('local_ocr_failed')
+        key = tuple(int(row[x]) for x in ('block_num', 'par_num', 'line_num'))
+        rows.append((key, text, confidence))
+    return rows
+
+
+def _recognized(rows):
+    lines, last, current, uncertain, numbers = [], None, [], 0, 0
+    for key, text, confidence in rows:
+        if key != last and current:
+            lines.append(' '.join(current)); current = []
+        last = key
+        # An OCR score is not calibrated certainty. Numeric fields ALWAYS stay
+        # explicitly unverified; lost/occluded digits cannot be reconstructed.
+        if confidence < 80:
+            uncertain += 1
+        if any(ch.isdigit() for ch in text):
+            numbers += 1
+            text = '[unverified OCR numeric token: ' + text + ']'
+        elif confidence < 80:
+            text = '[uncertain OCR token: ' + text + ']'
+        current.append(text)
+    if current:
+        lines.append(' '.join(current))
+    return '\n'.join(lines), uncertain, numbers
+
+
+def _child():
+    os.umask(0o077)
+    os.sched_setaffinity(0, sorted(os.sched_getaffinity(0))[:2])
+    for key, value in ((resource.RLIMIT_AS, 768 * 1024**2), (resource.RLIMIT_CPU, CPU_SECONDS),
+                       (resource.RLIMIT_FSIZE, 12 * 1024**2), (resource.RLIMIT_CORE, 0),
+                       (resource.RLIMIT_NOFILE, 64), (resource.RLIMIT_NPROC, 32)):
+        resource.setrlimit(key, (value, value))
+    # RLIMIT_CPU is per process; the single namespace worker also enforces a
+    # cumulative reaped-child CPU budget before each page/orientation launch.
+    deadline = time.monotonic() + WALL_SECONDS - 2
+    env = {'PATH': '/usr/bin:/bin', 'HOME': '/work', 'TMPDIR': '/tmp',
+           'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8', 'OMP_THREAD_LIMIT': '2',
+           'OMP_NUM_THREADS': '2', 'TESSDATA_PREFIX': PREFIX + '/usr/share/tesseract-ocr/5/tessdata',
+           'LD_LIBRARY_PATH': PREFIX + '/usr/lib/x86_64-linux-gnu'}
+    def budget():
+        usage = resource.getrusage(resource.RUSAGE_CHILDREN)
+        own = resource.getrusage(resource.RUSAGE_SELF)
+        if usage.ru_utime + usage.ru_stime + own.ru_utime + own.ru_stime > CPU_SECONDS - 2:
+            raise LocalOCRFailure('local_ocr_timeout')
+    _execute(['/usr/bin/pdfinfo', '/input.pdf'], '/work/info', env, deadline)
+    info = Path('/work/info').read_bytes()
+    page_lines = re.findall(rb'^Pages:\s+([1-9][0-9]*)\s*$', info, re.MULTILINE)
+    if len(info) > 8192 or len(page_lines) != 1:
+        raise LocalOCRFailure('malformed_or_unsupported')
+    count = int(page_lines[0])
+    if count > MAX_PAGES:
+        raise LocalOCRFailure('pdf_page_limit')
+    _execute(['/usr/bin/pdftotext', '/input.pdf', '-'], '/work/text', env, deadline)
+    plain = Path('/work/text').read_bytes()
+    if len(plain) > MAX_OUTPUT:
+        raise LocalOCRFailure('extracted_text_limit')
+    pages = plain.decode('utf-8').split('\f')
+    if len(pages) == count + 1 and not pages[-1].strip():
+        pages.pop()
+    if len(pages) != count or any(re.search(r'\[page \d+|\[PDF extraction warning:', page) for page in pages):
+        raise LocalOCRFailure('malformed_or_unsupported')
+    scans = [index for index, text in enumerate(pages) if len(text.strip()) < 20]
+    if len(scans) > MAX_OCR_PAGES:
+        raise LocalOCRFailure('pdf_ocr_page_limit')
+    sections, details = [], []
+    for index, text in enumerate(pages, 1):
+        budget()
+        if index - 1 not in scans:
+            sections.append(f'[page {index}; native text layer; image content not covered]\n' + text.strip())
+            details.append({'page': index, 'method': 'native_text', 'image_coverage': False})
+            continue
+        _execute(['/usr/bin/pdftoppm', '-f', str(index), '-l', str(index), '-singlefile',
+                  '-gray', '-scale-to', str(MAX_EDGE), '/input.pdf', '/work/page'],
+                 '/work/render-log', env, deadline)
+        width, height, pixels = _pgm_read('/work/page.pgm')
+        best, best_score, angle = [], -1, 0
+        for rotation in range(4):
+            budget()
+            Path('/work/rotation.pgm').write_bytes(f'P5\n{width} {height}\n255\n'.encode() + pixels)
+            _execute([PREFIX + '/usr/bin/tesseract', '/work/rotation.pgm', 'stdout',
+                      '-l', 'rus+eng', '--psm', '6', 'tsv'], '/work/ocr.tsv', env, deadline)
+            raw = Path('/work/ocr.tsv').read_bytes()
+            if len(raw) > MAX_OUTPUT:
+                raise LocalOCRFailure('extracted_text_limit')
+            rows = _tokens(raw)
+            score = sum(max(conf - 40, 0) * min(sum(ch.isalnum() for ch in token), 12)
+                        for _, token, conf in rows)
+            if score > best_score:
+                best, best_score, angle = rows, score, rotation * 90
+            width, height, pixels = _rotate(width, height, pixels)
+        recognized, uncertain, numbers = _recognized(best)
+        preserved = ('[native text layer fragments]\n' + text.strip() + '\n[local OCR candidate]\n') if text.strip() else ''
+        sections.append(f'[page {index}; local OCR candidate; NOT exact source text; rotation {angle} degrees]\n'
+                        + preserved + (recognized or '[no legible OCR text; page content unavailable]'))
+        details.append({'page': index, 'method': 'local_ocr', 'rotation_degrees': angle,
+                        'native_text_preserved': bool(text.strip()),
+                        'low_confidence_tokens': uncertain, 'unverified_numeric_tokens': numbers,
+                        'text_found': bool(recognized), 'exact': False})
+    warning = ('Local OCR is an uncertain transcription, not exact source text. Numeric tokens are '
+               'UNVERIFIED, including high-confidence OCR: digits may be lost or guessed. Do not '
+               'invent or confirm obscured digits, totals, dates, or exact quotations from OCR. '
+               'Report unreadable or ambiguous characters explicitly; request a clearer source '
+               'when exact values matter. Native text and OCR do not establish image/layout coverage.')
+    text = '[PDF extraction warning: ' + warning + ']\n\n' + '\n\n'.join(sections)
+    metadata = {'method': 'local_pdf_ocr', 'pages': count, 'page_results': details,
+                'coverage': 'native_text_and_uncertain_local_ocr; images_and_layout_not_covered',
+                'ocr_exact': False, 'numeric_values_verified': False, 'warning': warning,
+                'page_coverage': 'all_pages_processed', 'content_completeness': 'unverified',
+                'pages_without_text': [row['page'] for row in details if not row.get('text_found', True)]}
+    payload = json.dumps({'text': text, 'metadata': metadata}, ensure_ascii=False).encode()
+    if len(payload) > MAX_OUTPUT:
+        raise LocalOCRFailure('extracted_text_limit')
+    Path('/work/result.json').write_bytes(payload)
+
+
+if __name__ == '__main__':
+    if sys.argv[1:] != ['--child']:
+        raise SystemExit(2)
+    try:
+        _child()
+    except LocalOCRFailure as exc:
+        Path('/work/result.json').write_text(json.dumps({'error': str(exc)}))
+    except BaseException:
+        raise SystemExit(1)
