+    except (OSError, ValueError, TypeError):
+        raise LocalOCRFailure('local_ocr_failed') from None
+    finally:
+        try:
+            shutil.rmtree(work)
+        except OSError:
+            raise LocalOCRFailure('local_ocr_cleanup_unconfirmed') from None
+
