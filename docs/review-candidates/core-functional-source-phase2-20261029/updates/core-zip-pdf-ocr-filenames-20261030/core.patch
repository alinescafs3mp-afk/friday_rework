+             '--ro-bind', str(work / 'input.pdf'), '/work/input.pdf',
+             '--ro-bind', str(work / 'runner.py'), '/work/runner.py',
+             '--ro-bind', str(work / 'input.pdf'), '/input.pdf',
+             '--ro-bind', str(work / 'runner.py'), '/runner.py',
+             '--chdir', '/work', '--remount-ro', '/', '--',
