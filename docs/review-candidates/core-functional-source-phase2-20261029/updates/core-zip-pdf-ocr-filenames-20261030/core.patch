+        subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=stream,
+                       stderr=subprocess.DEVNULL, env=env, check=True,
+                       timeout=min(15, remaining), preexec_fn=limit_cpu)
+
+
+def _pgm_read(path):
+    data = Path(path).read_bytes()
