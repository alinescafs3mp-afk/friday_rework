+        stack.append(name)
+        offset = parser.CurrentByteIndex
+        if stack == [S[1:]+'worksheet', S[1:]+'sheetData', S[1:]+'row', S[1:]+'c']:
+            address = attrs.get('r')
+            if address in values:
+                if address in cells: _deny()
+                current = {'start': offset, 'open_end': _tag_end(raw, offset), 'v': []}
+                cells[address] = current
