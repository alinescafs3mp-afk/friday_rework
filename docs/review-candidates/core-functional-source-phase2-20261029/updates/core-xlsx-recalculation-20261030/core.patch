+def _tag_end(raw, offset):
+    quote = None
+    for index in range(offset, len(raw)):
+        char = raw[index]
+        if quote:
+            if char == quote: quote = None
+        elif char in (34, 39): quote = char
+        elif char == 62: return index+1
+    _deny()
+
