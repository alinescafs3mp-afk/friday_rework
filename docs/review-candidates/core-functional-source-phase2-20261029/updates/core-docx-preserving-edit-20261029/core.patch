+            or info.flag_bits & 1 or info.compress_type not in (ZIP_STORED, ZIP_DEFLATED)
+            or stat.S_ISLNK(info.external_attr >> 16) or info.file_size > MAX_OUTPUT
+            or info.file_size > max(4096, info.compress_size*200)
