+def create_edit(cap, fd, leaf, path, content):
+    """Unique literal body/table paragraph edit; new name, original never opened writable."""
+    from hermes_cli.friday_user_scope import workspace_document
+    check(cap)
+    _text(content)
+    def pairs(items):
+        value = {}
+        for key, item in items:
+            if key in value: raise ScopeDenied()
+            value[key] = item
+        return value
+    try:
+        spec = json.loads(content, object_pairs_hook=pairs)
+        if not isinstance(spec, dict) or set(spec) != {'source', 'old_text', 'new_text'}: raise ScopeDenied()
+        raw = spec['source']
+        if not isinstance(raw, str) or not raw or '\x00' in raw: raise ScopeDenied()
+        root = cap.home/'workspace'; source = Path(raw)
+        if not source.is_absolute(): source = root/source
+        relative = source.relative_to(root)
+        if (not relative.parts or any(p in ('.', '..') or p.startswith('.') for p in relative.parts)
+                or source.suffix.lower() != '.docx' or relative.as_posix() == path): raise ScopeDenied()
+        data, _, identity = workspace_document(str(source), with_identity=True)
+        rendered = render_edit(data, spec['old_text'], spec['new_text'])
+        def verify():
+            check(cap)
+            current, _, version = workspace_document(str(source), with_identity=True)
+            if current != data or version != identity: raise ScopeDenied()
+        result = json.loads(_create_bytes(cap, fd, leaf, path, rendered, verify_source=verify))
+        if result.get('success'):
+            result.update(source=relative.as_posix(), source_sha256=hashlib.sha256(data).hexdigest(),
+                          replacements=1, unchanged_parts_preserved=True, edit_mode='exact_text')
+        return json.dumps(result)
+    except _EditRefused as error:
+        return json.dumps({'success': False, 'error': 'document_edit_refused', 'reason': str(error),
+                           'effect_disposition': 'none'})
+    except (ValueError, TypeError, KeyError, RecursionError):
+        raise ScopeDenied() from None
