+def _unique_docx_edit(root, old):
+    parents = {child: parent for parent in root.iter() for child in parent}
+    matches = []
+    for paragraph in root.iter(_W+'p'):
+        texts = list(paragraph.iter(_W+'t'))
+        text = ''.join(n.text or '' for n in texts)
+        begin = text.find(old)
+        while begin >= 0:
+            matches.append((paragraph, texts, begin))
+            if len(matches) > 1: raise _EditRefused('ambiguous_match')
+            begin = text.find(old, begin+1)
+    if not matches: raise _EditRefused('match_missing')
+    paragraph, texts, begin = matches[0]; finish = begin+len(old)
+    if parents.get(paragraph) is None or parents[paragraph].tag not in (_W+'body', _W+'tc'):
+        raise _EditRefused('unsupported_structure')
+    if any(n.tag in (_W+'fldChar', _W+'instrText', _W+'fldSimple') for n in paragraph.iter()):
+        raise _EditRefused('field_owned_text')
+    selected = []; cursor = 0
+    for node in texts:
+        value = node.text or ''; end = cursor+len(value)
+        if cursor < finish and end > begin:
+            selected.append((node, max(0, begin-cursor), min(len(value), finish-cursor)))
+        cursor = end
+    return parents, paragraph, selected
