+        raise _EditRefused('anchor_or_structure_boundary')
+    properties = [property_key(r.find(_W+'rPr')) if r.find(_W+'rPr') is not None else None for r in runs]
+    if len(set(properties)) != 1: raise _EditRefused('mixed_run_format')
