+def _check_edit_runs(parents, paragraph, selected):
+    def property_key(node):
+        # XML indentation and attribute ordering do not change run formatting.
+        # Preserve text in extension properties; Word property text is empty.
+        text = node.text
+        if node.tag.startswith(_W) and text is not None and not text.strip(): text = None
