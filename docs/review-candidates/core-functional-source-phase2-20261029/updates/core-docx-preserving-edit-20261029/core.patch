+def _check_edit_fields(root, selected):
+    # Complex Word fields can span paragraphs. A cached field result is not a
+    # literal edit even when its own paragraph has no field delimiter.
+    selected_nodes = {node for node, _, _ in selected}
+    field_depth = 0
+    for node in root.iter():
+        if node.tag == _W+'fldChar':
+            kind = node.get(_W+'fldCharType')
+            if kind == 'begin': field_depth += 1
+            elif kind == 'end': field_depth -= 1
+            elif kind != 'separate': raise _EditRefused('unsupported_structure')
+            if field_depth < 0: raise _EditRefused('unsupported_structure')
+        elif node in selected_nodes and field_depth:
+            raise _EditRefused('field_owned_text')
+    if field_depth: raise _EditRefused('unsupported_structure')
