+def _edit_xml(raw):
+    # UTF-8 only; no entity expansion, DTD, processing instructions or deep XML.
+    if (b'\x00' in raw or b'<!DOCTYPE' in raw.upper() or b'<!ENTITY' in raw.upper()):
+        raise _EditRefused('unsupported_package')
+    parser = expat.ParserCreate(encoding='UTF-8', namespace_separator='}')
+    depth = count = 0
+    spans = []
+    active = None
+    def start(name, attrs):
+        nonlocal depth, count, active
+        depth += 1; count += 1
+        if depth > 128 or count > 100000:
+            raise _EditRefused('package_capacity')
+        if name == _W[1:]+'t':
+            if active is not None: raise _EditRefused('unsupported_structure')
+            offset = parser.CurrentByteIndex
+            quote = None
+            for end in range(offset, len(raw)):
+                byte = raw[end]
+                if quote is not None:
+                    if byte == quote: quote = None
+                elif byte in (34, 39): quote = byte
+                elif byte == 62: break
+            else: raise _EditRefused('invalid_package')
+            active = (end+1, raw[offset:end].rstrip().endswith(b'/'))
+    def end(name):
+        nonlocal depth, active
+        if name == _W[1:]+'t':
+            begin, empty = active
+            spans.append((begin, begin if empty else parser.CurrentByteIndex, empty))
+            active = None
+        depth -= 1
+    def refuse(*args): raise _EditRefused('unsupported_package')
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.StartDoctypeDeclHandler = refuse
+    parser.EntityDeclHandler = refuse
+    parser.ProcessingInstructionHandler = refuse
+    parser.XmlDeclHandler = lambda version, encoding, standalone: (
+        refuse() if encoding and encoding.upper() not in ('UTF-8', 'UTF8', 'US-ASCII') else None)
+    parser.Parse(raw, True)
+    return ET.fromstring(raw), spans
