+def _worker_python(project_root):
+    """Use the parent's activated PM generation in the isolated child.
+
+    PM activation adds site-packages without changing sys.executable. Select
+    once and require that generation to be already loaded; never switch an
+    existing parent to a newly selected environment or trust shell overrides.
+    Keep bin/python lexical: resolving its symlink loses venv activation.
+    """
+    try:
+        from pm.environments import committed_venv, site_packages, venv_python
+        environment = committed_venv(project_root)
+        if environment is None:
+            return sys.executable
+        selected = site_packages(environment).resolve()
+        if not any(Path(entry).resolve() == selected for entry in sys.path if entry):
+            raise CodecUnavailable('codec_unavailable')
+        python = venv_python(environment)
+        if not (environment / 'pyvenv.cfg').is_file() or not python.is_file():
+            raise CodecUnavailable('codec_unavailable')
+        return str(python)
+    except (ImportError, OSError, RuntimeError, ValueError, TypeError, KeyError, AttributeError):
+        raise CodecUnavailable('codec_unavailable') from None
+
+
