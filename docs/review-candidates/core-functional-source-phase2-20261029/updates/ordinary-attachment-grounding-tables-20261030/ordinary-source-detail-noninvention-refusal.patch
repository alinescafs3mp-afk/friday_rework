+def source_detail_noninvention_spans(text):
+    """Exclude only a local refusal to invent absent source details, never a task.
+
+    A separate refusal span remains terminal. This classifies wording only; it
+    neither verifies the claim of absence nor establishes semantic acceptance.
+    """
+    details = r'(?:детал\w*|подробност\w*|сведени\w*|информаци\w*|данн\w*)'
+    source = r'(?:источник\w*|документ\w*|текст\w*|материал\w*)'
+    absent = (rf'\b{details}\b[^.!?\n]{{0,140}}\bв\s+{source}\s+нет\b'
+              rf'|\bв\s+{source}\s+нет\b[^.!?\n]{{0,140}}\b{details}\b')
+    noninvent = (rf'\b(?:придумывать|выдумывать|додумывать)\s+'
+                 rf'(?:их|это|(?:эти|такие|недостающие|отсутствующие)\s+{details})\s+не\s+буду\b'
+                 rf'|\bне\s+буду\s+(?:их\s+)?(?:придумывать|выдумывать|додумывать)'
+                 rf'(?:\s+(?:их|это|(?:эти|такие|недостающие|отсутствующие)\s+{details}))?\b')
+    security = r'\b(?:доступ\w*|прав(?:а|ами|ом|о|ам|е)?|секрет\w*|конфиденц\w*|парол\w*|токен\w*|безопасност\w*|политик\w*|запрещ\w*)\b'
+    result = []
+    for sentence in re.finditer(r'[^.!?\n]+(?:[.!?]|$)', text):
+        local = sentence.group()
+        if re.search(absent, local, re.I) and not re.search(security, local, re.I):
+            result.extend(re.compile('(?:' + noninvent + r')(?=\s*[,;.!?]|$)', re.I).finditer(text, sentence.start(), sentence.end()))
+    return result
+
