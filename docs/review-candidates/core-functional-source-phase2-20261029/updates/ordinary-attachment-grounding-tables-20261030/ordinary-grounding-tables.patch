+"""Preserve rectangular ordinary-user text tables through Telegram MarkdownV2."""
+
+import re
+
+# Keep existing fenced code (including unfinished streaming code) byte-for-byte.
+_FENCED = re.compile(r"(```[\s\S]*?(?:```|$)|~~~[\s\S]*?(?:~~~|$))")
+_DIVIDER = re.compile(r":?-{3,}:?")
+
+
+def _cells(line: str) -> list[str]:
+    stripped = line.strip()
+    if not (stripped.startswith("|") and stripped.endswith("|")):
+        return []
+    return [cell.strip() for cell in re.split(r"(?<!\\)\|", stripped[1:-1])]
+
+
+def _fence_tables(text: str) -> str:
+    lines = text.split("\n")
+    out = []
+    i = 0
+    while i < len(lines):
+        header = _cells(lines[i])
+        divider = _cells(lines[i + 1]) if i + 1 < len(lines) else []
+        if (len(header) >= 2 and len(divider) == len(header)
+                and all(_DIVIDER.fullmatch(cell) for cell in divider)):
+            j = i + 2
+            while j < len(lines) and lines[j].strip().startswith("|"):
+                j += 1
+            rows = [_cells(row) for row in lines[i + 2:j]]
+            if rows and all(len(row) == len(header) for row in rows):
+                # The adapter's existing code-block escape and splitter own the
+                # Telegram representation and length limits after this step.
+                out.extend(["```text", *lines[i:j], "```"])
+                i = j
+                continue
+        out.append(lines[i])
+        i += 1
+    return "\n".join(out)
+
+
+def preserve_text_tables(text: str) -> str:
+    """Fence complete pipe tables, leaving code, prose and malformed blocks alone."""
+    if "|" not in text:
+        return text
+    return "".join(part if index % 2 else _fence_tables(part)
+                   for index, part in enumerate(_FENCED.split(text)))
+
+
+def ordinary_text_tables(text: str) -> str:
+    """Apply column preservation only for the existing ordinary audience."""
+    from hermes_cli.friday_user_scope import ordinary_presentation
+    return preserve_text_tables(text) if ordinary_presentation() else text
+
+
+def ordinary_table_split_formatting(text: str) -> bool:
+    """Budget ordinary text tables after escaping, including existing text fences."""
+    from hermes_cli.friday_user_scope import ordinary_presentation
+    if not ordinary_presentation():
+        return False
+    if preserve_text_tables(text) != text:
+        return True
+    for match in re.finditer(r"(?m)^[ \t]*```(?:text)?[ \t]*\r?\n([\s\S]*?)^[ \t]*```[ \t]*\r?$", text):
+        body = match.group(1)
+        if _fence_tables(body) != body:
+            return True
+    return False
