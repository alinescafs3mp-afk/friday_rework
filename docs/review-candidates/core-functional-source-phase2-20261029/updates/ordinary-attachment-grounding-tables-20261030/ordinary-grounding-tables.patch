+@pytest.mark.asyncio
+@pytest.mark.parametrize("fenced", [False, True])
+async def test_long_stream_finalize_keeps_columns_escaping_and_limit(adapter, ordinary, fenced):
+    adapter.MAX_MESSAGE_LENGTH = 256
+    adapter._bot.edit_message_text = AsyncMock()
+    rows = [f"| Changed | section-{i} | old😀-{i} | new\\{i}`! |" for i in range(20)]
+    table = "| Kind | Location | v1 | v2 |\n|---|---|---|---|\n" + "\n".join(rows)
+    content = "```text\n" + table + "\n```" if fenced else table
+    result = await adapter.edit_message("123", "456", content, finalize=True)
+    assert result.success
+    calls = [adapter._bot.edit_message_text.call_args, *adapter._bot.send_message.call_args_list]
+    bodies = []
+    assert len(calls) > 1
+    for call in calls:
+        chunk = call.kwargs["text"]
+        assert call.kwargs["parse_mode"] == "MarkdownV2"
+        assert len(chunk.encode("utf-16-le")) // 2 <= adapter.MAX_MESSAGE_LENGTH
+        assert chunk.count("```") == 2
+        match = re.search(r"```[^\n]*\n([\s\S]*?)\n```", chunk)
+        assert match is not None
+        bodies.append(re.sub(r"\\([\\`])", r"\1", match.group(1)))
+    assert "\n".join(bodies) == table
+
