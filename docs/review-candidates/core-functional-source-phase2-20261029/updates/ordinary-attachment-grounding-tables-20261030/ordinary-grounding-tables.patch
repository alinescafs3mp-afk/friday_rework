+"""Ordinary Telegram text tables retain columns through the actual send path."""
+
+import re
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from hermes_constants import get_hermes_home
+from hermes_cli.friday_user_scope import MARKER, ordinary_presentation
+from plugins.platforms.telegram.adapter import TelegramAdapter
+from plugins.platforms.telegram.telegram_text_tables import preserve_text_tables
+
+TABLE = "| Kind | Location | v1 | v2 |\n|---|---|---|---|\n| Changed | Header | 1 | 2 |"
+
+
+@pytest.fixture
+def adapter():
+    result = TelegramAdapter(PlatformConfig(enabled=True, token="fake-token"))
+    result._rich_messages_enabled = False
+    result._bot = MagicMock()
+    result._bot.send_message = AsyncMock(return_value=SimpleNamespace(message_id=1))
+    return result
+
+
+@pytest.fixture
+def ordinary():
+    marker = Path(get_hermes_home()) / MARKER
+    marker.parent.mkdir(parents=True, exist_ok=True)
+    marker.write_text("{}")
+    assert ordinary_presentation()
+    return marker
+
+
+@pytest.mark.asyncio
+async def test_ordinary_table_preserves_columns_in_actual_send(adapter, ordinary):
+    result = await adapter.send("123", "Before.\n\n" + TABLE + "\n\nAfter!", metadata={"notify": True})
+    assert result.success
+    sent = adapter._bot.send_message.call_args.kwargs
+    assert sent["parse_mode"] == "MarkdownV2"
+    assert "```text\n" + TABLE + "\n```" in sent["text"]
+    assert "•" not in sent["text"]
+    assert "Before\\." in sent["text"] and "After\\!" in sent["text"]
+
+
+def test_unscoped_table_retains_existing_bullet_default(adapter, ordinary):
+    ordinary.unlink()
+    assert not ordinary_presentation()
+    result = adapter.format_message(TABLE)
+    assert "• Location: Header" in result
+    assert "```" not in result
+
+
+def test_ordinary_table_code_escaping_and_existing_fence(adapter, ordinary):
+    table = TABLE.replace("| 1 | 2 |", "| `a` \\ b {x}! | [link](url) |")
+    result = adapter.format_message(table)
+    assert r"\`a\` \\ b {x}!" in result
+    assert "[link](url)" in result
+    fenced = "```text\n" + TABLE + "\n```"
+    assert adapter.format_message(fenced) == fenced
+    assert preserve_text_tables(fenced) == fenced
+
+
+@pytest.mark.parametrize("text", [
+    "a | b without a divider",
+    "| a | b |\n|---|---|",  # no data
+    "| a | b |\n|---|---|\n| only one |",
+    "| a | b |\n|---|---|\n| x | y | z |",
+    "| a | b |\n|---|---|\n| x | y |\n| incomplete",
+    "```python\n" + TABLE + "\n```",
+    "```text\n" + TABLE,  # streaming code still open
+    "~~~text\n" + TABLE + "\n~~~",
+])
+def test_non_tables_malformed_tables_and_code_are_not_reinterpreted(text):
+    assert preserve_text_tables(text) == text
+
+
+@pytest.mark.asyncio
+async def test_ordinary_table_split_keeps_fences_columns_and_utf16_limit(adapter, ordinary):
+    adapter.MAX_MESSAGE_LENGTH = 256
+    rows = [f"| Changed | section-{i} | old😀-{i} | new\\{i}`! |" for i in range(20)]
+    table = "| Kind | Location | v1 | v2 |\n|---|---|---|---|\n" + "\n".join(rows)
+    result = await adapter.send("123", table, metadata={"notify": True})
+    assert result.success
+    chunks = [call.kwargs["text"] for call in adapter._bot.send_message.call_args_list]
+    assert len(chunks) > 1
+    bodies = []
+    for chunk in chunks:
+        assert len(chunk.encode("utf-16-le")) // 2 <= adapter.MAX_MESSAGE_LENGTH
+        assert chunk.count("```") == 2
+        assert re.search(r"(?m)^``` ", chunk) is None
+        match = re.search(r"```[^\n]*\n([\s\S]*?)\n```", chunk)
+        assert match is not None
+        bodies.append(re.sub(r"\\([\\`])", r"\1", match.group(1)))
+    reconstructed = "\n".join(bodies)
+    assert reconstructed == table
+
+
