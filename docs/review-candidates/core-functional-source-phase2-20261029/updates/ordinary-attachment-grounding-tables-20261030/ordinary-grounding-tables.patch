+"""Retained upload evidence reaches ordinary model turns without choosing a version."""
+import asyncio
+import hashlib
+import json
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+from gateway import run_attachment_presentation as names
+from gateway.run_turn import GatewayTurnMixin
+from hermes_cli import friday_user_scope as scope
+
+
+def cap(user='user'):
+    return scope.UserScope(
+        authorization_home=Path('/authorization'), home=Path('/profile'), profile='runtime',
+        principal=('telegram', 'transport', '91', user),
+        binding={'platform': 'telegram', 'transport_profile': 'transport', 'account_id': '91',
+                 'user_id': user, 'runtime_profile': 'runtime', 'tools': ['read_file']},
+        directory_identity=(1, 2), admission_generation=1)
+
+
+def metadata(owner, filename='Original.docx', path='received/original.docx'):
+    return {'schema': 'friday.ordinary-attachment-presentations.v1', 'scope': names._scope(owner),
+            'files': [{'path': path, 'sha256': hashlib.sha256(b'original').hexdigest(),
+                       'size_bytes': 8, 'file_name': filename}]}
+
+
+@pytest.fixture
+def admitted(monkeypatch):
+    owner = cap()
+    token = scope._CURRENT.set(owner)
+    monkeypatch.setattr(scope.UserScope, 'check', lambda obj: obj)
+    monkeypatch.setattr(scope, 'check_database', lambda *args: None)
+    try:
+        yield owner
+    finally:
+        scope._CURRENT.reset(token)
+
+
+def parse(note):
+    return json.loads(note.split('\n', 1)[1])
+
+
+def test_only_user_upload_proof_is_actionable_not_assistant_copy(admitted):
+    source = SimpleNamespace(_friday_user_scope=admitted)
+    bad = metadata(admitted, 'AssistantCopy.docx', 'received/copy.docx')
+    row = {'role': 'assistant', 'display_metadata': {names.ATTACHMENT_PRESENTATIONS_KEY: bad}}
+    event = SimpleNamespace(source=source)
+    names.prepare_attachment_presentations(event, source, [row], retained=[metadata(admitted)])
+    note = names.attachment_grounding_note(source, 'exact-session')
+    payload = parse(note)
+    assert payload['user_uploads'] == metadata(admitted)['files']
+    assert payload['session_id'] == 'exact-session'
+    assert payload['index_complete'] is False
+    assert 'AssistantCopy.docx' not in note
+    assert 'session_search' in note and 'role_filter=user' in note and 'read_file' in note
+    assert names.original_document_name(source, admitted, 'received/original.docx', b'original') == 'Original.docx'
+
+
+def test_legacy_absence_and_foreign_scope_do_not_invent_original(admitted):
+    source = SimpleNamespace(_friday_user_scope=admitted)
+    event = SimpleNamespace(source=source)
+    # A legacy text body or a different admission cannot establish filename proof.
+    legacy = {'role': 'user', 'content': "[The user sent a document: '_____.docx'. It is saved at: received/legacy.docx.]"}
+    names.prepare_attachment_presentations(event, source, [legacy], retained=[metadata(cap('other'))])
+    assert parse(names.attachment_grounding_note(source, 'sid'))['user_uploads'] == []
+    source._friday_user_scope = cap('other')
+    assert names.attachment_grounding_note(source, 'sid') is None
+
+
+def test_conflicting_names_omitted_and_note_is_bounded(admitted):
+    source = SimpleNamespace(_friday_user_scope=admitted)
+    event = SimpleNamespace(source=source)
+    retained = [metadata(admitted, 'A.docx'), metadata(admitted, 'B.docx')]
+    retained += [metadata(admitted, f'{i}.docx', f'received/{i}.docx') for i in range(40)]
