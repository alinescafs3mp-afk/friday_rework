+def ordinary_unreadable_clarification(spec, step, expected, message, text):
+    """Keep a local reading limitation as ungraded evidence, not task refusal.
+
+    Ordinary document text replies may ask to clarify an unreadable fragment.
+    A separate refusal marker remains terminal. No fixture identity, truth, request
+    or semantic PASS is encoded here; existing admission/custody stays unchanged.
+    """
+    if (not isinstance(spec, dict) or spec.get('kind') != 'ordinary-document-task'
+            or spec.get('output') is not None
+            or not (isinstance(step.get('input'), dict)
+                    or isinstance(spec.get('source_reference'), dict))
+            or not reply_capture(expected) or expected.get('max_documents') != 0
+            or 'document' in message or not isinstance(text, str)):
+        return False
+    if re.search(r'\b(?:доступ\w*|прав(?:а|ами|ом|о|ам|е)?|секрет\w*|конфиденц\w*|парол\w*|токен\w*|безопасност\w*|политик\w*|запрещ\w*)\b', text, re.I):
+        return False  # Security/access refusals are never reading-ambiguity exemptions.
+    uncertain = list(re.finditer(
+        r'\bне\s+могу\s+(?:(?:над[её]жно|уверенно|однозначно|точно|достоверно)\s+){0,2}'
+        r'(?:разобрать|прочитать|распознать|определить|восстановить)\b[^\n.!?]{0,120}'
+        r'\b(?:цифр\w*|букв\w*|символ\w*|знак\w*|фрагмент\w*|ячейк\w*)\b', text, re.I))
+    refusals = list(REFUSAL.finditer(text))
+    return (bool(uncertain) and bool(refusals)
+            and all(any(span.start() <= refusal.start() and refusal.end() <= span.end()
+                        for span in uncertain) for refusal in refusals)
+            and bool(re.search(r'\b(?:уточните|подтвердите|пришлите)\b', text, re.I)))
 
 
