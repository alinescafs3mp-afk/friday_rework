+def source_quote_unavailability_spans(text):
+    """Only a local inability to quote a source whose attempted reading failed.
+
+    This is wording classification, not proof of the claim or semantic success.
+    A separate task/access/security refusal is still terminal, including one in
+    the same sentence. Unrelated topic words elsewhere grant no exemption.
+    """
+    source = r'(?:страниц\w*|источник\w*|документ\w*|текст\w*)'
+    failed = (rf'\b{source}\b[^.!?\n]{{0,160}}\bне\s+откр\w*\b'
+              rf'|\b(?:попытк\w*|извлечени\w*|чтени\w*)\b[^.!?\n]{{0,80}}\bошибк\w*\b')
+    quote = re.compile(r'\b(?:дословно\s+)?(?:процитировать|цитировать)\s+'
+                       r'(?:е[её]|его|этот\s+текст|эту\s+страницу)\s+не\s+могу\b', re.I)
+    protected = r'\b(?:доступ\w*|прав(?:а|ами|ом|о|ам|е)?|секрет\w*|конфиденц\w*|парол\w*|токен\w*|безопасност\w*|политик\w*|запрещ\w*|access|security|policy)\b'
+    spans = []
+    for sentence in re.finditer(r'[^.!?\n]+(?:[.!?]|$)', text):
+        local = sentence.group()
+        if re.search(failed, local, re.I) and not re.search(protected, local, re.I):
+            spans.extend(quote.finditer(text, sentence.start(), sentence.end()))
+    return spans
+
