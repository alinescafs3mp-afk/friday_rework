diff --git a/tests/test_native_admin_retained_review.py b/tests/test_native_admin_retained_review.py
new file mode 100644
index 0000000000000000000000000000000000000000..564dceba6b13665b89338af62580b00c95bd3d80
--- /dev/null
+++ b/tests/test_native_admin_retained_review.py
@@ -0,0 +1,65 @@
+"""Focused retained native-admin authority review on real temporary stores."""
+import contextvars
+
+import pytest
+
+from hermes_cli import friday_product_access as policy
+from test_operator_metadata_controls import REFUSALS, engaged, snapshot
+from test_user_onboarding import env as env
+from test_admin_foundation import ProductAccess
+from friday_admin_controls.operator_metadata import native_admin_write
+
+
+def retained(env):
+    engaged(env)
+    with env.admin.scope('default') as root:
+        state = env.admin._state()
+        with native_admin_write(env.admin, 'default', root, state):
+            access = ProductAccess(state)
+            assert access.users()
+            copied = contextvars.copy_context()
+            with pytest.raises(REFUSALS):
+                copied.run(access.users)
+            assert access.users()
+    return access, state, root
+
+
+def test_retained_native_admin_expires_before_read_or_write(env):
+    access, state, root = retained(env)
+    before = snapshot(env.home)
+    document = policy.current_access(state)
+    for invoke in (access.users, lambda: access.store.state_get(policy.KEY),
+                   lambda: access.store.state_set(policy.KEY, document)):
+        with pytest.raises(REFUSALS):
+            invoke()
+        assert snapshot(env.home) == before
+
+
+def test_retained_native_admin_cannot_use_later_authority(env):
+    access, state, root = retained(env)
+    before = snapshot(env.home)
+    with env.admin.scope('default') as current_root:
+        assert current_root == root
+        with native_admin_write(env.admin, 'default', current_root, state):
+            with pytest.raises(REFUSALS):
+                access.store.state_get(policy.KEY)
+            with pytest.raises(REFUSALS):
+                access.users()
+    assert snapshot(env.home) == before
+
+
+def test_native_admin_namespace_and_state_identity_stay_pinned(env):
+    access, state, root = retained(env)
+    before = snapshot(env.home)
+    with env.admin.scope('default') as current_root:
+        with native_admin_write(env.admin, 'default', current_root, state):
+            original = state._data_namespace
+            object.__setattr__(state, '_data_namespace', 'foreign_namespace_canary')
+            try:
+                with pytest.raises(REFUSALS):
+                    access.store.state_get(policy.KEY)
+            finally:
+                object.__setattr__(state, '_data_namespace', original)
+            with pytest.raises(REFUSALS):
+                access.store.state_get(policy.KEY)
+    assert snapshot(env.home) == before
