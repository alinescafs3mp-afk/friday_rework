+"""Verified original filenames as presentation-only metadata for ordinary delivery."""
+from __future__ import annotations
+
+import hashlib
+import re
+import unicodedata
+from pathlib import PurePosixPath
+
+ATTACHMENT_PRESENTATIONS_KEY = "friday_attachment_presentations"
+_SCHEMA = "friday.ordinary-attachment-presentations.v1"
+_SOURCE_ATTR = "_friday_original_document_names"
+
+
+def _safe_name(value):
+    if not isinstance(value, str) or not 0 < len(value) <= 255:
+        return None
+    name = "".join(
+        "_" if char in "/\\" or unicodedata.category(char) in {"Cc", "Cf", "Zl", "Zp"} else char
+        for char in value
+    ).strip()
+    return name if name and name not in {".", ".."} else None
+
+
+def _scope(cap):
+    from hermes_cli.friday_user_scope import _fingerprint
+    return {
+        "principal": cap.key,
+        "profile": cap.profile,
+        "binding_sha256": _fingerprint(cap.binding),
+    }
+
+
+def _relative_path(value):
+    if not isinstance(value, str):
+        return None
+    path = PurePosixPath(value)
+    if len(path.parts) != 2 or path.parts[0] != "received" or path.as_posix() != value:
+        return None
+    return value
+
+
+def _file_record(path, content, name):
+    if (not isinstance(content, dict) or set(content) != {"size_bytes", "sha256"}
+            or type(content["size_bytes"]) is not int or not 0 <= content["size_bytes"] <= 1_000_000
+            or not isinstance(content["sha256"], str)
+            or re.fullmatch(r"[0-9a-f]{64}", content["sha256"]) is None):
+        return None
+    path, name = _relative_path(path), _safe_name(name)
+    if path is None or name is None:
+        return None
+    return {
+        "path": path,
+        "sha256": content["sha256"],
+        "size_bytes": content["size_bytes"],
+        "file_name": name,
+    }
+
+
+def _current_metadata(event, source, cap):
+    from hermes_cli.friday_user_scope import _same_scope
+    owned = getattr(event, "_friday_owned_attachment_paths", None)
+    if not isinstance(owned, tuple) or len(owned) != 2:
+        return None
+    owner, paths = owned
+    if (not _same_scope(owner, cap)
+            or not _same_scope(getattr(source, "_friday_user_scope", None), cap)
+            or not _same_scope(getattr(event.source, "_friday_user_scope", None), cap)
+            or not isinstance(paths, frozenset) or not 0 < len(paths) <= 64):
+        return None
+    from gateway.run_inbound_media import owned_attachment_model_path
+    receipts = getattr(event, "_telegram_media_receipts", None)
+    if not isinstance(receipts, dict):
+        return None
+    files = []
+    for path in sorted(paths):
+        relative = owned_attachment_model_path(event, path)
+        receipt = receipts.get(path)
+        if relative is None or not isinstance(receipt, dict):
+            return None
+        presentation = receipt.get("presentation")
+        original = presentation.get("original_filename") if isinstance(presentation, dict) else None
+        if original is None:
+            continue
+        record = _file_record(relative, receipt.get("content"), original)
+        if record is not None:
+            files.append(record)
+    if not files:
+        return None
+    return {"schema": _SCHEMA, "scope": _scope(cap), "files": files}
+
+
+def _metadata_files(value, cap):
+    if (not isinstance(value, dict) or set(value) != {"schema", "scope", "files"}
+            or value["schema"] != _SCHEMA or value["scope"] != _scope(cap)
+            or not isinstance(value["files"], list) or not 0 < len(value["files"]) <= 64):
+        return []
+    files = []
+    for item in value["files"]:
+        if not isinstance(item, dict) or set(item) != {"path", "sha256", "size_bytes", "file_name"}:
+            continue
+        record = _file_record(
+            item["path"],
+            {"size_bytes": item["size_bytes"], "sha256": item["sha256"]},
+            item["file_name"],
+        )
+        if record is not None:
+            files.append(record)
+    return files
+
+
+def prepare_attachment_presentations(event, source, history):
+    """Index existing transcript proof once per turn; never read history during delivery."""
+    from hermes_cli.friday_user_scope import ordinary_file_scope
+    cap = ordinary_file_scope()
+    setattr(source, _SOURCE_ATTR, (cap, {}))
+    if cap is None:
+        return None
+    current = _current_metadata(event, source, cap)
+    records = []
+    if isinstance(history, list):
+        for row in history:
+            if not isinstance(row, dict) or row.get("role") != "user":
+                continue
+            display = row.get("display_metadata")
+            if isinstance(display, dict):
+                records.extend(_metadata_files(display.get(ATTACHMENT_PRESENTATIONS_KEY), cap))
+    if current is not None:
+        records.extend(current["files"])
+    candidates = {}
+    for record in records:
+        key = (record["path"], record["sha256"], record["size_bytes"])
+        candidates.setdefault(key, set()).add(record["file_name"])
+    names = {key: next(iter(values)) for key, values in candidates.items() if len(values) == 1}
+    setattr(source, _SOURCE_ATTR, (cap, names))
+    return current
+
+
+def original_document_name(source, cap, relative, data):
+    """Return a name only for the same scoped path and immutable original bytes."""
+    from hermes_cli.friday_user_scope import _same_scope
+    owner, names = getattr(source, _SOURCE_ATTR, (None, {}))
+    if not _same_scope(owner, cap) or not isinstance(names, dict):
+        return None
+    key = (relative, hashlib.sha256(data).hexdigest(), len(data))
+    return names.get(key)
