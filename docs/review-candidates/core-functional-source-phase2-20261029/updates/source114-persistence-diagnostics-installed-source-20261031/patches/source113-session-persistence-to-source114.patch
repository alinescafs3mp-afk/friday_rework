 # --- flush phases (module-level so the flush also works bound onto duck-typed agents) ---
+
+def _db_exception_metadata(error):
+    """Bounded source locations and exception types; never exception text/locals."""
+    def identifier(value):
+        return value if isinstance(value, str) and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.<>-]{0,159}", value) else "unknown"
+    result, seen = [], set()
+    while isinstance(error, BaseException) and id(error) not in seen and len(result) < 4:
+        seen.add(id(error))
+        kind = type(error)
+        item = {"exception_class": identifier(kind.__module__) + "." + identifier(kind.__qualname__)}
+        trace = error.__traceback__
+        while trace is not None and trace.tb_next is not None:
+            trace = trace.tb_next
+        if trace is not None:
+            item["place"] = {"module": identifier(trace.tb_frame.f_globals.get("__name__")),
+                "function": identifier(trace.tb_frame.f_code.co_name), "line": trace.tb_lineno}
+        result.append(item)
+        error = error.__cause__ if error.__cause__ is not None else error.__context__
+    return result
+
+
+def _db_flush_failure_metadata(agent, error):
+    # The native inbound platform ID is set by turn_context, never model prose.
+    # Hash the tuple rather than logging a session/principal/platform identifier.
+    session_id = getattr(agent, "session_id", None)
+    platform_id = getattr(agent, "_persist_user_message_platform_id", None)
+    correlation = None
+    if (type(session_id) is str and 0 < len(session_id) <= 512
+            and type(platform_id) in (str, int) and 0 < len(str(platform_id)) <= 512):
+        pair = [session_id, str(platform_id)]
+        correlation = hashlib.sha256(json.dumps(pair, ensure_ascii=True, separators=(",", ":")).encode()).hexdigest()
+    phases = {"ensure_session", "collect_rows", "build_row", "guard_generated_rows",
+              "append_messages_batch", "sync_flushed_markers", "drop_shadowed_checkpoints"}
+    phase = getattr(agent, "_db_flush_phase", None)
+    reason = getattr(agent, "_friday_reply_withheld_reason", None)
+    reasons = {"unsupported_self_deployment_claim", "restricted_deployment_value", "privacy_boundary_unavailable"}
+    details = {"schema": "friday.persistence-failure.v1", "request_correlation_sha256": correlation,
+               "phase": phase if phase in phases else "unknown", "exception_chain": _db_exception_metadata(error),
+               "reply_boundary_reason": reason if reason in reasons else None}
+    boundary = getattr(agent, "_friday_reply_boundary_failure", None)
+    if isinstance(boundary, list):
+        details["reply_boundary_exception_chain"] = boundary
+    return details
+
 
