+        expected = {'LoadState': 'loaded', 'ActiveState': 'inactive', 'SubState': 'dead',
+            'MainPID': '0', 'ControlPID': '0', 'ControlGroup': '', 'InvocationID': ''}
+        _require(len(rows) == len(expected) and all(len(row) == 2 for row in rows)
