+"""Private, bounded Basic session tombstones; no tokens or passwords at rest.
+
+The directory is an authority boundary. Never repair/reset missing or invalid state
+automatically: restore a verified complete backup, or deliberately provision a new
+directory (new store id invalidates previously issued sid-bearing credentials).
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import fcntl
+import hashlib
+import hmac
+import json
+import os
+from pathlib import Path
+import secrets
+import stat
+import time
+
+from hermes_cli.dashboard_auth import ProviderError
+
+_MAX_BYTES = 8 * 1024 * 1024
+_MAX_RECORDS = 100000
+
+
+class SessionStore:
+    def __init__(self, path: str | Path, secret: bytes):
+        self.path = Path(os.path.abspath(os.fspath(path)))
+        self.anchor = self.path.with_name(self.path.name + ".anchor")
+        self.key = hmac.new(secret, b"dashboard-basic-session-store-v1", hashlib.sha256).digest()
+        # Do not silently follow a redirected custody path, including ancestors.
+        for part in reversed((self.path, *self.path.parents)):
+            try:
+                if stat.S_ISLNK(part.lstat().st_mode):
+                    raise ProviderError("Basic session store path contains a symlink")
+            except FileNotFoundError:
+                pass
+        try:
+            os.mkdir(self.path, 0o700)
+            created = True
+        except FileExistsError:
+            created = False
+        except OSError as exc:
+            raise ProviderError("Basic session store directory unavailable") from exc
+        self.identity = None
+        self.lock_identity = None
+        self.store_id = None
+        try:
+            with self._directory() as directory:
+                if created:
+                    lock = os.open("lock", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+                                   0o600, dir_fd=directory)
+                    os.fsync(lock)
+                    os.close(lock)
+                    os.fsync(directory)
+                with self._locked(directory):
+                    if created:
+                        state = {"version": 1, "store_id": secrets.token_hex(16), "sessions": {}, "revoked": {}}
+                        # Sibling anchor survives loss of the ledger directory. Never
+                        # recreate it for an existing store, nor overwrite an old anchor.
+                        self._create_anchor(state["store_id"])
+                        self._write(directory, state)
+                    else:
+                        state = self._read(directory)
+                    self.store_id = state["store_id"]
+                    self._check_anchor()
+        except (OSError, ValueError, TypeError, KeyError) as exc:
+            raise ProviderError("Basic session store unavailable; restore verified state") from exc
+
+    @contextmanager
+    def _directory(self):
+        descriptor = os.open(self.path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        try:
+            info = os.fstat(descriptor)
+            if info.st_uid != os.geteuid() or info.st_mode & 0o077:
+                raise ProviderError("Basic session store must be private and owned by the process user")
+            identity = (info.st_dev, info.st_ino)
+            if self.identity is not None and identity != self.identity:
+                raise ProviderError("Basic session store directory was replaced")
+            self.identity = identity
+            yield descriptor
+        finally:
+            os.close(descriptor)
+
+    @staticmethod
+    def _private_file(descriptor):
+        info = os.fstat(descriptor)
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
+                or info.st_mode & 0o077 or info.st_nlink != 1):
+            raise ProviderError("Basic session store file custody is invalid")
+        return info
+
+    @contextmanager
+    def _locked(self, directory):
+        descriptor = os.open("lock", os.O_RDWR | os.O_NOFOLLOW, dir_fd=directory)
+        try:
+            info = self._private_file(descriptor)
+            identity = (info.st_dev, info.st_ino)
+            if self.lock_identity is not None and identity != self.lock_identity:
+                raise ProviderError("Basic session store lock was replaced")
+            self.lock_identity = identity
+            deadline = time.monotonic() + 1.0
+            while True:
+                try:
+                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                    break
+                except BlockingIOError:
+                    if time.monotonic() >= deadline:
+                        raise ProviderError("Basic session store lock timed out")
+                    time.sleep(0.01)
+            named = os.stat("lock", dir_fd=directory, follow_symlinks=False)
+            if (named.st_dev, named.st_ino) != identity:
+                raise ProviderError("Basic session store lock changed while acquiring it")
+            yield
+        finally:
+            os.close(descriptor)
+
+    @staticmethod
+    def _raw(state):
+        return json.dumps(state, sort_keys=True, separators=(",", ":")).encode()
+
+    def _create_anchor(self, store_id):
+        raw = self._raw({"store_id": store_id, "mac": hmac.new(self.key, store_id.encode(), hashlib.sha256).hexdigest()})
+        descriptor = os.open(self.anchor, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        with os.fdopen(descriptor, "wb") as stream:
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+        parent = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        try:
+            os.fsync(parent)
+        finally:
+            os.close(parent)
+
+    def _check_anchor(self):
+        descriptor = os.open(self.anchor, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        with os.fdopen(descriptor, "rb") as stream:
+            self._private_file(stream.fileno())
+            raw = stream.read(1025)
+        if len(raw) > 1024:
+            raise ValueError("invalid session store anchor")
+        anchor = json.loads(raw)
+        if (anchor["store_id"] != self.store_id
+                or not hmac.compare_digest(anchor["mac"], hmac.new(self.key, self.store_id.encode(), hashlib.sha256).hexdigest())):
+            raise ValueError("session store anchor mismatch")
+
+    def _read(self, directory):
+        descriptor = os.open("state.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+        with os.fdopen(descriptor, "rb") as stream:
+            self._private_file(stream.fileno())
+            raw = stream.read(_MAX_BYTES + 1)
+        if len(raw) > _MAX_BYTES:
+            raise ValueError("session state exceeds bound")
+        envelope = json.loads(raw)
+        state = envelope["state"]
+        expected = hmac.new(self.key, self._raw(state), hashlib.sha256).hexdigest()
+        if not hmac.compare_digest(envelope["mac"], expected):
+            raise ValueError("session state integrity failure")
+        if (set(state) != {"version", "store_id", "sessions", "revoked"}
+                or type(state["version"]) is not int or state["version"] != 1
+                or not isinstance(state["store_id"], str) or len(state["store_id"]) != 32
+                or any(ch not in "0123456789abcdef" for ch in state["store_id"])
+                or not isinstance(state["revoked"], dict) or not isinstance(state["sessions"], dict)
+                or len(state["revoked"]) + len(state["sessions"]) > _MAX_RECORDS):
+            raise ValueError("invalid session state")
+        if self.store_id is not None and state["store_id"] != self.store_id:
+            raise ValueError("session state was replaced")
+        for key, expiry in (*state["revoked"].items(), *state["sessions"].items()):
+            if (not isinstance(key, str) or len(key) > 80
+                    or type(expiry) is not int or expiry <= 0):
+                raise ValueError("invalid session tombstone")
+        return state
+
+    def _write(self, directory, state):
+        envelope = {"state": state, "mac": hmac.new(self.key, self._raw(state), hashlib.sha256).hexdigest()}
+        raw = self._raw(envelope)
+        if len(raw) > _MAX_BYTES or len(state["revoked"]) + len(state["sessions"]) > _MAX_RECORDS:
+            raise ProviderError("Basic session revocation store is full")
+        temporary = ".state-" + secrets.token_hex(16)
+        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+                             0o600, dir_fd=directory)
+        try:
+            with os.fdopen(descriptor, "wb") as stream:
+                stream.write(raw)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, "state.json", src_dir_fd=directory, dst_dir_fd=directory)
+            os.fsync(directory)
+        finally:
+            try:
+                os.unlink(temporary, dir_fd=directory)
+            except FileNotFoundError:
+                pass
+
+    @contextmanager
+    def transaction(self):
+        try:
+            with self._directory() as directory, self._locked(directory):
+                self._check_anchor()
+                state = self._read(directory)
+                yield state
+        except (OSError, ValueError, TypeError, KeyError) as exc:
+            raise ProviderError("Basic session store unavailable; restore verified state") from exc
+
+    def publish(self, state):
+        now = int(time.time())
+        state = dict(state,
+                     revoked={key: expiry for key, expiry in state["revoked"].items() if expiry > now},
+                     sessions={key: expiry for key, expiry in state["sessions"].items() if expiry > now})
+        # Called within transaction; reopen only the same checked directory, retaining flock.
+        with self._directory() as directory:
+            self._write(directory, state)
