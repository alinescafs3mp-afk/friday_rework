+"""Bounded Exa argument and native response phases for keyless MCP."""
+
+import json
+import re
+import time
+
+
+def validate_arguments(tool, arguments, KeylessMCPError):
+    if tool not in ("web_search_exa", "web_fetch_exa"):
+        raise KeylessMCPError("keyless tool refused")
+    if not isinstance(arguments, dict): raise KeylessMCPError("keyless arguments refused")
+    if tool == 'web_search_exa':
+        if (set(arguments) != {'query','numResults'} or not isinstance(arguments['query'], str)
+                or not 1 <= len(arguments['query']) <= 4096
+                or type(arguments['numResults']) is not int or not 1 <= arguments['numResults'] <= 20):
+            raise KeylessMCPError("keyless search bounds refused")
+    else:
+        from urllib.parse import urlsplit
+        import ipaddress
+        urls = arguments.get('urls')
+        if set(arguments) != {'urls'} or not isinstance(urls,list) or len(urls) != 1:
+            raise KeylessMCPError("keyless fetch bounds refused")
+        url_value = urls[0]
+        if not isinstance(url_value,str) or len(url_value)>2048: raise KeylessMCPError("keyless URL refused")
+        u = urlsplit(url_value)
+        try: ipaddress.ip_address(u.hostname or '')
+        except ValueError: pass
+        else: raise KeylessMCPError("keyless IP URL refused")
+        if (u.scheme != 'https' or u.username or u.password or u.port or u.fragment
+                or not u.hostname or '.' not in u.hostname or u.hostname.endswith(('.local','.internal'))
+                or any(ord(c)<=32 for c in url_value) or '\\' in url_value):
+            raise KeylessMCPError("keyless URL refused")
+
+
+def read_response(response, deadline, KeylessMCPError):
+    if response.status_code != 200: raise KeylessMCPError("keyless provider unavailable")
+    if response.headers.get('Content-Encoding','identity') != 'identity':
+        raise KeylessMCPError('keyless encoding refused')
+    if int(response.headers.get('Content-Length', '0')) > 1000000:
+        raise KeylessMCPError("keyless response bound")
+    # The pinned requests/urllib3 native socket is re-bounded to the
+    # remaining whole call time before every bounded read. Refuse
+    # an unsupported transport instead of reading without a bound.
+    sock = response.raw._fp.fp.raw._sock
+    parts = []; size = 0
+    while True:
+        left = deadline - time.monotonic()
+        if left <= 0: raise KeylessMCPError("keyless timeout")
+        sock.settimeout(left)
+        part = response.raw.read1(65536)
+        if not part: break
+        size += len(part)
+        if size > 1000000: raise KeylessMCPError("keyless response bound")
+        parts.append(part)
+    body = b''.join(parts).decode('utf-8')
+    candidates = [body.strip()] if body.lstrip().startswith('{') else [line[5:].strip() for line in re.split(r'\r\n|\r|\n',body) if line.startswith('data:')]
+    if len(candidates) != 1: raise KeylessMCPError("keyless envelope refused")
+    v = json.loads(candidates[0]); result = v.get('result') or {}
+    if (set(v) != {'jsonrpc','id','result'} or v['jsonrpc'] != '2.0' or type(v['id']) is not int or v['id'] != 1
+            or set(result) - {'content','isError'} or result.get('isError')
+            or not isinstance(result.get('content'),list) or len(result['content']) != 1
+            or result['content'][0].get('type') != 'text'
+            or set(result['content'][0]) - {'type','text','_meta'}):
+        raise KeylessMCPError("keyless result refused")
+    text = result['content'][0]['text']
+    if not isinstance(text,str) or len(text) > 15000:
+        raise KeylessMCPError("keyless text bound")
+    return text
