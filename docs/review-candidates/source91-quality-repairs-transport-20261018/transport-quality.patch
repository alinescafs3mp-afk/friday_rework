@@ -0,0 +1,28 @@
+"""Browser-local credential forms and model-input screening phase."""
+
+import base64
+import json
+from urllib.parse import quote, quote_plus, unquote
+
+
+def credential_forms_for(args, secrets):
+    from agent.redact import redact_sensitive_text, is_secret_field_name
+    fields = [value for value in args.values() if isinstance(value, str)]
+    for value in list(fields):
+        for _ in range(3):
+            value = unquote(value)
+            fields.append(value)
+    credential_forms = set()
+    for key, secret in secrets.items():
+        if not is_secret_field_name(key) or not isinstance(secret, str) or not secret:
+            continue
+        forms = {secret, quote(secret, safe=''), quote_plus(secret),
+                 base64.b64encode(secret.encode()).decode(),
+                 base64.urlsafe_b64encode(secret.encode()).decode()}
+        credential_forms.update(forms)
+        if any(form in value for form in forms for value in fields):
+            raise RuntimeError('browser_local_credential_refused')
+    encoded_args = json.dumps(args, ensure_ascii=True)
+    if redact_sensitive_text(encoded_args, force=True) != encoded_args:
+        raise RuntimeError('browser_local_credential_refused')
+    return credential_forms
