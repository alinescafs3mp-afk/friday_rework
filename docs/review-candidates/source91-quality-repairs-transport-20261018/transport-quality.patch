+"""Bounded native PTY-query response phase for the existing reader thread."""
+
+import logging
+
+logger = logging.getLogger("tools.process_registry")
+
+
+def respond_to_query(registry, session, pty, responder, chunk):
+    if responder is None or not isinstance(chunk, bytes):
+        return chunk
+    chunk, replies = responder.process(chunk)
+    if replies:
+        try:
+            if session.terminal_custody:
+                registry.terminal_stdin(session, replies)
+            else:
+                pty.write(replies)
+        except Exception:
+            logger.debug(
+                "PTY query response write failed",
+                exc_info=True,
+            )
+    return chunk
