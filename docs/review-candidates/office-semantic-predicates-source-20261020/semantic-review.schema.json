{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frw.bot-tester.artifact-semantic-review.v1",
  "$comment": "Private <=65536 exact bytes/SHA pinned report; receiver verifies custody and binding only. Python also rejects duplicate keys, bool-as-int, blank strings and verifies exact run/receipt/file bindings. This schema never grants native, live or semantic acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "run_record_sha256",
    "scenario_sha256",
    "step",
    "sent_message_id",
    "sent_ids",
    "request_body_sha256",
    "artifacts",
    "verdict",
    "operator_checked",
    "reviewer",
    "checks",
    "diagnostic_reference"
  ],
  "properties": {
    "schema": {
      "const": "frw.bot-tester.artifact-semantic-review.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "run_record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenario_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "sent_message_id": {
      "type": "integer",
      "minimum": 1
    },
    "sent_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "request_body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes",
          "message_id"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "message_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "verdict": {
      "const": "ACCEPTED_FOR_CONTINUATION"
    },
    "operator_checked": {
      "const": true
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "diagnostic_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
