+    from utils import fast_safe_load
+    import pickle
+    home = Path(home)
+    if home != owner.SOURCE.parent:
+        return None
+    marker_path = home/'FRIDAY-INSTALL.json'
+    if not marker_path.exists() and not marker_path.is_symlink():
+        return None
