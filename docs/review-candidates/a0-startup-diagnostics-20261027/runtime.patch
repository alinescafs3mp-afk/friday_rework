+def inspect_failure_snapshot(p, r, obj, error, *, stop_owned=False, pre_start=False):
+    """Allowlisted observations only; this evidence never grants custody/readiness."""
+    obj = obj if isinstance(obj, dict) else {}
+    state = obj.get('State'); state = state if isinstance(state, dict) else {}
+    status = state.get('Status')
+    selected = {'Status': status if isinstance(status, str) and status in {'created', 'running', 'paused', 'restarting',
+                                             'removing', 'exited', 'dead'} else None}
+    for key in ('Running', 'Paused', 'Restarting', 'OOMKilled', 'Dead'):
+        selected[key] = state.get(key) if type(state.get(key)) is bool else None
+    for key in ('Pid', 'ExitCode'):
+        selected[key] = state.get(key) if type(state.get(key)) is int and -(2**31) <= state[key] < 2**31 else None
+    for key in ('StartedAt', 'FinishedAt'):
+        value = state.get(key)
+        selected[key] = value if (isinstance(value, str) and len(value) <= 40
+                                  and re.fullmatch(r'[0-9TZ:.+\-]+', value)) else None
+    value = state.get('Error')
+    # Never retain Docker's arbitrary error text in a receipt or exception note.
+    raw = value.encode('utf-8', errors='replace') if isinstance(value, str) else None
+    selected['Error'] = {'present': bool(raw) if raw is not None else None,
+                         'bytes': len(raw) if raw is not None else None,
+                         'sha256': hashlib.sha256(raw).hexdigest() if raw is not None else None}
+    settings = obj.get('NetworkSettings')
+    networks = settings.get('Networks') if isinstance(settings, dict) else None
+    expected = p.get('network')
+    name = expected.get('name') if isinstance(expected, dict) else None
+    network = networks.get(name) if isinstance(networks, dict) else None
+    network = network if isinstance(network, dict) else {}
+    net = {'count': len(networks) if isinstance(networks, dict) else None,
+           'expected_only': set(networks) == {name} if isinstance(networks, dict) else None}
+    for key in ('NetworkID', 'EndpointID'):
+        value = network.get(key)
+        net[key] = value if (isinstance(value, str) and
+                            (value == '' or re.fullmatch(r'[0-9a-f]{64}', value))) else None
+    code = str(error) if isinstance(error, RuntimeErrorBoundary) else ''
+    return {'schema': 'friday.a0.inspect-failure.v1', 'plan_sha256': digest(p),
+            'container_id': r['container_id'], 'invocation_id': r.get('invocation_id', ''),
+            'phase': 'pre_start' if pre_start else 'stop_owned' if stop_owned else 'observe',
+            'refusal': code if re.fullmatch(r'[a-z0-9_]{1,96}', code) else 'native_inspection_failed',
+            'observed_id_matches': obj.get('Id') == r['container_id'],
+            'state': selected, 'network': net,
+            'restart_count': obj.get('RestartCount') if type(obj.get('RestartCount')) is int and 0 <= obj['RestartCount'] < 2**31 else None,
+            'authority': 'DIAGNOSTIC_ONLY'}
 
 
