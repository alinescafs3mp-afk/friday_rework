 def _source_guard_diagnostics(check):
     """Best-effort metadata only; preserve proof failures and interrupt ownership."""
+    import sys
+
+    # Fixed diagnostic labels only: no pathname, argument or frame value leaves
+    # this lookup. Labels never participate in source or credential admission.
+    callers = (
+        ('hermes_cli.friday_credential_admission', 'channel_config', 'RECEIVING_POST_GATE'),
+        ('hermes_cli.friday_credential_admission', 'channel_inputs', 'RECEIVING_PRE_GATE'),
+        ('gateway.run', '_load_ordinary_gateway_config_for_runner', 'RUNNER_PRE_ADMISSION'),
+        ('scripts.friday_start', 'unchanged', 'PARENT_UNCHANGED'),
+        ('hermes_cli.friday_credential_admission', 'bootstrap', 'BOOTSTRAP'),
+        ('scripts.friday_install', 'inspect', 'PARENT_INSPECT'),
+        ('scripts.friday_start', 'ordinary_start', 'PARENT_ORDINARY_PRECHECK'),
+    )
+
+    def caller_id():
+        frame = None
+        selected = len(callers)
+        try:
+            # Skip this helper and observed(); inspect at most twelve callers.
+            frame = sys._getframe(2)
+            for _ in range(12):
+                if frame is None:
+                    break
+                module = frame.f_globals.get('__name__')
+                name = frame.f_code.co_name
+                if type(module) is str:
+                    for priority, (allowed_module, allowed_name, _tag) in enumerate(callers):
+                        if (module, name) == (allowed_module, allowed_name):
+                            selected = min(selected, priority)
+                frame = frame.f_back
+            return callers[selected][2] if selected < len(callers) else 'UNKNOWN'
+        except Exception:
+            return 'UNKNOWN'
+        finally:
+            # Do not retain a caller frame (and its otherwise private locals).
+            del frame
+
