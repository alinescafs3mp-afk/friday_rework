+# An observer exists only while an ordinary invocation authenticates immutable
+# history. The context is reset on every exit; no graph fact is stored here.
+_ORDINARY_HISTORY_OBSERVER = contextvars.ContextVar('ordinary_history_observer', default=None)
+
+
+def _history_read_boundary(reader, *, pin_reader=False):
+    def checked(value, *args, **kwargs):
+        observer = _ORDINARY_HISTORY_OBSERVER.get()
+        if observer is None:
+            return reader(value, *args, **kwargs)
+        path = value.get('path') if pin_reader and type(value) is dict else value
+        before = observer.before_read(path)
+        result = reader(value, *args, **kwargs)
+        raw = observer.read_leaf(path) if pin_reader else result
+        observer.record_read(path, raw, before)
+        if pin_reader:
+            require(digest(raw) == value['sha256'], 'ordinary_history_pin_changed')
+        return result
+    return checked
 
 
