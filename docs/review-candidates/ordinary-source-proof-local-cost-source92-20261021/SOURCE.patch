+def _source_canonical_opener():
+    """Per-proof Linux opener; retain no file/directory FD or source trust.
+
+    openat2 checks every current pathname component in the kernel. The verified
+    x86-64 ABI is optional; unsupported platforms/kernels use read_owned below.
+    """
+    import sys
+    if sys.platform != 'linux' or os.uname().machine != 'x86_64':
+        return None
+    try:
+        import ctypes
+    except ImportError:
+        return None
+    if ctypes.sizeof(ctypes.c_void_p) != 8:
+        return None
+
+    class OpenHow(ctypes.Structure):
+        _fields_ = [('flags', ctypes.c_uint64), ('mode', ctypes.c_uint64),
+                    ('resolve', ctypes.c_uint64)]
+
+    # Zero-filled 24-byte Linux UAPI open_how. NO_SYMLINKS (4) also rejects
+    # magic links. O_CLOEXEC preserves os.open's non-inheritable FD contract.
+    how = OpenHow()
+    how.flags = os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC
+    how.resolve = 4
+    syscall = ctypes.CDLL(None, use_errno=True).syscall
+    syscall.restype = ctypes.c_long
+
+    def open_canonical(path):
+        encoded = os.fsencode(path)
+        require(b'\0' not in encoded)  # Never allow c_char_p to truncate a name.
+        fd = syscall(ctypes.c_long(437), ctypes.c_int(-100),
+                     ctypes.c_char_p(encoded), ctypes.byref(how),
+                     ctypes.c_size_t(ctypes.sizeof(how)))
+        if fd < 0:
+            error = ctypes.get_errno()
+            raise OSError(error, os.strerror(error), path)
+        return fd
+    return open_canonical
+
+
+def _read_source_owned(path, opener):
+    """Fresh named-file proof; the public/private read_owned API is unchanged."""
+    if opener is None:
+        return read_owned(path)
+    import errno
+    path = Path(path)
+    # Path has normalized '.' and separators. Reject remaining lexical aliases
+    # before the kernel walk, just as resolve() == path did in read_owned.
+    require(path.is_absolute() and path.anchor == '/' and '..' not in path.parts)
+    name = str(path)
+    owner_uid = getattr(os, 'getuid', None)
+    require(callable(owner_uid))
+    try:
+        fd = opener(name)
+    except OSError as exc:
+        if exc.errno != errno.ENOSYS:
+            raise
+        return read_owned(path)
+    try:
+        before = os.fstat(fd)
+        require(stat.S_ISREG(before.st_mode) and before.st_uid == owner_uid()
+                and before.st_nlink == 1)
+        require(0 <= before.st_size <= 64 * 1024**2)
+        with os.fdopen(fd, 'rb', closefd=False) as stream:
+            data = stream.read(before.st_size + 1)
+        after = os.fstat(fd)
+        fields = ('st_dev', 'st_ino', 'st_mode', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_uid', 'st_nlink')
+        require(len(data) == before.st_size and all(getattr(before, k) == getattr(after, k) for k in fields))
+        # Reopen the absolute CURRENT name with all-ancestor no-follow. This
+        # rejects an old detached directory tree after a concurrent rename.
+        # No directory binding is ever retained for another named file.
+        named_fd = opener(name)
+        try:
+            named = os.fstat(named_fd)
+            require(all(getattr(after, k) == getattr(named, k) for k in fields))
+        finally:
+            os.close(named_fd)
+        return data
+    finally:
+        os.close(fd)
+
