+"""Bounded compression keeps the latest request active without reviving completed user turns."""
+import copy
+import importlib.util
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+import agent
+from agent.bounded_context import BoundedContextPolicy, assert_bounded_protected_rows
+
+_MODULE_PATH = Path(__file__).resolve().parents[2] / "agent" / "context_compressor.py"
+_SPEC = importlib.util.spec_from_file_location("agent.context_compressor", _MODULE_PATH)
+_MODULE = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = _MODULE
+_SPEC.loader.exec_module(_MODULE)
+
+BOUNDED_SUMMARY_PREFIX = _MODULE.BOUNDED_SUMMARY_PREFIX
+ContextCompressor = _MODULE.ContextCompressor
+POLICY = BoundedContextPolicy(
+    "custom:local", "dispatcher", "http://127.0.0.1:9/v1",
+    40960, 40954, 4096, 4096, 1024, 2048, 4096,
+)
+SAVED_FORMAT_REQUEST = (
+    "Read my saved sample-report-format skill and apply it. "
+    "Status: Done; fact: 7; next step: File."
+)
+CURRENT_WEB_REQUEST = "Check only these two current documentation pages."
+
+
+def compressor():
+    value = ContextCompressor(
+        "dispatcher", config_context_length=40960, provider="custom",
+        base_url=POLICY.base_url, api_mode="chat_completions", max_tokens=4096,
+        quiet_mode=True,
+    )
+    value.bounded_context_policy = POLICY
+    value._bounded_summary_fit_callback = lambda _assembled: 40000
+    return value
+
+
+def compress(rows):
+    value = compressor()
+    before = copy.deepcopy(rows)
+    start, end = value._compress_window(rows)
+    with patch.object(value, "_call_summary_llm", return_value="Only historical completed facts."):
+        result = value.compress(copy.deepcopy(rows), current_tokens=38000)
+    assert rows == before
+    assert_bounded_protected_rows(rows, result, start, end)
+    summary = next(
+        index for index, row in enumerate(result)
+        if isinstance(row.get("content"), str) and row["content"].startswith(BOUNDED_SUMMARY_PREFIX)
+    )
+    return result, summary
+
+
+def completed(request, answer):
+    return [
+        {"role": "user", "content": request},
+        {"role": "assistant", "content": "", "tool_calls": [{
+            "id": "completed-call", "type": "function",
+            "function": {"name": "read_file", "arguments": "{}"},
+        }]},
+        {"role": "tool", "tool_call_id": "completed-call", "content": "Historical evidence. " * 200},
+        {"role": "assistant", "content": answer, "reasoning": "Historical reasoning. " * 100},
+    ]
+
+
+def pending(request, tool_name="web_extract"):
+    return [
+        {"role": "user", "content": request},
+        {"role": "assistant", "content": "", "tool_calls": [{
+            "id": "current-call", "type": "function",
+            "function": {"name": tool_name, "arguments": "{}"},
+        }]},
+        {"role": "tool", "tool_call_id": "current-call", "content": "Current evidence. " * 100},
+    ]
+
+
+class InstructionScopeTests(unittest.TestCase):
+    def test_completed_opening_saved_format_does_not_override_newer_request(self):
+        rows = [
+            {"role": "system", "content": "Persistent user preferences remain authoritative."},
+            *completed(SAVED_FORMAT_REQUEST, "STATUS: Done\nFACT: 7\nNEXT: File"),
+            *pending(CURRENT_WEB_REQUEST),
+        ]
+        result, summary = compress(rows)
+        self.assertEqual(result[0], rows[0])
+        self.assertNotIn(SAVED_FORMAT_REQUEST, [row.get("content") for row in result[:summary]])
+        self.assertEqual(
+            [row.get("content") for row in result[summary + 1:] if row.get("role") == "user"],
+            [CURRENT_WEB_REQUEST],
+        )
+
+    def test_latest_explicit_saved_format_request_remains_in_protected_tail(self):
+        rows = [
+            {"role": "system", "content": "Persistent user preferences remain authoritative."},
+            *completed("Earlier completed question.", "Earlier completed answer."),
+            *pending(SAVED_FORMAT_REQUEST, "skill_view"),
+        ]
+        result, summary = compress(rows)
+        self.assertEqual(result[0], rows[0])
+        self.assertNotIn(
+            "Earlier completed question.",
+            [row.get("content") for row in result[:summary]],
+        )
+        self.assertEqual(
+            [row.get("content") for row in result[summary + 1:] if row.get("role") == "user"],
+            [SAVED_FORMAT_REQUEST],
+        )
+
+    def test_completed_opening_user_is_not_pinned_without_system_row(self):
+        rows = [
+            *completed(SAVED_FORMAT_REQUEST, "Completed answer."),
+            *pending(CURRENT_WEB_REQUEST),
+        ]
+        result, summary = compress(rows)
+        self.assertNotIn(SAVED_FORMAT_REQUEST, [row.get("content") for row in result[:summary]])
+        self.assertEqual(
+            [row.get("content") for row in result[summary + 1:] if row.get("role") == "user"],
+            [CURRENT_WEB_REQUEST],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
