+def inference_capacity_configuration(before, after, *, root):
+    """Require precisely the three scalar changes in each already managed view."""
+    import copy
+    f=api();expected=copy.deepcopy(before)
+    views=[expected]
+    if root:
+        templates=expected['plugins']['entries']['friday_rework']['settings']['onboarding']['templates']
+        f.require(set(templates)=={'friday-local','friday-ordinary-local'},
+            'ordinary_rebind_exact_existing_templates_required')
+        views.extend(t['config'] for t in templates.values())
+    for cfg in views:
+        compression=cfg['auxiliary']['compression']
+        model=cfg['providers']['friday-compression']['models']['dispatcher']
+        bounded=model['bounded_context']
+        f.require(type(compression.get('context_length')) is int and compression['context_length']==40960
+            and type(model.get('context_length')) is int and model['context_length']==40960
+            and type(bounded.get('server_max_input_tokens')) is int and bounded['server_max_input_tokens']==40954,
+            'ordinary_rebind_capacity_configuration_before_required')
+        compression['context_length']=65536;model['context_length']=65536
+        bounded['server_max_input_tokens']=65530
+    f.require(encoded(after)==encoded(expected),'ordinary_rebind_exact_capacity_configuration_required')
+
