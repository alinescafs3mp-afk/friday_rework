+def inference_capacity_delta(old, new):
+    """Owner's exact capacity migration; every other typed product leaf is retained."""
+    f=api(); fields={'context','max_input'}
+    f.require(type(old) is dict and type(new) is dict
+        and {'inference','compression_inference','compression_multipass'}<=set(old)
+        and type(old['inference']) is dict
+        and type(old['compression_inference']) is dict
+        and type(new.get('compression_inference')) is dict
+        and encoded({k:v for k,v in old.items() if k!='compression_inference'})==
+            encoded({k:v for k,v in new.items() if k!='compression_inference'})
+        and encoded({k:v for k,v in old['compression_inference'].items() if k not in fields})==
+            encoded({k:v for k,v in new['compression_inference'].items() if k not in fields})
+        and all(type(p['compression_inference'].get(k)) is int for p in (old,new) for k in fields)
+        and (old['compression_inference']['context'],old['compression_inference']['max_input'])==(40960,40954)
+        and (new['compression_inference']['context'],new['compression_inference']['max_input'])==(65536,65530)
+        and type(old['inference'].get('context')) is int and old['inference']['context']==262144
+        and old['inference'].get('key_env')=='FRIDAY_LLM_API_KEY'
+        and old['compression_inference'].get('key_env')=='FRIDAY_COMPRESSION_API_KEY'
+        and all(type(p.get('runtime')) is dict and set(p['runtime'])=={'enabled'}
+            and p['runtime']['enabled'] is False for p in (old,new)),
+        'ordinary_rebind_exact_compression_capacity_delta_required')
+
+
+def inference_capacity_profiles(home, request):
+    """Derive the complete managed set from native policy, never a request subset."""
+    from hermes_cli.config import require_readable_config_before_write
+    from hermes_cli import friday_user_scope as user
+    from hermes_cli.friday_product_access import current_access,principal_id
+    f=api();cfg=require_readable_config_before_write(home/'config.yaml')
+    settings=cfg['plugins']['entries']['friday_rework']['settings']
+    isolation=settings.get('user_isolation')
+    f.require(type(isolation) is dict and isolation.get('enabled') is True
+        and type(isolation.get('bindings')) is list and bool(isolation['bindings']),
+        'ordinary_rebind_native_managed_inventory_required')
+    bindings=isolation['bindings'];profiles=[b.get('runtime_profile') for b in bindings]
+    f.require(all(isinstance(n,str) and n not in ('','default','.','..') and '/' not in n for n in profiles)
+        and len(set(profiles))==len(profiles)
+        and type(request.get('profiles')) is list and request['profiles']==sorted(profiles),
+        'ordinary_rebind_complete_managed_profiles_required')
+    f.require(set(settings['admin']['profiles'])=={'default',*profiles},
+        'ordinary_rebind_native_admin_inventory_required')
+    with user.authority(home): access=current_access()['users']
+    for binding in bindings:
+        name=binding['runtime_profile'];own=f.directory(home/'profiles'/name)
+        principal=tuple(binding[k] for k in ('platform','transport_profile','account_id','user_id'))
+        row=access.get(principal_id(*principal))
+        f.require(type(row) is dict and row.get('enabled') is True and row.get('role')=='user',
+            'ordinary_rebind_original_user_disabled')
+        user.check_onboarding_home(home,own,binding)
+        info=own.stat()
+        with user.authority(own):
+            user.UserScope(home,own,name,principal,dict(binding),(info.st_dev,info.st_ino),row['generation']).check()
+    return tuple(f.directory(home/'profiles'/name) for name in request['profiles'])
+
