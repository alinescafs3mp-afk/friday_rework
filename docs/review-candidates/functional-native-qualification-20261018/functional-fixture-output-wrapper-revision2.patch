+def reviewed_fixture_output_subdirs(binding):
+    """Only the two fixed per-invocation evidence directories are supported."""
+    if 'fixture_output_subdirs' not in binding:
+        return {}
+    fixed = {'FRIDAY_FIXTURE_EVIDENCE': 'fixture-evidence',
+             'WORKER_WEB_EVIDENCE': 'worker-web-evidence'}
+    selected = binding['fixture_output_subdirs']
+    if type(selected) is not dict or set(selected) != set(fixed):
+        raise ValueError('Fixture output map must contain exactly the two reviewed keys')
+    if any(type(selected[key]) is not str or selected[key] != leaf
+           for key, leaf in fixed.items()):
+        raise ValueError('Fixture output leaves must be the fixed reviewed path components')
+    literal_env = binding.get('fixture_env', {})
+    if type(literal_env) is not dict or set(fixed) & set(literal_env):
+        raise ValueError('Fixture output keys cannot also be literal fixture environment')
+    return fixed
+
