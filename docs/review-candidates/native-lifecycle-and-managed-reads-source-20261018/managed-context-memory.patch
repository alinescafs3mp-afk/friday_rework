+        text = b''.join(pieces).decode(encoding)
+        checkpoint()
+        return text.replace('\r\n', '\n').replace('\r', '\n')
+    except (ManagedTextReadTimeout, UnicodeError):
+        raise
+    except FileNotFoundError:
+        if missing_leaf:
+            raise
+        raise ScopeDenied() from None
+    except (OSError, ValueError):
+        raise ScopeDenied() from None
+    finally:
+        if item is not None:
+            os.close(item)
+        for fd, _, _, _ in reversed(descriptors):
+            os.close(fd)
+
