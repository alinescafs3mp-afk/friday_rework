+def read_context_text(path, *, encoding='utf-8-sig', timeout=5.0):
+    """Managed context text from the admitted SOUL or own workspace only."""
+    cap = current()
+    path = Path(path)
+    if cap is None:
+        return path.read_text(encoding=encoding)
+    check_database(cap)
+    if not path.is_absolute() or '..' in path.parts:
+        raise ScopeDenied()
+    if path == cap.home / 'SOUL.md':
+        parts = ('SOUL.md',)
+    else:
+        try:
+            relative = path.relative_to(cap.home / 'workspace')
+        except ValueError:
+            raise ScopeDenied() from None
+        if not relative.parts:
+            raise ScopeDenied()
+        parts = ('workspace', *relative.parts)
+    return _owned_text_snapshot(cap, path, parts, encoding=encoding, timeout=timeout)
+
+
+def read_memory_text(path, *, timeout=5.0):
+    """Only the two native memory targets of the current retained principal."""
+    cap = current()
+    path = Path(path)
+    if cap is None:
+        return path.read_text(encoding='utf-8-sig')
+    check_database(cap)
+    if path not in (cap.home / 'memories' / 'MEMORY.md', cap.home / 'memories' / 'USER.md'):
+        raise ScopeDenied()
+    return _owned_text_snapshot(cap, path, ('memories', path.name), encoding='utf-8-sig', timeout=timeout)
+
