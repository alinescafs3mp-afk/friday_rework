+class ManagedTextReadTimeout(TimeoutError):
+    """Cooperative deadline expired while reading an owned regular file."""
+
+
+_MANAGED_TEXT_MAX_BYTES = 1000000
+
+
+def _text_identity(info):
+    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns,
+            info.st_ctime_ns, info.st_mode, info.st_nlink, info.st_uid)
+
+
+def _private_descriptor(fd, *, directory=False):
+    info = os.fstat(fd)
+    if (info.st_uid != _owner_uid() or info.st_mode & 0o077
+            or (directory and not stat.S_ISDIR(info.st_mode))
+            or (not directory and (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1))):
+        raise ScopeDenied()
+    return info
+
+
+def _scope_home_directory(cap):
+    """Pin the existing admission's home; never acquire authority from a pathname."""
+    home = os.open(cap.home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        info = _private_descriptor(home, directory=True)
+        if (info.st_dev, info.st_ino) != cap.directory_identity:
+            raise ScopeDenied()
+        _private(cap.home, directory=True)
+        return home
+    except BaseException:
+        os.close(home)
+        raise
+
+
+def _check_text_directories(cap, descriptors):
+    """Each opened directory must still be the private object at its name."""
+    def identity(info):
+        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_nlink)
+    for fd, parent, name, before in reversed(descriptors):
+        after = _private_descriptor(fd, directory=True)
+        named = cap.home.lstat() if parent is None else os.stat(name, dir_fd=parent, follow_symlinks=False)
+        if identity(before) != identity(after) or identity(after) != identity(named):
+            raise ScopeDenied()
+
+
+def _owned_text_snapshot(cap, path, parts, *, encoding, timeout):
+    """Read only the validated object and revalidate its full descriptor chain.
+
+    Regular filesystem syscalls cannot be forcibly cancelled portably. The
+    deadline is checked between bounded reads; no reader thread or FD survives
+    this call. O_NONBLOCK also prevents opening a FIFO from blocking validation.
+    """
+    deadline = None if timeout is None else time.monotonic() + max(0, timeout)
+    descriptors = []
+    item = None
+    missing_leaf = False
+    def checkpoint():
+        if current(required=True) is not cap:
+            raise ScopeDenied()
+        if deadline is not None and time.monotonic() >= deadline:
+            raise ManagedTextReadTimeout()
+    try:
+        checkpoint()
+        home = _scope_home_directory(cap)
+        descriptors.append((home, None, None, os.fstat(home)))
+        for name in parts[:-1]:
+            parent = descriptors[-1][0]
+            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
+            descriptors.append((child, parent, name, os.fstat(child)))
+            _private_descriptor(child, directory=True)
+        parent = descriptors[-1][0]
+        try:
+            item = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+        except FileNotFoundError:
+            # Absence is native behavior only after the entire allowed parent
+            # chain and retained principal have been verified.
+            _check_text_directories(cap, descriptors)
+            checkpoint()
+            missing_leaf = True
+            raise
+        before = _private_descriptor(item)
+        if before.st_size > _MANAGED_TEXT_MAX_BYTES:
+            raise ScopeDenied()
+        pieces, size = [], 0
+        while True:
+            checkpoint()
+            chunk = os.read(item, min(65536, _MANAGED_TEXT_MAX_BYTES - size + 1))
+            if not chunk:
+                break
+            pieces.append(chunk)
+            size += len(chunk)
+            if size > _MANAGED_TEXT_MAX_BYTES:
+                raise ScopeDenied()
+        after = _private_descriptor(item)
+        named = os.stat(parts[-1], dir_fd=parent, follow_symlinks=False)
+        if (size != before.st_size or _text_identity(before) != _text_identity(after)
+                or _text_identity(after) != _text_identity(named)):
+            raise ScopeDenied()
+        _check_text_directories(cap, descriptors)
