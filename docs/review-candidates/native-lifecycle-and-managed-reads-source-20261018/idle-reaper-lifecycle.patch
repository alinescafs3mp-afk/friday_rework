+"""FastAPI owns the native idle reaper only while a user backend serves.
+
+Peripheral native jobs are replaced with finite unit collaborators. The actual
+app lifespan and native idle-reaper thread/start/stop/join remain real. Prepared
+source only; execution belongs to Root on the final composed Source.
+"""
+from __future__ import annotations
+
+import asyncio
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+
+def _prepare_native_lifespan(monkeypatch, administrative):
+    from gateway import code_skew
+    from hermes_cli import config, free_tier_bootstrap, friday_dashboard_owner, web_server
+    from hermes_cli.local_runtime import bootstrap
+    from tui_gateway import methods_groups, server
+
+    async def idle_job(*args):
+        await asyncio.Event().wait()
+
+    async def close_all():
+        return None
+
+    monkeypatch.setattr(friday_dashboard_owner, "startup_identity",
+                        lambda app: object() if administrative else None)
+    monkeypatch.setattr(web_server, "_eager_reconcile_own_session_db", lambda: None)
+    monkeypatch.setattr(web_server, "_warm_gateway_module", lambda: None)
+    monkeypatch.setattr(code_skew, "record_boot_fingerprint", lambda: None)
+    monkeypatch.setattr(server, "install_tui_message_injector", lambda: None)
+    monkeypatch.setattr(server, "clear_tui_message_injector", lambda: None)
+    monkeypatch.setattr(methods_groups, "start_hosted_room_service", lambda: None)
+    monkeypatch.setattr(methods_groups, "stop_hosted_room_service", lambda **kw: True)
+    monkeypatch.setattr(web_server, "is_desktop_owned_backend", lambda: False)
+    monkeypatch.setattr(web_server, "run_reaper", idle_job)
+    monkeypatch.setattr(web_server, "_dashboard_selftest_loop", idle_job)
+    monkeypatch.setattr(web_server, "_auto_archive_ticker_loop", idle_job)
+    monkeypatch.setattr(web_server, "PTY_REGISTRY", SimpleNamespace(close_all=close_all))
+    monkeypatch.setattr(config, "load_config", lambda: {})
+    monkeypatch.setattr(bootstrap, "ensure_local_runtime", lambda config: None)
+    monkeypatch.setattr(bootstrap, "shutdown_local_runtime", lambda: None)
+    monkeypatch.setattr(free_tier_bootstrap, "start_background_bootstrap", lambda: None)
+    return web_server, server
+
+
+@pytest.mark.parametrize("administrative,body_error", [(False, False), (False, True), (True, False)])
+def test_native_app_lifespan_owns_reaper_and_cleans_exception(monkeypatch, administrative, body_error):
+    web_server, server = _prepare_native_lifespan(monkeypatch, administrative)
+    assert server._idle_reaper_thread is None
+    baseline = {id(thread) for thread in threading.enumerate()}
+    seen = []
+
+    async def serve():
+        async with web_server._lifespan(SimpleNamespace(state=SimpleNamespace())):
+            thread = server._idle_reaper_thread
+            if administrative:
+                assert thread is None
+                assert not any(t.name == "hermes-idle-reaper" for t in threading.enumerate())
+            else:
+                assert thread is not None and thread.is_alive()
+                assert sum(t.name == "hermes-idle-reaper" for t in threading.enumerate()) == 1
+                seen.append(thread)
+            if body_error:
+                raise LookupError("finite serving-body error")
+
+    try:
+        if body_error:
+            with pytest.raises(LookupError, match="finite serving-body error"):
+                asyncio.run(serve())
+        else:
+            asyncio.run(serve())
+        assert server._idle_reaper_thread is None
+        assert all(not thread.is_alive() for thread in seen)
+    finally:
+        assert server._stop_idle_reaper()
+        # Existing lifecycle's finite eager/local/hosted startup workers also
+        # remain owned by this test; join rather than ignore any final return.
+        owned = [thread for thread in threading.enumerate() if id(thread) not in baseline]
+        for thread in owned:
+            thread.join(timeout=2.0)
+        assert all(not thread.is_alive() for thread in owned)
