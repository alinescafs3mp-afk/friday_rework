+"""Serving-owned idle reaper; helpers bind to the facade's session state.
+
+Importing this module starts no work. Native stdio, Web and compute-host owners
+explicitly start the ContextVar-preserving thread and confirm bounded cleanup.
+"""
+from __future__ import annotations
+
+import contextlib
+import threading
+
+from .method_ctx import bind_module
+
+
+def _shutdown_sessions(*, reaper_timeout: float = 1.0) -> None:
+    # Durable-first: flush transcripts (bounded budget) BEFORE the slow teardown so a supervisor SIGKILL can't lose them.
+    for step in (_flush_sessions_before_exit, _release_gateway_wake_owner, _stop_turns_before_exit):
+        with contextlib.suppress(Exception):
+            step()
+    with _sessions_lock:
+        sids = list(_sessions)
+    try:
+        for sid in sids:
+            _close_session_by_id(sid, end_reason="tui_shutdown")
+    finally:
+        if not _stop_idle_reaper(timeout=reaper_timeout):
+            logger.error("idle reaper did not stop within the shutdown join budget")
+
+def _idle_reaper_loop(stop_event: threading.Event) -> None:
+    # Keep the native scan cadence; an exit request wakes the wait immediately.
+    while not stop_event.wait(_REAPER_SCAN_S):
+        if stop_event.is_set():
+            return
+        with contextlib.suppress(Exception):
+            _reap_idle_sessions()
+
+def _start_idle_reaper() -> None:
+    """Start one process-wide reaper from the serving lifecycle, never on import."""
+    global _idle_reaper_thread, _idle_reaper_stop, _idle_reaper_start_complete
+    with _idle_reaper_lock:
+        if _idle_reaper_thread is not None and not _idle_reaper_start_complete:
+            raise RuntimeError("idle reaper start outcome is unconfirmed")
+        if _idle_reaper_thread is not None and _idle_reaper_thread.is_alive():
+            if _idle_reaper_stop.is_set():
+                raise RuntimeError("idle reaper is still stopping")
+            return
+        stop_event = threading.Event()
+        from agent.memory_provider import spawn_context_thread
+        thread = spawn_context_thread(
+            _idle_reaper_loop, name="hermes-idle-reaper", args=(stop_event,))
+        _idle_reaper_stop = stop_event
+        _idle_reaper_thread = thread
+        _idle_reaper_start_complete = False
+        try:
+            thread.start()
+            _idle_reaper_start_complete = True
+        except BaseException:
+            # A start interrupted after creating the OS thread must not leave
+            # that thread sleeping forever or discard a live owner's handle.
+            stop_event.set()
+            # False is_alive cannot distinguish an unstarted refusal from an
+            # OS thread not yet past _started. Keep the sole uncertain owner.
+            raise
+
+def _stop_idle_reaper(timeout: float = 1.0) -> bool:
+    """Bounded cleanup, including signal reentry and uncertain native starts."""
+    global _idle_reaper_thread, _idle_reaper_stop, _idle_reaper_start_complete
+    # Ordinary concurrent closes may briefly share this mutex. Account for
+    # both mutex phases and the join under one budget; the signal caller uses
+    # zero after its durable flush so reentry cannot wait on its own lock.
+    deadline = time.monotonic() + max(0.0, timeout)
+    if not _idle_reaper_lock.acquire(timeout=max(0.0, deadline - time.monotonic())):
+        return False
+    try:
+        thread = _idle_reaper_thread
+        if thread is None:
+            return True
+        _idle_reaper_stop.set()
+    finally:
+        _idle_reaper_lock.release()
+    if thread is threading.current_thread():
+        return False
+    try:
+        thread.join(timeout=max(0.0, deadline - time.monotonic()))
+    except RuntimeError:
+        return False  # Pending _started outcome is unconfirmed, not completed.
+    if thread.is_alive():
+        return False
