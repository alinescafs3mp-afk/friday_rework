+    gateway._start_idle_reaper()
+    owner = gateway._idle_reaper_thread
+    native_lock = gateway._idle_reaper_lock
+    attempts = [threading.Event() for _ in range(2 if close_host else 1)]
+    results, failures = [], []
+
+    class ObservedNativeLock:
+        def acquire(self, blocking=True, timeout=-1):
+            index = int(threading.current_thread().name.rsplit("-", 1)[1])
+            if not blocking:
+                # The legacy immediate-refusal branch must actually observe
+                # the held native mutex before the parent releases it.
+                acquired = native_lock.acquire(False)
+                attempts[index].set()
+                return acquired
+            attempts[index].set()
+            return native_lock.acquire(blocking, timeout)
+
+        def release(self):
+            native_lock.release()
+
+    def close(index):
+        try:
+            results.append(host.close() if close_host else gateway._stop_idle_reaper())
+        except BaseException as exc:
