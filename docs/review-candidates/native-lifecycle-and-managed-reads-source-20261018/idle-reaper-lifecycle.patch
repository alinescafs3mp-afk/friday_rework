+            for worker in workers:
+                worker.start()
+            assert all(event.wait(2.0) for event in attempts)
+        for worker in workers:
+            worker.join(timeout=2.0)
+        assert all(not worker.is_alive() for worker in workers)
+        assert not failures
+        assert results == ([None, None] if close_host else [True])
+        assert not owner.is_alive()
+        assert gateway._idle_reaper_thread is None
+    finally:
+        # Restore the actual mutex before serialized fallback cleanup; never
+        # treat a proxy or a surviving test helper as proof of native cleanup.
+        monkeypatch.setattr(gateway, "_idle_reaper_lock", native_lock)
+        for worker in workers:
