@@ -0,0 +1,726 @@
+"""Native idle-reaper ownership, cancellation and serving-boundary regression tests.
+
+These sources have only been prepared, not executed. Root must run through the
+canonical isolated native test runner on its composed final source.
+"""
+from __future__ import annotations
+
+import threading
+import time
+
+import pytest
+
+
+@pytest.fixture
+def gateway():
+    from tui_gateway import server
+
+    # A fresh per-file native runner import must never start the reaper.
+    assert server._idle_reaper_thread is None
+    assert not any(t.name == "hermes-idle-reaper" for t in threading.enumerate())
+    yield server
+    assert server._stop_idle_reaper(), "owned native reaper failed to settle"
+
+
+def test_real_wait_wakes_and_restart_owns_a_new_thread(gateway):
+    assert gateway._REAPER_SCAN_S == 300.0
+    gateway._start_idle_reaper()
+    first = gateway._idle_reaper_thread
+    assert first is not None and first.is_alive()
+    assert first.daemon
+    gateway._start_idle_reaper()
+    assert gateway._idle_reaper_thread is first
+    assert sum(t.name == "hermes-idle-reaper" for t in threading.enumerate()) == 1
+    began = time.monotonic()
+    assert gateway._stop_idle_reaper()
+    assert time.monotonic() - began < 2.0
+    assert not first.is_alive()
+    assert gateway._idle_reaper_thread is None
+    assert gateway._stop_idle_reaper()
+    gateway._start_idle_reaper()
+    second = gateway._idle_reaper_thread
+    assert second is not first and second.is_alive()
+    assert gateway._stop_idle_reaper()
+    assert not second.is_alive()
+
+
+def test_loop_retains_300_second_cadence_and_retries_scan_errors(gateway, monkeypatch):
+    intervals = []
+    scanned = []
+
+    class UnitWait:
+        def wait(self, interval):
+            intervals.append(interval)
+            return len(intervals) == 3
+
+        def is_set(self):
+            return False
+
+    def scan():
+        scanned.append("scan")
+        if len(scanned) == 1:
+            raise RuntimeError("one failed native scan")
+
+    monkeypatch.setattr(gateway, "_reap_idle_sessions", scan)
+    gateway._idle_reaper_loop(UnitWait())
+    assert intervals == [300.0, 300.0, 300.0]
+    assert scanned == ["scan", "scan"]
+
+
+def test_stop_between_wait_and_scan_does_not_begin_another_scan(gateway, monkeypatch):
+    scanned = []
+
+    class UnitWait:
+        def wait(self, interval):
+            assert interval == 300.0
+            return False
+
+        def is_set(self):
+            return True
+
+    monkeypatch.setattr(gateway, "_reap_idle_sessions", lambda: scanned.append(True))
+    gateway._idle_reaper_loop(UnitWait())
+    assert scanned == []
+
+
+def test_concurrent_starts_and_stops_preserve_one_owner(gateway):
+    barrier = threading.Barrier(9)
+    errors = []
+
+    def start():
+        try:
+            barrier.wait(timeout=2.0)
+            gateway._start_idle_reaper()
+        except BaseException as exc:
+            errors.append(exc)
+
+    starters = [threading.Thread(target=start) for _ in range(8)]
+    for thread in starters:
+        thread.start()
+    try:
+        barrier.wait(timeout=2.0)
+    finally:
+        for thread in starters:
+            thread.join(timeout=2.0)
+    assert not errors
+    assert all(not thread.is_alive() for thread in starters)
+    first = gateway._idle_reaper_thread
+    assert first is not None and first.is_alive()
+    assert sum(t.name == "hermes-idle-reaper" for t in threading.enumerate()) == 1
+    stopped = []
+    stoppers = [threading.Thread(target=lambda: stopped.append(gateway._stop_idle_reaper()))
+                for _ in range(8)]
+    for thread in stoppers:
+        thread.start()
+    for thread in stoppers:
+        thread.join(timeout=2.0)
+    assert all(not thread.is_alive() for thread in stoppers)
+    # The stop API conservatively refuses lock contention. Every helper must
+    # return, then one bounded serialized cleanup confirms the captured owner.
+    assert len(stopped) == 8 and all(isinstance(value, bool) for value in stopped)
+    assert gateway._stop_idle_reaper()
+    assert not first.is_alive()
+    assert gateway._idle_reaper_thread is None
+
+
+def test_active_scan_timeout_keeps_ownership_and_refuses_overlap(gateway, monkeypatch):
+    entered, release = threading.Event(), threading.Event()
+    original_loop = gateway._idle_reaper_loop
+
+    def finite_busy_scan(stop_event):
+        entered.set()
+        assert release.wait(2.0), "test-owned scan was not released"
+
+    # Unit seam only: force a finite in-flight callback without shortening the
+    # real native 300-second interval or changing threading globally.
+    monkeypatch.setattr(gateway, "_idle_reaper_loop", finite_busy_scan)
+    gateway._start_idle_reaper()
+    first = gateway._idle_reaper_thread
+    try:
+        assert entered.wait(2.0)
+        assert gateway._stop_idle_reaper(timeout=0.0) is False
+        assert gateway._idle_reaper_thread is first
+        assert gateway._idle_reaper_stop.is_set()
+        with pytest.raises(RuntimeError, match="still stopping"):
+            gateway._start_idle_reaper()
+        assert sum(t.name == "hermes-idle-reaper" for t in threading.enumerate()) == 1
+    finally:
+        release.set()
+        first.join(timeout=2.0)
+    assert not first.is_alive()
+    assert gateway._stop_idle_reaper()
+    monkeypatch.setattr(gateway, "_idle_reaper_loop", original_loop)
+    gateway._start_idle_reaper()
+    assert gateway._idle_reaper_thread is not first
+
+
+def test_self_stop_requests_exit_without_self_join(gateway, monkeypatch):
+    done, start_returned = threading.Event(), threading.Event()
+    outcome = []
+
+    def self_stop(stop_event):
+        assert start_returned.wait(2.0), "completed-start boundary not released"
+        outcome.append(gateway._stop_idle_reaper())
+        outcome.append(stop_event.is_set())
+        done.set()
+
+    monkeypatch.setattr(gateway, "_idle_reaper_loop", self_stop)
+    gateway._start_idle_reaper()
+    thread = gateway._idle_reaper_thread
+    try:
+        start_returned.set()
+        assert done.wait(2.0)
+    finally:
+        start_returned.set()
+        thread.join(timeout=2.0)
+    assert outcome == [False, True]
+    assert not thread.is_alive()
+    assert gateway._stop_idle_reaper()
+
+
+def test_native_stdio_boundary_starts_and_stops_on_eof_and_error(gateway, monkeypatch):
+    from tui_gateway import entry
+
+    monkeypatch.setattr(entry, "_prepare_stdio_entry", lambda: None)
+    monkeypatch.setattr(entry, "server", gateway, raising=False)
+    seen = []
+
+    def serving():
+        thread = gateway._idle_reaper_thread
+        assert thread is not None and thread.is_alive()
+        seen.append(thread)
+
+    monkeypatch.setattr(entry, "_serve_stdio", serving)
+    entry.main()
+    assert len(seen) == 1 and not seen[0].is_alive()
+    assert gateway._idle_reaper_thread is None
+
+    def broken_serving():
+        serving()
+        raise LookupError("finite startup/read-loop error")
+
+    monkeypatch.setattr(entry, "_serve_stdio", broken_serving)
+    with pytest.raises(LookupError, match="finite startup/read-loop error"):
+        entry.main()
+    assert len(seen) == 2 and not seen[1].is_alive()
+    assert gateway._idle_reaper_thread is None
+
+
+def test_shutdown_fallback_wakes_before_flush_and_joins_after(gateway, monkeypatch):
+    observed = []
+    gateway._start_idle_reaper()
+    thread = gateway._idle_reaper_thread
+    stop = gateway._idle_reaper_stop
+    monkeypatch.setattr(gateway, "_sessions", {})
+
+    def flush():
+        assert not stop.is_set()
+        observed.append("flush")
+
+    monkeypatch.setattr(gateway, "_flush_sessions_before_exit", flush)
+    monkeypatch.setattr(gateway, "_release_gateway_wake_owner", lambda: observed.append("wake"))
+    monkeypatch.setattr(gateway, "_stop_turns_before_exit", lambda: observed.append("turns"))
+    gateway._shutdown_sessions()
+    assert observed == ["flush", "wake", "turns"]
+    assert not thread.is_alive()
+    assert gateway._idle_reaper_thread is None
+
+
+def test_old_stop_cannot_clear_a_concurrently_restarted_owner(gateway, monkeypatch):
+    gateway._start_idle_reaper()
+    first = gateway._idle_reaper_thread
+    native_join = first.join
+    joined, release = threading.Event(), threading.Event()
+    results = []
+
+    def hold_after_join(timeout=None):
+        native_join(timeout=timeout)
+        joined.set()
+        assert release.wait(2.0), "test-owned old-stop barrier was not released"
+
+    # The instance seam schedules the precise old-join/new-start race without
+    # patching the global threading implementation or suppressing ownership.
+    monkeypatch.setattr(first, "join", hold_after_join)
+    stopper = threading.Thread(target=lambda: results.append(gateway._stop_idle_reaper()))
+    stopper.start()
+    try:
+        assert joined.wait(2.0)
+        assert not first.is_alive()
+        gateway._start_idle_reaper()
+        second = gateway._idle_reaper_thread
+        assert second is not first and second.is_alive()
+    finally:
+        release.set()
+        stopper.join(timeout=2.0)
+    assert not stopper.is_alive()
+    assert results == [True]
+    assert gateway._idle_reaper_thread is second
+    assert second.is_alive()
+
+
+def test_start_failure_releases_unstarted_owner_for_a_clean_retry(gateway, monkeypatch):
+    from agent import memory_provider
+
+    def rejected_factory(*args, **kwargs):
+        raise RuntimeError("finite native thread-construction refusal")
+
+    with monkeypatch.context() as local:
+        local.setattr(memory_provider, "spawn_context_thread", rejected_factory)
+        with pytest.raises(RuntimeError, match="finite native thread-construction refusal"):
+            gateway._start_idle_reaper()
+    assert gateway._idle_reaper_thread is None
+    assert gateway._idle_reaper_stop is None
+    gateway._start_idle_reaper()
+    assert gateway._idle_reaper_thread.is_alive()
+
+
+def test_loop_calls_native_idle_policy_and_preserves_busy_exemptions(gateway, monkeypatch):
+    now = time.time()
+    old = now - gateway._SESSION_TTL_S - 10.0
+    ready = threading.Event()
+    ready.set()
+
+    def record(**changes):
+        data = {"created_at": old, "last_active": old, "running": False,
+                "transport": gateway._detached_ws_transport, "agent_ready": ready}
+        data.update(changes)
+        return data
+
+    sessions = {"idle": record(), "running": record(running=True),
+                "pending": record(), "delegating": record(),
+                "building": record(agent_ready=threading.Event()),
+                "connected": record(transport=object()),
+                "fresh": record(created_at=now, last_active=now)}
+    observed = []
+    monkeypatch.setattr(gateway, "_sessions", sessions)
+    monkeypatch.setattr(gateway, "_session_pending_kind", lambda sid: "approval" if sid == "pending" else None)
+    monkeypatch.setattr(gateway, "_session_has_active_delegations", lambda sid, session: sid == "delegating")
+    monkeypatch.setattr(gateway, "_flush_dirty_sessions", lambda: observed.append("flush"))
+    monkeypatch.setattr(gateway, "_repair_missing_ws_orphan_reaps", lambda: observed.append("orphans"))
+    monkeypatch.setattr(gateway, "_enforce_session_cap", lambda: observed.append("cap"))
