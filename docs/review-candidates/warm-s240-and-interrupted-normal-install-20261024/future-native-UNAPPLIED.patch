+"""Inactive immutable trusted profile bootstrap for the finite engine.
+
+No arbitrary Agent/extensions/config factories execute to obtain credentials.
+Trusted caller supplies already approved provider/native profile and global kwargs
+from its immutable admitted source/config closure; only public IDs reach jobs.
+"""
+# The finite runtime proved this fixed whole native tree read-only before
+# transport initialization; -I intentionally omits cwd from module search.
+import sys
+if '/a0' not in sys.path:sys.path.insert(0,'/a0')
+from types import MappingProxyType
+from helpers.frw_model_work_core import NativeProviderGraph,decode,require
+
+def build_dispatch(config):
+    value=decode(config)
+    require(type(value) is dict and set(value)=={'v','profiles','global_kwargs'} and type(value['v']) is int and value['v']==1,'trusted_profile_config_schema')
+    require(type(value['profiles']) is dict and 0<len(value['profiles'])<=16 and type(value['global_kwargs']) is dict,'trusted_profiles_required')
+    import models
+    global_kwargs=MappingProxyType(dict(value['global_kwargs']))
+    models.get_litellm_global_kwargs=lambda:dict(global_kwargs)
+    profiles={}
+    for pid,p in value['profiles'].items():
+        require(type(p) is dict and set(p)=={'kind','provider','name','kwargs','model_config'},'trusted_profile_schema')
+        require(p['kind'] in ('chat','embedding','local_embedding') and type(p['provider']) is str and type(p['name']) is str and type(p['kwargs']) is dict and type(p['model_config']) is dict,'trusted_profile_types')
+        kwargs=dict(p['kwargs'])
+        require(set(p['model_config'])<={'ctx_length','limit_requests','limit_input','limit_output','vision'},'trusted_model_metadata')
+        conf=models.ModelConfig(type=models.ModelType.CHAT if p['kind']=='chat' else models.ModelType.EMBEDDING,provider=p['provider'],name=p['name'],**p['model_config'])
+        if p['kind']=='chat':
+            require(kwargs.get('a0_retry_attempts',0)==0,'no_implicit_retry_required')
+            kwargs['a0_retry_attempts']=0
+            profiles[pid]=models.get_chat_model(p['provider'],p['name'],conf,**kwargs)
+        elif p['kind']=='embedding':profiles[pid]=models.get_embedding_model(p['provider'],p['name'],conf,**kwargs)
+        else:profiles[pid]=models.get_embedding_model(p['provider'],p['name'],conf,**kwargs)
+    return NativeProviderGraph(profiles)
