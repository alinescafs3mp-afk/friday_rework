+"""Inactive job-local provider bridge; native Agent and extension orchestration stays local.
+
+Bindings contain public profile identity and IPC callables, never provider keys,
+GuardianSession, engine endpoints or GuardianLease. Every fresh interpreter owns
+its own registry; retained provider dispatch never receives objects/callbacks.
+"""
+from __future__ import annotations
+import inspect
+from helpers.frw_model_work_core import ModelWorkError,encode,validate_request,validate_response
+_BINDINGS={}
+def bind(model,profile,exchange,exchange_sync=None,exchange_stream=None):
+    if id(model) in _BINDINGS:raise ModelWorkError('already_bound')
+    _BINDINGS[id(model)]=(model,profile,exchange,exchange_sync,exchange_stream)
+    return model
+def is_bound(model):return id(model) in _BINDINGS and _BINDINGS[id(model)][0] is model
+def _binding(model):
+    if not is_bound(model):raise ModelWorkError('model_not_bound')
+    return _BINDINGS[id(model)]
+def _messages(messages,system_message,user_message):
+    from langchain_core.messages import SystemMessage,HumanMessage
+    native=list(messages or [])
+    if system_message:native.insert(0,SystemMessage(content=system_message))
+    if user_message:native.append(HumanMessage(content=user_message))
+    out=[]
+    for m in native:
+        role={'human':'user','ai':'assistant'}.get(m.type,m.type)
+        from helpers.images import prepare_content
+        content=prepare_content(m.content)
+        value={'role':role,'content':content}
+        if getattr(m,'tool_calls',None):value['tool_calls']=m.tool_calls
+        if role=='tool':value['tool_call_id']=m.tool_call_id
+        out.append(value)
+    return out
+class OutputAccounting:
+    """One call's cumulative native estimate, reconciled against reported usage.
+
+    The supplied native RateLimiter persists in the trusted engine across jobs;
+    this ledger does not replace its original 60-second limits or add a model
+    cap. Text estimates and provider-reported hidden usage remain distinct from
+    measured actual model tokens. Stream text/final metadata are charged once.
+    """
+    def __init__(self,limiter):
+        self.limiter=limiter;self.text={'response':'','reasoning':''};self.charged=0
+    def add_delta(self,response='',reasoning=''):
+        if not self.limiter:return
+        self.text['response']+=response;self.text['reasoning']+=reasoning;self.finish()
+    def finish(self,result=None):
+        if not self.limiter:return
+        from helpers.tokens import approximate_tokens
+        text=dict(self.text)
+        totals={kind:approximate_tokens(value) for kind,value in text.items()}
+        if result is not None:
+            for kind in text:
+                totals[kind]=max(totals[kind],approximate_tokens(result.get(kind,'')))
+        total=sum(totals.values())
+        if result is not None:
+            generated={'response':[],'reasoning':[]}
+            for item in result.get('output_items',[]):
+                if type(item) is not dict:continue
+                kind='reasoning' if item.get('type')=='reasoning' else 'response'
+                if item.get('type')=='function_call':
+                    generated[kind].extend(item.get(k,'') for k in ('name','arguments')
+                                           if type(item.get(k,'')) is str)
+                parts=item.get('summary',[]) if kind=='reasoning' else []
+                parts=parts if type(parts) is list else []
+                content=item.get('content',[])
+                if type(content) is list:parts=parts+content
+                for part in parts:
+                    if type(part) is dict:
+                        generated[kind].extend(part.get(k,'') for k in ('text','refusal')
+                                               if type(part.get(k,'')) is str)
+            total=sum(max(totals[kind],
+                          approximate_tokens(''.join(generated[kind]))) for kind in text)
+        # Responses provider usage includes hidden reasoning when reported.
+        # It remains a provider report, not proof of actual target tokenization.
+        if result is not None:
+            usage=result.get('usage',{})
+            if type(usage) is dict:
+                known=usage.get('output_tokens',usage.get('completion_tokens',0))
+                if type(known) is int and known>=0:total=max(total,known)
+        if total>self.charged:self.limiter.add(output=total-self.charged);self.charged=total
+
+async def invoke_model(model,route,*,system_message='',user_message='',messages=None,response_callback=None,reasoning_callback=None,tokens_callback=None,rate_limiter_callback=None,explicit_caching=False,**options):
+    _,profile,exchange,_,exchange_stream=_binding(model)
+    request={'v':1,'route':route,'profile':profile,'messages':_messages(messages,system_message,user_message),
+        'stream':any(c is not None for c in (response_callback,reasoning_callback,tokens_callback)),
+        'explicit_caching':explicit_caching,'options':options}
+    raw=encode(request);canonical=validate_request(raw,{profile})
+    # Native limiter executes with job-local callback and public native metadata
+    # before IPC. The engine also enforces its independent trusted profile quota.
+    from models import apply_rate_limiter
+    from langchain_core.messages import AIMessage,HumanMessage,SystemMessage,ToolMessage,ChatMessage
+    classes={'assistant':AIMessage,'user':HumanMessage,'system':SystemMessage,'tool':ToolMessage}
+    prepared=[]
+    for item in request['messages']:
+        data={k:v for k,v in item.items() if k!='role'}
+        prepared.append(classes[item['role']](**data) if item['role'] in classes else ChatMessage(role=item['role'],**data))
+    limiter=await apply_rate_limiter(model.a0_model_conf,
+        str(model._convert_messages(prepared,explicit_caching=explicit_caching)),rate_limiter_callback)
+    accounting=OutputAccounting(limiter)
+    callbacks={'response':response_callback,'reasoning':reasoning_callback,'tokens':tokens_callback}
+    async def on_event(event_raw):
+        from helpers.frw_model_work_core import decode
+        event=decode(event_raw)
+        if type(event) is not dict or set(event)!={'kind','delta','total'} or event['kind'] not in callbacks:
+            raise ModelWorkError('invalid_live_event')
+        validate_response(encode({'v':1,'route':route,'result':{'response':'','reasoning':''},'events':[event]}),canonical)
+        if event['kind'] in accounting.text:
+            accounting.add_delta(**{event['kind']:event['delta']})
+        cb=callbacks[event['kind']]
+        value=None
+        if cb is not None:
+            value=cb(event['delta'],event['total'])
+            if inspect.isawaitable(value):value=await value
+        if event['kind']=='response' and value is not None:
+            raise ModelWorkError('stream_earlystop_requires_provider_cancel_or_sticky_unknown')
+        return True
+    if request['stream']:
+        if exchange_stream is None:raise ModelWorkError('live_duplex_exchange_required')
+        reply=exchange_stream(raw,on_event)
+    else:reply=exchange(raw)
+    if inspect.isawaitable(reply):reply=await reply
+    decoded=validate_response(reply,canonical)
+    if request['stream'] and decoded['events']:raise ModelWorkError('live_events_must_not_be_replayed')
+    result=decoded['result']
+    accounting.finish(result)
+    if route=='turn':
+        from helpers.llm_result import LLMResult
+        return LLMResult.from_dict(result)
+    return result['response'],result['reasoning']
+def invoke_embedding(model,inputs):
+    _,profile,_,exchange_sync,_=_binding(model)
+    if exchange_sync is None:raise ModelWorkError('sync_embedding_exchange_required')
+    from models import apply_rate_limiter_sync
+    apply_rate_limiter_sync(model.a0_model_conf,' '.join(inputs))
+    req={'v':1,'route':'embedding','profile':profile,'inputs':inputs}
+    raw=encode(req);validate_request(raw,{profile})
+    return validate_response(exchange_sync(raw),req)['result']['vectors']
+
+_INSTALLED=None
+def install_graph_bridge(exchange,profile_descriptors,*,exchange_sync=None,exchange_stream=None):
+    """Install only in one fresh job, before native model getters are used.
+
+    Descriptors are public data staged read-only by the finite guardian. Native
+    arbitrary extension/loader code remains job-local. Provider profile selection
+    is an exact public descriptor lookup; unadmitted custom models remain OPEN.
+    """
+    global _INSTALLED
+    if _INSTALLED is not None:raise ModelWorkError('fresh_job_bridge_already_installed')
+    if not callable(exchange) or type(profile_descriptors) is not dict or not profile_descriptors:
+        raise ModelWorkError('job_exchange_and_profiles_required')
+    from helpers.frw_model_work_core import decode
+    clean=decode(encode(profile_descriptors))
+    for pid,p in clean.items():
+        if type(p) is not dict or set(p)!={'kind','provider','name','public_kwargs'} or p['kind'] not in ('chat','embedding','local_embedding'):
+            raise ModelWorkError('public_profile_descriptor_schema')
+        if type(p['provider']) is not str or type(p['name']) is not str or type(p['public_kwargs']) is not dict:
+            raise ModelWorkError('public_profile_descriptor_schema')
+        # A public api_base may be present only as the guardian's pinned,
+        # nonsecret approved local route. It is used for exact model matching;
+        # per-call endpoint and header overrides remain outside request schema.
+        # Credentials never belong in descriptors. Authority is selected by ID in
+        # trusted guardian profiles, never inferred from user-supplied settings.
+        if any(k in p['public_kwargs'] for k in ('api_key','api_token','aws_access_key_id','aws_secret_access_key','extra_headers','headers')):
+            raise ModelWorkError('credential_or_route_in_public_profile')
+    _INSTALLED=(exchange,clean,exchange_sync,exchange_stream)
+def bridge_installed():return _INSTALLED is not None
+def get_bound_model(kind,provider,name,model_config,kwargs):
+    if _INSTALLED is None:raise ModelWorkError('job_bridge_not_installed')
+    exchange,profiles,sync,stream=_INSTALLED
+    from models import _merge_provider_public_defaults,_adjust_call_args
+    if type(provider) is not str or type(name) is not str or type(kwargs) is not dict:
+        raise ModelWorkError('model_selector_schema')
+    provider=provider.lower()
+    effective_provider,kwargs=_merge_provider_public_defaults(kind,provider,dict(kwargs))
+    matches=[(pid,p) for pid,p in profiles.items() if p['kind'] in ((kind,'local_embedding') if kind=='embedding' else (kind,)) and p['provider']==provider and p['name']==name and p['public_kwargs']==kwargs]
+    if len(matches)!=1:raise ModelWorkError('model_override_not_in_immutable_profiles')
+    pid,p=matches[0]
+    effective_provider,name,kwargs=_adjust_call_args(effective_provider,name,dict(kwargs))
+    from models import LiteLLMChatWrapper,LiteLLMEmbeddingWrapper,LocalSentenceTransformerWrapper
+    if p['kind']=='local_embedding':
+        model=LocalSentenceTransformerWrapper.__new__(LocalSentenceTransformerWrapper)
+        model.model_name=name;model.a0_model_conf=model_config
+    else:
+        cls=LiteLLMChatWrapper if kind=='chat' else LiteLLMEmbeddingWrapper
+        model=cls(name,effective_provider,model_config,**kwargs)
+    return bind(model,pid,exchange,sync,stream)
