+class JobModelIPC:
+    """One job's data-only socket; authenticated against current OS namespace.
+
+    The path conveys no model grant. Every peer frame is tied to an actual
+    living process in the already admitted current PID+mount namespace. Session,
+    leases, engine socket/config and provider credentials stay in the guardian.
+    """
+    def __init__(self,boundary,path,job_id,context_id,deadline):
+        import socket
+        self.boundary,self.path,self.job_id,self.context_id,self.deadline=boundary,str(path),job_id,context_id,deadline
+        self.listener=socket.socket(socket.AF_UNIX,socket.SOCK_SEQPACKET)
+        self.listener.setsockopt(socket.SOL_SOCKET,socket.SO_PASSCRED,1)
+        self.listener.bind(self.path);os.chmod(self.path,0o600);self.listener.listen(16)
+        self.listener.settimeout(.05)
+        self.closing=threading.Event();self.thread=None;self.peer=None;self.error=None
+
+    def start(self):
+        self.thread=threading.Thread(target=self._run,name='finite-native-job-ipc',daemon=False)
+        self.thread.start()
+
+    def _current(self):
+        b=self.boundary
+        with b.lock:
+            active=b.active
+            require(not self.closing.is_set() and active is not None
+                    and active[:2] == (self.job_id,self.context_id)
+                    and not b.unknown and active[2].populated(), 'retired_job_ipc')
+            require(b.clock()<min(self.deadline,b.end_monotonic), 'job_ipc_expired')
+            b._model_engine_dispatch.session.runtime_admission().job(active[2])
+            return active
+
+    def _packet(self,peer):
+        import socket,struct,array
+        active=self._current()
+        peer.settimeout(max(.001,self.deadline-self.boundary.clock()))
+        raw,anc,flags,_=peer.recvmsg(65549,socket.CMSG_SPACE(12)+socket.CMSG_SPACE(256))
+        creds=[];received=[];unknown=False
+        for level,kind,data in anc:
+            if level==socket.SOL_SOCKET and kind==socket.SCM_CREDENTIALS:
+                if len(data)==12:creds.append(struct.unpack('3i',data))
+                else:unknown=True
+            elif level==socket.SOL_SOCKET and kind==socket.SCM_RIGHTS:
+                fds=array.array('i');fds.frombytes(data[:len(data)-len(data)%fds.itemsize]);received.extend(fds);unknown=True
+            else:unknown=True
+        for fd in received:os.close(fd)
+        require(not flags&(socket.MSG_TRUNC|socket.MSG_CTRUNC) and not unknown
+                and len(creds)==1 and creds[0][0]>0 and raw and len(raw)<=65548,
+                'job_ipc_ancillary_or_size')
+        identity=process_identity(creds[0][0])
+        require(identity[2][0:2]==active[2].identity[0:2], 'foreign_job_ipc_namespace')
+        require(self._current() is active,'job_ipc_current_changed')
+        return raw
+
+    def _recv(self,peer):
+        import struct
+        raw=self._packet(peer)
+        require(len(raw)>=12 and raw[:4]==b'FWJ1','job_ipc_fragment_header')
+        total,offset=struct.unpack('!II',raw[4:12])
+        require(0<total<=2000000 and offset==0,'job_ipc_fragment_bound')
+        result=raw[12:]
+        while len(result)<total:
+            raw=self._packet(peer)
+            require(len(raw)>=12 and raw[:4]==b'FWJ1'
+                    and struct.unpack('!II',raw[4:12])==(total,len(result)),
+                    'job_ipc_fragment_sequence')
+            result+=raw[12:]
+        require(len(result)==total,'job_ipc_fragment_length')
+        return result
+
+    def _send(self,peer,value):
+        import struct
+        self._current()
+        raw=json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False).encode()
+        require(0<len(raw)<=2000000,'job_ipc_reply_oversized')
+        peer.settimeout(max(.001,self.deadline-self.boundary.clock()))
+        for offset in range(0,len(raw),65536):
+            self._current()
+            packet=b'FWJ1'+struct.pack('!II',len(raw),offset)+raw[offset:offset+65536]
+            require(peer.send(packet)==len(packet),'job_ipc_backpressure')
+
+    def _run(self):
+        import socket,base64
+        try:
+            while not self.closing.is_set() and self.boundary.clock()<self.deadline:
+                try:self.peer,_=self.listener.accept()
+                except socket.timeout:continue
+                self.peer.setsockopt(socket.SOL_SOCKET,socket.SO_PASSCRED,1)
+                self.peer.setsockopt(socket.SOL_SOCKET,socket.SO_SNDBUF,2*1048576)
+                self.peer.setsockopt(socket.SOL_SOCKET,socket.SO_RCVBUF,2*1048576)
+                try:
+                    raw=self._recv(self.peer)
+                    def on_event(event):
+                        require(type(event) is bytes,'typed_model_event_required')
+                        self._send(self.peer,{'kind':'event','body':base64.b64encode(event).decode()})
+                        ack=checked_json(self._recv(self.peer))
+                        require(type(ack) is dict and set(ack)=={'kind','continue'}
+                                and ack['kind']=='ack' and type(ack['continue']) is bool,'job_event_ack_invalid')
+                        return ack['continue']
+                    reply=self.boundary.dispatch_model_work(self.job_id,self.context_id,raw,on_event=on_event)
+                    self._send(self.peer,{'kind':'reply','body':base64.b64encode(reply).decode()})
+                finally:
+                    self.peer.close();self.peer=None
+        except BaseException as exc:
+            if not self.closing.is_set():
+                self.error=type(exc).__name__
+                self.boundary.unknown=True
+                dispatch=self.boundary._model_engine_dispatch
+                if dispatch is not None:
+                    try:dispatch.session.cancel(reason='job_ipc_failed')
+                    except BaseException:pass
+        finally:
+            if self.peer is not None:self.peer.close();self.peer=None
+
+    def revoke(self):
+        import socket
+        self.closing.set()
+        self.listener.close()
+        if self.peer is not None:
+            try:self.peer.shutdown(socket.SHUT_RDWR)
+            except OSError:pass
+
+    def settle(self,seconds=1):
+        self.revoke()
