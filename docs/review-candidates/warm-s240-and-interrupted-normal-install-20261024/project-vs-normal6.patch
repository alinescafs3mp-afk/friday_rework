+def check_inspection_config(pins):
+    """Data-only public current-profile view, before any native import/hook.
+
+    User/project/agent/plugin executable discovery is absent. Provider keys are
+    not needed for profile preparation; the later admitted engine owns keys.
+    """
+    allowed={'settings.json','plugins/_model_config/presets.yaml','plugins/_model_config/config.json'}
+    require(type(pins) is dict and set(pins)==allowed,'inspection_public_config_pins_required')
+    root=Path('/a0/usr');directories={'plugins','plugins/_model_config'};found=set()
+    require(root.resolve()==root and stat.S_IMODE(root.stat().st_mode)==0o700
+            and root.stat().st_uid==os.getuid() and os.statvfs(root).f_flag&os.ST_RDONLY,
+            'inspection_private_readonly_data_view_required')
+    for directory,dirs,files in os.walk(root,followlinks=False):
+        for name in dirs+files:
+            path=Path(directory)/name;relative=path.relative_to(root).as_posix();s=path.lstat()
+            require(not stat.S_ISLNK(s.st_mode) and s.st_uid==os.getuid()
+                    and os.statvfs(path).f_flag&os.ST_RDONLY,'inspection_foreign_or_mutable_config')
+            if name in dirs:
+                require(relative in directories and stat.S_ISDIR(s.st_mode)
+                        and stat.S_IMODE(s.st_mode)==0o700,'inspection_executable_discovery_directory')
+            else:
+                require(relative in allowed and stat.S_ISREG(s.st_mode) and s.st_nlink==1
+                        and stat.S_IMODE(s.st_mode) in (0o400,0o600),'inspection_executable_or_secret_config')
+                raw=path.read_bytes()
+                require(len(raw)<=16*1024**2 and hashlib.sha256(raw).hexdigest()==pins[relative]
+                        and s==path.lstat(),'inspection_config_pin_changed')
+                found.add(relative)
