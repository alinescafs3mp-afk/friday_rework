+def checked_policy(value, *, check_files=True, preparation=False):
+    fields = {'schema','enabled','image','base_image','bwrap_sha256','core_sha256','sources','factory_source'}
+    require(isinstance(value, dict) and fields <= set(value) <= fields | {'model_work'} and value['schema'] == SCHEMA
+            and value['enabled'] is True, 'finite_service_explicit_opt_in_required')
+    for key in ('image', 'base_image'):
+        require(isinstance(value[key], str) and re.fullmatch('sha256:[0-9a-f]{64}', value[key]), 'finite_image_unpinned')
+    for key in ('bwrap_sha256','core_sha256'):
+        require(isinstance(value[key], str) and re.fullmatch('[0-9a-f]{64}', value[key]), 'finite_asset_unpinned')
+    require(isinstance(value['factory_source'],dict)
+            and value['factory_source'].get('path') == str(Path(__file__).resolve()),
+            'finite_foreign_factory_source')
+    if 'model_work' in value:
+        require(value['model_work']=={'enabled':True,'schema':'frw.native-model-runtime.v1'},
+                'native_model_work_explicit_opt_in_required')
+    sources = value['sources']
+    require(isinstance(sources, dict) and REQUIRED <= set(sources) <= REQUIRED | OPTIONAL, 'finite_sources_incomplete')
+    model_required = MODEL_REQUIRED - ({'/a0/frw-model-runtime.json'} if preparation else set())
+    require((model_required <= set(sources)) if 'model_work' in value else not (set(sources)&MODEL_REQUIRED),
+            'native_model_work_staging_incomplete')
+    require(sources['/usr/bin/bwrap']['sha256'] == value['bwrap_sha256']
+            and sources['/a0/plugins/_memory/helpers/memory.py']['sha256'] == GUARD, 'finite_required_pin_changed')
+    for target, pin in {**sources,'@host_factory':value['factory_source']}.items():
+        require(isinstance(pin, dict) and set(pin) == {'path','sha256'}
+                and isinstance(pin['sha256'], str) and re.fullmatch('[0-9a-f]{64}',pin['sha256'])
+                and isinstance(pin['path'], str), 'finite_source_pin_invalid')
+        p = Path(pin['path'])
+        require(p.is_absolute() and '..' not in p.parts and not any(c in str(p) for c in '\r\n\x00,')
+                and p.resolve() == p, 'finite_source_path_invalid')
+        if check_files:
+            fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+            try:
+                before = os.fstat(fd)
+                require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and before.st_uid == os.getuid()
+                        and not before.st_mode & 0o022 and 0 < before.st_size <= 16*1024**2,
+                        'finite_source_identity_changed')
+                data = b''
+                while chunk := os.read(fd, 65536):
+                    data += chunk; require(len(data) <= 16*1024**2, 'finite_source_oversized')
+                identity = lambda s: (s.st_dev,s.st_ino,s.st_mode,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_nlink)
+                require(identity(before) == identity(os.fstat(fd)) == identity(p.lstat())
+                        and hashlib.sha256(data).hexdigest() == pin['sha256'], 'finite_source_bytes_changed')
+            finally: os.close(fd)
+    return json.loads(json.dumps(value, allow_nan=False))
