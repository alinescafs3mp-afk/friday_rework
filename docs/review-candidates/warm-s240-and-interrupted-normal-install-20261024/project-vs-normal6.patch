+                    and type(launch['deadline_monotonic']) in (int, float)
+                    and math.isfinite(launch['deadline_monotonic'])
+                    and launch['deadline_monotonic'] == lease.accepted_monotonic + lease.budget_seconds,
+                    'warm_launch_not_admitted')
+            file_prefix = hashlib.sha256((lease.job_id + ':' + lease.admission_sha256).encode()).hexdigest()[:24]
+            result = self.native.begin(lease.job_id, self._context(lease),
+                {**launch, 'file_prefix': file_prefix})
+            self._check_receipt(result, lease, settled=False)
+            self.journal('JOB_STARTED', {'job_id': lease.job_id, 'native': result})
+            return result
+        except BaseException:
+            self.unknown = True
+            self.invalidate('warm_job_begin_unknown_or_refused')
+            raise
+
+    @staticmethod
+    def _context(lease):
+        # Independent per-job namespace, never previous request/context IDs.
+        return hashlib.sha256((lease.job_id + ':' + lease.admission_sha256
+                               + ':' + lease.request_sha256).encode()).hexdigest()
+
+    def _check_receipt(self, result, lease, *, settled):
+        require(isinstance(result, dict)
+                and result.get('service_id') == self.custody.service_id
+                and result.get('job_id') == lease.job_id
+                and result.get('context_id') == self._context(lease)
+                and result.get('settled') is settled
+                and result.get('service_running') is True
+                and result.get('core_readonly') is True
+                and result.get('job_processes_empty') is settled,
+                'native_job_boundary_unknown')
+
+    def finish(self, lease):
+        """Release job capacity, while reporting the service as still running."""
+        with self.lock:
+            require(self.active == lease and not self.finishing, 'foreign_active_warm_job')
+            self.finishing = True
+        try:
+            self._check_current(lease)
+            self.journal('JOB_END_INTENT', {'job_id': lease.job_id})
+            result = self.native.end(lease.job_id, self._context(lease))
+            self._check_receipt(result, lease, settled=True)
+            self._check_current(lease)
+            self.journal('JOB_SETTLED', {'job_id': lease.job_id, 'native': result,
+                'job_capacity_released': True, 'service_stop_confirmed': False})
+            with self.lock:
+                self.active = None
+                self.finishing = False
+            return {'job_id': lease.job_id, 'state': 'completed',
+                    'job_capacity_released': True, 'service_running': True,
+                    'stop_confirmed': False, 'boundary': result}
+        except BaseException:
+            self.unknown = True
+            self.invalidate('warm_job_end_unknown_or_refused')
+            raise
+
+    def invalidate(self, reason):
+        """Revocation/cancel/expiry/UNKNOWN always retain exact original stop."""
+        require(isinstance(reason, str) and re.fullmatch(r'[a-z_]{1,96}', reason),
+                'invalid_warm_stop_reason')
+        with self.lock:
+            self.invalidated = True
+            attempted = self.stop_attempted
+            self.stop_attempted = True
+        # The existing boundary handles repeated stops by reconciliation. No
+        # changed fresh lease, policy or secret can withhold original custody.
+        try:
+            unit = self.owned_stop(self.original_row)
+            require(unit.quiescent, 'STOP_UNCONFIRMED')
+            self.stop_confirmed = True
+        except BaseException:
+            self.stop_confirmed = False
+            raise A0Error('STOP_UNCONFIRMED') from None
+        finally:
+            try:
+                self.journal('SERVICE_INVALIDATED', {'reason': reason,
+                    'stop_confirmed': self.stop_confirmed, 'repeated': attempted,
+                    'active_job_id': None if self.active is None else self.active.job_id})
+            except BaseException:
+                self.unknown = True
+        return unit
+
+
+class A0NativeWarmControl:
+    """Host proxy over the existing exact native /api/api_message transport.
+
+    The guardian is an optional wrapper inside the original run_ui process.
+    It starts/stops fresh native run_ui job interpreters in bounded namespaces;
+    it is neither a host daemon nor a second model engine. This class creates
+    no native guardian and cannot adopt one after restart.
+    """
+    def __init__(self, original_boundary, original_row, policy):
+        import copy
+        require(isinstance(policy, dict) and {"bwrap_sha256", "bootstrap_sha256", "helper_sha256", "data_helper_sha256", "memory_helper_sha256", "memory_enabled", "job_config"} <= set(policy) <= {"bwrap_sha256", "bootstrap_sha256", "helper_sha256", "data_helper_sha256", "memory_helper_sha256", "memory_enabled", "job_config", "model_work"}
+                and type(policy["memory_enabled"]) is bool
+                and isinstance(policy["job_config"],dict)
+                and {"plugins/_model_config/presets.yaml","plugins/_model_config/config.json","plugins/_code_execution/config.json"}
+                    <= set(policy["job_config"]) <= {"plugins/_model_config/presets.yaml","plugins/_model_config/config.json","plugins/_code_execution/config.json","plugins/_document_query/config.json"}
+                and all(isinstance(v,str) and re.fullmatch("[0-9a-f]{64}",v) for v in policy["job_config"].values())
+                and all(isinstance(v, str) and re.fullmatch("[0-9a-f]{64}", v) for k,v in policy.items() if k not in {"memory_enabled","job_config","model_work"}),
+                "pinned_warm_runtime_policy_required")
+        if 'model_work' in policy:
+            require(type(policy['model_work']) is dict
+                    and set(policy['model_work'])=={'runtime_helper_sha256','policy_sha256'}
+                    and all(type(v) is str and re.fullmatch('[0-9a-f]{64}',v) for v in policy['model_work'].values()),
+                    'native_model_work_pins_required')
+        self.policy = dict(policy)
+        require(not original_boundary.stop_only, 'a0_restart_stop_only')
+        self.boundary, self.row = original_boundary, copy.deepcopy(original_row)
+        self.service_id = original_boundary.grant.container_id + ':' + original_boundary.grant.invocation_id
+        self.active_layout = None  # opaque current job handle; never authority bytes
+        self.active = None
+        self.unknown = False
+        self.initialized = False
+
+    def _request(self, op, values, *, timeout=3, max_bytes=65536):
+        require(not self.unknown and not self.boundary.stop_only, 'warm_control_unknown_or_stop_only')
+        try:
+            self.boundary.admit(self.row)
+            left = self.boundary.native_end_monotonic - self.boundary.monotonic() - 5
+            timeout = min(timeout, left)
+            require(timeout > 0, 'original_service_expired')
+            result = self.boundary.request(self.row, 'POST', '/api/api_message', {
+                '_friday_warm_control': {'op': op, 'service_id': self.service_id, **values}},
+                timeout, max_bytes)
+            require(isinstance(result, dict), 'warm_native_control_unknown')
+            return result
+        except BaseException:
+            self.unknown = True
+            raise
+
+    def check(self, service_id):
+        require(service_id == self.service_id, 'foreign_warm_service')
+        self.boundary.admit(self.row)
+        if not self.initialized:
+            value = self._request('init', {
+                'accepted_monotonic': self.boundary.native_started_monotonic,
+                'end_monotonic': self.boundary.native_end_monotonic,
+                'stop_reserve': 10, **self.policy})
+            require(value.get('service_id') == service_id and value.get('service_running') is True
+                    and value.get('original_end_monotonic') == self.boundary.native_end_monotonic,
+                    'warm_native_initialization_unknown')
+            self.initialized = True
+        else:
+            value = self._request('check', {})
+        require(value.get('service_id') == service_id and value.get('service_running') is True
+                and value.get('core_readonly') is True
+                and value.get('original_end_monotonic') == self.boundary.native_end_monotonic,
+                'warm_native_control_changed')
+        return value
+
+    def begin(self, job_id, context_id, launch):
+        require(self.initialized and self.active is None and isinstance(launch, dict)
+                and set(launch) == {'deadline_monotonic', 'file_prefix'}
+                and isinstance(launch['file_prefix'], str)
+                and re.fullmatch('[0-9a-f]{24}', launch['file_prefix']), 'warm_launch_not_admitted')
+        self.active = (job_id, context_id)
+        self.active_layout = object()
+        return self._request('begin', {'job_id': job_id, 'context_id': context_id,
+                                      'deadline_monotonic': launch['deadline_monotonic'],
+                                      'file_prefix': launch['file_prefix'],
+                                      **({'model_work_mode':'retained-native-provider'} if 'model_work' in self.policy else {})})
+
+    def check_active(self, job_id, context_id):
+        require(self.active == (job_id, context_id), 'foreign_active_warm_job')
+        value = self._request('check_active', {'job_id': job_id, 'context_id': context_id})
+        require(value.get('job_id') == job_id and value.get('context_id') == context_id
+                and value.get('job_processes_empty') is False
+                and value.get('service_running') is True, 'native_warm_job_lost')
+        return value
+
+    def request(self, job_id, context_id, method, path, payload, timeout, max_bytes):
+        require(self.active == (job_id, context_id), 'foreign_active_warm_job')
+        # API/key validation, no redirect/proxy, byte caps and native-token
+        # redaction happen inside the trusted original service guardian.
+        value = self._request('request', {'job_id': job_id, 'context_id': context_id,
+            'method': method, 'path': path, 'payload': payload, 'timeout': timeout,
+            'max_bytes': max_bytes}, timeout=timeout + 1, max_bytes=4 * ((max_bytes + 2) // 3) + 65536)
+        if value == {'ok': True, 'ready': False}: return {'ready': False}
+        require(set(value) == {'ok', 'body'} and value['ok'] is True, 'warm_api_outcome_unknown')
+        return strict_json(decode_file(value['body'], max_bytes))
+
+    def file(self, job_id, context_id, path, limit, timeout):
+        require(self.active == (job_id, context_id), 'foreign_active_warm_job')
+        require(isinstance(path, str) and type(limit) is int and 0 < limit <= 16 * 1024**2,
+                'invalid_warm_file_read')
+        value = self._request('file', {'job_id': job_id, 'context_id': context_id,
+            'path': path, 'limit': limit}, timeout=timeout,
+            max_bytes=4 * ((limit + 2) // 3) + 65536)
+        require(isinstance(value, dict) and set(value) == {
+            'identity', 'size', 'sha256', 'base64', 'provenance'}, 'invalid_warm_file_proof')
+        data = decode_file(value['base64'], limit)
+        require(type(value['size']) is int and value['size'] == len(data)
+                and value['sha256'] == hashlib.sha256(data).hexdigest(), 'warm_file_bytes_changed')
+        return value
+
+    def end(self, job_id, context_id):
+        require(self.active == (job_id, context_id), 'foreign_active_warm_job')
+        result = self._request('end', {'job_id': job_id, 'context_id': context_id})
+        self.active = self.active_layout = None
+        return result
+
+
+class A0WarmTransport:
+    """One fresh job's requests; original service custody is never relabeled."""
+    def __init__(self, service, lease):
+        from threading import Lock
+        require(isinstance(service, A0FiniteWarmService) and isinstance(lease, WarmJobLease)
+                and service.active == lease, 'foreign_warm_transport')
+        self.service, self.lease = service, lease
+        self.used_messages = set()
+        self.lock = Lock()
+
+    def request(self, method, path, payload, timeout, max_bytes):
+        require(method in {'GET', 'POST'} and path in {
+            '/api/health', '/api/api_message', '/api/api_log_get', '/api/api_files_get'}
+            and isinstance(payload, dict) and type(max_bytes) is int
+            and 0 < max_bytes <= 64 * 1024**2, 'invalid_warm_request')
+        require(path != '/api/health' or (method == 'GET' and not payload), 'invalid_warm_readiness')
+        context = self.service._context(self.lease)
+        if path in {'/api/api_message', '/api/api_log_get'}:
+            require(payload.get('context_id') == context and not payload.get('project_name'),
+                    'foreign_warm_request_context')
+        if not self.lock.acquire(blocking=False): raise A0Error('warm_request_inflight')
+        try:
+            require(self.service.active == self.lease, 'foreign_warm_transport')
+            self.service._check_current(self.lease)
+            self.service.native.check_active(self.lease.job_id, context)
+            mono = self.service.monotonic()
+            left = min(self.service.custody.end_monotonic - mono - self.lease.stop_reserve_seconds,
+                self.lease.deadline_unix - self.service.clock(),
+                self.lease.accepted_monotonic + self.lease.budget_seconds - mono)
+            require(type(timeout) in (int, float) and math.isfinite(timeout)
+                    and 0 < timeout <= left, 'warm_request_does_not_fit_original_clock')
+            if path == '/api/api_message':
+                phase = hashlib.sha256(json.dumps(payload, sort_keys=True, allow_nan=False).encode()).hexdigest()
+                require(phase not in self.used_messages, 'warm_message_replay')
+                self.used_messages.add(phase)
+            result = self.service.native.request(self.lease.job_id, context,
+                method, path, payload, timeout, max_bytes)
+            self.service._check_current(self.lease)
+            return result
+        except BaseException:
+            self.service.unknown = True
+            self.service.invalidate('warm_api_outcome_unknown')
+            raise
+        finally:
+            self.lock.release()
+
+    def file(self, path, limit, timeout):
+        """Independent current namespace read; not the native files_get API."""
+        require(isinstance(path, str) and type(limit) is int and 0 < limit <= 16 * 1024**2,
+                'invalid_warm_file_read')
+        if not self.lock.acquire(blocking=False): raise A0Error('warm_request_inflight')
+        try:
+            require(self.service.active == self.lease, 'foreign_warm_transport')
+            self.service._check_current(self.lease)
+            context = self.service._context(self.lease)
