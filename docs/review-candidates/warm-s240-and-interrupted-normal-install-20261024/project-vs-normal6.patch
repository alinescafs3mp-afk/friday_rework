+class _NativeWorker:
+    """One execution thread and event loop inside this finite engine only.
+
+    Cached native AsyncClients keep their original loop across fresh jobs. The
+    queue cannot accept concurrent work, and interruption retires whole engine.
+    """
+    def __init__(self, engine):
+        self.engine, self.tasks, self.active = engine, queue.Queue(maxsize=1), None
+        self.thread = threading.Thread(target=self._run,name='finite-native-call',daemon=True)
+        self.thread.start()
+
+    def _run(self):
+        with asyncio.Runner() as runner:
+            while True:
+                item = self.tasks.get()
+                if item is None:
+                    return
+                payload, scope, emit, result, done = item
+                try:
+                    method = getattr(self.engine,'invoke_stream',None)
+                    value = method(payload,scope,emit) if callable(method) else self.engine.invoke(payload,scope)
+                    if inspect.isawaitable(value):
+                        value = runner.run(value)
+                    result.append(('result',value))
+                except BaseException:
+                    result.append(('error','executor_failure'))
+                finally:
+                    done.set()
+
+    def submit(self,payload,scope,emit):
+        require(self.active is None or self.active.is_set(),'previous_native_call_unsettled')
+        done, result = threading.Event(), []
+        self.active = done
+        self.tasks.put_nowait((payload,scope,emit,result,done))
+        return done,result
+
+    def close(self):
+        if self.active is None or self.active.is_set():
+            self.tasks.put_nowait(None)
+            self.thread.join(timeout=.1)
+
+
+def _stream_execute(sock,key,session,seq,guardian_pid,until,worker,payload,scope_nonce):
+    events = queue.Queue(maxsize=1)
+    acknowledged, cancelled = threading.Event(), threading.Event()
+    def emit(raw):
+        require(type(raw) is bytes and len(raw) <= MAX_PAYLOAD,'bounded_stream_event')
+        if cancelled.is_set():
+            return False
+        acknowledged.clear()
+        events.put(('event',raw),timeout=max(.001,until-time.monotonic()))
+        while not acknowledged.wait(min(.02,max(.001,until-time.monotonic()))):
+            if cancelled.is_set() or time.monotonic() >= until:
+                return False
+        return not cancelled.is_set()
+    done,outcome = worker.submit(payload,scope_nonce,emit)
+    index = 0
+    try:
+        while time.monotonic() < until:
+            if done.is_set() and events.empty():
+                require(outcome and outcome[0][0] == 'result','executor_failure')
+                result = outcome[0][1]
+                require(type(result) is bytes and len(result) <= MAX_PAYLOAD,'bounded_executor_reply')
+                return result
+            try:
+                _, event = events.get(timeout=min(.01,max(.001,until-time.monotonic())))
+            except queue.Empty:
+                continue
+            _send(sock,pack(key,{'session':session,'seq':seq,'kind':'event','event':index,
+                                 'payload':base64.b64encode(event).decode('ascii')}))
+            ack = unpack(key,_recv(sock,guardian_pid,until))
+            require(type(ack) is dict and set(ack) == {'session','seq','kind','event'}
+                    and ack['session'] == session and type(ack['seq']) is int and ack['seq'] == seq
+                    and type(ack['event']) is int and ack['event'] == index
+                    and ack['kind'] in ('ack','cancel'),'stream_ack_identity')
+            if ack['kind'] == 'cancel':
+                cancelled.set(); acknowledged.set()
+                raise TransportError('stream_cancelled_provider_cessation_unproved')
+            index += 1
+            acknowledged.set()
+        raise TransportError('executor_deadline')
+    except BaseException:
+        cancelled.set(); acknowledged.set()
+        # Guardian retires/reaps exact engine. Task cancellation alone never
+        # claims remote/provider/descendant cessation, and session cannot reuse.
+        raise
+
+
+def _engine(fd, executor_fd, executor_sha256, guardian_pid, bootstrap_until=None):
+    sock = socket.socket(fileno=fd)
+    _socket_setup(sock)
+    _send(sock,encode({'schema':'frw.native-engine-hello.v2'}))
+    if bootstrap_until is None:
+        bootstrap_until = time.monotonic()+5
+    else:
+        require(finite(bootstrap_until) and time.monotonic()<bootstrap_until<=time.monotonic()+120,
+                'original_bootstrap_deadline_required')
+    raw_init, guardian_pid = _recv(sock,None,bootstrap_until,peer=True)
+    init = decode(raw_init)
+    require(type(init) is dict and set(init) == {'schema', 'key', 'session', 'service_id', 'accepted', 'end', 'source_only', 'config'}
+            and type(init['source_only']) is bool
+            and init['schema'] == 'frw.native-engine-init.v1'
+            and type(init['key']) is str and re.fullmatch('[0-9a-f]{64}', init['key'])
+            and type(init['session']) is str and HEX.fullmatch(init['session'])
+            and type(init['service_id']) is str and 1 <= len(init['service_id']) <= 160
+            and finite(init['accepted']) and finite(init['end'])
+            and 0 < init['end']-init['accepted'] <= 120
+            and init['accepted'] <= time.monotonic() < init['end'], 'invalid_engine_init')
+    if init['source_only']:
+        protect_process()
+    else:
+        require(init['accepted']<bootstrap_until<=init['end'],'bootstrap_outside_original_clock')
+        if '/a0' not in sys.path:sys.path.insert(0,'/a0')
+    # Production uses factory-proved PID/mount/user isolation and stays readable
+    # to its trusted guardian for continuous actual namespace/mount validation.
+    key, session, service = bytes.fromhex(init['key']), init['session'], init['service_id']
+    config = base64.b64decode(init['config'], validate=True)
+    require(len(config) <= 65536, 'bounded_trusted_config')
+    opened_executor = type(executor_fd) is str
+    executor_origin = executor_fd if opened_executor else '/proc/self/fd/'+str(executor_fd)
+    if opened_executor:
+        require(not init['source_only'] and executor_fd == '/a0/helpers/frw_model_work_bootstrap.py',
+                'production_executor_path_required')
+        executor_fd, _, _ = _open_pin(executor_fd, executor_sha256)
+    os.lseek(executor_fd, 0, os.SEEK_SET)
+    source = b''
+    while chunk := os.read(executor_fd, 65536):
+        source += chunk
+        require(len(source) <= 16*1024*1024, 'executor_oversized')
+    require(hashlib.sha256(source).hexdigest() == executor_sha256, 'executor_pin_changed')
+    if opened_executor:
+        os.close(executor_fd)
+    module = types.ModuleType('_frw_pinned_native_executor')
+    module.__file__ = executor_origin
+    sys.modules[module.__name__] = module
+    try:
+        exec(compile(source,module.__file__,'exec'),module.__dict__)
+        engine = module.build_dispatch(config)
+    except BaseException as exc:
+        _send(sock,pack(key,{'bootstrap_error_class':type(exc).__name__,'session':session}))
+        raise SystemExit(70) from None
+    # No arbitrary job callable/object crosses this boundary. This trusted
+    # factory itself is pinned SOURCE and still requires full graph review.
+    require(callable(getattr(engine, 'invoke', None)), 'pinned_executor_invoke_required')
+    _send(sock, pack(key, {'ready': True, 'session': session}))
+    expected, current, used = 1, None, set()
+    worker = _NativeWorker(engine)
+    while time.monotonic() < init['end']:
+        raw = _recv(sock, guardian_pid, init['end'])
+        seq = None
+        try:
+            value = unpack(key, raw)
+            require(type(value) is dict and set(value) == {'schema', 'session', 'service_id', 'seq', 'op',
+                    'job', 'context', 'nonce', 'deadline', 'payload'}, 'call_schema')
+            seq = value['seq']
+            require(value['schema'] == 'frw.native-engine-call.v1' and value['session'] == session
+                    and value['service_id'] == service and type(seq) is int and seq == expected,
+                    'session_or_sequence')
+            require(value['op'] in ('begin', 'invoke', 'stream', 'end') and type(value['job']) is str
+                    and ID.fullmatch(value['job']) and type(value['context']) is str
+                    and ID.fullmatch(value['context']) and type(value['nonce']) is str
+                    and HEX.fullmatch(value['nonce']) and finite(value['deadline'])
+                    and time.monotonic() < value['deadline'] <= init['end'], 'job_or_deadline')
+            scope = (value['job'], value['context'], value['nonce'], value['deadline'])
+            payload = base64.b64decode(value['payload'], validate=True)
+            require(len(payload) <= MAX_PAYLOAD, 'payload_oversized')
+            op = value['op']
+            if op == 'begin':
+                require(not payload and current is None and scope[:2] not in used, 'active_or_reused_job')
+                current = scope; used.add(scope[:2]); result = b''
+            else:
+                require(current == scope, 'revoked_or_foreign_job')
+                if op == 'end':
+                    require(not payload, 'end_payload_forbidden')
+                    current = None; result = b''
+                else:
+                    require(payload, 'empty_payload')
+                    if op == 'stream':
+                        result = _stream_execute(sock,key,session,seq,guardian_pid,
+                                                 min(scope[3],init['end']),worker,payload,scope[2])
+                    else:
+                        result = _stream_execute(sock,key,session,seq,guardian_pid,
+                                                 min(scope[3],init['end']),worker,payload,scope[2])
+                    require(type(result) is bytes and len(result) <= MAX_PAYLOAD, 'bounded_executor_reply')
+                    require(time.monotonic() < min(scope[3], init['end']), 'executor_deadline')
+            expected += 1
+            reply = {'session': session, 'seq': seq, 'ok': True,
+                     'payload': base64.b64encode(result).decode('ascii'), 'error': ''}
+        except Exception as exc:
+            # Authentication/sequence rejection causes no provider effect.
+            # Native invocation failures cause guardian sticky UNKNOWN and stop.
+            reply = {'session': session, 'seq': seq, 'ok': False, 'payload': '',
+                     'error': str(exc)[:160] if isinstance(exc, TransportError) else 'executor_failure'}
+        _send(sock, pack(key, reply))
+    worker.close()
+    sock.close()
+
+if __name__ == '__main__':
+    require((len(sys.argv)==6 and sys.argv[1]=='--engine')
+            or (len(sys.argv)==7 and sys.argv[1]=='--engine-path'), 'internal_engine_only')
+    if sys.argv[1] == '--engine-path':
+        require(sys.argv[2] == '/frw-engine.sock', 'fixed_engine_socket_required')
+        connection = socket.socket(socket.AF_UNIX,socket.SOCK_SEQPACKET)
+        connection.settimeout(5)
+        connection.connect(sys.argv[2]); connection.settimeout(None)
+        _engine(connection.detach(),sys.argv[3],sys.argv[4],int(sys.argv[5]),float(sys.argv[6]))
+    else:
+        _engine(int(sys.argv[2]), int(sys.argv[3]), sys.argv[4], int(sys.argv[5]))
