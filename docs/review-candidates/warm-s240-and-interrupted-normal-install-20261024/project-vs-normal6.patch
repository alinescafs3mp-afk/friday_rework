+def image_recipe(policy):
+    """Deterministic build input; caller stages exact files, no build occurs here.
+
+    The existing base must provide bwrap's runtime libraries. The produced image
+    is still unusable until independently built, digest-pinned and inspected.
+    """
+    p = checked_policy(policy)
+    entries = []
+    lines = ['FROM '+p['base_image'], 'SHELL ["/bin/bash", "-ceu"]',
+             'RUN . /ins/setup_venv.sh; . /ins/copy_A0.sh; mkdir -p /a0/tmp /frw-private /workspace /frw-memory; touch /frw-job-config.json /frw-engine.sock /frw-model.sock /frw-model-job.json; chmod -R go-w /a0 /opt/venv-a0']
+    for i, (target, pin) in enumerate(sorted(p['sources'].items())):
+        name = 'asset-%02d' % i
+        entries.append({'name':name,'target':target, **pin})
+        lines.append('COPY --chmod='+('0555' if target == '/usr/bin/bwrap' else '0444')+' '+name+' '+target)
+    checks={target:pin['sha256'] for target,pin in p['sources'].items()}
+    checks['/a0/agent.py']=p['core_sha256']
+    for target,want in sorted(checks.items()):
+        lines.append('RUN echo '+shlex.quote(want+'  '+target)+' | sha256sum -c -')
+    lines.append('RUN /usr/bin/bwrap --version >/dev/null')
+    lines += ['LABEL friday.finite.recipe='+recipe_identity(p),
+              'ENV PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1']
+    return {'dockerfile':'\n'.join(lines)+'\n','assets':entries,'recipe_sha256':recipe_identity(p),
+            'build':'NOT_RUN','native_layers':'UNCHANGED_120','model_work_mode':'fresh-isolated',
+            'actual_model_work_process_warm':False,
+            'optional_native_model_work_staged':'model_work' in p,
+            'runtime_admission':'NOT_OBSERVED'}
