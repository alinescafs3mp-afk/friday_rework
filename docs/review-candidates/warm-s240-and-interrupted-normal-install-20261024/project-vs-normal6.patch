+    except (ValueError, UnicodeError, RecursionError):
+        raise TransportError('invalid_data_only_json') from None
+
+def pack(key, value):
+    body = encode(value)
+    return encode({'body': base64.b64encode(body).decode('ascii'),
+                   'mac': hmac.digest(key, body, 'sha256').hex()})
+
+def unpack(key, raw):
+    wrapper = decode(raw)
+    require(type(wrapper) is dict and set(wrapper) == {'body', 'mac'}
+            and type(wrapper['body']) is str and type(wrapper['mac']) is str,
+            'authenticated_frame_required')
+    try:
+        body = base64.b64decode(wrapper['body'], validate=True)
+    except ValueError:
+        raise TransportError('invalid_base64') from None
+    require(hmac.compare_digest(wrapper['mac'], hmac.digest(key, body, 'sha256').hex()),
+            'invalid_mac')
+    return decode(body)
