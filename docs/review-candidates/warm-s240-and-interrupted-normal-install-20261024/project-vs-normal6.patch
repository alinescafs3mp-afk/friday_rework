+"""Optional A0 worker entry point, executed once in each isolated fresh job.
+
+Install at /a0/frw_native_job.py as readonly core. Native run_ui remains the
+engine. No provider call, request body, credential or new daemon is introduced.
+"""
+from __future__ import annotations
+import json
+import os
+from pathlib import Path
+import re
+import sys
+
+
+def require(value, code):
+    if not value:
+        raise RuntimeError(code)
+
+
+def start():
+    fields = [arg.split('=', 1)[1] for arg in sys.argv[1:] if arg.startswith('--frw-context-id=')]
+    require(len(fields) == 1 and re.fullmatch('[a-zA-Z0-9_-]{8,96}', fields[0]), 'fresh_context_id_required')
+    context_id = fields[0]
+    require(os.statvfs('/a0/agent.py').f_flag & os.ST_RDONLY, 'readonly_native_core_required')
+    require(os.statvfs('/a0/usr/settings.json').f_flag & os.ST_RDONLY
+            and os.statvfs('/a0/usr/.env').f_flag & os.ST_RDONLY, 'readonly_job_authority_required')
+    require(sys.flags.isolated == 1, 'isolated_python_required')
+    # Only the two declared canonical DATA mounts may survive fresh usr/tmp.
+    # The exact helper is pinned by the trusted guardian before worker spawn.
+    memory_flags = [arg for arg in sys.argv[1:] if arg.startswith('--frw-memory-enabled=')]
+    require(memory_flags in ([], ['--frw-memory-enabled=true']), 'invalid_memory_mode')
+    sys.path.insert(0, '/a0')
+    from frw_native_memory import fresh_native_state
+    fresh_native_state(bool(memory_flags))
+    from helpers import runtime, dotenv
+    runtime.initialize()
+    dotenv.load_dotenv()
+    if Path('/frw-model-job.json').exists():
+        require(os.statvfs('/frw-model-job.json').f_flag & os.ST_RDONLY, 'model_descriptor_readonly_required')
+        from native_model_runtime import checked_json
+        descriptors=checked_json(Path('/frw-model-job.json').read_bytes())
+        from frw_native_model_client import install
+        require(type(descriptors) is dict and set(descriptors)=={'profiles','deadline_monotonic'}, 'model_job_descriptor_invalid')
+        install(descriptors['profiles'],descriptors['deadline_monotonic'])
+    import run_ui
+    import initialize
+    from agent import AgentContext, AgentContextType
+    from api.api_message import ApiMessage
+    from api.api_log_get import ApiLogGet
+    from api.api_files_get import ApiFilesGet
+    from helpers.api import Response, ApiHandler
+    from native_job_boundary import bind_processes
+
+    native_init = run_ui.init_a0
+    expected_profile = [None]
+
+    def init_current_job():
+        native_init()
+        require(not AgentContext.all(), 'native_context_preexisted')
+        config = initialize.initialize_agent()
+        expected_profile[0] = config.profile
+        AgentContext(config=config, id=context_id, type=AgentContextType.USER)
+
+    run_ui.init_a0 = init_current_job
+    native_message = ApiMessage.process
+    native_log = ApiLogGet.process
+    native_files = ApiFilesGet.process
+
+    def reject():
+        return Response('{"error":"fresh_job_boundary_required"}', status=409, mimetype='application/json')
+
+    async def message(self, value, request):
+        if (value.get('context_id') != context_id or value.get('project_name')
+                or value.get('agent_profile', expected_profile[0]) != expected_profile[0]):
+            return reject()
+        return await native_message(self, value, request)
+
+    async def logs(self, value, request):
+        incoming = request.args.get('context_id') if request.method == 'GET' else value.get('context_id')
+        if incoming != context_id:
+            return reject()
+        return await native_log(self, value, request)
+
+    async def files(self, value, request):
+        paths = value.get('paths')
+        if not isinstance(paths, list) or not paths or len(paths) > 64:
+            return reject()
+        roots = [Path('/a0/usr/uploads'), Path('/a0/usr/workdir'), Path('/a0/tmp'), Path('/workspace')]
+        for name in paths:
+            if not isinstance(name, str) or not any(Path(name).is_relative_to(root) for root in roots):
+                return reject()
+            # Resolve before donor file handler so traversal/symlinks cannot read
+            # readonly credentials/core. Model file reads remain in this job.
+            path = Path(name)
+            if path.resolve() != path or not any(path.resolve().is_relative_to(root) for root in roots):
+                return reject()
+        return await native_files(self, value, request)
+
+    bind_processes(ApiHandler, {'ApiMessage':message, 'ApiLogGet':logs, 'ApiFilesGet':files})
+    run_ui.run()
+
+
+if __name__ == '__main__':
+    start()
