+def protect_process(*, parent_pid=None):
+    """An extra host-process defense, never a namespace/credential proof."""
+    libc = ctypes.CDLL(None, use_errno=True)
+    require(libc.prctl(4, 0, 0, 0, 0) == 0, 'nondumpable_required')
+    require(libc.prctl(3, 0, 0, 0, 0) == 0, 'nondumpable_not_confirmed')
+    if parent_pid is not None:
+        require(libc.prctl(1, signal.SIGKILL, 0, 0, 0) == 0, 'parent_death_signal_required')
+        require(os.getppid() == parent_pid, 'guardian_parent_changed')
