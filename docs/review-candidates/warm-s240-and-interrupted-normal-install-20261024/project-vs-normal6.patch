+def require_model_work_mode(mode):
+    # No caller-supplied reset receipt can certify arbitrary retained Python.
+    # The current finite checkpoint supports a fresh isolated interpreter only.
+    if mode == 'same-process':
+        raise BoundaryError('same_process_model_work_reuse_unproved')
+    require(mode in {'fresh-isolated','retained-native-provider'}, 'unknown_model_work_mode')
+    return mode
