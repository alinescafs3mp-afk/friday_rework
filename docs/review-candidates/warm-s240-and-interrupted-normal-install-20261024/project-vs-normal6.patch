+                self._used.add((job_id, context_id))
+                self._current = (job_id, context_id, secrets.token_hex(16), job_deadline)
+                self._lease = GuardianLease(self.session, *self._current)
+                self._revoked = False
+                lease = self._lease
+            self._roundtrip('begin', lease=lease)
+            return lease
+
+    def invoke(self, raw, lease, on_event=None):
+        return self.invoke_stream(raw, lease, on_event=on_event)
+
+    def invoke_stream(self, raw, lease, on_event=None):
+        require(type(raw) is bytes and 0 < len(raw) <= MAX_PAYLOAD, 'bounded_payload_required')
+        require(on_event is None or callable(on_event), 'stream_callback_required')
+        with self._lock:
+            with self._state_lock:
+                self._check()
+                if not self.source_only:
+                    self.runtime_admission().job(self._job_namespace)
+                require(type(lease) is GuardianLease and lease is self._lease and not self._revoked,
+                        'revoked_or_foreign_lease')
+                require(self._current is not None, 'no_current_job')
+                job, context, nonce, deadline = self._current
+                require(time.monotonic() < deadline, 'job_deadline')
+                seq = self._seq+1; self._seq = seq
+                until = min(deadline,self.end_monotonic-self.reserve)
+                value = {'schema':'frw.native-engine-call.v1','session':self.session,'service_id':self.service_id,
+                         'seq':seq,'op':'stream','job':job,'context':context,'nonce':nonce,
+                         'deadline':deadline,'payload':base64.b64encode(raw).decode('ascii')}
+                self.inflight, self._inflight_seq = True, seq
+            watchdog = threading.Timer(max(.001,until-time.monotonic()),self._expire_inflight,args=(seq,))
+            self._watchdog = watchdog
+            watchdog.daemon = True; watchdog.start()
+            try:
+                _send(self._socket,pack(self.key,value))
+                event_index = 0
+                while True:
+                    reply = unpack(self.key,_recv(self._socket,self.pid,until))
+                    require(type(reply) is dict and reply.get('session') == self.session
+                            and type(reply.get('seq')) is int and reply.get('seq') == seq, 'reply_identity')
+                    with self._state_lock:
+                        self._check()
+                        require(lease is self._lease and not self._revoked and time.monotonic() < until,
+                                'reply_to_revoked_or_late_lease')
+                    if reply.get('kind') == 'event':
+                        require(set(reply) == {'session','seq','kind','event','payload'}
+                                and type(reply['event']) is int and reply['event'] == event_index, 'stream_event_sequence')
+                        event = base64.b64decode(reply['payload'],validate=True)
+                        require(len(event) <= MAX_PAYLOAD,'stream_event_oversized')
+                        proceed = True if on_event is None else on_event(event) is not False
+                        with self._state_lock:
+                            self._check()
+                            require(time.monotonic() < until,'callback_exceeded_job_deadline')
+                        _send(self._socket,pack(self.key,{'session':self.session,'seq':seq,
+                              'kind':'ack' if proceed else 'cancel','event':event_index}))
+                        event_index += 1
+                        if not proceed:
+                            self.unknown = True
+                            receipt = self.retire(reason='stream_callback_earlystop')
+                            raise StreamStopped(receipt)
+                    else:
+                        require(set(reply) == {'session','seq','ok','payload','error'}
+                                and type(reply['ok']) is bool and type(reply['error']) is str,
+                                'stream_terminal_schema')
+                        require(reply['ok'],'engine_rejected_'+reply['error'])
+                        result = base64.b64decode(reply['payload'],validate=True)
+                        require(len(result) <= MAX_PAYLOAD,'reply_oversized')
+                        with self._state_lock:
+                            self._check()
+                            require(not self._revoked and time.monotonic() < until,'late_or_revoked_completion')
+                            self.inflight, self._inflight_seq = False, None
+                        self.audit.append({'event':'stream_complete','seq':seq,'events':event_index,'at':time.monotonic()})
+                        return result
+            except BaseException:
+                self.unknown = self.unknown or self.inflight
+                self.retire(reason='stream_dispatch_or_callback_failed')
+                raise
+            finally:
+                watchdog.cancel()
+                if watchdog is not threading.current_thread():
+                    watchdog.join(timeout=max(.001,min(2.1,self.end_monotonic-time.monotonic())))
+                if self._watchdog is watchdog:
+                    self._watchdog = None
+
+    def _expire_inflight(self,seq):
+        with self._state_lock:
+            if not self.inflight or self.retired or self._inflight_seq != seq:
+                return
+            self.unknown, self._revoked, self.retired = True, True, True
+        self.retire(reason='absolute_job_deadline_during_dispatch')
+
+    def end(self, lease):
+        # Revoke BEFORE waiting for the dispatch lock. A concurrent native call
+        # is terminated through exact owned engine retirement, not task.cancel.
+        with self._state_lock:
+            require(type(lease) is GuardianLease and lease is self._lease and not self._revoked,
+                    'revoked_or_foreign_lease')
+            acquired = self._lock.acquire(blocking=False)
+            if not acquired:
+                self._revoked = True
+                receipt = self.retire(reason='job_end_during_dispatch')
+                self._current = self._lease = self._job_namespace = None
+                return {'settled': receipt['engine_stopped'], 'engine_alive': False,
+                        'interrupted_effect_unknown': receipt['effect_unknown'],
+                        'provider_or_descendant_cessation': False, 'retirement': receipt}
+        try:
+            self._roundtrip('end', lease=lease)
+            with self._state_lock:
+                self._revoked = True
+                self._current = self._lease = self._job_namespace = None
+                return {'settled': True, 'engine_alive': True, 'interrupted_effect_unknown': False,
+                        'provider_or_descendant_cessation': False}
+        finally:
+            self._lock.release()
+
+    def retire(self, *, reason='owner_retire', settlement_seconds=2.0):
+        require(finite(settlement_seconds) and 0 < settlement_seconds <= 5, 'bounded_settlement')
+        with self._state_lock:
+            if self._settled_receipt is not None:
+                return dict(self._settled_receipt)
+            if self.inflight:
+                self.unknown = True
+            self.retired, self._revoked = True, True
+            if self._watchdog is not None:
+                self._watchdog.cancel()
+            process, pidfd, sock = self._process, self._pidfd, self._socket
+            if process is None:
+                return {'engine_stopped': True, 'reaped': True, 'effect_unknown': self.unknown}
+            self.audit.append({'event': 'retire_intent', 'reason': reason, 'pid': process.pid,
+                               'at': time.monotonic(), 'effect_unknown': self.unknown})
+            # Actual engine settlement is independent of its bwrap monitor.
+            # A live namespace init must still be killed if monitor exited.
+            try:
+                if pidfd is not None:
+                    signal.pidfd_send_signal(pidfd,signal.SIGKILL)
+                elif process.poll() is None:
+                    process.kill()
+            except ProcessLookupError:
+                pass
+            until = min(self.end_monotonic,time.monotonic()+settlement_seconds)
+            # Let the owned namespace launcher reap its exact child first.
+            # A stuck launcher is then killed precisely, without process groups.
+            if process.poll() is None and process.pid != self.pid:
+                try:
+                    process.wait(timeout=max(.001,min(.25,until-time.monotonic())))
+                except subprocess.TimeoutExpired:
+                    process.kill()
+            try:
+                process.wait(timeout=max(.001, until-time.monotonic()))
+                stopped = process.poll() is not None
+            except subprocess.TimeoutExpired:
+                stopped = False
+            if pidfd is not None:
+                ready, _, _ = select.select([pidfd], [], [], max(0,until-time.monotonic()))
+                stopped = stopped and bool(ready)
+            if self._uses_namespace_launcher and self._engine_pid is None:
+                # Reaping a launcher without authenticated actual-engine hello
+                # proves no key/provider admission, but not engine cessation.
+                stopped = False
+            if not stopped:
+                self.unknown = True
+            else:
+                if sock is not None:
+                    sock.close(); self._socket = None
+                if pidfd is not None:
+                    os.close(pidfd); self._pidfd = None
+            receipt = {'engine_stopped': stopped, 'reaped': stopped,
+                       'engine_pid': self.pid, 'wrapper_pid': process.pid, 'exitcode': process.returncode,
+                       'wrapper_reaped': process.poll() is not None,
+                       'engine_reaped_by_guardian': bool(stopped and process.pid == self.pid),
+                       'effect_unknown': self.unknown, 'retired': True,
+                       'provider_or_descendant_cessation': False,
+                       'owned_namespace_cessation': bool(stopped and not self.source_only and self._admission is not None),
+                       'original_end_monotonic': self.end_monotonic}
+            self._last_stop_receipt = dict(receipt)
+            if stopped:
+                self._settled_receipt = dict(receipt)
+                bootstrap_socket = getattr(self,'_bootstrap_socket',None)
+                if bootstrap_socket is not None:
+                    Path(bootstrap_socket).unlink(missing_ok=True)
+                    self._bootstrap_socket = None
+            self.audit.append({'event': 'engine_end', 'at': time.monotonic(), **receipt})
+            if not getattr(self, '_stop_recorded', False):
+                _durable(self.evidence_dir,self.session+'-stop.json',receipt)
+                self._stop_recorded = True
+            return receipt
+
+    cancel = retire
