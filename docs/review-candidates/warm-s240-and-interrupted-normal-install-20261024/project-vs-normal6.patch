+@dataclass(frozen=True)
+class WarmAuthority:
+    """Freshly observed service-scoped provenance, with no raw secret material.
+
+    These values are supplied by the trusted current host, never by an A0
+    request. A job reuses service credentials only while the exact current
+    secret authority/provenance remains valid. No job grant is copied here.
+    """
+    principal_id: str
+    access_generation: str
+    profile: str
+    runtime_home: str
+    source_sha256: str
+    image: str
+    deployment_sha256: str
+    network_sha256: str
+    configuration_sha256: str
+    secret_provenance_sha256: str
+
+    def checked(self):
+        require(all(isinstance(v, str) and 0 < len(v) <= 2048 and '\x00' not in v
+                    for v in vars(self).values()), 'invalid_warm_authority')
+        require(Path(self.runtime_home).is_absolute() and '..' not in Path(self.runtime_home).parts
+                and re.fullmatch(r'sha256:[0-9a-f]{64}', self.image)
+                and all(re.fullmatch(r'[0-9a-f]{64}', getattr(self, name)) for name in (
+                    'source_sha256', 'deployment_sha256', 'network_sha256',
+                    'configuration_sha256', 'secret_provenance_sha256')), 'invalid_warm_authority')
+        return self
+
+
+@dataclass(frozen=True)
+class WarmJobLease:
+    """One independently admitted job, never an alias for the service grant."""
+    job_id: str
+    admission_sha256: str
+    request_sha256: str
+    accepted_unix: float
+    accepted_monotonic: float
+    deadline_unix: float
+    budget_seconds: float
+    stop_reserve_seconds: float
+    boot_id: str
+    authority: WarmAuthority
+
+    def checked(self):
+        require(re.fullmatch(r'native-[0-9a-f]{64}', self.job_id)
+                and all(re.fullmatch(r'[0-9a-f]{64}', v) for v in (
+                    self.admission_sha256, self.request_sha256))
+                and self.admission_sha256 == hashlib.sha256(self.job_id.encode()).hexdigest(),
+                'invalid_fresh_job_identity')
+        require(all(type(v) in (int, float) and math.isfinite(v) and v > 0 for v in (
+                    self.accepted_unix, self.accepted_monotonic, self.deadline_unix,
+                    self.budget_seconds, self.stop_reserve_seconds))
+                and self.deadline_unix == self.accepted_unix + self.budget_seconds
+                and self.stop_reserve_seconds >= 10, 'invalid_fresh_job_clock')
+        require(re.fullmatch(r'[0-9a-f-]{36}', self.boot_id), 'invalid_fresh_job_boot')
+        self.authority.checked()
+        return self
