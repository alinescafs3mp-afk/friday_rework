+    settings=json.loads((root/'settings.json').read_bytes())
+    require(type(settings) is dict and settings.get('api_keys',{})=={}
+            and all(settings.get(k) in ('',None) for k in
+                ('auth_login','auth_password','rfc_password','root_password','mcp_server_token','secrets')),
+            'inspection_authority_in_public_settings')
