+
+def _accept_engine(listener, wrapper_pidfd, until):
+    """Wait on the owned wrapper and endpoint under the original bootstrap clock.
+
+    An exited launcher cannot produce an authenticated hello. This observation
+    never certifies an unobserved namespace init or any descendant cessation.
+    """
+    require(type(wrapper_pidfd) is int and wrapper_pidfd >= 0 and finite(until),
+            'owned_wrapper_pidfd_and_deadline_required')
+    remaining = until-time.monotonic()
+    require(remaining > 0, 'engine_hello_original_clock_expired')
+    ready, _, _ = select.select([listener, wrapper_pidfd], [], [], remaining)
+    # Prefer an already pending connection over a simultaneous monitor exit;
+    # the normal SCM credentials/descendant/namespace checks still admit it.
+    if listener in ready:
+        remaining = until-time.monotonic()
+        require(remaining > 0, 'engine_hello_original_clock_expired')
+        listener.settimeout(remaining)
+        return listener.accept()[0]
+    require(wrapper_pidfd not in ready, 'engine_launcher_exited_before_hello')
+    raise TransportError('engine_hello_original_clock_expired')
