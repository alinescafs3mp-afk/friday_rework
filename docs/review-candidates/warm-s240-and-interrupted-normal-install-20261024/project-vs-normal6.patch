+class _FiniteServiceState:
+    def __init__(self, *, service_id, accepted_monotonic, end_monotonic,
+                 bwrap, bwrap_sha256, bootstrap, bootstrap_sha256,
+                 helper_sha256, stop_reserve=5, clock=time.monotonic):
