+        self.native, self.journal, self.current_authority = native, journal, current_authority
+        self.clock, self.monotonic = clock, monotonic
+        self.owned_stop = original_boundary.stop if owned_stop is None else owned_stop
+        require(callable(self.owned_stop), "owned_service_stop_required")
+        self.lock = Lock()
+        self.active = None
+        self.finishing = False
+        self.used_jobs = set()
+        self.invalidated = False
+        self.stop_attempted = False
+        self.stop_confirmed = False
+        self.unknown = False
+        self._grant_bytes = self._grant_identity()
+        try:
+            original_boundary.admit(self.original_row)
+            start = original_boundary.native_started_monotonic
+            end = original_boundary.native_end_monotonic
+            require(type(start) in (int, float) and type(end) in (int, float)
+                    and math.isfinite(start) and math.isfinite(end)
+                    and 0 < end - start <= 120 and self.monotonic() < end,
