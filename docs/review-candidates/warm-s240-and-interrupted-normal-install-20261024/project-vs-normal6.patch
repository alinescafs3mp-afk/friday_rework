+def recipe_identity(policy):
+    p = checked_policy(policy, check_files=False)
+    return digest({'schema':SCHEMA,'base_image':p['base_image'],'core_sha256':p['core_sha256'],
+                   'sources':{k:v['sha256'] for k,v in p['sources'].items()},
+                   **({'model_work':p['model_work']} if 'model_work' in p else {})})
