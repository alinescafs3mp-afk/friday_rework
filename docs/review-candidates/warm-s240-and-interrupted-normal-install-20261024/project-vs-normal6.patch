+"""Independent finite fresh-job file observation inside the original guardian.
+
+This grants no execution and does not retain an interpreter. Only an already
+registered live namespace and its exact private usr mount may supply bytes.
+"""
+from __future__ import annotations
+import base64
+import hashlib
+import os
+import re
+import stat
+
+NATIVE_USR = '/a0/usr'
+NATIVE_WORKSPACE = '/workspace'
+
+
+class DataBoundaryError(RuntimeError):
+    pass
+
+
+def require(value, code):
+    if not value:
+        raise DataBoundaryError(code)
+
+
+def _identity(s):
+    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns,
+            s.st_ctime_ns, s.st_nlink, s.st_mode]
+
+
+def _relative(path, expected_prefix):
+    require(isinstance(expected_prefix, str)
+            and re.fullmatch('[0-9a-f]{24}', expected_prefix), 'unbound_file_prefix')
+    require(isinstance(path, str), 'unsafe_job_file')
+    name = expected_prefix + r'-[A-Za-z0-9_.-]{1,96}'
+    allowed = (r'/a0/usr/uploads/' + name,
+               r'/a0/usr/workdir/' + expected_prefix + '/' + name)
+    require(any(re.fullmatch(pattern, path) for pattern in allowed), 'unsafe_job_file')
+    return path[len('/a0/usr/'):]
+
+
+def _namespace(group):
+    ids = group.identity
+    require(isinstance(ids, (tuple, list)) and len(ids) == 3
+            and all(type(v) is int and v > 0 for v in ids), 'unbound_namespace')
+    require(group.populated(), 'native_job_process_exited')
+    pid = ids[2]
+    require(os.stat('/proc/' + str(pid) + '/ns/pid').st_ino == ids[0]
+            and os.stat('/proc/' + str(pid) + '/ns/mnt').st_ino == ids[1],
+            'native_file_namespace_changed')
+    return list(ids)
+
+
+
+def _namespace_directory(pid, path):
+    parent = os.open('/proc/' + str(pid) + '/root', os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        for component in path.strip('/').split('/'):
+            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
+            os.close(parent); parent = child
+        return parent
+    except BaseException:
+        os.close(parent)
+        raise
+
+
+def _directory_identity(fd):
+    value = os.fstat(fd)
+    return [value.st_dev, value.st_ino]
+
+
+def read_job_file(native, job_id, context_id, path, limit, *, expected_prefix,
+                  reject_bytes=()):
+    """Read a selected file through the exact current process's mount view.
+
+    expected_prefix is a trusted begin-time binding from cold job_prefix(),
+    never a value inferred from the requested path. reject_bytes are current
+    guardian/job credentials retained only in memory, never in this receipt.
+    """
+    relative = _relative(path, expected_prefix)
+    require(type(limit) is int and 0 < limit <= 16 * 1024**2, 'unbounded_file_read')
+    require(isinstance(reject_bytes, (tuple, list))
+            and all(isinstance(v, bytes) and v for v in reject_bytes), 'invalid_file_secret_filter')
+    native.check(native.service_id)
+    active, layout = native.active, native.active_layout
+    require(active is not None and active[:2] == (job_id, context_id)
+            and layout is not None, 'foreign_active_file_job')
+    group = active[2]
+    namespace = _namespace(group)
+    # /proc/<exact namespace init>/root is intentionally followed; all remaining
+    # components and the selected file are walked using no-follow directory FDs.
+    parent = _namespace_directory(namespace[2], NATIVE_USR)
+    selected = expected = workspace = expected_workspace = None
+    try:
+        expected = os.open(layout.usr, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        usr_identity = _directory_identity(parent)
+        require(usr_identity == _directory_identity(expected), 'native_usr_mount_changed')
+        workspace = _namespace_directory(namespace[2], NATIVE_WORKSPACE)
+        expected_workspace = os.open(layout.workspace, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        workspace_identity = _directory_identity(workspace)
+        require(workspace_identity == _directory_identity(expected_workspace),
+                'native_workspace_mount_changed')
+        for component in relative.split('/')[:-1]:
+            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
+            os.close(parent); parent = child
+        name = relative.split('/')[-1]
+        selected = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+        before = os.fstat(selected)
+        require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1
+                and 0 <= before.st_size <= limit, 'unsafe_native_job_file')
+        chunks, count = [], 0
+        while chunk := os.read(selected, min(65536, limit + 1 - count)):
+            count += len(chunk)
+            require(count <= limit, 'oversized_native_job_file')
+            chunks.append(chunk)
+        data = b''.join(chunks)
+        require(_identity(before) == _identity(os.fstat(selected)) ==
+                _identity(os.stat(name, dir_fd=parent, follow_symlinks=False))
+                and len(data) == before.st_size, 'mutable_native_job_file')
+        require(not any(secret in data for secret in reject_bytes), 'runtime_secret_in_file')
+        require(native.active is active and native.active_layout is layout
+                and _namespace(group) == namespace, 'stale_native_file_job')
+        # The private usr tree is not writable by another namespace through the
+        # original service path. Recheck the mount anchor after the bounded read.
+        require([os.fstat(expected).st_dev, os.fstat(expected).st_ino] == usr_identity
+                and (os.stat(layout.usr, follow_symlinks=False).st_dev,
+                     os.stat(layout.usr, follow_symlinks=False).st_ino) == tuple(usr_identity),
+                'native_usr_mount_changed')
+        require(_directory_identity(expected_workspace) == workspace_identity
+                and (os.stat(layout.workspace, follow_symlinks=False).st_dev,
+                     os.stat(layout.workspace, follow_symlinks=False).st_ino) == tuple(workspace_identity),
+                'native_workspace_mount_changed')
+        # Re-open both paths in the current process view after the read. A held
+        # directory FD alone would miss replacement of the named mount target.
+        for target, identity, code in ((NATIVE_USR, usr_identity, 'native_usr_mount_changed'),
+                (NATIVE_WORKSPACE, workspace_identity, 'native_workspace_mount_changed')):
+            current = _namespace_directory(namespace[2], target)
+            try:
+                require(_directory_identity(current) == identity, code)
+            finally:
+                os.close(current)
+        native.check(native.service_id)
+        return {'identity': _identity(before), 'size': len(data),
+                'sha256': hashlib.sha256(data).hexdigest(),
+                'base64': base64.b64encode(data).decode(),
+                'provenance': {'schema': 'frw.a0.current-job-file.v1',
+                    'service_id': native.service_id, 'job_id': job_id,
+                    'context_id': context_id, 'native_boundary_identity': namespace,
+                    'usr_identity': usr_identity, 'workspace_identity': workspace_identity, 'path': path}}
+    finally:
+        for fd in (selected, expected, workspace, expected_workspace, parent):
+            if fd is not None:
+                os.close(fd)
