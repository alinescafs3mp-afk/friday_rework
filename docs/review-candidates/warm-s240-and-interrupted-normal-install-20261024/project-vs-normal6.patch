+def public_inspection_config(value, *, field='', depth=0, schema=False):
+    """Public configuration data, including JSON-encoded options and tool schemas."""
+    require(depth<=32,'inspection_config_too_deep')
+    sensitive={'api_key','api_keys','secret','secrets','access_token','refresh_token',
+        'bearer_token','api_token','authorization','password','headers','extra_headers','credential',
+        'credentials','cookie','cookies','aws_access_key_id','aws_secret_access_key','aws_session_token',
+        'aws_security_token','session_token','client_secret','auth_token','use_auth_token','token','hf_token','huggingface_token'}
+    key=field.lower()
+    require(schema or not (key in sensitive or key.endswith(('_api_key','_api_token','_password','_secret')))
+            or value in ('',None,{},[]),'inspection_authority_in_public_configuration')
+    if type(value) is dict:
+        function=None;wrapped=False
+        if not schema and value.get('type')=='function':
+            wrapped=set(value)=={'type','function'}
+            function=value.get('function') if wrapped else value
+            allowed={'name','description','parameters','strict'}
+            require(type(function) is dict
+                    and {'name'} <= set(function) <= (allowed if wrapped else allowed|{'type'})
+                    and type(function['name']) is str and bool(function['name'])
+                    and type(function.get('parameters',{})) is dict
+                    and ('description' not in function or type(function['description']) is str)
+                    and ('strict' not in function or type(function['strict']) is bool),
+                    'inspection_invalid_function_schema')
+        for k,v in value.items():
+            require(type(k) is str,'inspection_config_key_required')
+            if wrapped and k=='function':
+                for fk,fv in v.items():
+                    public_inspection_config(fv,field=fk,depth=depth+1,schema=fk=='parameters')
+            else:public_inspection_config(v,field=k,depth=depth+1,
+                schema=schema or (function is value and k=='parameters'))
+    elif type(value) is list:
+        for v in value:public_inspection_config(v,depth=depth+1,schema=schema)
+    elif type(value) is str:
