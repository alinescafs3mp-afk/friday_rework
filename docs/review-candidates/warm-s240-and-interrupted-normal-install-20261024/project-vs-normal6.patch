+    require(enabled is True and session.plan is not None and 'finite_service' in session.plan
+            and session.config['a0'].get('finite_service') == session.plan['finite_service'],
+            'finite_attach_requires_current_opt_in')
+    session._current(original_row)
+    with session.finite_factory_lock:
+        require(not session.finite_attach_attempted,'finite_attach_requires_reconciliation')
+        session.finite_attach_attempted=True
+    session.verify_finite_assets(original_row)
+    policy = proxy_policy(session.plan['finite_service'])
+    policy['memory_enabled'] = session.plan.get('user_memory') is not None
+    policy['job_config'] = job_config_manifest(session._module(),session.plan)
+    native = A0NativeWarmControl(session.boundary, original_row, policy)
+    host = A0FiniteWarmHostSession(session, original_row, native, enabled=True, current_runtime=current_runtime)
+    staging = Path(session.config['staging_root'])/original_row['existing_task_id']
+    def expected(row):
