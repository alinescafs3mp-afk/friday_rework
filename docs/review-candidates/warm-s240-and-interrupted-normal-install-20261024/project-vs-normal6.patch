+def bind_processes(base, handlers, *, allowed=None, reject=None):
+    """Bind after native security decorators, including dynamically loaded APIs.
+
+    Donor helpers.modules.import_module does not reuse imported API classes.
+    Patching an imported ApiMessage.process alone would silently miss requests.
+    All dynamically loaded native handlers inherit this exact shared base.
+    """
+    native_handle = base.handle_request
+    async def handle(self, request):
+        if allowed is not None and type(self).__name__ not in allowed:
+            if reject is not None:
+                return reject()
+            raise BoundaryError('native_handler_forbidden')
+        process = handlers.get(type(self).__name__)
+        if process is not None:
+            self.process = types.MethodType(process, self)
+        return await native_handle(self, request)
+    base.handle_request = handle
