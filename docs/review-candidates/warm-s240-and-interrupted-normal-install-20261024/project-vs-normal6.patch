+            # SIGKILL exact namespace init settles all fork/setsid/double-forks.
+            # The enclosing original service remains running; no stop is claimed.
+            group.kill()
+            until = min(self.end_monotonic, self.clock() + settlement_seconds)
+            while group.populated() and self.clock() < until:
+                select.select([], [], [], min(.01, max(0, until-self.clock())))
+            if group.populated():
+                self.unknown = True
