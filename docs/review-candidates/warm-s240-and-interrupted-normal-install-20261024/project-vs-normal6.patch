+class PidNamespaceJob:
+    """Exact namespace init pidfd; no delegated cgroup is needed.
+
+    Trusted bwrap blocks namespace PID1 BEFORE exec. Broker pins its pidfd and
+    verifies NSpid=1 and a distinct PID+mount namespace, then releases command.
+    SIGKILL of that init triggers Linux zap_pid_ns_processes: all descendant
+    tasks, including nested namespaces/setsid/double-forks, die before init exit
+    becomes observable. pidfd readiness proves init exit, not process-name census.
+    """
+    primitive = 'pid-namespace-init-pidfd'
+
+    def __init__(self, argv, *, timeout=1, readonly_paths=()):
+        require(hasattr(os, 'pidfd_open') and hasattr(signal, 'pidfd_send_signal'), 'pidfd_required')
+        info_read, info_write = os.pipe()
+        gate_read, gate_write = os.pipe()
+        self.pidfd = self.nsfd = self.mntfd = None
+        self.worker = None
+        try:
+            command = [argv[0], '--as-pid-1', '--unshare-user', '--disable-userns', '--info-fd', str(info_write),
+                       '--block-fd', str(gate_read), *argv[1:]]
+            self.worker = subprocess.Popen(command, stdin=subprocess.DEVNULL,
+                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env={'PATH': '/usr/bin:/bin'},
+                close_fds=True, pass_fds=(info_write, gate_read), start_new_session=True)
+            os.close(info_write); info_write = None
+            os.close(gate_read); gate_read = None
+            until, raw = time.monotonic() + timeout, b''
+            value = None
+            while time.monotonic() < until and value is None:
+                require(select.select([info_read], [], [], max(0, until-time.monotonic()))[0], 'namespace_info_timeout')
+                data = os.read(info_read, 16385-len(raw))
+                require(data and len(raw) + len(data) <= 16384, 'invalid_namespace_info')
+                raw += data
+                try:
+                    def pairs(items):
+                        require(len(dict(items)) == len(items), 'duplicate_namespace_info')
+                        return dict(items)
+                    value = json.loads(raw, object_pairs_hook=pairs)
+                except json.JSONDecodeError:
+                    pass
+            require(isinstance(value, dict) and type(value.get('child-pid')) is int
+                    and value['child-pid'] > 1, 'namespace_init_missing')
+            self.pid = value['child-pid']
+            self.pidfd = os.pidfd_open(self.pid)
+            proc = Path('/proc') / str(self.pid)
+            self.nsfd = os.open(proc/'ns/pid', os.O_RDONLY)
+            self.mntfd = os.open(proc/'ns/mnt', os.O_RDONLY)
+            status = dict(line.split(':', 1) for line in (proc/'status').read_text().splitlines() if ':' in line)
+            require(status.get('NSpid', '').split()[-1:] == ['1'], 'not_namespace_init')
+            pid_namespace = os.fstat(self.nsfd).st_ino
+            mount_namespace = os.fstat(self.mntfd).st_ino
+            require(pid_namespace != os.stat('/proc/self/ns/pid').st_ino
+                    and mount_namespace != os.stat('/proc/self/ns/mnt').st_ino
+                    and value.get('pid-namespace') == pid_namespace
+                    and value.get('mnt-namespace') == mount_namespace
+                    and not self._dead(), 'namespace_identity_unconfirmed')
+            self.identity = (pid_namespace, mount_namespace, self.pid)
+            # All nonstandard broker FDs are closed by bwrap in its exec child.
+            # Parent never releases an unregistered native job.
+            require(os.write(gate_write, b'1') == 1, 'namespace_release_failed')
+            # bwrap emits info and waits at block-fd before completing mounts.
+            # Release only trusted pinned setup, then observe the actual target
+            # mount view before returning a core_readonly receipt to the host.
+            for relative in readonly_paths:
+                require(relative.startswith('/') and '..' not in Path(relative).parts,
+                        'invalid_readonly_observation_path')
+            while readonly_paths:
+                require(not self._dead(), 'namespace_exited_during_mount_verification')
+                try:
+                    observed = all(os.statvfs(proc/'root'/relative.lstrip('/')).f_flag & os.ST_RDONLY
+                                   for relative in readonly_paths)
+                except FileNotFoundError:
+                    observed = False
+                if observed:
+                    break
+                require(time.monotonic() < until, 'native_core_mount_not_readonly')
+                select.select([], [], [], .001)
+        except BaseException:
+            if self.pidfd is not None:
+                try: signal.pidfd_send_signal(self.pidfd, signal.SIGKILL)
+                except ProcessLookupError: pass
+            if self.worker is not None:
+                if self.worker.poll() is None:
+                    self.worker.kill()
+                self.worker.wait(timeout=1)
+            self._close_fds()
+            raise
+        finally:
+            for fd in (info_read, info_write, gate_read, gate_write):
+                if fd is not None:
+                    os.close(fd)
+
+    def _dead(self):
+        return bool(select.select([self.pidfd], [], [], 0)[0])
+
+    def populated(self):
+        return not self._dead()
+
+    def kill(self):
+        if not self._dead():
+            try: signal.pidfd_send_signal(self.pidfd, signal.SIGKILL)
+            except ProcessLookupError: pass
+
+    def _close_fds(self):
+        for name in ('pidfd', 'nsfd', 'mntfd'):
+            fd = getattr(self, name)
+            if fd is not None:
+                os.close(fd); setattr(self, name, None)
+
+    def close_empty(self):
+        require(self._dead(), 'namespace_init_still_live')
+        self.worker.wait(timeout=1)
+        self._close_fds()
+
