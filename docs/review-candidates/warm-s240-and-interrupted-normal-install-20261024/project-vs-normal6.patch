+                    or row.get('host', {}).get('a0', {}).get('grant') is None):
+                raise AssociationError('original_warm_custody_changed')
+            records = self.store.state_get(self.KEY, {'schema': 'friday.a0.finite-services.v1', 'services': {}})
+            if (not isinstance(records, dict) or set(records) != {'schema', 'services'}
+                    or records['schema'] != 'friday.a0.finite-services.v1'
+                    or not isinstance(records['services'], dict)):
