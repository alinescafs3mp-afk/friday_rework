+"""Finite-worker memory DATA mounts; original canonical host codec stays host-side.
+
+No host-store deserialization, model calls, adoption or reindex is implemented.
+The existing exact native guard operates only in the fresh isolated interpreter.
+"""
+from __future__ import annotations
+import hashlib
+import json
+import re
+import os
+from pathlib import Path
+import stat
+
+GUARD = '/a0/plugins/_memory/helpers/memory.py'
+GUARD_SHA256 = 'dcd46c2b896a20ac2dc3e18f82168f09845e54b8982fbdb06ecbb6d7e2fb049a'
+STORES = '/frw-memory/stores'
+CACHE = '/frw-memory/cache'
+
+def require(value, code):
+    if not value:
+        raise RuntimeError(code)
+
+def guard_identity(*, readonly=False):
+    path = Path(GUARD)
+    require(path.resolve() == path, 'memory_guard_path_changed')
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        initial = os.fstat(fd)
+        require(stat.S_ISREG(initial.st_mode) and initial.st_nlink == 1
+                and not initial.st_mode & 0o022 and initial.st_size == 28559,
+                'memory_guard_source_changed')
+        data = b''
+        while chunk := os.read(fd, 65536):
+            data += chunk
+            require(len(data) <= 28559, 'memory_guard_source_changed')
+        identity = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_uid, s.st_nlink,
+                              s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+        require(identity(initial) == identity(os.fstat(fd)) == identity(path.lstat())
+                and hashlib.sha256(data).hexdigest() == GUARD_SHA256,
+                'memory_guard_source_changed')
+    finally:
+        os.close(fd)
+    if readonly:
+        require(os.statvfs(path).f_flag & os.ST_RDONLY, 'memory_guard_not_readonly')
+
+def source_roots(enabled):
+    require(type(enabled) is bool, 'explicit_memory_mode_required')
+    if not enabled:
+        require(not Path('/frw-memory').exists(), 'undeclared_memory_mount')
+        return ()
+    guard_identity(readonly=True)
+    roots = (STORES, CACHE)
+    for name in roots:
+        path = Path(name)
+        require(path.resolve() == path, 'memory_mount_linked')
+        st = path.lstat()
+        require(stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid()
+                and stat.S_IMODE(st.st_mode) == 0o700
+                and not os.statvfs(path).f_flag & os.ST_RDONLY, 'unsafe_memory_mount')
+    return roots
+
+def _mounted_rw(path):
+    # Exact mountpoint verification, unlike st_dev/ismount for same-FS binds.
+    found = []
+    for line in Path('/proc/self/mountinfo').read_text().splitlines():
+        fields = line.split()
+        if len(fields) > 6 and fields[4] == path:
+            found.append(fields)
+    require(len(found) == 1 and 'rw' in found[0][5].split(','), 'memory_data_mount_unproved')
+
+def fresh_native_state(enabled):
+    require(type(enabled) is bool, 'explicit_memory_mode_required')
+    config = native_job_config()
+    check_native_config_tree(config)
+    for name in ('chats','scheduler','extensions','agents','projects','prompts'):
+        path = Path('/a0/usr') / name
+        require(not path.exists() or (path.is_dir() and not any(path.iterdir())), 'nonfresh_native_usr')
+    memory = Path('/a0/usr/memory')
+    if not enabled:
+        require(not memory.exists() or (memory.is_dir() and not any(memory.iterdir())), 'nonfresh_native_usr')
+        require(not any(Path('/a0/tmp').iterdir()), 'nonfresh_native_tmp')
+        require(not Path('/frw-memory').exists(), 'undeclared_memory_mount')
+        return
+    guard_identity(readonly=True)
+    _mounted_rw('/a0/usr/memory')
+    _mounted_rw('/a0/tmp/memory/embeddings')
+    require({p.name for p in Path('/a0/tmp').iterdir()} == {'memory'}
+            and {p.name for p in Path('/a0/tmp/memory').iterdir()} == {'embeddings'},
+            'nonfresh_native_tmp')
+    # Source staging is hidden after selected data binds. Neither host paths nor
+    # a preceding job's credentials, chats, settings or Python surfaces follow.
+    require(Path('/frw-memory').is_dir() and not any(Path('/frw-memory').iterdir()),
+            'memory_source_staging_visible')
+
+# Data-only native plugin configuration is copied from the ORIGINAL admitted
+# guardian settings. No Python, plugins, grants or prior-job runtime surfaces.
+CONFIG_REQUIRED = frozenset({'plugins/_model_config/config.json',
+    'plugins/_model_config/presets.yaml', 'plugins/_code_execution/config.json'})
+CONFIG_OPTIONAL = frozenset({'plugins/_document_query/config.json'})
+
+def checked_job_config(value):
+    require(isinstance(value, dict) and CONFIG_REQUIRED <= set(value)
+            <= CONFIG_REQUIRED | CONFIG_OPTIONAL
+            and all(isinstance(k, str) and isinstance(v, str)
+                    and re.fullmatch('[0-9a-f]{64}', v) for k, v in value.items()),
+            'invalid_job_config')
+    return dict(value)
+
+def stable_data(path, digest=None, *, readonly=False, maximum=65536):
+    path = Path(path)
+    require(path.is_absolute() and path.resolve() == path, 'unsafe_job_config_path')
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        initial = os.fstat(fd)
+        require(stat.S_ISREG(initial.st_mode) and initial.st_uid == os.getuid()
+                and initial.st_nlink == 1 and stat.S_IMODE(initial.st_mode) in (0o400, 0o600)
+                and 0 <= initial.st_size <= maximum, 'unsafe_job_config_file')
+        data = b''
+        while chunk := os.read(fd, 65536):
+            data += chunk
+            require(len(data) <= maximum, 'unsafe_job_config_file')
+        identity = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_uid, s.st_nlink,
+                              s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+        require(identity(initial) == identity(os.fstat(fd)) == identity(path.lstat())
+                and (digest is None or hashlib.sha256(data).hexdigest() == digest),
+                'job_config_changed')
+    finally:
+        os.close(fd)
+    if readonly:
+        require(os.statvfs(path).f_flag & os.ST_RDONLY, 'job_config_not_readonly')
+    return data
+
+def _config_json(data):
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            require(key not in result, 'duplicate_job_config_key')
+            result[key] = value
+        return result
+    return checked_job_config(json.loads(data, object_pairs_hook=unique))
+
+def prepare_job_config(root, config):
+    config = checked_job_config(config)
+    root = Path(root)
+    require(root.is_absolute() and root.resolve() == root and root.is_dir(), 'unsafe_job_config_root')
+    directory = root / 'config'
+    directory.mkdir(mode=0o700)
+    files = []
+    for number, (relative, digest) in enumerate(sorted(config.items())):
+        data = stable_data(Path('/a0/usr') / relative, digest)
+        target = directory / str(number)
+        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        try:
+            with os.fdopen(fd, 'wb') as stream:
+                stream.write(data); stream.flush(); os.fsync(stream.fileno())
+        except BaseException:
+            raise
+        files.append((str(target), relative, digest))
+    target = directory / 'manifest.json'
+    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(fd, 'wb') as stream:
+        stream.write(json.dumps(config, sort_keys=True, separators=(',', ':')).encode())
+        stream.flush(); os.fsync(stream.fileno())
+    return tuple(files), str(target)
+
+def check_job_config_files(files, manifest, private):
+    require(isinstance(files, tuple) and 3 <= len(files) <= 4
+            and all(isinstance(item, tuple) and len(item) == 3 for item in files),
+            'trusted_job_config_files_required')
+    config = _config_json(stable_data(manifest, maximum=4096))
+    require({item[1]: item[2] for item in files} == config and len(files) == len(config),
+            'job_config_manifest_changed')
+    for source, relative, digest in files:
+        path = Path(source)
+        require(path.is_relative_to(Path(private)) and path.parent == Path(manifest).parent,
+                'job_config_outside_private_root')
+        stable_data(source, digest)
+    return config
+
+def native_job_config():
+    return _config_json(stable_data('/frw-job-config.json', readonly=True, maximum=4096))
+
+def check_native_config_tree(config):
+    config = checked_job_config(config)
+    required_dirs = {'plugins'}
+    for relative in config:
+        required_dirs.update(str(p) for p in Path(relative).parents if str(p) != '.')
+    pending = [Path('/a0/usr/plugins')]
+    found = set()
+    while pending:
+        directory = pending.pop()
+        require(directory.resolve() == directory and directory.is_dir(), 'unsafe_native_config_tree')
+        for path in directory.iterdir():
+            relative = path.relative_to(Path('/a0/usr')).as_posix()
+            require(not path.is_symlink(), 'unsafe_native_config_tree')
+            if path.is_dir():
+                require(relative in required_dirs, 'unexpected_native_plugin_surface')
+                pending.append(path)
+            else:
+                require(relative in config and relative not in found, 'unexpected_native_plugin_surface')
+                stable_data(path, config[relative], readonly=True)
+                found.add(relative)
+    require(found == set(config), 'missing_native_job_config')
