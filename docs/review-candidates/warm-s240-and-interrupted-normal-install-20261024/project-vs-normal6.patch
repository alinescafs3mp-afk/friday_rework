+"""Fresh-job data-only native bridge. No provider key, lease or engine FD."""
+from __future__ import annotations
+import asyncio
+import base64
+import json
+from pathlib import Path
+import socket
+import stat
+import struct
+import time
+
+PATH='/frw-model.sock'
+MAX=2000000
+_deadline=None
+
+def remaining():
+    require(type(_deadline) in (int,float) and time.monotonic()<_deadline,"original_job_deadline_required")
+    return _deadline-time.monotonic()
+
+
+def require(ok,code):
+    if not ok:raise RuntimeError(code)
+
+
+def decode(raw):
+    def pairs(items):
+        require(len(dict(items))==len(items),'duplicate_job_model_frame');return dict(items)
+    def constant(_):raise RuntimeError('nonfinite_job_model_frame')
+    require(type(raw) is bytes and 0<len(raw)<=MAX,'job_model_frame_bound')
+    return json.loads(raw,object_pairs_hook=pairs,parse_constant=constant)
+
+
+def ack(keep):
+    require(type(keep) is bool,'event_callback_boolean_required')
+    return json.dumps({'kind':'ack','continue':keep},separators=(',',':')).encode()
+
+
+def result(value):
+    require(type(value) is dict and set(value)=={'kind','body'} and value['kind']=='reply'
+            and type(value['body']) is str,'job_model_reply_required')
+    raw=base64.b64decode(value['body'],validate=True)
+    require(len(raw)<=MAX,'job_model_reply_bound');return raw
+
+
+def connect():
+    p=Path(PATH)
+    require(stat.S_ISSOCK(p.stat().st_mode) and p.stat().st_uid==__import__('os').getuid(),
+            'protected_job_model_endpoint_required')
