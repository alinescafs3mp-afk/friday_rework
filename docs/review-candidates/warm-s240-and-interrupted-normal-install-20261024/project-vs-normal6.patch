+def _open_pin(path, expected=None):
+    path = Path(path)
+    require(path.is_absolute() and path.resolve() == path, 'absolute_resolved_pin_required')
+    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+    try:
+        before = os.fstat(fd)
+        require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1
+                and not before.st_mode & 0o022, 'unsafe_pinned_source')
+        data = b''
+        while chunk := os.read(fd, 65536):
+            data += chunk
+            require(len(data) <= 16 * 1024 * 1024, 'source_oversized')
+        digest = hashlib.sha256(data).hexdigest()
+        require(expected is None or digest == expected, 'source_pin_changed')
+        require(os.fstat(fd) == before, 'source_pin_raced')
+        os.lseek(fd, 0, os.SEEK_SET)
+        return fd, digest, data
+    except BaseException:
+        os.close(fd)
+        raise
