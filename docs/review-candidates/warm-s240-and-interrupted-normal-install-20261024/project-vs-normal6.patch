+"""Finite fresh-namespace data pipeline reusing the accepted cold ingress.
+
+The optional caller owns current authority and final namespace settlement. File
+bytes are independently observed before/after native files_get. No text response
+can stand in for expected artifacts. No service or execution engine is added.
+"""
+from __future__ import annotations
+from dataclasses import asdict
+import hashlib
+import json
+from pathlib import Path, PurePosixPath
+
+from .a0_config import A0Error, require
+from .a0_native import decode_file
+from ..artifacts import stage_file, read_staged
+from .dsh import _private, _write
+
+
+def verified_native_files(transport, paths, *, limit, timeout, service_id,
+                          job_id, context_id, max_response_bytes=32 * 1024**2):
+    """Current namespace proof, native API bytes, then the same proof again."""
+    require(isinstance(paths, tuple) and len(paths) <= 16
+            and len(set(paths)) == len(paths)
+            and len({PurePosixPath(p).name for p in paths}) == len(paths), 'duplicate_basename')
+    require(type(max_response_bytes) is int and 0 < max_response_bytes <= 64 * 1024**2,
+            'invalid_warm_response_limit')
+    if not paths:
+        return {}, {}
+    before = {path: transport.file(path, limit, timeout()) for path in paths}
+    values = transport.request('POST', '/api/api_files_get', {'paths': list(paths)},
+                               timeout(), max_response_bytes)
+    require(isinstance(values, dict)
+            and set(values) == {PurePosixPath(p).name for p in paths}, 'missing_or_extra_files')
+    contents, evidence, total = {}, {}, 0
+    for path in paths:
+        data = decode_file(values[PurePosixPath(path).name], limit)
+        after = transport.file(path, limit, timeout())
+        require(before[path] == after and isinstance(after, dict), 'mutable_or_mismatched_file')
+        proof = after.get('provenance')
+        require(isinstance(proof, dict) and set(proof) == {'schema', 'service_id', 'job_id',
+                'context_id', 'native_boundary_identity', 'usr_identity', 'workspace_identity', 'path'}
+                and proof['schema'] == 'frw.a0.current-job-file.v1'
+                and proof['service_id'] == service_id and proof['job_id'] == job_id
+                and proof['context_id'] == context_id and proof['path'] == path
+                and isinstance(proof['native_boundary_identity'], list)
+                and len(proof['native_boundary_identity']) == 3
+                and all(type(x) is int and x > 0 for x in proof['native_boundary_identity'])
+                and isinstance(proof['usr_identity'], list) and len(proof['usr_identity']) == 2
+                and all(type(x) is int and x > 0 for x in proof['usr_identity'])
+                and isinstance(proof['workspace_identity'], list) and len(proof['workspace_identity']) == 2
+                and all(type(x) is int and x > 0 for x in proof['workspace_identity']), 'foreign_native_file_proof')
+        require(isinstance(after.get('identity'), list) and len(after['identity']) == 7
+                and after.get('size') == len(data)
+                and after.get('sha256') == hashlib.sha256(data).hexdigest()
+                and decode_file(after.get('base64'), limit) == data, 'mutable_or_mismatched_file')
+        total += len(data); require(total <= limit, 'outputs_too_large')
+        contents[path] = data
+        evidence[path] = {k: v for k, v in after.items() if k != 'base64'}
+    return contents, evidence
+
+
+def canonical_memory_binding(runtime, descriptor, deployment, authority):
+    """Reuse the canonical checker; descriptor presence never adopts a store.
+
+    This is data-only. Existing prepare_memory/codec/guard and explicit reviewed
+    mounts must still run under the current host before a native job can use it.
+    No scan, unpickle, creation, migration or reindex is performed here.
+    """
+    if descriptor is None:
+        return None
+    value = runtime.checked_memory_descriptor(descriptor, deployment)
+    require(value['home'] == authority.runtime_home
+            and value['lineage']['principal'] == authority.principal_id
+            and value['lineage']['runtime_profile'] == authority.profile,
+            'foreign_canonical_memory')
+    return json.loads(json.dumps(value, allow_nan=False))
+
+
+class A0WarmDataPipeline:
+    def __init__(self, config, lease, transport, service, root, inputs, expected_files):
+        # Import locally because the optional adapter itself lives in a0.py.
+        from .a0 import A0Adapter, A0HostConfig
+        require(isinstance(config, A0HostConfig), 'warm_data_config_required')
+        require(config.project_name is None and config.agent_profile == 'agent0',
+                'warm_project_or_profile_requires_cold_mode')
+        for path in (config.input_root, config.staging_root):
+            _private(path)
+        self.config, self.lease, self.transport, self.service = config, lease, transport, service
+        self.root = _private(root)
+        self.limit = config.max_file_bytes
+        require(type(self.limit) is int and 0 < self.limit <= 16 * 1024**2
+                and type(config.max_response_bytes) is int
+                and 4 * ((self.limit + 2) // 3) + 65536 <= config.max_response_bytes <= 64 * 1024**2,
+                'invalid_warm_file_limit')
+        # Only cold path parsing/input reads are reused, never a fabricated
+        # association row, launch grant, old preparation, or cold stop method.
+        adapter = object.__new__(A0Adapter); adapter.config = config
+        self.data_row = {'existing_task_id': lease.job_id, 'admission_hash': lease.admission_sha256}
+        self.inputs = adapter._inputs(self.data_row, inputs)
+        declared = config.expected_files(self.data_row)
+        require(declared == expected_files and isinstance(declared, tuple), 'warm_expected_files_changed')
+        self.outputs = adapter._outputs(self.data_row) if declared else ()
+        require(sum(v.size_bytes for v, _ in self.inputs) <= self.limit,
+                'warm_input_bytes_exceed_transport_bound')
+        self.evidence = {}
+
+    def timeout(self):
+        self.service._check_current(self.lease)
+        left = min(30, self.lease.deadline_unix - self.service.clock() - 1,
+            self.service.custody.end_monotonic - self.service.monotonic()
+                - self.lease.stop_reserve_seconds - 1)
+        require(left > 0, 'warm_data_budget_exhausted')
+        return left
+
+    def attachments(self):
+        values = [value for _, value in self.inputs]
+        require(len(json.dumps(values).encode()) <= self.config.max_response_bytes,
+                'warm_input_bytes_exceed_transport_bound')
+        return values
+
+    def verify_inputs(self):
+        contents, proof = self._files(tuple(v.worker_path for v, _ in self.inputs))
+        require(all(len(contents[v.worker_path]) == v.size_bytes
+                    and hashlib.sha256(contents[v.worker_path]).hexdigest() == v.sha256
+                    for v, _ in self.inputs), 'uploaded_input_missing_or_changed')
+        self.evidence['inputs'] = proof
+        _write(self.root / 'warm-inputs-verified.json', {'inputs': [asdict(v) for v, _ in self.inputs],
+            'native_files': proof})
+
+    def _files(self, paths):
+        return verified_native_files(self.transport, paths, limit=self.limit, timeout=self.timeout,
+            service_id=self.service.custody.service_id, job_id=self.lease.job_id,
+            context_id=self.service._context(self.lease), max_response_bytes=self.config.max_response_bytes)
+
+    def instructions(self):
+        return ('\nVerified input files: ' + json.dumps([v.worker_path for v, _ in self.inputs])
+                + '\nWrite these exact output files: ' + json.dumps([v.worker_path for v in self.outputs]))
+
+    def capture(self):
+        contents, proof = self._files(tuple(v.worker_path for v in self.outputs))
+        self.evidence['outputs'] = proof
+        _write(self.root / 'warm-output-provenance.json', {'native_files': proof,
+            'outputs': [asdict(v) for v in self.outputs]})
+        if not self.outputs:
+            return ()
+        received = self.root / 'a0-received'; received.mkdir(mode=0o700)
+        result = []
+        for output in self.outputs:
+            name = PurePosixPath(output.worker_path).name
+            _write(received / name, contents[output.worker_path])
+            result.append(stage_file(source_root=received, relative_path=name,
+                staging_root=self.config.staging_root, logical_name=output.logical_name,
+                media_type=output.media_type, origin_reference=str(self.root / 'worker-response.json'),
+                max_bytes=self.limit))
+        return tuple(result)
+
+    def verify_staged(self, artifacts):
+        for artifact in artifacts:
+            read_staged(staging_root=self.config.staging_root, artifact=artifact, max_bytes=self.limit)
