+def _identity(pid):
+    raw = Path('/proc/' + str(pid) + '/stat').read_text()
+    rest = raw[raw.rfind(')')+2:].split()
+    inodes = set()
+    for name in os.listdir('/proc/' + str(pid) + '/fd'):
+        try:
+            value = os.readlink('/proc/' + str(pid) + '/fd/' + name)
+        except FileNotFoundError:
+            continue
+        if value.startswith('socket:'):
+            inodes.add(value)
+    return {'pid': pid, 'ppid': int(rest[1]), 'birth': int(rest[19]),
+            'namespaces': {name: os.readlink('/proc/' + str(pid) + '/ns/' + name)
+                           for name in ('pid', 'mnt', 'user', 'net')},
+            'socket_inodes': sorted(inodes)}
+
+def _descendant(pid, ancestor):
+    seen = set()
+    while pid > 1 and pid not in seen:
+        if pid == ancestor:
+            return True
+        seen.add(pid)
+        pid = _identity(pid)['ppid']
+    return pid == ancestor
