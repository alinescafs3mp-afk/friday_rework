+def _socket_setup(sock):
+    sock.set_inheritable(False)
+    sock.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
+    # Frames larger than kernel's actual admitted sndbuf are rejected before
+    # dispatch rather than split into unauthenticated application fragments.
+    sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, MAX_FRAME * 2)
+    sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, MAX_FRAME * 2)
+
+def _recv(sock, sender_pid, until, *, peer=False):
+    remaining = until - time.monotonic()
+    require(remaining > 0, 'deadline_expired')
+    readable, _, _ = select.select([sock], [], [], remaining)
+    require(readable, 'transport_timeout')
+    raw, control, flags, _ = sock.recvmsg(MAX_FRAME + 1, socket.CMSG_SPACE(12) + socket.CMSG_SPACE(256))
+    fds = []
+    creds = []
+    unknown = False
+    for level, kind, data in control:
+        if level == socket.SOL_SOCKET and kind == socket.SCM_CREDENTIALS:
+            if len(data) != 12:
+                unknown = True
+            else:
+                creds.append(struct.unpack('3i', data))
+        elif level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
+            items = array.array('i')
+            items.frombytes(data[:len(data) - len(data) % items.itemsize])
+            fds.extend(items)
+            unknown = True
+        else:
+            unknown = True
+    for fd in fds:
+        os.close(fd)
+    require(not flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC) and not unknown,
+            'truncated_or_ancillary_frame')
