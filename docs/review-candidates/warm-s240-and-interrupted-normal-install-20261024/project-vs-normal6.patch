+def create(session, original_row, *, current_runtime, enabled=False):
+    """Create the optional original guardian via the unchanged Runtime.start API.
+
+    This explicit trusted host operation requires an already reserved original
+    row and verified file ingress. It cannot invent or recover an admission.
+    """
+    require(enabled is True and callable(current_runtime)
+            and 'finite_service' in session.config['a0'],'finite_create_explicit_opt_in_required')
+    checked_policy(session.config['a0']['finite_service'])
+    with session.finite_factory_lock:
+        require(not session.finite_create_attempted and session.runtime is None
+                and session.plan is None,'finite_create_requires_reconciliation')
+        session.finite_create_attempted=True
+    session._launch(original_row)
+    try:
+        return attach(session,original_row,current_runtime=current_runtime,enabled=True)
+    except BaseException as error:
+        try: session.emergency_stop(original_row)
+        except BaseException: error.add_note('owned execution STOP_UNCONFIRMED')
+        raise
