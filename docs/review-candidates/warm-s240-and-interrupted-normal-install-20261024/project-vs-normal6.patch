+
+def _send(sock, raw):
+    require(type(raw) is bytes and len(raw) <= MAX_FRAME, 'bounded_frame_required')
+    try:
+        # Nonblocking send avoids a full queue extending the finite clock.
+        sent = sock.send(raw, socket.MSG_DONTWAIT | socket.MSG_NOSIGNAL)
+    except OSError as exc:
+        raise TransportError('transport_send_failed_' + str(exc.errno)) from None
+    require(sent == len(raw), 'partial_seqpacket_send')
