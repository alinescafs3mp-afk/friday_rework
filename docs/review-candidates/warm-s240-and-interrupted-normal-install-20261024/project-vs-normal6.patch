+def pinned_file(path, digest, *, executable=False):
+    p = Path(path)
+    require(p.is_absolute() and p.resolve() == p and re.fullmatch('[0-9a-f]{64}', digest), 'invalid_pin')
+    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
+    try:
+        s = os.fstat(fd)
+        require(stat.S_ISREG(s.st_mode) and s.st_nlink == 1 and not s.st_mode & 0o022, 'writable_pinned_file')
+        require(not executable or s.st_mode & 0o111, 'not_executable')
+        data = b''
+        while chunk := os.read(fd, 65536):
+            data += chunk
+            require(len(data) <= 16 * 1024 * 1024, 'pin_oversized')
+        require(hashlib.sha256(data).hexdigest() == digest, 'pin_changed')
+        require(os.fstat(fd) == s and os.stat(p, follow_symlinks=False) == s, 'pin_raced')
+    finally:
+        os.close(fd)
+    require(os.statvfs(p).f_flag & os.ST_RDONLY, 'pinned_core_not_readonly')
+    return str(p)
