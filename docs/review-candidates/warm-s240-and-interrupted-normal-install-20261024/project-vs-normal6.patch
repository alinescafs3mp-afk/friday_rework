+SCHEMA = 'frw.a0.finite-factory.v1'
+GUARD = 'dcd46c2b896a20ac2dc3e18f82168f09845e54b8982fbdb06ecbb6d7e2fb049a'
+REQUIRED = {'/a0/frw_native_warm_service.py', '/a0/native_job_boundary.py',
+            '/a0/frw_native_job.py', '/a0/frw_native_job_data.py',
+            '/a0/plugins/_memory/helpers/memory.py', '/usr/bin/bwrap','/a0/frw_native_memory.py'}
+MODEL_REQUIRED = {'/a0/native_model_transport.py','/a0/native_model_runtime.py',
+    '/a0/frw_native_model_client.py','/a0/frw-model-runtime.json',
+    '/a0/helpers/frw_model_work_core.py','/a0/helpers/frw_model_work_job.py',
