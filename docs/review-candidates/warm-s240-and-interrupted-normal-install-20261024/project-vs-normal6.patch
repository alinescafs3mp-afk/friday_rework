+def capture_native_profiles(config_api, models_api, runtime_api):
+    """Capture exact current native builder arguments WITHOUT provider creation.
+
+    The caller is trusted, single-threaded preparation with admitted current
+    native config. Native builders resolve all preset/vision/embedding defaults.
+    Provider keys remain engine-only and are never captured into the policy.
+    """
+    captured=[]
+    def capture(kind):
+        def call(provider,name,model_config=None,**kwargs):
+            require(type(provider) is str and type(name) is str, 'native_model_identity_required')
+            provider=provider.lower()
+            effective_provider,kwargs=models_api._merge_provider_public_defaults(kind,provider,dict(kwargs))
+            runtime_api.public_native_options(kwargs)
+            require(model_config is not None and not model_config.api_key,
+                    'profile_inline_credential_requires_private_admission')
+            local=kind=='embedding' and effective_provider=='huggingface' and name.startswith('sentence-transformers/')
+            value={'kind':'local_embedding' if local else kind,'provider':provider,'name':name,
+                   'kwargs':kwargs,'model_config':{k:getattr(model_config,k) for k in
+                       ('ctx_length','limit_requests','limit_input','limit_output','vision')}}
+            runtime_api.public_profiles({'captured':value})
+            captured.append(value)
+            return value
+        return call
+    old_chat,old_embedding=models_api.get_chat_model,models_api.get_embedding_model
+    try:
+        models_api.get_chat_model=capture('chat');models_api.get_embedding_model=capture('embedding')
+        for builder in ('build_chat_model','build_utility_model','build_vision_model','build_embedding_model'):
+            if builder=='build_vision_model' and not config_api.get_vision_model_config():continue
+            getattr(config_api,builder)()
+    finally:
+        models_api.get_chat_model=old_chat;models_api.get_embedding_model=old_embedding
+    require(captured,'current_native_profiles_missing')
+    profiles={}; identities={}
+    for value in captured:
+        identity=digest({k:v for k,v in value.items() if k!='model_config'})
+        if identity in identities:
+            require(profiles[identities[identity]]==value,'ambiguous_native_profile_metadata')
+            continue
+        pid='native-'+identity[:24];identities[identity]=pid;profiles[pid]=value
+    globals_value=models_api.get_litellm_global_kwargs()
+    runtime_api.public_native_options(globals_value)
+    return {'profiles':profiles,'global_kwargs':globals_value}
