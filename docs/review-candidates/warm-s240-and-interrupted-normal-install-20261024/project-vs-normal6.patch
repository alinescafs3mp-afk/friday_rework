+        self.service_id = service_id
+        require(finite(accepted_monotonic) and finite(end_monotonic)
+                and 0 < end_monotonic - accepted_monotonic <= 120
+                and finite(stop_reserve) and 0 < stop_reserve < 120, 'original_finite_clock_required')
+        self.accepted, self.end_monotonic, self.reserve = accepted_monotonic, end_monotonic, stop_reserve
+        self.clock = clock
+        self.pins = (bwrap_sha256, bootstrap_sha256, helper_sha256)
+        self.bwrap = pinned_file(bwrap, bwrap_sha256, executable=True)
+        self.bootstrap = pinned_file(bootstrap, bootstrap_sha256)
+        self.helper = pinned_file(__file__, helper_sha256)
+        self.used, self.active, self.unknown = set(), None, False
+        self.used_native_ids = set()  # private authority values; never journal
+        self.active_layout = None
+        self.lock = threading.Lock()
+        self._model_call_channel = None
+        self._model_engine_dispatch = None
+        self.model_job_ipc = None
+
+
+
+    def _receipt(self, *, settled):
+        job_id, context_id, group, _, _ = self.active
+        return {'schema': 'frw.a0.native-job-boundary.v1', 'service_id': self.service_id,
+                'job_id': job_id, 'context_id': context_id, 'settled': settled,
+                'service_running': self.clock() < self.end_monotonic, 'job_processes_empty': settled,
+                'core_readonly': True, 'service_stop_confirmed': False,
+                'native_boundary_identity': list(group.identity),
+                'mechanism': group.primitive,
+                'original_end_monotonic': self.end_monotonic,
+                'model_work_mode': ('retained-native-provider' if self._model_engine_dispatch else 'fresh-isolated'),
+                'actual_model_work_process_warm': self._model_engine_dispatch is not None}
+
+    def end(self, job_id, context_id, settlement_seconds=2):
+        with self.lock:
+            require(self.active is not None and (job_id, context_id) == self.active[:2], 'wrong_active_job')
+            require(finite(settlement_seconds) and 0 < settlement_seconds <= 5, 'invalid_settle_bound')
+            if self.model_job_ipc is not None:
+                self.model_job_ipc.revoke()
+            # Revoke the data-only model-call ticket BEFORE namespace teardown.
+            # This discards a late reply; it does not certify model-call cessation.
+            if self._model_call_channel is not None:
+                self._model_call_channel._invalidate_locked(job_id, context_id)
+            # Revoke guardian engine lease before exact namespace teardown.
+            # Even failed engine settlement must not skip the existing job stop.
+            model_error = None
+            if self._model_engine_dispatch is not None:
+                try:
+                    self._model_engine_dispatch._end_locked(job_id, context_id)
+                except BaseException as exc:
+                    model_error = exc
