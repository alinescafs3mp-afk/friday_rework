+                     for x in session.config['a0']['expected_files'])
+    config = A0HostConfig(Path(session.config['workspace_root']), staging, staging,
+        lambda row: session.store.get(row['existing_task_id'],row.get('owner',original_row['owner'])),
+        expected, session.keys, max_file_bytes=min(session.config['max_file_bytes'],session.config['max_total_bytes']))
+    return A0FiniteWarmAdapter(host,data_config=config)
