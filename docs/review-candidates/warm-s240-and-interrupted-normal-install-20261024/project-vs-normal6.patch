+def _durable(directory, name, value):
+    path = Path(directory)
+    require(path.is_absolute() and path.resolve() == path and path.is_dir()
+            and not path.stat().st_mode & 0o077, 'private_evidence_directory_required')
+    target = path / name
+    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    try:
+        data = encode(value)
+        with os.fdopen(fd, 'wb', closefd=False) as handle:
+            handle.write(data); handle.flush(); os.fsync(fd)
+    finally:
+        os.close(fd)
+    directory_fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(directory_fd)
+    finally:
+        os.close(directory_fd)
+    return str(target)
