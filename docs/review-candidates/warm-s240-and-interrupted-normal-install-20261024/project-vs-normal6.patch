+# Preparation is deliberately separate from runtime opt-in. These APIs produce
+# inert build inputs only; no image execution, installation or clock is granted.
+def native_dependency_recipe(source_map):
+    """Derive imports and dynamic loader sites from the COMPLETE native source.
+
+    No import shortlist defines the closure. All six immutable import/native
+    trees are inventoried in the built image, including lazy provider modules.
+    This AST report explains that inventory and does not claim imports succeeded.
+    """
+    import ast
+    require(type(source_map) is dict and 'models.py' in source_map
+            and 'helpers/providers.py' in source_map
+            and 'conf/model_providers.yaml' in source_map,
+            'complete_native_source_map_required')
+    imports = {}; dynamic = {}; registries = {}; pins = {}
+    for relative, pin in sorted(source_map.items()):
+        require(type(relative) is str and not relative.startswith('/')
+                and '..' not in Path(relative).parts, 'native_dependency_path_invalid')
+        require(type(pin) is dict and set(pin) == {'path','sha256'}, 'native_dependency_pin_invalid')
+        path=Path(pin['path'])
+        require(path.is_absolute() and path.resolve()==path, 'native_dependency_source_alias')
+        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
+        try:
+            before=os.fstat(fd)
+            require(stat.S_ISREG(before.st_mode) and before.st_nlink==1
+                    and not before.st_mode&0o022 and before.st_size<=16*1024**2,
+                    'native_dependency_source_unsafe')
+            with os.fdopen(os.dup(fd),'rb') as stream: raw=stream.read(16*1024**2+1)
+            require(len(raw)<=16*1024**2 and hashlib.sha256(raw).hexdigest()==pin['sha256']
+                    and before==os.fstat(fd)==path.lstat(),'native_dependency_source_changed')
+        finally:os.close(fd)
+        pins[relative]=pin['sha256']
+        if relative.endswith('model_providers.yaml'):registries[relative]=pin['sha256']
+        if not relative.endswith('.py'):continue
+        tree=ast.parse(raw,filename=relative)
+        names=set(); calls=[]
+        for node in ast.walk(tree):
+            if isinstance(node,ast.Import):names.update(x.name for x in node.names)
+            elif isinstance(node,ast.ImportFrom):names.add('.'*node.level+(node.module or ''))
+            elif isinstance(node,ast.Call):
+                name=ast.unparse(node.func)
+                if name.endswith(('import_module','__import__','find_spec','load_module','load_classes_from_folder','spec_from_file_location')):
+                    calls.append({'line':node.lineno,'call':ast.unparse(node)})
+        imports[relative]=sorted(names)
+        if calls:dynamic[relative]=calls
+    require('models.py' in imports and registries,'native_registry_or_models_missing')
+    return {'schema':'frw.a0.native-dependency-derivation.v1','source_pins':pins,
+            'imports':imports,'dynamic_sites':dynamic,'provider_registries':registries,
+            'closure_strategy':'ALL_RUNTIME_IMPORT_TREES_AND_INTERPRETER_NOT_IMPORT_SHORTLIST',
+            'dependency_installation':'EXISTING_BASE_SETUP_VENV_AND_COPY_A0',
+            'import_execution':'NOT_RUN','future_Root_authority':None}
+
