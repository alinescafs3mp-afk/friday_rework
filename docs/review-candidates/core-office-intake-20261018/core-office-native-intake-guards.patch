+++ b/tools/scoped_office_worker.py
@@ -0,0 +1,119 @@
+"""Private byte-only converter child; no CLI/path document conversion fallback."""
+import ctypes
+import errno
+import importlib
+import json
+import resource
+import sys
+
+
+def main():
+    # The parent supplies its selected installed package location, never a user
+    # document path. -I prevents ambient PYTHONPATH/CWD injection in this child.
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    resource.setrlimit(resource.RLIMIT_CPU, (3, 3))
+    resource.setrlimit(resource.RLIMIT_AS, (1024**3, 1024**3))
+    resource.setrlimit(resource.RLIMIT_FSIZE, (6100000, 6100000))
+    resource.setrlimit(resource.RLIMIT_NOFILE, (64, 64))
+    sys.path.insert(0, sys.argv[1])
+    try:
+        module = importlib.import_module('anydoc')
+    except (ImportError, OSError):
+        return {'error': 'missing_local_converter'}
+    payload = sys.stdin.buffer.read(1000033)
+    format_raw, separator, data = payload.partition(b'\n')
+    if not separator or len(data) > 1000000:
+        return {'error': 'input_limit'}
+    format = format_raw.decode('ascii')
+    if format not in {'pdf', 'rtf', 'odt', 'ods', 'odp', 'xlsx', 'pptx'}:
+        return {'error': 'unsupported_format'}
+    try:
+        lib = ctypes.CDLL('libseccomp.so.2', use_errno=True)
+        lib.seccomp_init.argtypes = [ctypes.c_uint32]
+        lib.seccomp_init.restype = ctypes.c_void_p
+        lib.seccomp_syscall_resolve_name.argtypes = [ctypes.c_char_p]
+        lib.seccomp_syscall_resolve_name.restype = ctypes.c_int
+        lib.seccomp_rule_add.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int, ctypes.c_uint]
+        lib.seccomp_load.argtypes = [ctypes.c_void_p]
+        lib.seccomp_release.argtypes = [ctypes.c_void_p]
+        lib.seccomp_attr_set.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint32]
+        class Compare(ctypes.Structure):
+            _fields_ = [('arg', ctypes.c_uint), ('op', ctypes.c_uint),
+                        ('a', ctypes.c_uint64), ('b', ctypes.c_uint64)]
+        lib.seccomp_rule_add_array.argtypes = [ctypes.c_void_p, ctypes.c_uint32,
+                                              ctypes.c_int, ctypes.c_uint,
+                                              ctypes.POINTER(Compare)]
+        # Default refusal also covers new syscalls and metadata mutation.
+        ctx = lib.seccomp_init(0x50000 | errno.EPERM)  # SCMP_ACT_ERRNO
+        if not ctx:
+            raise RuntimeError()
+        try:
+            # Native libraries can initialize helper threads while importing.
+            # Require TSYNC so every existing thread receives the same filter.
+            if lib.seccomp_attr_set(ctx, 4, 1) != 0:  # SCMP_FLTATR_CTL_TSYNC
+                raise RuntimeError()
+            # Imports are complete; only anonymous memory, inherited I/O,
+            # synchronization, signals and process-local queries remain.
+            allowed = ('read', 'write', 'readv', 'writev', 'close', 'lseek',
+                       'fstat', 'newfstatat', 'statx', 'mmap', 'mmap2',
+                       'mprotect', 'munmap', 'mremap', 'madvise', 'brk',
+                       'futex', 'futex_waitv', 'rt_sigaction', 'rt_sigprocmask',
+                       'rt_sigreturn', 'sigaltstack', 'clock_gettime',
+                       'gettimeofday', 'time', 'getpid', 'getppid', 'gettid',
+                       'getrandom', 'sched_getaffinity', 'sched_yield',
+                       'rseq', 'set_robust_list', 'set_tid_address',
+                       'getrusage', 'restart_syscall', 'exit',
+                       'exit_group')
+            for name in allowed:
+                number = lib.seccomp_syscall_resolve_name(name.encode())
+                if number >= 0 and lib.seccomp_rule_add(ctx, 0x7fff0000, number, 0) != 0:
+                    raise RuntimeError()
+            # Rayon PDF extraction initializes one helper lazily. A thread
+            # shares this process and inherits the filter; process creation
+            # stays forbidden. clone3's pointer argument cannot be safely
+            # filtered, so make glibc fall back to the inspectable clone ABI.
+            clone = lib.seccomp_syscall_resolve_name(b'clone')
+            # Permit only ordinary pthread flags, excluding namespaces and
+            # tracing/parent/vfork modifiers as well as separate processes.
+            # libseccomp permits one comparison per argument. Combine the
+            # required bits and forbidden-extra-bit masks into one predicate.
+            clone_comparison = Compare(0, 7,
+                0x109ff | ((~0x013d0f00) & ((1 << 64) - 1)), 0x10900)
+            if clone < 0 or lib.seccomp_rule_add_array(ctx, 0x7fff0000, clone, 1, ctypes.byref(clone_comparison)) != 0:
+                raise RuntimeError()
+            clone3 = lib.seccomp_syscall_resolve_name(b'clone3')
+            if clone3 >= 0 and lib.seccomp_rule_add(ctx, 0x50000 | errno.ENOSYS, clone3, 0) != 0:
+                raise RuntimeError()
+            # pthread startup can query its own limits; never permit changes
+            # or another process's limits through prlimit64.
+            limits = lib.seccomp_syscall_resolve_name(b'prlimit64')
+            comparisons = (Compare * 2)(Compare(0, 4, 0, 0), Compare(2, 4, 0, 0))
+            if limits >= 0 and lib.seccomp_rule_add_array(ctx, 0x7fff0000, limits, 2, comparisons) != 0:
+                raise RuntimeError()
+            if lib.seccomp_load(ctx) != 0:
+                raise RuntimeError()
+        finally:
+            lib.seccomp_release(ctx)
+    except Exception:
+        return {'error': 'converter_containment_unavailable'}
+    try:
+        if module.format_from_bytes(data) != format:
+            return {'error': 'format_mismatch'}
+        text = module.to_markdown_bytes(data, format=format, ocr='reject')
+    except Exception as exc:
+        needs_ocr = getattr(module, 'NeedsOcrError', None)
+        code = 'needs_ocr' if needs_ocr is not None and isinstance(exc, needs_ocr) else 'malformed_or_unsupported'
+        return {'error': code}
+    if not isinstance(text, str) or not text.strip():
+        return {'error': 'no_extractable_text'}
+    if len(text.encode('utf-8')) > 1000000:
+        return {'error': 'extracted_text_limit'}
+    return {'text': text}
+
+
+if __name__ == '__main__':
+    try:
+        result = main()
+    except Exception:
+        result = {'error': 'converter_failed'}
+    sys.stdout.write(json.dumps(result, ensure_ascii=False))
