+def _source_guard_diagnostics(check):
+    """Best-effort metadata only; preserve proof failures and interrupt ownership."""
+    sequence = count(1)
+    emitting = local()
+    logger = logging.getLogger(__name__)
+
+    def record(message):
+        try:
+            # A logging handler may itself enter the guard. That proof still runs,
+            # but its diagnostic is unobserved rather than recursively logging.
+            if getattr(emitting, 'active', False) or len(message) > 512:
+                return
+            emitting.active = True
+            try:
+                logger.warning(message)
+            finally:
+                emitting.active = False
+        except Exception:
+            pass
+
+    @wraps(check)
+    def observed(*args, **kwargs):
+        span = None
+        try:
+            # Reserve an ordinal even when a handler reenters: later sequence
+            # gaps remain evidence of unobserved entries, never zero calls.
+            seq = next(sequence)
+            if not getattr(emitting, 'active', False):
+                pid, tid = os.getpid(), get_native_id()
+                entered = monotonic_ns()
+                record(f'FRW_SOURCE_GUARD_V1 event=begin pid={pid} tid={tid} seq={seq} enter_ns={entered}')
+                span = (pid, tid, seq, entered, monotonic_ns())
+        except Exception:
+            pass
+        ok = False
+        try:
+            result = check(*args, **kwargs)
+            ok = True
+            return result
+        finally:
+            try:
+                if span is not None:
+                    ended = monotonic_ns()
+                    pid, tid, seq, entered, body_begin = span
+                    status = 'ok' if ok else 'fail'
+                    record(f'FRW_SOURCE_GUARD_V1 event=end pid={pid} tid={tid} seq={seq} enter_ns={entered} body_begin_ns={body_begin} end_ns={ended} status={status}')
+            except Exception:
+                pass
+            except BaseException:
+                # A pending proof exception keeps its exact object/type. With no
+                # proof failure, do not swallow SystemExit/KeyboardInterrupt.
+                if ok:
+                    raise
+
+    return observed
+
+
