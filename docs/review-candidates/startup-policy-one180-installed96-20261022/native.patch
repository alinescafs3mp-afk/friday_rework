+def friday_startup_test_seconds() -> int:
+    """One explicit temporary startup policy; normal rendering stays unchanged.
+
+    The test owner must stop the service before clearing this environment and
+    regenerating the ordinary unit. This setting grants no launch authority.
+    """
+    value = os.environ.get("HERMES_FRIDAY_STARTUP_TEST_SECONDS")
+    if value is None:
+        return 90
+    if value != "180":
+        raise ValueError("friday_startup_test_seconds_requires_exact_180")
+    return 180
+
