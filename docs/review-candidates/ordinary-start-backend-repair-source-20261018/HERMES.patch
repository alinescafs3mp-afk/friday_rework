+"""Fixed native identify diagnostics never reflect server payloads."""
+import json
+
+import pytest
+
+from gateway import control_socket as cs
+
+
+@pytest.mark.parametrize("response,outcome,refusal", [
+    ({"ok": True, "result": {"pid": 1}}, "ok", None),
+    ({"ok": False, "error": "ValueError: friday_dashboard_owner_unproved"},
+     "native_error", "source_or_owner_unproved"),
+    ({"ok": False, "error": "CredentialDenied: friday_credential_route_override_refused"},
+     "native_error", "credential_refused"),
+    ({"ok": False, "error": "SECRET /private/path"}, "native_error", "unspecified"),
+    ({"ok": True, "result": "SECRET"}, "invalid_result", None),
+    ([], "invalid_response", None),
+    (None, "invalid_response", None),
+    ({"error": "SECRET"}, "invalid_response", None),
+])
+def test_static_response_classification(monkeypatch, tmp_path, response, outcome, refusal):
+    monkeypatch.setattr(cs, "_IS_WINDOWS", False)
+    monkeypatch.setattr(cs, "_query_unix_socket", lambda *a, **kw: json.dumps(response).encode())
+    diagnostic = {"old": "SECRET"}
+    result = cs.identify_gateway(tmp_path, timeout=5, diagnostic=diagnostic)
+    assert diagnostic == {"transport": "unix", "outcome": outcome,
+                          **({"refusal": refusal} if refusal else {})}
+    assert result == (response["result"] if outcome == "ok" else None)
+
+
+def test_absent_socket_and_malformed_response_remain_refusals(monkeypatch, tmp_path):
+    monkeypatch.setattr(cs, "_IS_WINDOWS", False)
+    monkeypatch.setattr(cs, "resolve_client_socket_path", lambda home: None)
+    diagnostic = {}
+    assert cs.identify_gateway(tmp_path, diagnostic=diagnostic) is None
+    assert diagnostic == {"transport": "unix", "outcome": "socket_unavailable"}
+    monkeypatch.setattr(cs, "_query_unix_socket", lambda *a, **kw: b"SECRET not JSON")
+    assert cs.identify_gateway(tmp_path, diagnostic=diagnostic) is None
+    assert diagnostic == {"transport": "unix", "outcome": "malformed_response"}
+
+
+def test_transport_timeout_is_distinct_without_changed_timeout(monkeypatch, tmp_path):
+    monkeypatch.setattr(cs, "_IS_WINDOWS", False)
+    monkeypatch.setattr(cs, "resolve_client_socket_path", lambda home: tmp_path / "gateway.sock")
+    timeouts = []
+
+    class Socket:
+        def __enter__(self):
+            return self
+        def __exit__(self, *args):
+            pass
+        def settimeout(self, seconds):
+            timeouts.append(seconds)
+        def connect(self, path):
+            raise TimeoutError("SECRET")
+
+    monkeypatch.setattr(cs.socket, "socket", lambda *a: Socket())
+    diagnostic = {}
+    assert cs.identify_gateway(tmp_path, timeout=5, diagnostic=diagnostic) is None
+    assert timeouts == [5]
+    assert diagnostic == {"transport": "unix", "outcome": "timeout"}
+
+
