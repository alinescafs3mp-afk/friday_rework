+"""Embedded native session backend for the already owning messaging daemon.
+
+The lease permits module initialization only. It never admits a product user,
+changes the CLI principal or relaxes a session/RPC/profile check.
+"""
+from __future__ import annotations
+
+from contextvars import ContextVar
+import importlib
+import os
+from threading import get_ident
+
+_IMPORT = ContextVar("hermes_native_backend_import", default=None)
+
+
+def _deny():
+    from hermes_cli.friday_user_scope import ScopeDenied
+    raise ScopeDenied()
+
+
+def _gateway_owner():
+    from gateway import host_rendezvous as hr
+    from gateway.status import get_process_start_time
+    from hermes_constants import get_hermes_home, get_process_hermes_home
+    from hermes_cli import friday_user_scope as users
+    from hermes_cli.friday_cli_principal import _LOCAL
+    from hermes_cli.friday_gateway_owner import expected
+
+    # A model/tool/CLI context in the same OS process is not its daemon owner.
+    if users._CURRENT.get() is not None or _LOCAL.get() is not None:
+        _deny()
+    home = get_process_hermes_home()
+    record = hr.read_record(hr.ROLE_GATEWAY, include_stale=True)
+    if (get_hermes_home() != home or record is None
+            or not hr.owns_host_lock(hr.ROLE_GATEWAY)
+            or record.role != hr.ROLE_GATEWAY or record.pid != os.getpid()
+            or record.home != str(home) or type(record.start_time) is not int
+            or record.start_time != get_process_start_time(os.getpid())
+            or not hr.liveness_is_proven(record)
+            or not hr.record_token_is_consistent(record)):
+        _deny()
+    # Full source/configuration and the actual native run role remain required.
+    expected(home)
+    if hr.read_record(hr.ROLE_GATEWAY, include_stale=True) != record:
+        _deny()
+    return record
+
+
+def native_backend_import() -> bool:
+    """Consume one exact daemon import lease; otherwise retain the CLI guard."""
+    lease = _IMPORT.get()
+    if lease is None:
+        return False
+    if (not lease["active"] or lease["used"] or lease["pid"] != os.getpid()
+            or lease["thread"] != get_ident() or _gateway_owner() != lease["owner"]):
+        _deny()
+    lease["used"] = True
+    return True
+
+
+def hosted_room_backend():
+    """Reuse native handlers, under the current daemon's actual owned incarnation."""
+    from hermes_cli.friday_dashboard_owner import enabled
+    if not enabled():
+        return importlib.import_module("tui_gateway.server")
+    record = _gateway_owner()
+    lease = {"active": True, "used": False, "pid": os.getpid(),
+             "thread": get_ident(), "owner": record}
+    token = _IMPORT.set(lease)
+    try:
+        server = importlib.import_module("tui_gateway.server")
+        # A cached interactive backend cannot be reclassified as a daemon.
+        if not getattr(server, "_entry_gateway_backend", False):
+            _deny()
+        if _gateway_owner() != record:
+            _deny()
+        return server
+    finally:
+        lease["active"] = False
+        _IMPORT.reset(token)
