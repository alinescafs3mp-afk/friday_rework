+def _iter_docx_owned(para: ET.Element, w: str) -> Iterator[ET.Element]:
+    """Yield one paragraph's owned nodes in document order, pruning nested w:p and ruby w:rt
+    subtrees: a nested paragraph (e.g. inside w:txbxContent) is emitted by this loop's own
+    iteration, and w:rt is the ruby guide over w:rubyBase — it annotates text, it is not text.
+    Explicit stack, so deep nesting hits no recursion limit and each node is visited once."""
+    stack = list(reversed(list(para)))
+    while stack:
+        node = stack.pop()
+        if node.tag in (f"{w}p", f"{w}rt"):
+            continue
+        yield node
+        stack.extend(reversed(list(node)))
+
