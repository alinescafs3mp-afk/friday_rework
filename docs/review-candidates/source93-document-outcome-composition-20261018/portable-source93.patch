+"""Normal Telegram text entry and one retained-route direct document outcome."""
+from __future__ import annotations
+
+import asyncio
+from typing import Any, Dict, Optional
+from gateway.platforms.base import SendResult
+
+
+async def send(
+    self, chat_id: str, content: str, reply_to: Optional[str] = None, metadata: Optional[Dict[str, Any]] = None) -> SendResult:
+    """Send a message to a Telegram chat."""
+    if isinstance(metadata, dict) and '_friday_document_outcome' in metadata:
+        return await _send_outcome(self, chat_id, content, reply_to, metadata)
+    if not self._bot:
+        live = self._replacement_telegram_adapter()
+        if live is not None:
+            return await live.send(chat_id, content, reply_to, metadata)
+        if self._is_permanent_fatal() or not await self._wait_for_reconnection():
+            return SendResult(success=False, error="Not connected", retryable=not self._is_permanent_fatal())
+        live = self._replacement_telegram_adapter()
+        if not self._bot and live is not None:
+            return await live.send(chat_id, content, reply_to, metadata)
+        if not self._bot:
+            return SendResult(success=False, error="Not connected", retryable=True)
+    # getattr() — tests build adapters via object.__new__() (no __init__).
+    if getattr(self, "_send_path_degraded", False):
+        return SendResult(success=False, error="send_path_degraded", retryable=True)
+    # Skip whitespace-only text to prevent Telegram 400 empty-text errors.
+    if not content or not content.strip():
+        return SendResult(success=True, message_id=None)
+    # One chat at a time (held only around the API calls, never across the reconnect wait above), so
+    # two concurrent split replies to one chat cannot interleave their chunks (#114396).
+    async with self._chat_send_lock(chat_id):
+        return await self._send_text_locked(chat_id, content, reply_to, metadata)
+
+
+async def _send_outcome(adapter, chat_id, content, reply_to, metadata):
+    """No reconnect, retarget or retry after any ambiguous status attempt."""
+    from gateway.run_plugin_delivery import freeze_route
+    proof = metadata.get('_friday_document_outcome')
+    if not isinstance(proof, tuple) or len(proof) != 2 or not callable(proof[0]):
+        return SendResult(success=False, error='original_outcome_required')
+    validate, original = proof
+    route = freeze_route(original)
+    target = route['source']
+    if (chat_id != target['chat_id'] or reply_to != target['message_id']
+            or not isinstance(content, str) or not content):
+        return SendResult(success=False, error='original_outcome_required')
+    bot = adapter._bot
+    def check():
+        validate()
+        if (bot is None or adapter._bot is not bot or adapter.is_connected is not True
+                or getattr(adapter, '_send_path_degraded', False)
+                or str(bot.id) != route['bot_id']):
+            raise RuntimeError('original_bot_offline')
+    check()
+    async with adapter._chat_send_lock(chat_id):
+        check()
+        cooldown = adapter._send_flood_cooldown_remaining(chat_id)
+        if cooldown is not None:
+            return SendResult(success=False, error='document_outcome_rate_limited')
+        remaining = adapter._chat_outbound_slot_remaining(chat_id)
+        if remaining > 0:
+            await asyncio.sleep(remaining)
+            check()
+        adapter._hold_chat_outbound_slot(chat_id)
+        kwargs = {**adapter._notification_kwargs(metadata), 'chat_id': chat_id,
+                  'reply_to_message_id': int(target['message_id']), 'text': content, 'parse_mode': None}
+        thread_id = adapter._message_thread_id_for_send(target['thread_id'])
+        if thread_id is not None:
+            kwargs['message_thread_id'] = thread_id
+        check()
+        # The fixed short plain-text result needs no markdown or chunk fallback.
+        # One bounded SDK call; a lost ACK leaves the caller's immutable PENDING.
+        message = await asyncio.wait_for(bot.send_message(**kwargs), timeout=30)
+    message_id = getattr(message, 'message_id', None)
+    if (type(message_id) is not int or message_id <= 0
+            or str(getattr(getattr(message, 'chat', None), 'id', '')) != chat_id
+            or getattr(message, 'message_thread_id', None) != kwargs.get('message_thread_id')):
+        raise RuntimeError('document_outcome_ack_unavailable')
+    return SendResult(success=True, message_id=str(message_id), raw_response={
+        'kind': 'document_outcome', 'chat_id': chat_id, 'thread_id': target['thread_id'],
+        'reply_to': reply_to, 'message_id': str(message_id)})
