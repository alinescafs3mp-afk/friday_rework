+def test_recursive_alias_hidden_in_opaque_pair_preserves_finite_legacy_graph():
+    raw = yaml.safe_load("""&root
+flag: original
+pairs: !!pairs [{root: *root}]
+""")
+    expected = legacy_effective(raw)
+    actual = effective._effective(raw, isolate_raw=True)
+    for result in (expected, actual):
+        retained_root = result["pairs"][0][1]
+        assert retained_root is not result
+        assert retained_root["pairs"][0] is result["pairs"][0]
+        assert retained_root["flag"] == "original"
+    actual["pairs"][0][1]["flag"] = "private"
+    assert expected["pairs"][0][1]["flag"] == raw["flag"] == "original"
