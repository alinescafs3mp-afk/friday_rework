+def test_both_readers_ignore_frozen_complete_stat_signature(tmp_path, monkeypatch):
+    path = tmp_path / "config.yaml"
+    path.write_text("value: first\n")
+    frozen = path.stat()
+    original_stat = Path.stat
+
+    def same_target_stat(target, *args, **kwargs):
+        return frozen if target == path else original_stat(target, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "stat", same_target_stat)
+    assert cfg.require_readable_config_before_write(path) == {"value": "first"}
+    assert effective.read_user_config_effective_readonly(path) == {"value": "first"}
+    path.write_text("value: other\n")
+    assert cfg.require_readable_config_before_write(path) == {"value": "other"}
+    assert effective.read_user_config_effective_readonly(path) == {"value": "other"}
+
