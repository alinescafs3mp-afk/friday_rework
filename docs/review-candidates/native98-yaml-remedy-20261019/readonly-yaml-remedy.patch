+def test_missing_empty_and_deleted_file_keep_each_caller_contract(tmp_path):
+    path = tmp_path / "config.yaml"
+    assert cfg.require_readable_config_before_write(path) == {}
+    assert effective.read_user_config_effective_readonly(path, allow_empty=True) == {}
+    with pytest.raises(FileNotFoundError):
+        effective.read_user_config_effective_readonly(path)
+    path.write_text("")
+    assert cfg.require_readable_config_before_write(path) == {}
+    assert effective.read_user_config_effective_readonly(path, allow_empty=True) == {}
+    with pytest.raises(ValueError, match="effective_config_mapping_required"):
+        effective.read_user_config_effective_readonly(path)
+    path.write_text("value: good\n")
+    effective.read_user_config_effective_readonly(path)
+    path.unlink()
+    with pytest.raises(FileNotFoundError):
+        effective.read_user_config_effective_readonly(path)
+
