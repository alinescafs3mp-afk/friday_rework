+def test_alias_across_opaque_pairs_and_expanded_branch_keeps_legacy_graph(monkeypatch):
+    monkeypatch.setenv("REMEDY_ENV", "expanded")
+    raw = yaml.safe_load("""
+node: &node {env: '${REMEDY_ENV}', tags: !!set {red: null}}
+pairs: !!pairs [{node: *node}]
+""")
+    expected = legacy_effective(raw)
+    actual = effective._effective(raw, isolate_raw=True)
+    for result in (expected, actual):
+        assert result["node"]["env"] == "expanded"
+        assert result["pairs"][0][1]["env"] == "${REMEDY_ENV}"
+        assert result["node"] is not result["pairs"][0][1]
+        assert result["node"]["tags"] is result["pairs"][0][1]["tags"]
+    actual["pairs"][0][1]["tags"].add("private")
+    assert expected["node"]["tags"] == raw["node"]["tags"] == {"red"}
+
