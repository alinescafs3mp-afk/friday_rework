+def _clone_expand_readonly_raw(raw):
+    """Copy/expand the user layer without first cloning every dict/list twice.
+
+    Expansion already constructs fresh dicts/lists and breaks their YAML aliases,
+    just as ``_expand_env_vars(deepcopy(raw))`` does. Keys and opaque leaves still
+    need deepcopy: safe YAML includes mutable sets and tuples from !!pairs or
+    sequence keys. One memo preserves aliases inside those retained objects and
+    keeps them isolated from the byte-keyed raw cache and every other caller.
+    """
+    memo = {}
+
+    def expand(value):
+        if isinstance(value, str):
+            return _config._expand_env_vars(value)
+        if isinstance(value, dict):
+            return {copy.deepcopy(key, memo): expand(child)
+                    for key, child in value.items()}
+        if isinstance(value, list):
+            return [expand(child) for child in value]
+        return copy.deepcopy(value, memo)
+
+    return expand(raw)
+
+
+def _effective(raw: Dict[str, Any], *, isolate_raw: bool = False) -> Dict[str, Any]:
+    expanded = (_clone_expand_readonly_raw(raw) if isolate_raw
+                else _config._expand_env_vars(raw))
