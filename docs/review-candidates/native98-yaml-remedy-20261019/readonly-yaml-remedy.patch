+def test_unchanged_file_env_only_rotation_and_public_mutation_isolation(tmp_path, monkeypatch):
+    path = tmp_path / "config.yaml"
+    path.write_text("env: ${REMEDY_ENV}\nset: &set !!set {red: null}\nalias: *set\nlist: [original]\n")
