+def test_large_current_source_bypasses_retained_cache_and_mutation_isolated(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("#" + "x" * effective._READONLY_RAW_CACHE_MAX_BYTES + "\nvalue: [original]\n")
+    before = effective._cached_readonly_user_raw.cache_info()
+    first = cfg.require_readable_config_before_write(path)
+    first["value"].append("private")
+    assert cfg.require_readable_config_before_write(path) == {"value": ["original"]}
+    assert effective.read_user_config_effective_readonly(path) == {"value": ["original"]}
+    assert effective._cached_readonly_user_raw.cache_info() == before
+
