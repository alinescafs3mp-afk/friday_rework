+def test_managed_overlay_and_model_normalization_remain_current(tmp_path, monkeypatch):
+    path = tmp_path / "config.yaml"
+    path.write_text("model: {name: own/model}\nprovider: custom\nlabel: user\n")
+    managed = tmp_path / "managed"
+    managed.mkdir()
+    monkeypatch.setattr(managed_scope, "get_managed_dir", lambda: managed)
+    managed_scope.invalidate_managed_cache()
+    (managed / "config.yaml").write_text("label: ${REMEDY_ENV}\n")
+    monkeypatch.setenv("REMEDY_ENV", "one")
+    first = effective.read_user_config_effective_readonly(path)
+    monkeypatch.setenv("REMEDY_ENV", "two")
+    second = effective.read_user_config_effective_readonly(path)
+    assert first["label"] == "one" and second["label"] == "two"
+    assert second["model"] == {"default": "own/model", "provider": "custom"}
+    assert "gateway" not in second
+    managed_scope.invalidate_managed_cache()
+
