+"""SOURCE controls: unexecuted; Root must qualify the final frozen candidate.
+
+Exercises real safe YAML, current temporary files and the legacy semantic
+reference. Does not authorize installed-home writes or performance acceptance.
+"""
+import builtins
+import copy
+from datetime import date, datetime
+import os
+from pathlib import Path
+
+import pytest
+
+import hermes_yaml as yaml
+from hermes_cli import config as cfg
+from hermes_cli import config_effective as effective
+from hermes_cli import managed_scope
+
+
+@pytest.fixture(autouse=True)
+def isolated_raw_cache(monkeypatch):
+    effective._cached_readonly_user_raw.cache_clear()
+    monkeypatch.setattr(managed_scope, "get_managed_dir", lambda: None)
+    yield
+    effective._cached_readonly_user_raw.cache_clear()
+
+
+def legacy_effective(raw):
+    # Exact old order, independently spelled out; do not use the new helper.
+    expanded = cfg._expand_env_vars(copy.deepcopy(raw))
+    merged = managed_scope.apply_managed_overlay(expanded if isinstance(expanded, dict) else {})
+    return cfg._normalize_root_model_keys(merged if isinstance(merged, dict) else {})
+
+
+DOCUMENTS = [
+    "values: [null, true, false, 42, 1.5, .inf, on, OFF]\n",
+    "value: ${REMEDY_ENV}\nmodel: {name: local/model, api_base: https://example.invalid}\nprovider: local\n",
+    "blob: !!binary aGVsbG8=\nday: 2026-10-19\nstamp: 2026-10-19T01:00:00Z\n",
+    "shared: &s !!set {red: null, blue: null}\nsame: *s\n",
+    "shared: &s ['${REMEDY_ENV}', {v: hello}]\nsame: *s\n",
+    "base: &b {x: 2, env: '${REMEDY_ENV}'}\nmerged: {<<: *b, x: 3}\n",
+    "pairs: !!pairs [{key: {env: '${REMEDY_ENV}'}}]\n",
+    "ordered: !!omap [{z: 1}, {a: '${REMEDY_ENV}'}]\n",
+    "? [one, two]\n: {value: '${REMEDY_ENV}'}\n",
+]
+
+
+@pytest.mark.parametrize("document", DOCUMENTS)
+def test_real_yaml_values_and_types_match_legacy(document, monkeypatch):
+    monkeypatch.setenv("REMEDY_ENV", "expanded-current")
+    raw = yaml.safe_load(document)
+    assert effective._effective(raw, isolate_raw=True) == legacy_effective(raw)
+    result = effective._effective(raw, isolate_raw=True)
+    if "blob" in result:
+        assert type(result["blob"]) is bytes and result["blob"] == b"hello"
+        assert type(result["day"]) is date and isinstance(result["stamp"], datetime)
+    if "pairs" in result:
+        assert isinstance(result["pairs"][0], tuple)
+        assert result["pairs"][0][1]["env"] == "${REMEDY_ENV}"
+    if "ordered" in result:
+        assert list(result["ordered"]) == ["z", "a"]
+    if ("one", "two") in result:
+        assert result[("one", "two")]["value"] == "expanded-current"
+
+
+def test_alias_mutation_isolation_including_opaque_pairs_and_sets(monkeypatch):
+    monkeypatch.setenv("REMEDY_ENV", "expanded-current")
+    raw = yaml.safe_load("""
+shared: &shared !!set {red: null}
+set_alias: *shared
+items: &items [one]
+items_alias: *items
+pairs: &pairs !!pairs [{x: {flag: original}}]
+pairs_alias: *pairs
+""")
+    first = effective._effective(raw, isolate_raw=True)
+    second = effective._effective(raw, isolate_raw=True)
+    assert first["shared"] is first["set_alias"]
+    assert first["items"] is not first["items_alias"]
+    assert first["pairs"] is not first["pairs_alias"]
+    assert first["pairs"][0] is first["pairs_alias"][0]
+    first["shared"].add("changed")
+    first["items"].append("changed")
+    first["pairs"][0][1]["flag"] = "changed"
+    assert second == legacy_effective(raw)
+    assert raw["shared"] == {"red"}
+    assert raw["pairs"][0][1]["flag"] == "original"
+
+
+def test_naive_no_clone_is_a_meaningful_negative_control():
+    raw = yaml.safe_load("value: !!set {original: null}\n")
+    unsafe = cfg._expand_env_vars(raw)
+    unsafe["value"].add("leaked")
+    assert "leaked" in raw["value"]
+    clean = yaml.safe_load("value: !!set {original: null}\n")
+    safe = effective._effective(clean, isolate_raw=True)
+    safe["value"].add("private")
+    assert clean["value"] == {"original"}
+
+
+def test_fresh_files_same_stat_signature_and_current_env(tmp_path, monkeypatch):
+    path = tmp_path / "config.yaml"
+    path.write_text("value: first\nenv: ${REMEDY_ENV}\n")
+    monkeypatch.setenv("REMEDY_ENV", "one")
+    first_stat = path.stat()
+    first = effective.read_user_config_effective_readonly(path)
+    path.write_text("value: other\nenv: ${REMEDY_ENV}\n")
+    os.utime(path, ns=(first_stat.st_atime_ns, first_stat.st_mtime_ns))
+    monkeypatch.setenv("REMEDY_ENV", "two")
+    second = effective.read_user_config_effective_readonly(path)
+    assert path.stat().st_size == first_stat.st_size
+    assert first == {"value": "first", "env": "one"}
+    assert second == {"value": "other", "env": "two"}
+
