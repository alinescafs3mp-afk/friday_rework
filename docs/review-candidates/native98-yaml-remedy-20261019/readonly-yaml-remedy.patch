+def test_both_callers_read_every_time_and_refuse_after_warm(tmp_path, monkeypatch):
+    path = tmp_path / "config.yaml"
+    path.write_text("value: current\n")
+    real_open = builtins.open
+    reads = []
+    deny = False
+
+    def observed_open(file, *args, **kwargs):
+        if isinstance(file, (str, os.PathLike)) and Path(file) == path:
+            reads.append((args, kwargs))
+            if deny:
+                raise PermissionError("synthetic-current-read-refused")
+        return real_open(file, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "open", observed_open)
+    assert effective.read_user_config_effective_readonly(path) == {"value": "current"}
+    assert cfg.require_readable_config_before_write(path) == {"value": "current"}
+    assert effective.read_user_config_effective_readonly(path) == {"value": "current"}
+    assert cfg.require_readable_config_before_write(path) == {"value": "current"}
+    assert len(reads) == 4
+    assert effective._cached_readonly_user_raw.cache_info().misses == 1
+    deny = True
+    with pytest.raises(PermissionError):
+        effective.read_user_config_effective_readonly(path)
+    with pytest.raises(RuntimeError, match="cannot be read"):
+        cfg.require_readable_config_before_write(path)
+    assert len(reads) == 6
+
