+def test_write_guard_raw_result_isolation_and_no_expansion(tmp_path, monkeypatch):
+    path = tmp_path / "config.yaml"
+    path.write_text("env: ${REMEDY_ENV}\nset: !!set {original: null}\n")
+    monkeypatch.setenv("REMEDY_ENV", "expanded")
+    first = cfg.require_readable_config_before_write(path)
+    first["set"].add("private")
+    second = cfg.require_readable_config_before_write(path)
+    assert second == {"env": "${REMEDY_ENV}", "set": {"original"}}
+    assert effective.read_user_config_effective_readonly(path)["env"] == "expanded"
+
