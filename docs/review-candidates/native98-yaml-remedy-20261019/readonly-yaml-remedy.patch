+@pytest.mark.parametrize("prefix", [b"", b"\xef\xbb\xbf", b"\xef\xbb\xbf\xef\xbb\xbf"])
+@pytest.mark.parametrize("newline", [b"\n", b"\r\n", b"\r"])
+def test_text_guard_matches_exact_legacy_stream_bom_and_newline(tmp_path, prefix, newline):
+    path = tmp_path / "config.yaml"
+    path.write_bytes(prefix + newline.join([b"value: hello", b"items: [one, two]", b""]))
+    with open(path, encoding="utf-8-sig") as stream:
+        expected = yaml.safe_load(stream)
+    first = cfg.require_readable_config_before_write(path)
+    second = cfg.require_readable_config_before_write(path)
+    assert first == second == expected
+
