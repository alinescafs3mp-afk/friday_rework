+def test_invalid_encoding_refuses_after_valid_warm_read(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_bytes(b"value: good\n")
+    cfg.require_readable_config_before_write(path)
+    effective.read_user_config_effective_readonly(path)
+    path.write_bytes(b"value: \xff\n")
+    with pytest.raises(UnicodeDecodeError):
+        effective.read_user_config_effective_readonly(path)
+    with pytest.raises(RuntimeError, match="formatting error"):
+        cfg.require_readable_config_before_write(path)
+    assert path.read_bytes() == b"value: \xff\n"
+
