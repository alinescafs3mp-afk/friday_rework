+@pytest.mark.parametrize("body", ["[]", "42", "true", "a: [unterminated", "a: 1\na: 2\n"])
+def test_invalid_current_file_refuses_after_warm(tmp_path, body):
+    path = tmp_path / "config.yaml"
+    path.write_text("value: good\n")
+    cfg.require_readable_config_before_write(path)
+    effective.read_user_config_effective_readonly(path)
+    path.write_text(body)
+    with pytest.raises((ValueError, yaml.YAMLError)):
+        effective.read_user_config_effective_readonly(path)
+    with pytest.raises(RuntimeError) as failure:
+        cfg.require_readable_config_before_write(path)
+    if body in ("[]", "42", "true"):
+        assert "must start with settings names" in str(failure.value)
+        assert isinstance(failure.value.__cause__, TypeError)
+    else:
+        assert "has a formatting error" in str(failure.value)
+        assert isinstance(failure.value.__cause__, yaml.YAMLError)
+    assert path.read_text() == body
+
