+def test_recursive_container_alias_keeps_legacy_refusal():
+    raw = yaml.safe_load("loop: &loop [*loop]\n")
+    with pytest.raises(RecursionError):
+        legacy_effective(raw)
+    with pytest.raises(RecursionError):
+        effective._effective(raw, isolate_raw=True)
+
