+    def retire_legacy_signins(self, *, access_token: str, password: str) -> bool:
+        """Permanently end ALL legacy sign-ins of this verified Basic account.
+
+        Returns whether it was already retired. A failed acknowledgement can follow
+        a committed write; callers must not claim failure means no durable effect.
+        Modern nonlegacy sessions and other subjects remain active.
+        """
+        payload = _unsign(access_token, self._secret, "access")
+        owned = payload is not None and payload["sub"] == self._username
+        password_ok = _verify_password(password, self._password_hash if owned else _DUMMY_HASH)
+        if not (owned and password_ok):
+            raise InvalidCredentialsError("invalid account reauthentication")
+        with self._sessions.transaction() as state:
+            # Recheck under the same lock that serializes refresh and retirement.
+            if not self._accepted(state, payload, access_token):
+                raise InvalidCredentialsError("invalid account reauthentication")
+            subject = hashlib.sha256(payload["sub"].encode("utf-8")).hexdigest()
+            if subject in state["retired_subjects"]:
+                # A previous acknowledgement may have failed after replace but
+                # before directory fsync. Reaffirm durability before success.
+                self._sessions.publish(state)
+                return True
+            state["retired_subjects"].append(subject)
+            self._sessions.publish(state)
+            return False
+
