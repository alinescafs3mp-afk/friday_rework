+class _LegacyRetirementBody(BaseModel):
+    scope: Literal["all-legacy-dashboard-signins"]
+    password: str = Field(min_length=1, max_length=4096)
+
+    class Config:
+        extra = "forbid"
+
+
+@router.post("/api/auth/legacy-retirement", name="auth_legacy_retirement")
+async def api_auth_legacy_retirement(request: Request, body: _LegacyRetirementBody):
+    """Explicit self-account legacy-only retirement, with fresh password proof.
+
+    The verified provider/account is the only target. A modern session can repeat
+    this idempotently; a legacy caller loses admission after a successful action.
+    """
+    sess = _require_session(request)
+    # A custom intent header cannot be sent by a cross-origin HTML form. Also
+    # refuse cross-origin fetches even if a deployment enables credentialed CORS.
+    if (request.headers.get("x-hermes-legacy-retirement") != "1"
+            or request.headers.get("sec-fetch-site", "") == "cross-site"):
+        raise _http(403, "Explicit same-origin retirement intent required")
+    origin = request.headers.get("origin")
+    public = _prefix_mod.resolve_public_url()
+    target = urlparse(public or str(request.url))
+    if origin is not None and origin != f"{target.scheme}://{target.netloc}":
+        raise _http(403, "Cross-origin retirement refused")
+    p = get_provider(sess.provider)
+    if (sess.provider != "basic" or p is None or p.name != "basic"
+            or not getattr(p, "supports_self_legacy_retirement", False)
+            or not callable(getattr(p, "retire_legacy_signins", None))):
+        raise _http(403, "Legacy retirement requires a Basic account")
+    if _password_rate_limited(_client_ip(request)):
+        raise _http(429, "Too many reauthentication attempts. Try again shortly.")
+    try:
+        already = await run_in_threadpool(
+            p.retire_legacy_signins, access_token=sess.access_token, password=body.password)
+    except InvalidCredentialsError:
+        raise _http(401, "Invalid account reauthentication")
+    except ProviderError:
+        # Publication may have committed before acknowledgement failed. Do not
+        # claim it did not happen or clear/replace the caller's credentials.
+        raise _http(503, "Legacy retirement not confirmed; durable outcome may already be committed")
+    return JSONResponse({"ok": True, "scope": body.scope, "provider": sess.provider,
+                         "user_id": sess.user_id, "already_retired": already}, headers=_NO_STORE)
+
