+def inference_capacity_locks(home, profile_homes, access_path, budget):
+    """Existing config-only custody; absent auth/env locks are never created."""
+    from hermes_cli.plugins_state import PluginState
+    from plugins.friday_rework.associations import Associations
+    f=api();homes=(home,*profile_homes)
+    paths=[own/'config.yaml.lock' for own in homes]+[access_path.with_name('.state.json.lock')]
+    admission=access_path.with_name('admission.lock');states={}
+    for path in paths+[admission]:
+        state=update_file_state(path)
+        f.require(state is not None and state['mode']==0o600
+            and state['data']==(b'v1\n' if path==admission else b''),
+            'ordinary_rebind_existing_private_native_lock_required')
+        states[path]=state['identity']
+    def prove():
+        for path,identity in states.items():
+            state=update_file_state(path)
+            f.require(state is not None and state['identity']==identity,
+                'ordinary_rebind_native_lock_identity_changed')
+        budget.check()
+    document=f.read_json(access_path)
+    f.require('associations.v1' in document,'ordinary_rebind_existing_associations_required')
+    with Associations(PluginState('friday_rework'))._locked(), contextlib.ExitStack() as locks:
+        for own in homes: locks.enter_context(retained_first_contact_config_lock(own/'config.yaml'))
+        prove();yield prove;prove()
