+                or self.deadline <= self.loop.time()):
+            raise ValueError('cli_output_expired_before_write')
+        await output.asyncio.sleep(0)
+        self.check()
+        if self.stop() or self.loop.time() >= self.deadline:
+            raise ValueError('cli_output_stopped_before_write')
