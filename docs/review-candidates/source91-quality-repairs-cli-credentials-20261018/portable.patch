+"""Fail-closed kernel capabilities for original CLI custody.
+
+These boundaries require numeric Linux ownership and exact pidfd SIGKILL.
+Unsupported platforms do not acquire a username-based or weaker capability.
+"""
+import os
+import signal
+import sys
+
+
+class UnsupportedPlatform(RuntimeError):
+    """The required kernel authority is unavailable before an owned effect."""
+
+
+def numeric_uid():
+    real = getattr(os, "getuid", None)
+    effective = getattr(os, "geteuid", None)
+    if sys.platform != "linux" or not callable(real) or not callable(effective):
+        raise UnsupportedPlatform("original_cli_numeric_Linux_ownership_required")
+    uid, euid = real(), effective()
+    if type(uid) is not int or type(euid) is not int or uid < 0 or uid != euid:
+        raise UnsupportedPlatform("original_cli_numeric_privilege_identity_required")
+    return uid
+
+
+def require_fcntl(module):
+    if sys.platform != "linux" or module is None:
+        raise UnsupportedPlatform("original_cli_Linux_fcntl_required")
+    return module
+
+
+def pidfd_kill_signal():
+    kill = getattr(signal, "SIGKILL", None)
+    sender = getattr(signal, "pidfd_send_signal", None)
+    opener = getattr(os, "pidfd_open", None)
+    if sys.platform != "linux" or kill is None or not callable(sender) or not callable(opener):
+        raise UnsupportedPlatform("original_cli_pidfd_SIGKILL_required")
+    return kill
