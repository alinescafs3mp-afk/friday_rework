+            from hermes_cli.friday_cli_prompt import CLEANUP_RESERVE, PromptUnsupported
+            try:
+                self.op = self.binding.reserve(self.deadline)
+                self.op.caller_task = output.asyncio.current_task()
+                self.op.caller_loop = self.loop
+                self.op.descriptor = self.lease.fd
+                self.op.descriptor_identity = self.lease.original_identity
+            except PromptUnsupported:
+                raise output.OutputRejected('unsupported_or_unavailable_native_prompt') from None
