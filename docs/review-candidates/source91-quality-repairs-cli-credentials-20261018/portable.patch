+def validated_cli_repair_chain(home, marker, request):
+    """Only witnessed additive Source35/36 repairs may extend the immutable marker."""
+    read_owned = _admission.owned_file
+    import hashlib, time, stat
+    home = _admission.Path(home)
+    def load(ref, expected=None):
+        _admission.require(type(ref) is dict and set(ref) == {'path','sha256'}
+                and (expected is None or ref['path'] == str(expected)), 'cli_runtime_chain_pin_required')
+        raw = read_owned(_admission.Path(ref['path']), private=True)
+        _admission.require(hashlib.sha256(raw).hexdigest() == ref['sha256'], 'cli_runtime_chain_pin_changed')
