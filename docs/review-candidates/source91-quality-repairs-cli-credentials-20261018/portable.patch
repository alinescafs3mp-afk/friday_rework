+            raise output.OutputRejected('unsupported_or_unavailable_original_cli_output') from None
+        self.binding = self.owner.prompt
+
+    async def emit(self, data, end, *, cleanup=False):
+        if type(data) is not bytes or len(data) > (4096 if cleanup else output.MAX_ENVELOPE):
+            raise ValueError('cli_output_owned_phase_limit')
+        offset = 0
+        while offset < len(data):
+            if not cleanup:
+                self.check()
+            self.lease.check(cleanup=cleanup)
