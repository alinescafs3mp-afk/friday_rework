+        except BaseException as exc:  # health: allow BLE001 -- A lease close interruption is retained alongside the document error and prompt cleanup; never retry a possibly reused FD.
+            self.remember_cleanup('descriptor_close', exc)
+
+    async def finish_prompt(self):
+        try:
+            if self.binding is not None and self.op is not None:
+                await self.binding.finish(self.op, self.deadline)
+        except BaseException as exc:  # health: allow BLE001 -- Original prompt completion may cancel; retain it and prevent a clean document acknowledgement without logging content.
+            self.remember_cleanup('prompt_finish', exc)
+            self.abandon_prompt()
+
+    async def cleanup(self):
+        # Each original phase is attempted once; an unexpected abandon failure
+        # still cannot prevent descriptor closure under the original deadline.
+        try:
+            await self.restore_prompt()
+        finally:
+            self.close_descriptor()
