+# Generic Russian marker for labels that carry no safe displayable residue.
+_GENERIC_FILE_LABEL = "файл"
+_SAFE_LABEL_MAX = 80
+
+
+def _safe_display_label(path) -> str:
+    """Bounded safe basename for the managed public file-mutation footer.
+
+    Both slash styles are treated as separators so Windows-style host paths
+    cannot leak through on a POSIX host; the label is cut at the first
+    control, format, or Unicode line/paragraph boundary character (ASCII
+    newlines, U+2028/U+2029, bidi/zero-width marks) so an injected
+    presentation directive can never reach the caption. An empty or
+    unusable residue never falls back to the raw path — the generic
+    Russian marker is used instead. Ordinary Unicode and space-containing
+    filenames are preserved verbatim.
+    """
+    tail = str(path or "").replace("\\", "/").rstrip("/").rsplit("/", 1)[-1]
+    safe = []
+    for ch in tail:
+        if unicodedata.category(ch) in ("Cc", "Cf", "Zl", "Zp"):
+            break
+        safe.append(ch)
+    cleaned = "".join(safe).strip()
+    if len(cleaned) > _SAFE_LABEL_MAX:
+        cleaned = cleaned[:_SAFE_LABEL_MAX].rstrip()
+    return cleaned or _GENERIC_FILE_LABEL
 
 
