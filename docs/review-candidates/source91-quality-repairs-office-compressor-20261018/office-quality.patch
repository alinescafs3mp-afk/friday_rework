+"""Strict scoped-child teardown, preserving the original owner/patch seams."""
+
+
+def scoped_cleanup(self, delegated, *, heartbeat, child_pool, leased_cred_id,
+                   close_deferred):
+    from tools import delegate_tool_child_run as owner
+    child = self.child
+    # Pin the actual original profile and existing host before deferring.
+    # A later operator context or a replacement host cannot adopt cleanup.
+    from agent import relay_runtime
+    if not hasattr(self, "_cleanup_profile_key"):
+        self._cleanup_profile_key = relay_runtime.current_profile_key()
+        self._cleanup_runtime = relay_runtime.get_runtime(
+            create=False, profile_key=self._cleanup_profile_key)
+    if close_deferred:
+        owner._stop_unconfirmed(child)
+        # Register only after the finally path owns the lease/registry teardown.
+        # The callback runs after actual worker exit; never join an unconfirmed worker.
+        owner._defer_close_after_timeout(child, self.child_future, cleanup=lambda: self.cleanup(
+            heartbeat=heartbeat, child_pool=child_pool, leased_cred_id=leased_cred_id,
+            close_deferred=False))
+        # Callback registration may run inline if the future just settled;
+        # retain a conservative outcome without overwriting confirmed cleanup.
+        raise RuntimeError("native_delegation_STOP_UNCONFIRMED")
+    try:
+        child_sid = str(getattr(child, "session_id", "") or "")
+        if relay_runtime.current_profile_key() != self._cleanup_profile_key:
+            raise owner._stop_unconfirmed(child)
+        runtime = relay_runtime.get_runtime(create=False, profile_key=self._cleanup_profile_key)
+        if self._cleanup_runtime is not None and runtime is not self._cleanup_runtime:
+            raise owner._stop_unconfirmed(child)
+        if relay_runtime.SESSION_COORDINATOR.has_active_turn(
+                profile_key=self._cleanup_profile_key, session_id=child_sid):
+            raise owner._stop_unconfirmed(child)
+    except BaseException:  # health: allow BLE001 -- Exact child cleanup faults must retain custody and return sanitized STOP_UNCONFIRMED, including cancellation.
+        raise owner._stop_unconfirmed(child) from None
+    owner._close_child(child, "Failed to close scoped child after delegation")
+    # Ancillary cleanup is also part of this boundary. Its failures must not
+    # disappear behind best-effort helpers after the live controls were removed.
+    try:
+        import model_tools
+        saved = getattr(child, "_delegate_saved_tool_names", None)
+        if isinstance(saved, list):
+            model_tools._last_resolved_tool_names = list(saved)
+        from tools.code_kernel import shutdown_kernels_for_delegated_child
+        child_sid = str(getattr(child, "session_id", "") or "")
+        shutdown_kernels_for_delegated_child(child_sid)
+        from agent import relay_runtime
+        if relay_runtime.current_profile_key() != self._cleanup_profile_key:
+            raise owner._stop_unconfirmed(child)
+        runtime = relay_runtime.get_runtime(create=False, profile_key=self._cleanup_profile_key)
+        if self._cleanup_runtime is not None and runtime is not self._cleanup_runtime:
+            raise owner._stop_unconfirmed(child)
+        if relay_runtime.SESSION_COORDINATOR.has_active_turn(
+                profile_key=self._cleanup_profile_key, session_id=child_sid):
+            raise owner._stop_unconfirmed(child)
+        if runtime is not None and child_sid:
+            # Keep its exact host if the worker created it after registration.
+            self._cleanup_runtime = runtime
+            runtime.unregister_subagent({"child_session_id": child_sid})
+        if child_pool is not None and leased_cred_id is not None:
+            child_pool.release_lease(leased_cred_id)
+    except BaseException:  # health: allow BLE001 -- Exact child cleanup faults must retain custody and return sanitized STOP_UNCONFIRMED, including cancellation.
+        raise owner._stop_unconfirmed(child) from None
+    if self.subagent_id:
+        owner._unregister_subagent(self.subagent_id, agent=child)
+    owner._detach_child(self.parent_agent, child)
+    delegated["cleanup_unconfirmed"] = False
+    pending = getattr(self, "_pending_completion", None)
+    if pending is not None:
+        self._pending_completion = None
+        owner._safe_progress(self.child_progress_cb, "subagent.complete", **pending)
+    return
+
