@@ -0,0 +1,39 @@
+"""Skill dependency readiness, preserving managed reading's no-install boundary."""
+
+
+def dependency_note(cap, content, frontmatter, readiness, readiness_extras):
+    from tools import skills_tool as owner
+    deps_note = None
+    declared_deps = frontmatter.get("deps") or []
+    if isinstance(declared_deps, str):
+        declared_deps = [declared_deps]
+    if cap is not None:
+        requirements = []
+        if declared_deps:
+            requirements.append("declared package dependencies")
+        from agent.skill_preprocessing import _INLINE_SHELL_RE
+        if _INLINE_SHELL_RE.search(content):
+            requirements.append("inline shell commands")
+        if requirements:
+            readiness.update(setup_needed=True, readiness_status=owner.SkillReadinessStatus.SETUP_NEEDED.value)
+            readiness_extras["setup_note"] = "Not executed or verified during skill reading: " + ", ".join(requirements) + ". Use the admitted Friday execution path within the original task budget."
+        cap.check()
+    elif isinstance(declared_deps, list) and declared_deps:
+        failed_deps = []
+        for dep in [str(d).strip() for d in declared_deps if str(d).strip()]:
+            try:
+                import pm
+
+                pm.ensure(dep)
+            except Exception as exc:  # health: allow BLE001 -- Optional native package activation faults become a readiness note; skill content remains available.
+                failed_deps.append(f"{dep}: {exc}")
+        if failed_deps:
+            deps_note = (
+                "Tool dependencies could not be installed — "
+                + "; ".join(failed_deps)
+                + ". Run `hermes pm install "
+                + " ".join(str(d) for d in declared_deps)
+                + "` and reload."
+            )
+
+    return deps_note
