+"""Managed skill rollback transaction; invoked inside the native write fence."""
+from pathlib import Path
+
+
+def managed_rollback(entry_id):
+    from tools import skill_ledger as owner
+    with owner._fio.transaction() as tx:
+        entry = owner.get_entry(entry_id)
+        if entry is None:
+            return False, 'No ledger entry with this id.'
+        if owner._validate_entry_paths(entry):
+            raise owner._fio.ScopeDenied()
+        before, after = entry.get('before') or [], entry.get('after') or []
+        blobs = [(Path(i['path']), owner.read_blob(i['sha256'])) for i in before]
+        if any(data is None for _, data in blobs):
+            return False, 'Missing history blob; nothing changed.'
+        touched = {i['path'] for i in before + after}
+        safety = [{'path': p, 'sha256': owner._store_blob(owner._fio.read_bytes(Path(p)))}
+                  for p in sorted(touched) if owner._fio.exists(Path(p))]
+        safety_id = owner.append_entry('pre-rollback', entry['skill'], before=safety, after=safety,
+                                 evidence={'rollback_target': entry_id})
+        if safety_id is None:
+            tx.abort = True
+            return False, 'History safety capture unavailable; nothing changed.'
+        for path, data in blobs:
+            owner._fio.write_bytes(path, data)
+        restored = {str(path) for path, _ in blobs}
+        for path in touched - restored:
+            owner._fio.remove(Path(path), missing_ok=True)
+        owner.append_entry('rollback', entry['skill'], before=safety, after=before,
+                     evidence={'rollback_target': entry_id})
+        tx.check()
+    return True, 'Restored native skill history atomically; pre-rollback safety entry ' + safety_id
