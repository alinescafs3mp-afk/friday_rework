+def _object_member_span(text: str, start: int, wanted: str):
+    """Locate a member value in already validated JSON using decoder boundaries."""
+    decoder = json.JSONDecoder()
+    position = start + 1
+    while True:
+        while text[position].isspace() or text[position] == ",":
+            position += 1
+        if text[position] == "}":
+            return None
+        key, position = decoder.raw_decode(text, position)
+        while text[position].isspace():
+            position += 1
+        position += 1  # Colon: the whole document was parsed strictly first.
+        while text[position].isspace():
+            position += 1
+        value_start = position
+        _, position = decoder.raw_decode(text, position)
+        if key == wanted:
+            return value_start, position
+
+
+def _vocabulary_key_spans(text: str, start: int):
+    decoder = json.JSONDecoder()
+    position = start + 1
+    spans = []
+    while True:
+        while text[position].isspace() or text[position] == ",":
+            position += 1
+        if text[position] == "}":
+            return spans
+        key_start = position
+        _, position = decoder.raw_decode(text, position)
+        if _TMP_TOKEN.search(text, key_start, position):
+            spans.append((key_start, position))
+        while text[position].isspace():
+            position += 1
+        position += 1
+        while text[position].isspace():
+            position += 1
+        _, position = decoder.raw_decode(text, position)
+
