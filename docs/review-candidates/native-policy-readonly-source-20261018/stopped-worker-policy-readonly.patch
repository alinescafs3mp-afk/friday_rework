--- a/hermes_cli/config_effective.py
+++ b/hermes_cli/config_effective.py
@@ -109,14 +109,25 @@
         return effective
 
 
-def read_user_config_effective_readonly(config_path: Path) -> Dict[str, Any]:
+def read_user_config_effective_readonly(
+    config_path: Path, *, allow_empty: bool = False,
+) -> Dict[str, Any]:
     """Current effective mapping without home seeding, backup or recovery writes.
 
     Diagnostics use the same expansion/managed/model normalization pipeline;
     malformed or non-mapping input refuses instead of silently showing defaults.
+    Policy readers may explicitly allow a missing or empty first-run user layer;
+    the managed overlay still applies. The default diagnostic contract is strict.
     """
-    with open(config_path, encoding="utf-8-sig") as stream:
-        raw = fast_safe_load(stream)
+    try:
+        with open(config_path, encoding="utf-8-sig") as stream:
+            raw = fast_safe_load(stream)
+    except FileNotFoundError:
+        if not allow_empty:
+            raise
+        raw = {}
+    if raw is None and allow_empty:
+        raw = {}
     if not isinstance(raw, dict):
         raise ValueError("effective_config_mapping_required")
     return _effective(raw)
