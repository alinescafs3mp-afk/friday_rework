+        if "before_bytes" in row:
+            require(len(data) == row["before_bytes"], "overlay_input_changed")
+        if "before_mode" in row:
+            require(("100755" if mode & 0o111 else "100644") == row["before_mode"],
+                    "overlay_input_mode_changed")
