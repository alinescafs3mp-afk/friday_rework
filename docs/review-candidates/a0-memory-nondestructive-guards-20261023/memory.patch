     @staticmethod
+    def _load_existing_store_metadata(abs_dir: str) -> dict[str, str] | None:
+        # Only an absent path or an empty directory is a fresh store. A ledger or
+        # any orphan companion is evidence to preserve, not permission to reset.
+        if os.path.islink(os.path.normpath(abs_dir)):
+            raise RuntimeError(f"Memory store path is a symlink: '{abs_dir}'; originals retained")
+        if not os.path.lexists(abs_dir):
+            return None
+        if not os.path.isdir(abs_dir):
+            raise RuntimeError(f"Memory store path is not a directory: '{abs_dir}'")
+        if not os.listdir(abs_dir):
+            return None
+
+        required = ("index.faiss", "index.pkl", "index.faiss.sha256", "embedding.json")
+        invalid = [
+            name for name in required
+            if os.path.islink(os.path.join(abs_dir, name))
+            or not os.path.isfile(os.path.join(abs_dir, name))
+        ]
+        if invalid:
+            raise RuntimeError(
+                f"Incomplete or linked memory store in '{abs_dir}': {', '.join(invalid)}; originals retained"
+            )
+        if not Memory._verify_index_hash(abs_dir):
+            raise RuntimeError(f"Memory index hash unavailable or invalid in '{abs_dir}'; originals retained")
+
+        with open(os.path.join(abs_dir, "embedding.json"), "r", encoding="utf-8") as f:
+            embedding_set = json.load(f)
+        if not isinstance(embedding_set, dict) or any(
+            not isinstance(embedding_set.get(key), str) or not embedding_set[key].strip()
+            for key in ("model_provider", "model_name")
+        ):
+            raise RuntimeError(f"Invalid memory embedding metadata in '{abs_dir}'; originals retained")
+        return embedding_set
+
+    @staticmethod
+    def _validate_loaded_store(index_count: int, index_to_docstore_id: dict, docs: dict) -> None:
+        # A successfully unpickled bundle can still be inconsistent. Never turn
+        # a nonempty vector index with a missing/partial docstore into an empty rebuild.
+        if (
+            not isinstance(index_to_docstore_id, dict)
+            or not isinstance(docs, dict)
+            or len(index_to_docstore_id) != index_count
+            or len(docs) != index_count
+            or set(index_to_docstore_id) != set(range(index_count))
+            or set(index_to_docstore_id.values()) != set(docs)
+        ):
+            raise RuntimeError("Inconsistent memory index/docstore bundle; originals retained")
