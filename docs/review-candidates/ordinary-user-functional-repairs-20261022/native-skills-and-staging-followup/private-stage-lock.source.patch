+@contextlib.contextmanager
+def _private_stage_lock(config_path):
+    """Create only our new private lock; never repair or adopt an existing one."""
+    from scripts import friday_install as f
+    f.directory(config_path.parent)
+    require(not os.path.lexists(config_path), 'worker_declaration_new_stage_configuration_required')
+    parent = os.open(config_path.parent, os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
+    fd = None
+    try:
+        directory = os.fstat(parent)
+        fd = os.open(config_path.name+'.lock', os.O_RDWR|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,
+            0o600, dir_fd=parent)
+        # This descriptor was just exclusively created by this function. A
+        # restrictive umask may remove owner bits; no existing file is chmodded.
+        os.fchmod(fd, 0o600)
+        initial = os.fstat(fd)
+        def prove():
+            named = os.stat(config_path.name+'.lock', dir_fd=parent, follow_symlinks=False)
+            current = os.fstat(fd); actual_parent = config_path.parent.lstat()
+            keys = ('st_dev','st_ino','st_uid','st_nlink','st_mode','st_size')
+            require(stat.S_ISREG(current.st_mode) and current.st_uid == os.getuid()
+                and current.st_nlink == 1 and current.st_size == 0
+                and stat.S_IMODE(current.st_mode) == 0o600
+                and all(getattr(named,k) == getattr(current,k) == getattr(initial,k) for k in keys)
+                and (actual_parent.st_dev,actual_parent.st_ino) == (directory.st_dev,directory.st_ino)
+                and os.pread(fd,1,0) == b'', 'worker_declaration_private_stage_lock_changed')
+        prove(); os.fsync(fd); os.fsync(parent)
+        yield prove
+        prove()
+    finally:
+        if fd is not None: os.close(fd)
+        os.close(parent)
 
 
