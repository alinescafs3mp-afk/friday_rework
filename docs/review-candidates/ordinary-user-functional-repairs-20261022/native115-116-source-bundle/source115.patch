+"""Admitted native /room ingress for the existing hosted room worker."""
+from __future__ import annotations
+
+import json
+import shlex
+import threading
+import uuid
+
+from gateway.hosted_room_consent import RoomConsentDenied
+
+_SERVICE_LOCK = threading.RLock()
+_REFUSED = "Group Chat requires current personal admission and explicit member consent."
+_HELP = (
+    "/room invite <JSON: room_id, name, members, task_id, thread_id, text, expires_at>\n"
+    "/room inspect ROOM\n/room join ROOM TASK CONSENT_ID\n/room start ROOM TASK\n"
+    "/room log ROOM\n/room stop ROOM\n/room revoke ROOM\n"
+    "/room pending ROOM MEMBER\n"
+    "/room approve ROOM MEMBER TASK GENERATION REQUEST once|deny"
+)
+
+
+def get_native_room_service(runner):
+    """One existing service/worker per native gateway; no dashboard/CLI authority."""
+    from tui_gateway.hosted_room_service import HostedRoomService
+    with _SERVICE_LOCK:
+        service = getattr(runner, "_native_hosted_room_service", None)
+        if service is None:
+            service = HostedRoomService(None)
+            runner._native_hosted_room_service = service
+        service.start()
+        return service
+
+
+def stop_native_room_service(runner, *, timeout=5.0):
+    with _SERVICE_LOCK:
+        service = getattr(runner, "_native_hosted_room_service", None)
+    return True if service is None else service.stop(timeout=timeout)
+
+
+async def dispatch_native_room(runner, event, source, *, is_internal=False):
+    """Called only after GatewayInboundMixin._hm_admit_event and its pause gate.
+
+    The original SessionSource already owns the UserScope minted by the real
+    native/product authorization intersection. JSON carries only coordination.
+    """
+    text = getattr(event, "text", "")
+    if not isinstance(text, str) or text.split(maxsplit=1)[0:1] != ["/room"]:
+        return False, None
+    if is_internal or getattr(event, "internal", False):
+        return True, _REFUSED
+    from hermes_cli.friday_user_scope import slash_allowed
+    if not slash_allowed(source, "room"):
+        return True, _REFUSED
+    denied = runner._check_slash_access(source, "room")
+    if denied:
+        return True, denied
+    try:
+        # Recheck the actual native admission before retaining authority. A
+        # mutable source/capability attached after admission is not a grant.
+        if not runner._is_user_authorized_for_source(source):
+            raise RoomConsentDenied()
+        from gateway.hosted_room_consent import RoomConsentRegistry
+        RoomConsentRegistry._admitted(source)
+        service = get_native_room_service(runner)
+        registry = service.consent
+        pieces = text.split(maxsplit=2)
+        if len(pieces) < 2 or pieces[1] == "help":
+            return True, _HELP
+        command = pieces[1]
+        raw = pieces[2] if len(pieces) == 3 else ""
+        if command == "invite":
+            value = json.loads(raw)
+            if not isinstance(value, dict) or set(value) != {
+                    "room_id", "name", "members", "task_id", "thread_id", "text", "expires_at"}:
+                raise RoomConsentDenied()
+            # Validate genuine source BEFORE any coordination writes.
+            registry._admitted(source)
+            room = service.create_room(room_id=value["room_id"], name=value["name"], members=value["members"])
+            # Reusing a durable event id never authorizes replay of its effects.
+            if any(e.get("event_id") == value["task_id"] for e in service._events(value["room_id"])):
+                raise RoomConsentDenied()
+            result = registry.open(room, source, task_id=value["task_id"], thread_id=value["thread_id"],
+                text=value["text"], expires_at=value["expires_at"])
+        else:
+            args = shlex.split(raw)
+            if not args:
+                return True, _HELP
+            room = service._room(args[0])
+            if command == "inspect" and len(args) == 1:
+                result = registry.describe(room, source, invitation=True)
+            elif command == "join" and len(args) == 3:
+                result = registry.accept(room, source, args[1], args[2])
+            elif command == "start" and len(args) == 2:
+                registry.validate_start(room, source, args[1])
+                if next(iter(service._list_tasks(args[0],
+                        ("queued", "running", "stopping", "indeterminate", "deferred"))), None) is not None:
+                    # Fresh admission never retries a consumed or unknown old
+                    # effect. The existing exact cancellation path must prove
+                    # acknowledged cleanup before admitting this NEW event.
+                    service.stop_room(args[0], cancel_id=f"readmission:{uuid.uuid4().hex}",
+                                      require_acknowledged=True)
+                payload = registry.start(room, source, args[1])
+                result = service.send(room_id=args[0], event_id=args[1], payload=payload,
+                                      native_consent_event=True)
+            elif command == "log" and len(args) == 1:
+                result = registry.shared_events(room, source, service._events(args[0]))
+            elif command == "stop" and len(args) == 1:
+                registry.stop(room, source)
+                result = {"stopped": service.stop_room(args[0], cancel_id=f"native:{uuid.uuid4().hex}")}
+            elif command == "revoke" and len(args) == 1:
+                member_id = registry.revoke(room, source)
+                # Losing any required frozen member invalidates this shared task;
+                # use the existing cancellation path to stop pending room turns.
+                result = {"revoked_member": member_id,
+                    "stopped": service.stop_room(args[0], cancel_id=f"member-revoke:{uuid.uuid4().hex}")}
+            elif command == "pending" and len(args) == 2:
+                registry.own_member(room, source, args[1])
+                result = service.native_rpc.pending(room_id=args[0], member_id=args[1], source=source)
+            elif command == "approve" and len(args) == 6:
+                registry.own_member(room, source, args[1])
+                result = service.approve_room_task(args[0], member_id=args[1], task_id=args[2],
+                    execution_generation=int(args[3]), request_id=args[4], choice=args[5],
+                    native_source=source)
+            else:
+                return True, _HELP
+        return True, json.dumps(result, ensure_ascii=False, sort_keys=True, default=str)
+    except (RoomConsentDenied, PermissionError, RuntimeError, OSError):
+        return True, _REFUSED
+    except (ValueError, TypeError, KeyError):
+        return True, _HELP
