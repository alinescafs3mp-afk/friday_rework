+"""Process-local explicit native member admission for one shared room task.
+
+Durable room rows describe coordination only. No value from those rows can recreate
+the original authenticated UserScope retained here. Restart deliberately empties
+this registry; historical shared room messages remain in the existing room store.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+import math
+import threading
+import time
+import uuid
+
+
+class RoomConsentDenied(PermissionError):
+    def __init__(self):
+        super().__init__("room_member_readmission_required")
+
+
+def _text(value):
+    if not isinstance(value, str) or not value or len(value) > 256:
+        raise RoomConsentDenied()
+    return value
+
+
+def _room_key(room):
+    try:
+        if room.get("disbanded_at") is not None:
+            raise RoomConsentDenied()
+        epoch = room["authority_epoch"]
+        if type(epoch) is not int or epoch < 1:
+            raise RoomConsentDenied()
+        return (_text(room["room_id"]), _text(room["authority_gateway_id"]), epoch)
+    except (KeyError, TypeError, ValueError):
+        raise RoomConsentDenied() from None
+
+
+def _roster(room):
+    try:
+        members = room["members"]
+        if not isinstance(members, list) or not 2 <= len(members) <= 6:
+            raise RoomConsentDenied()
+        rows = []
+        for member in members:
+            target = member.get("target") or {"kind": "local", "profile": member["profile"]}
+            if target != {"kind": "local", "profile": member["profile"]}:
+                raise RoomConsentDenied()  # peer topology remains on its existing path
+            rows.append((_text(member["member_id"]), _text(member["profile"])))
+        if len(set(x[0] for x in rows)) != len(rows) or len(set(x[1] for x in rows)) != len(rows):
+            raise RoomConsentDenied()
+        return tuple(rows)
+    except (KeyError, TypeError, ValueError):
+        raise RoomConsentDenied() from None
+
+
+@dataclass
+class _Member:
+    source: object
+    capability: object
+    principal: tuple
+    admission_generation: int
+    identity: object
+    session_id: str | None = None
+
+
+@dataclass
+class _Consent:
+    key: tuple
+    roster: tuple
+    requester: _Member
+    task_id: str
+    thread_id: str
+    text: str
+    expires_at: float
+    cancel_generation: int
+    consent_id: str
+    members: dict = field(default_factory=dict)
+    source_event_seq: int | None = None
+    started: bool = False
+    revoked: bool = False
+    turns: dict = field(default_factory=dict)
+
+
+class RoomConsentRegistry:
+    """One service-owned authority registry; all grants die with the process."""
+
+    def __init__(self, *, clock=time.time):
+        self.clock, self._lock, self._rooms = clock, threading.RLock(), {}
+        self._used_tasks = set()
+        self._cleanup_entries = {}
+
+    @staticmethod
+    def _admitted(source):
+        from gateway.session_identity import identity_of
+        from hermes_cli.friday_user_scope import UserScope, authority, scoped_source
+        cap = getattr(source, "_friday_user_scope", None)
+        identity = identity_of(source)
+        # Live native provenance is required. Restored SessionSource/JSON objects
+        # may coordinate messages but cannot supply a fresh member opt-in.
+        if (not isinstance(cap, UserScope) or identity is None
+                or identity.adapter() is None or identity.transport_inferred
+                or not identity.multiplexed):
+            raise RoomConsentDenied()
+        with authority(cap.home), scoped_source(source) as current:
+            if current is not cap:
+                raise RoomConsentDenied()
+            cap.check()
+        return _Member(source, cap, tuple(cap.principal), cap.admission_generation, identity)
+
+    def _check_member(self, member):
+        from gateway.session_identity import identity_of
+        from hermes_cli.friday_user_scope import authority
+        cap, source = member.capability, member.source
+        identity = identity_of(source)
+        if (getattr(source, "_friday_user_scope", None) is not cap
+                or identity is not member.identity or identity.adapter() is None
+                or tuple(cap.principal) != member.principal
+                or cap.admission_generation != member.admission_generation
+                or source.platform.value != cap.principal[0] or source.user_id != cap.principal[3]
+                or source.profile not in (None, "", cap.profile)
+                or identity.runtime_profile != cap.profile or identity.runtime_home != cap.home
+                or identity.authorization_home != cap.authorization_home
+                or identity.transport_profile != cap.principal[1]):
+            raise RoomConsentDenied()
+        # Rechecking another retained member must never replace the ambient
+        # principal. Only member_scope enters that member's original context.
+        with authority(cap.home):
+            cap.check()
+        return cap
+
+    def _entry(self, room, *, historical=False):
+        entry = self._rooms.get(_room_key(room)[0])
+        if (entry is None or entry.key != _room_key(room) or entry.roster != _roster(room)
+                or not historical and (entry.revoked or self.clock() >= entry.expires_at)):
+            raise RoomConsentDenied()
+        return entry
+
+    def _get(self, room, *, all_members=False):
+        entry = self._entry(room)
+        self._check_member(entry.requester)
+        if all_members and set(entry.members) != {m for m, _p in entry.roster}:
+            raise RoomConsentDenied()
+        for member in entry.members.values():
+            self._check_member(member)
+        return entry
+
+    def open(self, room, source, *, task_id, thread_id, text, expires_at, cancel_generation=0):
+        requester, key, roster = self._admitted(source), _room_key(room), _roster(room)
+        if requester.capability.profile not in {p for _m, p in roster}:
+            raise RoomConsentDenied()
+        if (not isinstance(text, str) or not text.strip() or len(text.encode()) > 65536
+                or type(expires_at) not in (float, int) or not math.isfinite(expires_at)
+                or not self.clock() < expires_at <= self.clock() + 3600
+                or type(cancel_generation) is not int or cancel_generation != 0):
+            raise RoomConsentDenied()
+        with self._lock:
+            previous = self._rooms.get(key[0])
+            if ((key[0], task_id) in self._used_tasks
+                    or previous is not None and not previous.revoked):
+                raise RoomConsentDenied()  # stop the old task before replacing its authority
+            self._rooms[key[0]] = _Consent(key, roster, requester, _text(task_id),
+                _text(thread_id), text, float(expires_at), cancel_generation, uuid.uuid4().hex)
+            self._used_tasks.add((key[0], task_id))
+        return self.describe(room, source, invitation=True)
+
+    def describe(self, room, source, *, invitation=False):
+        member = self._admitted(source)
+        with self._lock:
+            entry = self._get(room)
+            if member.capability.profile not in {p for _m, p in entry.roster}:
+                raise RoomConsentDenied()
+            if not invitation:
+                self._read_access(entry, member)
+            return {"room_id": entry.key[0], "gateway_id": entry.key[1],
+                "authority_epoch": entry.key[2], "requester": list(entry.requester.principal),
+                "task_id": entry.task_id, "thread_id": entry.thread_id,
+                "consent_id": entry.consent_id,
+                "shared_task": entry.text, "expires_at": entry.expires_at,
+                "cancel_generation": entry.cancel_generation,
+                "members": [{"member_id": m, "profile": p, "accepted": m in entry.members}
+                            for m, p in entry.roster],
+                "shared": "Only room messages and this shared task's outputs. Private history, memory, config and credentials remain private.",
+                "approval": "Each affected member approves its own exact current effect."}
+
+    def accept(self, room, source, task_id, consent_id):
+        member = self._admitted(source)
+        with self._lock:
+            entry = self._get(room)
+            matches = [m for m, p in entry.roster if p == member.capability.profile]
+            if (entry.started or task_id != entry.task_id or consent_id != entry.consent_id
+                    or len(matches) != 1):
+                raise RoomConsentDenied()
+            old = entry.members.get(matches[0])
+            if old is not None and old.principal != member.principal:
+                raise RoomConsentDenied()
+            entry.members[matches[0]] = member
+        return self.describe(room, source)
+
+    def _read_access(self, entry, member):
+        if (member.principal != entry.requester.principal and not any(
+                m.principal == member.principal for m in entry.members.values())):
+            raise RoomConsentDenied()
+
+    def requester(self, room, source):
+        member = self._admitted(source)
+        with self._lock:
+            entry = self._entry(room, historical=True)
+            if member.principal != entry.requester.principal:
+                raise RoomConsentDenied()
+            return entry
+
+    def own_member(self, room, source, member_id):
+        incoming = self._admitted(source)
+        with self._lock:
+            entry = self._get(room, all_members=True)
+            member = entry.members.get(member_id)
+            if member is None or incoming.principal != member.principal:
+                raise RoomConsentDenied()
+            return member
+
+    def validate_start(self, room, source, task_id):
+        """Reject wrong/replayed starts before the producer performs cleanup."""
+        with self._lock:
+            entry = self.requester(room, source)
+            self._get(room, all_members=True)
+            if entry.started or task_id != entry.task_id:
+                raise RoomConsentDenied()
+            return entry
+
+    def start(self, room, source, task_id):
+        with self._lock:
+            entry = self.validate_start(room, source, task_id)
+            entry.started = True  # never repeat send after an uncertain result
+            return {"text": entry.text, "thread_id": entry.thread_id}
+
+    def bind_event(self, room, *, event_id, source_event_seq):
+        with self._lock:
+            entry = self._get(room, all_members=True)
+            if (not entry.started or entry.task_id != event_id or entry.source_event_seq is not None
+                    or type(source_event_seq) is not int or source_event_seq < 1):
+                raise RoomConsentDenied()
+            entry.source_event_seq = source_event_seq
+
+    def revoke(self, room, source):
+        member = self._admitted(source)
+        with self._lock:
+            entry = self._entry(room, historical=True)
+            owned = [m for m, p in entry.roster if p == member.capability.profile
+                     and m in entry.members and entry.members[m].principal == member.principal]
+            if len(owned) != 1:
+                raise RoomConsentDenied()
+            entry.revoked = True
+            return owned[0]
+
+    def stop(self, room, source):
+        with self._lock:
+            entry = self.requester(room, source)
+            if entry.revoked:
+                return
+            entry.revoked = True
+            entry.cancel_generation += 1
+
+    def require_all(self, room):
+        with self._lock:
+            return self._get(room, all_members=True)
+
+    @contextmanager
+    def member_scope(self, room, member_id, profile, *, task=None, session_id=None, operation="execute"):
+        """Bind one exact room/task/turn/session attempt to its ORIGINAL member.
+
+        A retry after a consumed/cancelled generation requires a fresh invitation;
+        this first version never transfers an old opt-in to a different attempt.
+        """
+        from hermes_cli.friday_user_scope import authority, scoped_source
+        if operation == "interrupt":
+            raise RoomConsentDenied()  # cleanup has its separate, authority-free scope
+        with self._lock:
+            entry = self._get(room, all_members=True)
+            if (member_id, profile) not in entry.roster:
+                raise RoomConsentDenied()
+            member = entry.members[member_id]
+            if not entry.started or entry.source_event_seq is None:
+                raise RoomConsentDenied()
+            if task is not None:
+                identity, payload = task["identity"], task["payload"]
+                if (identity.room_id != entry.key[0] or identity.thread_id != entry.thread_id
+                        or payload.get("source_event_seq") != entry.source_event_seq
+                        or payload.get("target_profile") != profile
+                        or payload.get("target_member_id", profile) != member_id
+                        or task.get("cancel_generation") != entry.cancel_generation
+                        or type(task.get("execution_generation")) is not int
+                        or task.get("execution_generation") not in (0, 1)):
+                    raise RoomConsentDenied()
+                # Stable deterministic turn identity, independently checked against
+                # room policy and the durable running generation by the backend.
+                proof = (identity.thread_id, identity.turn_id, member_id, profile,
+                         int(task.get("execution_generation") or 1), entry.cancel_generation)
+                previous = entry.turns.get(identity.task_id)
+                if previous is None:
+                    entry.turns[identity.task_id] = proof
+                    self._cleanup_entries[(entry.key[0], identity.task_id)] = entry
+                elif previous != proof:
+                    raise RoomConsentDenied()
+            if session_id is not None:
+                session_id = _text(session_id)
+                if member.session_id not in (None, session_id):
+                    raise RoomConsentDenied()
+                member.session_id = session_id
+            cap = self._check_member(member)
+        with authority(cap.home), scoped_source(member.source) as current:
+            if current is not cap:
+                raise RoomConsentDenied()
+            yield cap
+
+    @contextmanager
+    def interruption_scope(self, room, member_id, profile, *, task, session_id):
+        """Cleanup ONLY for an already bound original task/turn/session handle.
+
+        Does not enter UserScope, runtime-home or credential context, check a
+        database, mint a grant, or yield a capability. The caller may only stop
+        its exact existing active record; loss of product admission cannot
+        prevent that cleanup. Every fresh effect uses member_scope instead.
+        """
+        from gateway.session_identity import identity_of
+        with self._lock:
+            key = _room_key(room)
+            entry = self._cleanup_entries.get((key[0], task["identity"].task_id))
+            if entry is None or entry.key != key or entry.roster != _roster(room):
+                raise RoomConsentDenied()
+            member = entry.members.get(member_id)
+            if (member is None or (member_id, profile) not in entry.roster
+                    or not entry.started or member.session_id != session_id):
+                raise RoomConsentDenied()
+            cap = member.capability
+            identity, payload = task["identity"], task["payload"]
+            original = member.identity
+            proof = entry.turns.get(identity.task_id)
+            expected = (identity.thread_id, identity.turn_id, member_id, profile,
+                        task.get("execution_generation"))
+            if (getattr(member.source, "_friday_user_scope", None) is not cap
+                    or identity_of(member.source) is not original
+                    or cap.principal != member.principal or cap.profile != profile
+                    or cap.home != original.runtime_home
+                    or cap.authorization_home != original.authorization_home
+                    or cap.admission_generation != member.admission_generation
+                    or identity.room_id != entry.key[0] or identity.thread_id != entry.thread_id
+                    or payload.get("source_event_seq") != entry.source_event_seq
+                    or payload.get("target_profile") != profile
+                    or payload.get("target_member_id", profile) != member_id
+                    or task.get("cancel_generation") not in (0, 1)
+                    or proof is None or proof[:5] != expected
+                    or task.get("status") not in ("running", "stopping", "indeterminate")):
+                raise RoomConsentDenied()
+        yield
+
+    def shared_events(self, room, source, events):
+        member = self._admitted(source)
+        with self._lock:
+            entry = self._entry(room, historical=True)
+            self._read_access(entry, member)
+            # Only explicit shared transcript events. Never call session.history
+            # or a member's private store to serve this room view.
+            return [{k: event[k] for k in ("seq", "event_id", "kind", "actor", "payload") if k in event}
+                    for event in events if event.get("room_id") == entry.key[0]
+                    and event.get("kind") in {"message.user", "message.member", "turn.settled",
+                        "turn.failed", "turn.cancelled", "turn.deferred", "room.activity"}]
