+            raise Refused('Reconciliation requires both existing pinned exclusive locks')
+        run, cursor, key = self.unknown_reconciliation_context(plan, consumer_fd, credential_fd)
+        parent = secure_dir(self.store.root / 'reconciliations')
+        action = parent / key
+        action.mkdir(mode=0o700)  # Intent/crash/failed authentication consumes this dispatch once.
+        for directory in (self.store.root, parent):
+            fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+            try:
+                os.fsync(fd)
+            finally:
+                os.close(fd)
+        common = dict(action_id=plan['action_id'], predecessor_run_id=run['id'],
+                      original_send_outcome='UNKNOWN', original_operation_replayed=False,
+                      original_run_mutated=False, cursor_mutated=False, outbound_sent=False,
+                      acceptance='NOT_ESTABLISHED', product_runtime_binding_verified=False,
+                      response_binding='UNBOUND', original_observation_window='NOT_COMMITTED_NO_ACK')
+        self.store.put(action / 'INTENT.json', dict(plan=plan, plan_sha256=plan_sha256,
+                       status='ADMITTED_ONCE_NO_RETRY', at=stamp(), **common))
