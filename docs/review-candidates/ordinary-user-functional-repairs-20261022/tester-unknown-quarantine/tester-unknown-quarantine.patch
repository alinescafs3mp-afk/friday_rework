+        try:
+            preflight(self.api, timeout=self.recovery_guard(plan), guard=lambda: self.recovery_guard(plan))
+            self.unknown_reconciliation_context(plan, consumer_fd, credential_fd)
+            # This offset acknowledges no newly received update: no cursor change or
+            # second getUpdates is permitted. Shared pending updates remain available.
+            params = dict(offset=cursor['offset'], timeout=0, limit=plan['max_updates'], allowed_updates=['message'])
+            self.store.put(action / 'DISPATCH.json', dict(method='getUpdates', params=params,
+                           at=stamp(), no_new_update_acknowledged=True))
+            self.api._last_response = None
+            phase = 'receive'
+            updates = self.api.call('getUpdates', params, timeout=self.recovery_guard(plan))
+            raw = getattr(self.api, '_last_response', None)
+            if not isinstance(raw, bytes) or not 1 <= len(raw) <= MAX_JSON:
+                raise Refused('Reconciliation lacks exact bounded HTTP response custody')
+            self.store.write(action / 'response.private.json', raw)
