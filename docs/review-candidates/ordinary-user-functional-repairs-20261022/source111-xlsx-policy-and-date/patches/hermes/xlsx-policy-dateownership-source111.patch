+def valid_date_ownership(session_id: Any, prompt: Any, ownership: Any) -> Optional[Dict[str, Any]]:
+    """Structural validation for persistence: the sidecar must be bound to THIS
+    session and THESE exact bytes (span in bounds, both content hashes matching).
+    Anything else returns None — persistence never mints ownership from text."""
+    if not isinstance(ownership, dict) or ownership.get("schema") != DATE_OWNERSHIP_SCHEMA:
+        return None
+    if not isinstance(prompt, str) or not prompt or ownership.get("session_id") != session_id:
+        return None
+    span = ownership.get("span")
+    if not (isinstance(span, (list, tuple)) and len(span) == 2
+            and all(isinstance(i, int) and not isinstance(i, bool) for i in span)):
+        return None
+    start, end = span
+    if not (0 <= start < end <= len(prompt)):
+        return None
+    if hashlib.sha256(prompt.encode("utf-8")).hexdigest() != ownership.get("prompt_sha256"):
+        return None
+    if hashlib.sha256(prompt[start:end].encode("utf-8")).hexdigest() != ownership.get("owned_sha256"):
+        return None
+    if not all(isinstance(ownership.get(k), str) and ownership[k] for k in ("start_day", "owned_day")):
+        return None
+    root = ownership.get("root_id")
+    return {"schema": DATE_OWNERSHIP_SCHEMA, "session_id": session_id,
+            "root_id": root if isinstance(root, str) and root else None,
+            "start_day": ownership["start_day"], "owned_day": ownership["owned_day"],
+            "span": [start, end], "owned_sha256": ownership["owned_sha256"],
+            "prompt_sha256": ownership["prompt_sha256"]}
+
