+    try:
+        config = json.loads(raw) if isinstance(raw, str) and raw else (raw if isinstance(raw, dict) else {})
+    except ValueError:
+        return None
+    record = config.get(DATE_OWNERSHIP_FIELD) if isinstance(config, dict) else None
+    return record if isinstance(record, dict) and record.get("schema") == DATE_OWNERSHIP_SCHEMA else None
+
