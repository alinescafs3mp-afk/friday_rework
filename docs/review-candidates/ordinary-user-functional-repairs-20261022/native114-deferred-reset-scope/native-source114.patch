diff --git a/gateway/slash_confirm_scope.py b/gateway/slash_confirm_scope.py
new file mode 100644
--- /dev/null
+++ b/gateway/slash_confirm_scope.py
@@ -0,0 +1,122 @@
+"""Retain admitted destructive-command authority across the confirmation gap."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+import time
+
+from gateway.session_identity import identity_of
+from hermes_cli.friday_user_scope import ScopeDenied, current, policy, _same_scope
+
+
+_active_authority = ContextVar("destructive_confirmation_authority", default=None)
+
+
+def revalidate_destructive_authority():
+    """Recheck after native custody yields, before invalidating or closing a run."""
+    current()
+    active = _active_authority.get()
+    if active is not None:
+        retained, fresh, capability = active
+        retained.check_target()
+        if fresh is not None:
+            retained.check_confirmation(fresh, capability)
+
+
+def _source_key(source):
+    return tuple(getattr(source, name, None) for name in (
+        'platform', 'user_id', 'chat_id', 'chat_type', 'thread_id', 'scope_id', 'profile',
+        'user_id_alt', 'chat_id_alt', 'is_bot', 'role_authorized', 'delivered_via_upstream_relay'))
+
+
+def _session_id(runner, key):
+    entry = runner.session_store._entries.get(key)
+    return getattr(entry, 'session_id', None)
+
+
+@dataclass(frozen=True)
+class DestructiveAuthority:
+    runner: object
+    event: object
+    command: str
+    source: object
+    capability: object
+    identity: object
+    source_key: tuple
+    request: tuple
+    session_key: str
+    session_id: str
+    run_generation: int
+    created: float
+
+    def check_target(self):
+        from tools.slash_confirm import DEFAULT_TIMEOUT_SECONDS
+        if (self.event.source is not self.source
+                or _source_key(self.source) != self.source_key
+                or identity_of(self.source) is not self.identity
+                or getattr(self.source, '_friday_user_scope', None) is not self.capability
+                or (self.event.text, self.event.message_id) != self.request
+                or self.runner._session_key_for_source(self.source) != self.session_key
+                or _session_id(self.runner, self.session_key) != self.session_id
+                or self.runner._current_session_run_generation(self.session_key) != self.run_generation
+                or time.monotonic() - self.created > DEFAULT_TIMEOUT_SECONDS):
+            raise ScopeDenied()
+        with self.runner._profile_scope_for_source(self.source):
+            if (current(required=True) is not self.capability
+                    or not self.runner._is_user_authorized_for_source(self.source)
+                    or self.runner._check_slash_access(self.source, self.command) is not None):
+                raise ScopeDenied()
+
+    def check_confirmation(self, fresh, expected_capability=None):
+        if (fresh is None or _source_key(fresh) != self.source_key
+                or identity_of(fresh) != self.identity
+                or (expected_capability is not None
+                    and getattr(fresh, '_friday_user_scope', None) is not expected_capability)
+                or not self.runner._is_user_authorized_for_source(fresh)):
+            raise ScopeDenied()
+        with self.runner._profile_scope_for_source(fresh):
+            cap = current(required=True)
+            if (not _same_scope(cap, self.capability)
+                    or self.runner._session_key_for_source(fresh) != self.session_key
+                    or self.runner._check_slash_access(fresh, self.command) is not None):
+                raise ScopeDenied()
+            return cap
+
+    @contextmanager
+    def scope(self, *, deferred=False):
+        """Revalidate before config writes, custody, agent close or session reset."""
+        from tools.slash_confirm import confirmation_source
+        self.check_target()
+        fresh = confirmation_source() if deferred else None
+        fresh_cap = self.check_confirmation(fresh) if deferred else None
+        # Both _CURRENT and _SOURCE are restored by the native scope. asyncio's
+        # to_thread copies this context, including the genuine capability.
+        with self.runner._profile_scope_for_source(self.source):
+            token = _active_authority.set((self, fresh, fresh_cap))
+            try:
+                yield
+            finally:
+                _active_authority.reset(token)
+
+
+def capture_destructive_authority(runner, event, command):
+    """Capture only an already admitted in-memory source, never serialized origin."""
+    source = event.source
+    identity = identity_of(source)
+    from hermes_constants import get_hermes_home
+    home = identity.authorization_home if identity is not None else get_hermes_home()
+    if policy(home) is None:
+        if getattr(source, '_friday_user_scope', None) is not None:
+            raise ScopeDenied()
+        return None
+    cap = getattr(source, '_friday_user_scope', None)
+    if cap is None or identity is None:
+        raise ScopeDenied()
+    with runner._profile_scope_for_source(source):
+        if (current(required=True) is not cap
+                or not runner._is_user_authorized_for_source(source)
+                or runner._check_slash_access(source, command) is not None):
+            raise ScopeDenied()
+        key = runner._session_key_for_source(source)
+        return DestructiveAuthority(runner, event, command, source, cap, identity,
+            _source_key(source), (event.text, event.message_id), key, _session_id(runner, key),
+            runner._current_session_run_generation(key), time.monotonic())
