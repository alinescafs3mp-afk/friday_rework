+"""Real Unix listener/probe coverage for long-home loop tick rendezvous and custody."""
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import json
+import os
+import shutil
+import socket
+import stat
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+import gateway.shutdown_watchdog as wd
+import hermes_cli.gateway as cli
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+@pytest.fixture
+def socket_homes():
+    root = Path(tempfile.mkdtemp(prefix="tick-fix-", dir="/tmp"))
+    homes = [root / ("a" * 90), root / ("д" * 60)]
+    parents = set()
+    for home in homes:
+        home.mkdir()
+        parents.add(wd.get_loop_tick_socket_path(home).parent)
+    try:
+        yield root, homes
+    finally:
+        for directory in parents:
+            if directory.is_symlink():
+                directory.unlink()
+            elif directory.exists():
+                shutil.rmtree(directory)
+        shutil.rmtree(root)
+
+
+def bind_node(path, *, listening=False):
+    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    server.bind(str(path))
+    path.chmod(0o600)
+    if listening:
+        server.listen(8)
+    return server
+
+
+async def wait_payload(home):
+    for _ in range(100):
+        try:
+            return json.loads(wd.get_loop_heartbeat_path(home).read_text())
+        except (OSError, json.JSONDecodeError):
+            await asyncio.sleep(0.02)
+    pytest.fail("producer did not publish heartbeat")
+
+
+@pytest.mark.parametrize("index", [0, 1], ids=["ascii", "multibyte"])
+@pytest.mark.asyncio
+async def test_long_home_real_producer_and_product_probe(socket_homes, index):
+    _, homes = socket_homes
+    home = homes[index]
+    direct = home / "state" / f"gateway.loop-tick.{os.getpid()}.sock"
+    direct.parent.mkdir()
+    # The original producer's actual bind fails for this fixture, including multibyte homes.
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as old:
+        with pytest.raises(OSError, match="path too long"):
+            old.bind(str(direct))
+    path = wd.get_loop_tick_socket_path(home)
+    assert len(os.fsencode(path)) <= 100 < 108
+    assert not path.parent.exists()  # resolving a probe address never creates it
+    task = asyncio.create_task(wd.loop_heartbeat_forever(home=home))
+    try:
+        payload = await wait_payload(home)
+        assert payload["loop_tick_socket"] is True
+        assert payload["loop_tick_tcp_port"] is None
+        assert stat.S_IMODE(path.parent.stat().st_mode) == 0o700
+        assert stat.S_IMODE(path.stat().st_mode) == 0o600
+        assert await asyncio.to_thread(cli._probe_loop_tick_socket, os.getpid(), home, 1) is True
+        assert cli._probe_loop_tick_socket(os.getpid() + 1, home, 0.01) is None
+        assert cli._probe_loop_tick_socket(os.getpid(), homes[1 - index], 0.01) is None
+    finally:
+        task.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await task
+    assert not path.exists()
+    assert path.parent.is_dir()  # another PID may still own a socket in this namespace
+
+
+def test_path_identity_compatibility_and_environment_independence(socket_homes, monkeypatch):
+    root, homes = socket_homes
+    short = root / "s"
+    assert wd.get_loop_tick_socket_path(short, 123) == short / "state/gateway.loop-tick.123.sock"
+    path = wd.get_loop_tick_socket_path(homes[0], 123)
+    monkeypatch.setenv("TMPDIR", str(root / "unrelated"))
+    assert wd.get_loop_tick_socket_path(homes[0], 123) == path
+    assert wd.get_loop_tick_socket_path(homes[0], 124) != path
+    assert wd.get_loop_tick_socket_path(homes[1], 123) != path
+    for pid in (0, -1):
+        with pytest.raises(ValueError):
+            wd.get_loop_tick_socket_path(homes[0], pid)
+
+
+@pytest.mark.parametrize("unsafe", ["symlink", "writable", "foreign"])
+@pytest.mark.asyncio
+async def test_unsafe_namespace_refused_by_producer_and_probe(socket_homes, monkeypatch, unsafe):
+    root, homes = socket_homes
+    home = homes[0]
+    path = wd.get_loop_tick_socket_path(home)
+    if unsafe == "symlink":
+        target = root / "foreign-target"
+        target.mkdir(mode=0o700)
+        path.parent.symlink_to(target, target_is_directory=True)
+    else:
+        path.parent.mkdir(mode=0o700)
+        if unsafe == "writable":
+            path.parent.chmod(0o777)
+        else:
+            original = Path.lstat
+            def foreign_lstat(p, *args, **kwargs):
+                info = original(p, *args, **kwargs)
+                return (SimpleNamespace(st_mode=info.st_mode, st_uid=info.st_uid + 1)
+                        if p == path.parent else info)
+            monkeypatch.setattr(Path, "lstat", foreign_lstat)
+    assert cli._probe_loop_tick_socket(os.getpid(), home, 0.01) is None
+    task = asyncio.create_task(wd.loop_heartbeat_forever(home=home, should_continue=lambda: False))
+    await task
+    assert (await wait_payload(home))["loop_tick_socket"] is False
+    assert not path.exists()
+    assert path.parent.lstat()  # refusal did not unlink or chmod the namespace
+
+
+def test_stale_sweep_preserves_live_foreign_symlink_and_non_socket(socket_homes, monkeypatch):
+    _, homes = socket_homes
+    own = wd.get_loop_tick_socket_path(homes[0])
+    own.parent.mkdir(mode=0o700)
+    live = own.with_name(f"gateway.loop-tick.{os.getpid()}.sock")
+    dead = own.with_name("gateway.loop-tick.123456789.sock")
+    denied = own.with_name("gateway.loop-tick.123456788.sock")
+    foreign = own.with_name("gateway.loop-tick.123456787.sock")
+    regular = own.with_name("gateway.loop-tick.123456786.sock")
+    link = own.with_name("gateway.loop-tick.123456785.sock")
+    malformed = own.with_name("gateway.loop-tick.-1.sock")
+    for path in (live, dead, denied, foreign, malformed):
+        bind_node(path).close()
+    regular.write_text("keep")
+    link.symlink_to(dead)
+    original_lstat = Path.lstat
+    def foreign_lstat(p, *args, **kwargs):
+        info = original_lstat(p, *args, **kwargs)
+        return (SimpleNamespace(st_mode=info.st_mode, st_uid=info.st_uid + 1)
+                if p == foreign else info)
+    monkeypatch.setattr(Path, "lstat", foreign_lstat)
+    calls = []
+    def kill(pid, sig):
+        calls.append((pid, sig))
+        if pid == 123456789:
+            raise ProcessLookupError()
+        if pid == 123456788:
+            raise PermissionError()
+    monkeypatch.setattr(wd.os, "kill", kill)
+    wd._sweep_stale_tick_sockets(own.with_name("gateway.loop-tick.123456784.sock"))
+    assert not dead.exists()
+    assert all(p.lstat() for p in (live, denied, foreign, regular, link, malformed))
+    assert set(calls) == {(os.getpid(), 0), (123456789, 0), (123456788, 0)}
+
+
+@pytest.mark.asyncio
+async def test_live_existing_node_and_replacement_survive_cleanup(socket_homes):
+    _, homes = socket_homes
+    home = homes[0]
+    path = wd.get_loop_tick_socket_path(home)
+    listener = bind_node(path, listening=True)
+    before = path.lstat().st_ino
+    try:
+        await wd.loop_heartbeat_forever(home=home, should_continue=lambda: False)
+        assert path.lstat().st_ino == before
+        assert (await wait_payload(home))["loop_tick_socket"] is False
+    finally:
+        listener.close()
+        path.unlink()
+        wd.get_loop_heartbeat_path(home).unlink()
+    task = asyncio.create_task(wd.loop_heartbeat_forever(home=home))
+    await wait_payload(home)
+    retained = path.with_suffix(".retained")
+    path.rename(retained)
+    replacement = bind_node(path, listening=True)
+    before = path.lstat().st_ino
+    try:
+        task.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await task
+        assert path.lstat().st_ino == before
+    finally:
+        replacement.close()
+
+
+@pytest.mark.asyncio
+async def test_cancel_during_server_handoff_closes_bound_fd(socket_homes, monkeypatch):
+    _, homes = socket_homes
+    path = wd.get_loop_tick_socket_path(homes[0])
+    bound = []
+    async def cancelled(*args, sock=None, **kwargs):
+        assert sock.fileno() >= 0 and path.is_socket()
+        bound.append(sock)
+        raise asyncio.CancelledError()
+    monkeypatch.setattr(wd.asyncio, "start_unix_server", cancelled)
+    with pytest.raises(asyncio.CancelledError):
+        await wd.loop_heartbeat_forever(home=homes[0])
+    assert bound and bound[0].fileno() == -1
+    assert not path.exists()
+
+
+def test_unsafe_leaf_is_never_probe_evidence(socket_homes):
+    root, homes = socket_homes
+    path = wd.get_loop_tick_socket_path(homes[0])
+    path.parent.mkdir(mode=0o700)
+    target = root / "elsewhere.sock"
+    with bind_node(target):
+        path.symlink_to(target)
+        assert cli._probe_loop_tick_socket(os.getpid(), homes[0], 0.01) is None
+        with pytest.raises(PermissionError):
+            wd.get_loop_tick_socket_path(homes[0])
+        assert path.is_symlink() and target.is_socket()
