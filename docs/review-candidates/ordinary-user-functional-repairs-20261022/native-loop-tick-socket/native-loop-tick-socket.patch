+def _validate_tick_socket_directory(directory: Path, *, private: bool) -> None:
+    """Refuse symlinks/foreign owners; the new shared-temp namespace must be private."""
+    info = directory.lstat()
+    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
+            or (private and stat.S_IMODE(info.st_mode) & 0o077)):
+        raise PermissionError(f"Unsafe loop tick socket directory: {directory}")
+
+
+def _tick_socket_identity(path: Path) -> tuple[int, int]:
+    info = path.lstat()
+    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
+        raise PermissionError(f"Unsafe loop tick socket node: {path}")
+    return info.st_dev, info.st_ino
+
