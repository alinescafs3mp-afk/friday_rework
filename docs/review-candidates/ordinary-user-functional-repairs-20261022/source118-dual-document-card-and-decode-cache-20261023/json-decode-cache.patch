+# Cache only JSON decoding, never ownership, bytes, pins or validation results.
+# Every call below still obtains a fresh private, stable owned_file read.
+_JSON_DECODE_CACHE = {}
+_JSON_DECODE_CACHE_BYTES = 0
+_JSON_DECODE_CACHE_LOCK = __import__('threading').Lock()
+_JSON_DECODE_MISSING = object()
+
+
+def _copy_json_value(value):
+    # Iterative copy preserves json.loads' accepted nesting depth.
+    if type(value) not in (dict, list):
+        return value
+    result = {} if type(value) is dict else []
+    pending = [(value, result)]
+    while pending:
+        source, target = pending.pop()
+        for key, item in (source.items() if type(source) is dict else enumerate(source)):
+            clone = {} if type(item) is dict else [] if type(item) is list else item
+            if type(target) is dict:
+                target[key] = clone
+            else:
+                target.append(clone)
+            if type(item) in (dict, list):
+                pending.append((item, clone))
+    return result
+
+
+def _read_json_cached(path):
+    global _JSON_DECODE_CACHE_BYTES
+    raw = owned_file(path, private=True)
+    policy = unique
+    key = (policy, raw)  # exact bytes and duplicate-key policy, not path/mtime
+    with _JSON_DECODE_CACHE_LOCK:
+        value = _JSON_DECODE_CACHE.get(key, _JSON_DECODE_MISSING)
+    if value is not _JSON_DECODE_MISSING:
+        return _copy_json_value(value)
+    value = json.loads(raw, object_pairs_hook=policy)
+    # Bounded retained raw bytes, not decoded RSS. Oversized docs keep old path.
+    if len(raw) <= 32 * 1024**2:
+        with _JSON_DECODE_CACHE_LOCK:
+            if key not in _JSON_DECODE_CACHE:
+                while _JSON_DECODE_CACHE and (len(_JSON_DECODE_CACHE) >= 2048
+                        or _JSON_DECODE_CACHE_BYTES + len(raw) > 32 * 1024**2):
+                    oldest = next(iter(_JSON_DECODE_CACHE))
+                    _JSON_DECODE_CACHE_BYTES -= len(oldest[1])
+                    del _JSON_DECODE_CACHE[oldest]
+                _JSON_DECODE_CACHE[key] = value
+                _JSON_DECODE_CACHE_BYTES += len(raw)
+            value = _JSON_DECODE_CACHE[key]
+        return _copy_json_value(value)
+    return value
+
