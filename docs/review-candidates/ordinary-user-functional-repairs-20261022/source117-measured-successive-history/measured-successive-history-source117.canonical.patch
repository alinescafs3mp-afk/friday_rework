+# Reuse only pure parses of identical archived configuration text. Callers
+# still read and authenticate each archive before every invocation. At most
+# 16 documents, at most 4 MiB each and 16 MiB raw total; failures never enter.
+_HISTORICAL_YAML_PARSE_CACHE = {}
+
+
+def _historical_yaml_parse(document, parser):
+    if type(document) is not str or len(document.encode('utf-8')) > 4 * 1024 * 1024:
+        return copy.deepcopy(parser(document))
+    key = (parser, document)
+    if key not in _HISTORICAL_YAML_PARSE_CACHE:
+        parsed = parser(document)
+        while _HISTORICAL_YAML_PARSE_CACHE and (len(_HISTORICAL_YAML_PARSE_CACHE) >= 16
+                or sum(len(k[1].encode('utf-8')) for k in _HISTORICAL_YAML_PARSE_CACHE)
+                    + len(document.encode('utf-8')) > 16 * 1024 * 1024):
+            del _HISTORICAL_YAML_PARSE_CACHE[next(iter(_HISTORICAL_YAML_PARSE_CACHE))]
+        _HISTORICAL_YAML_PARSE_CACHE[key] = parsed
+    return copy.deepcopy(_HISTORICAL_YAML_PARSE_CACHE[key])
+
 
