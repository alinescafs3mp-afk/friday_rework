+        row = current_access(PluginState('friday_rework'))['users'].get(principal_id(*principal))
+        require(type(row) is dict and row.get('enabled') is True and row.get('role') == 'user'
+            and type(row.get('generation')) is int and row['generation'] == identity['generation']
