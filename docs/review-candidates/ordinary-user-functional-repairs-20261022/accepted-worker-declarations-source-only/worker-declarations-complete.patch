+"""Stage or apply exact worker declarations through existing native maintenance.
+
+Apply is a finite private OS-operator command over a reviewed current install.
+It never enables, qualifies or starts workers, alters units or grants access.
+"""
+from __future__ import annotations
+
+import argparse
+import contextlib
+import copy
+import fcntl
+import re
+import time
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import stat
+import sys
