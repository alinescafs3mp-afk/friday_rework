+    from scripts import friday_install as f
+    # Runtime.locked is shared with the actual A0 owner. It cannot be bypassed
+    # by a request-supplied lock path or an inactive gateway observation.
+    with runtime.Runtime.locked(None):
+        launcher.owned_directory(launcher.ROOT)
+        launcher.checked_unit_registration()
+        unit = launcher.INSTALLED_UNIT
+        unit_state = ordinary.update_file_state(unit)
+        names = ('Id', 'LoadState', 'ActiveState', 'SubState', 'MainPID', 'ControlPID',
+            'InvocationID', 'ControlGroup', 'FragmentPath', 'DropInPaths')
+        def prove():
+            budget.check(reserve=1)
+            require(ordinary.same_update_file(unit, unit_state),
+                'worker_declaration_daemon_unit_changed')
