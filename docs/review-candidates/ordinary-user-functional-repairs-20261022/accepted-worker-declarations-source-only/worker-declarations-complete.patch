+                'worker_declaration_historical_a0_service_attempt_requires_separate_reconciliation')
+        require(_apply_inputs(request, budget) == preflight, 'worker_declaration_locked_preflight_changed')
+        saved = {name: ordinary.update_file_state(home/name,parent_fd(name)) for name in request['before']}
+        retained = {name: ordinary.update_file_state(home/name) for name in request['retained']}
