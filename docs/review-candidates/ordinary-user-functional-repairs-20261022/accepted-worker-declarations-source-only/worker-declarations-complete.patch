+def apply_declarations(request, budget=None, *, request_path=None):
+    """Finite existing-maintenance publication; no start, preparation or grant.
+
+    Per-file atomic replacement occurs while every native consumer and admission
+    writer is excluded. A durable consumed intent precedes staging. Power loss
+    leaves a consumed transaction requiring reconciliation; replay is refused.
+    """
+    require(budget is not None and request_path is not None,
+        'worker_declaration_original_clock_and_request_path_required')
+    from scripts.install_containment import Budget
+    require(type(budget) is Budget and type(request) is dict
+        and type(request.get('seconds')) is int and 30 <= request['seconds'] <= 180
+        and budget.seconds == request['seconds']
+        and all(type(v) in (int, float) and math.isfinite(v) for v in
+            (budget.started, budget.original_deadline, budget.deadline))
+        and 0 <= budget.started <= time.monotonic()
+        and budget.deadline <= budget.original_deadline <= budget.started + request['seconds'],
+        'worker_declaration_original_budget_binding_required')
+    # Copy the authenticated original window; never grant now + seconds or
+    # continue using a caller-mutable deadline during the publication.
+    budget = Budget(request['seconds'], started=budget.started, deadline=budget.deadline)
+    from scripts import friday_install as f
+    request_path = f.canonical(str(request_path))
+    request_state = ordinary.update_file_state(request_path)
+    f.owned_file(request_path, private=True)
+    require(request_state is not None and json.loads(request_state['data'], object_pairs_hook=f.unique) == request,
+        'worker_declaration_request_changed')
+    require(type(request) is dict and type(request.get('previous_input')) is dict
+        and type(request['previous_input'].get('sha256')) is str
+        and re.fullmatch('[0-9a-f]{64}', request['previous_input']['sha256']),
+        'worker_declaration_previous_input_pin_required')
+    claim_home = f.directory(f.canonical(request.get('home')))
+    tx = claim_home/'preparation'/('worker-declarations-'+request['previous_input']['sha256'])
+    require(not os.path.lexists(tx), 'worker_declaration_consumed_no_retry')
+    budget.check()
+    preflight = _apply_inputs(request, budget)
+    home, source, profile_home, access_path, previous, current, marker, plan, identity = preflight
+    require(not os.path.lexists(tx), 'worker_declaration_consumed_no_retry')
+    fd = os.open(home, os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
+    commit_started = False
