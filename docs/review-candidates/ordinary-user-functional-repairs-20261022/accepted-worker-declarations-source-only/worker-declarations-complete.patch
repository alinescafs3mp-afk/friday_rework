+        a0_prove = stack.enter_context(_stopped_launcher(budget))
+        build_prove = stack.enter_context(ordinary.retained_build_lock(source))
+        pm_prove = stack.enter_context(ordinary.retained_pm_lock(home, source))
+        lock_prove = stack.enter_context(ordinary.inference_locks(home, profile_home, access_path, budget))
+        publication_dirs = stack.enter_context(ordinary.SourceUpdateDirectories(home, request['before'], set()))
+        launcher_dirs = stack.enter_context(ordinary.SourceUpdateDirectories(
+            Path(request['launcher_before']['path']).parent, [Path(request['launcher_before']['path']).name], set()))
+        def parent_fd(name): return publication_dirs.parent_fd(name)
+        def launcher_fd(): return launcher_dirs.parent_fd(Path(request['launcher_before']['path']).name)
+        def custody():
+            native_prove(); a0_prove(); build_prove(); pm_prove(); lock_prove()
