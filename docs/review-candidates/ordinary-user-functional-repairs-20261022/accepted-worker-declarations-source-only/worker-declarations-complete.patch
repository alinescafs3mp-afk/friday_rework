+            raw = run(['/usr/bin/systemctl', '--user', 'show', runtime.DAEMON,
+                '--property=' + ','.join(names)], f.ROOT,
+                timeout=min(10, budget.check(reserve=1)), deadline=budget.deadline,
+                env=runtime.ENV)[0]
+            pairs = [line.split('=', 1) for line in raw.splitlines() if line]
+            fields = dict(pairs)
+            require(len(pairs) == len(names) and set(fields) == set(names)
+                and fields['Id'] == runtime.DAEMON and fields['LoadState'] == 'loaded'
+                and fields['ActiveState'] == 'inactive' and fields['SubState'] == 'dead'
+                and fields['MainPID'] == fields['ControlPID'] == '0'
