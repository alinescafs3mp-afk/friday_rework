+                'worker_declaration_retained_or_external_changed')
+        def before_unchanged():
+            retained_unchanged()
+            require(all(ordinary.same_update_file(home/n,v,parent_fd(n)) for n,v in saved.items())
+                and ordinary.same_update_file(launcher_path, launcher_before,launcher_fd()),
+                'worker_declaration_beforeimage_identity_changed')
+        from plugins.friday_rework.onboarding import prepare_admin_config_edit, finish_admin_config_edit, validate_template
+        from hermes_cli.config import atomic_config_write
+        from hermes_cli.friday_ordinary_gateway import normalized_configuration, check
+        from hermes_cli.config_effective import load_user_config_effective
+        from hermes_cli.friday_credential_admission import local_route, profile_policy
+        from tools.configure_product import compose_product
+        from hermes_yaml import safe_load
+        from hermes_cli import friday_user_scope as user
+        root_cfg, profile_cfg = plan['root_config'], plan['profile_config']
+        # Contract and ordinary templates remain byte/semantic equivalents;
+        # only the four planner-approved config subtrees may be published.
+        require(compose_product(previous['product'])['contract'] == compose_product(current['product'])['contract'],
+            'worker_declaration_root_profile_contract_changed')
+        for template in root_cfg['plugins']['entries']['friday_rework']['settings']['onboarding']['templates'].values():
+            validate_template(template)
+        prepared = prepare_admin_config_edit(profile_home, profile_cfg)
