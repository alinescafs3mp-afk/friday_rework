+def owned_attachment_model_path(event, path):
+    """Project only this event's verified own attachment into the file-tool namespace."""
+    owned = getattr(event, '_friday_owned_attachment_paths', None)
+    if owned is None:
+        return None  # Unmanaged/unverified paths retain the existing cache adapter.
+    from hermes_cli.friday_user_scope import current, _same_scope, ScopeDenied
+    cap = current(required=True)
+    owner, paths = owned
+    if (not _same_scope(owner, cap)
+            or not _same_scope(getattr(event.source, '_friday_user_scope', None), cap)):
+        raise ScopeDenied()
+    if path not in paths:
+        return None
+    try:
+        return Path(path).relative_to(cap.home / 'workspace').as_posix()
+    except ValueError:
+        raise ScopeDenied() from None
 
 
