+"""Bounded numeric-cell edit into a new own-workspace XLSX copy.
+
+Unchanged members retain exact decompressed bytes and ZIP metadata. Formula
+caches are preserved, never advertised as recalculated. No external engine.
+"""
+from io import BytesIO
+from pathlib import Path, PurePosixPath
+from decimal import Decimal, InvalidOperation
+import json
+import re
+import stat
+from xml.etree import ElementTree as ET
+from zipfile import ZipFile, ZIP_STORED, ZIP_DEFLATED, BadZipFile
+from hermes_cli.friday_user_scope import ScopeDenied, workspace_document
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _create_bytes
+
+S = '{http://schemas.openxmlformats.org/spreadsheetml/2006/main}'
+R = '{http://schemas.openxmlformats.org/officeDocument/2006/relationships}'
+P = '{http://schemas.openxmlformats.org/package/2006/relationships}'
+MAX_BYTES = 1000000
+
+def _number(value):
+    if type(value) not in (int,float) or len(str(value))>64: raise ScopeDenied()
+    number=Decimal(str(value))
+    if not number.is_finite() or abs(number)>Decimal('1e100'): raise ScopeDenied()
+    return number
+
+
+def render_copy(data, sheet, cell, expected, value):
+    if not isinstance(data,bytes) or len(data)>MAX_BYTES: raise ScopeDenied()
+    if not isinstance(sheet,str) or not 1<=len(sheet)<=31: raise ScopeDenied()
+    if not isinstance(cell,str) or not re.fullmatch(r'[A-Z]{1,3}[1-9][0-9]{0,6}',cell): raise ScopeDenied()
+    col=0
+    for char in re.match('[A-Z]+',cell)[0]: col=col*26+ord(char)-64
+    if col>16384 or int(re.search('[0-9]+',cell)[0])>1048576: raise ScopeDenied()
+    old=_number(expected);new=_number(value)
+    try:
+        with ZipFile(BytesIO(data)) as source:
+            infos=source.infolist();names=[i.filename for i in infos]
+            if not 1<=len(infos)<=256 or len(set(names))!=len(names): raise ScopeDenied()
+            if sum(i.file_size for i in infos)>MAX_BYTES: raise ScopeDenied()
+            parts={}
+            for info in infos:
+                name=info.filename;path=PurePosixPath(name)
+                if (path.is_absolute() or '..' in path.parts or '\\' in name or '\x00' in name
+                        or info.flag_bits&1 or info.compress_type not in (ZIP_STORED,ZIP_DEFLATED)
+                        or stat.S_ISLNK(info.external_attr>>16) or info.file_size>MAX_BYTES
+                        or info.file_size>max(4096,info.compress_size*200)
+                        or name.startswith('_xmlsignatures/') or name.endswith('vbaProject.bin')):
+                    raise ScopeDenied()
+                with source.open(info) as stream: raw=stream.read(MAX_BYTES+1)
+                if len(raw)!=info.file_size: raise ScopeDenied()
+                if name.endswith(('.xml','.rels')):
+                    if b'<!DOCTYPE' in raw.upper() or b'<!ENTITY' in raw.upper() or b'\x00' in raw: raise ScopeDenied()
+                    root=ET.fromstring(raw)
+                    if name.endswith('.rels') and any(n.get('TargetMode')=='External' for n in root): raise ScopeDenied()
+                parts[name]=raw
+            types=ET.fromstring(parts['[Content_Types].xml'])
+            ct='{http://schemas.openxmlformats.org/package/2006/content-types}'
+            if types.tag!=ct+'Types': raise ScopeDenied()
+            overrides={}
+            for node in types.findall(ct+'Override'):
+                part=node.get('PartName')
+                if part in overrides: raise ScopeDenied()
+                overrides[part]=node.get('ContentType')
+            if overrides.get('/xl/workbook.xml')!='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml': raise ScopeDenied()
+            package_rels=ET.fromstring(parts['_rels/.rels'])
+            if package_rels.tag!=P+'Relationships': raise ScopeDenied()
+            office=[n for n in package_rels if n.tag==P+'Relationship' and n.get('Type')==R[1:-1]+'/officeDocument']
+            if len(office)!=1 or office[0].get('Target') not in ('xl/workbook.xml','/xl/workbook.xml') or office[0].get('TargetMode') is not None: raise ScopeDenied()
+            book=ET.fromstring(parts['xl/workbook.xml'])
+            if book.tag!=S+'workbook': raise ScopeDenied()
+            sheets=[n for n in book.findall(S+'sheets/'+S+'sheet') if n.get('name')==sheet]
+            if len(sheets)!=1: raise ScopeDenied()
+            rels=ET.fromstring(parts['xl/_rels/workbook.xml.rels'])
+            if rels.tag!=P+'Relationships': raise ScopeDenied()
+            links=[n for n in rels if n.tag==P+'Relationship' and n.get('Id')==sheets[0].get(R+'id')
+                   and n.get('Type')==R[1:-1]+'/worksheet' and n.get('TargetMode') is None]
+            if len(links)!=1: raise ScopeDenied()
+            target=links[0].get('Target','')
+            if target.startswith('/xl/'): target=target[1:]
+            else: target='xl/'+target
+            if '..' in PurePosixPath(target).parts or '\\' in target or not target.startswith('xl/worksheets/'): raise ScopeDenied()
+            if overrides.get('/'+target)!='application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml': raise ScopeDenied()
+            raw=parts[target];root=ET.fromstring(raw)
+            if root.tag!=S+'worksheet': raise ScopeDenied()
+            # Array/shared/dataTable followers may contain only a cached <v>.
+            # This narrow literal editor refuses those sheets rather than editing
+            # a formula-owned follower while claiming caches were preserved.
+            if any(f.get('t') not in (None,'normal') or 'ref' in f.attrib for f in root.iter(S+'f')): raise ScopeDenied()
+            cells=[n for n in root.findall(S+'sheetData/'+S+'row/'+S+'c') if n.get('r')==cell]
+            if len(cells)!=1 or cells[0].get('t','n')!='n' or cells[0].find(S+'f') is not None: raise ScopeDenied()
+            vals=cells[0].findall(S+'v')
+            if len(vals)!=1 or Decimal(vals[0].text)!=old: raise ScopeDenied()
+            # Patch the single raw numeric <v> span, preserving namespace prefixes,
+            # formulas, extension markup, whitespace and every unrelated byte.
+            tag=rb'(?:[A-Za-z_][\w.-]*:)?'
+            pattern=rb'<'+tag+rb'c\b[^>]*\br=["\']'+cell.encode()+rb'["\'][^>]*>.*?</'+tag+rb'c\s*>'
+            matches=list(re.finditer(pattern,raw,re.S))
+            if len(matches)!=1: raise ScopeDenied()
+            block=matches[0].group();values=list(re.finditer(rb'(<'+tag+rb'v\b[^>]*>)([^<]*)(</'+tag+rb'v\s*>)',block,re.S))
+            if len(values)!=1 or Decimal(values[0][2].decode())!=old: raise ScopeDenied()
+            v=values[0];replacement=block[:v.start(2)]+str(new).encode('ascii')+block[v.end(2):]
+            changed=raw[:matches[0].start()]+replacement+raw[matches[0].end():]
+            checked=ET.fromstring(changed)
+            check_cell=[n for n in checked.findall(S+'sheetData/'+S+'row/'+S+'c') if n.get('r')==cell]
+            if len(check_cell)!=1 or Decimal(check_cell[0].find(S+'v').text)!=new: raise ScopeDenied()
+            result=BytesIO()
+            with ZipFile(result,'w') as out:
+                out.comment=source.comment
+                for info in infos: out.writestr(info, changed if info.filename==target else parts[info.filename])
+            rendered=result.getvalue()
+            if len(rendered)>MAX_BYTES: raise ScopeDenied()
+            return rendered
+    except (BadZipFile,ET.ParseError,KeyError,ValueError,TypeError,InvalidOperation,RuntimeError,OSError,NotImplementedError):
+        raise ScopeDenied() from None
+
+
+def create_copy(cap,fd,leaf,path,content):
+    check(cap)
+    if not isinstance(content,str) or len(content)>4096: raise ScopeDenied()
+    try:
+        spec=json.loads(content)
+        if not isinstance(spec,dict) or set(spec)!={'source','sheet','cell','expected','value'}: raise ScopeDenied()
+        raw=spec['source']
+        if not isinstance(raw,str) or '\x00' in raw: raise ScopeDenied()
+        root=cap.home/'workspace';source=Path(raw)
+        if not source.is_absolute(): source=root/source
+        relative=source.relative_to(root)
+        if (not relative.parts or any(p in ('.','..') or p.startswith('.') for p in relative.parts)
+                or source.suffix.lower()!='.xlsx' or relative.as_posix()==path): raise ScopeDenied()
+        data,_,version=workspace_document(str(source),with_identity=True)
+        rendered=render_copy(data,spec['sheet'],spec['cell'],spec['expected'],spec['value'])
+        def verify():
+            check(cap)
+            current,_,identity=workspace_document(str(source),with_identity=True)
+            if current!=data or identity!=version: raise ScopeDenied()
+        result=json.loads(_create_bytes(cap,fd,leaf,path,rendered,output_format='xlsx',verify_source=verify))
+        if result.get('success'):
+            result.update(source=relative.as_posix(),sheet=spec['sheet'],cell=spec['cell'],
+                          formula_cache_recomputed=False,unchanged_parts_preserved=True)
+        return json.dumps(result)
+    except (ValueError,TypeError,KeyError):
+        raise ScopeDenied() from None
