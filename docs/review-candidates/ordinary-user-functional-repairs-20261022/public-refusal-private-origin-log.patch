+        # Fixed origin: preserve the true cause only in existing private logs.
+        import logging
+        logging.getLogger(__name__).warning(
+            'Private tool refusal: cause=product_user_scope_refused')
+        return json.dumps({'error': PUBLIC_TOOL_REFUSAL_COPY, 'success': False}, ensure_ascii=False)
+    return None
 
 
