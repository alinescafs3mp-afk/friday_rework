+@contextlib.contextmanager
+def _launcher_custody(budget):
+    """Existing A0 native lock and stopped daemon; no Docker or service effects."""
+    from scripts import a0_runtime as runtime, rootless_docker_launch as launcher
+    from scripts.dsh_prepare import run
+    from scripts import friday_install as f
+    # Retain the existing runtime lock inode; Runtime.locked may not create it.
+    from scripts import friday_ordinary_install as ordinary
+    lock = runtime.RUNTIME / 'runtime.lock'
+    before = ordinary.update_file_state(lock)
+    require(before is not None and before['mode'] == 0o600,
+        'worker_declaration_existing_a0_lock_required')
+    def prove():
+        require(ordinary.same_update_file(lock, before), 'worker_declaration_a0_lock_changed')
+        launcher.checked_unit_registration()
+        raw, _ = run(['/usr/bin/systemctl', '--user', 'show', runtime.DAEMON,
+            '--property=Id,LoadState,ActiveState,SubState,MainPID,ControlPID,ControlGroup,Job'],
+            f.ROOT, timeout=min(10, budget.check(reserve=1)), deadline=budget.deadline,
+            env=runtime.ENV)
+        pairs = [line.split('=', 1) for line in raw.splitlines() if line]
+        require(len(pairs) == 8 and all(len(p) == 2 for p in pairs)
+            and dict(pairs) == {'Id': runtime.DAEMON, 'LoadState': 'loaded',
+                'ActiveState': 'inactive', 'SubState': 'dead', 'MainPID': '0',
+                'ControlPID': '0', 'ControlGroup': '', 'Job': ''},
+            'worker_declaration_a0_stopped_required')
+        for path in (launcher.REQUEST, launcher.GUARD, launcher.STATE / 'rootlesskit'):
+            require(not os.path.lexists(path), 'worker_declaration_retained_route_or_namespace')
+        if os.path.lexists(launcher.STATE):
+            launcher.owned_directory(launcher.STATE)
+            require(not any(launcher.STATE.iterdir()), 'worker_declaration_retained_route_or_namespace')
+    with runtime.Runtime.locked(None):
+        prove()
+        yield prove
+        prove()
