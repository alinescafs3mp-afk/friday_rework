+def project_delta(previous, current):
+    """One project-only Source100 successor, not an inspector input override."""
+    old, new = previous.get('project_files'), current.get('project_files')
+    require(type(old) is dict and type(new) is dict and set(new) == set(old) | PROJECT_NEW
+        and not set(old) & PROJECT_NEW
+        and all(old.get(n) == h and new.get(n) != h for n, h in PROJECT_BEFORE.items())
+        and all(new[n] == h for n, h in old.items() if n not in PROJECT_BEFORE)
+        and new.get(PLANNER) == PLANNER_SHA256
+        and new.get('scripts/rootless_docker_launch.py') == LAUNCHER_AFTER,
+        'worker_declaration_exact_project_source_delta_required')
+
+
+def input_delta(previous, current, deployment, worker_inputs):
+    """No source update, resource change, runtime enable or inferred defaults."""
+    require(type(previous) is dict and type(current) is dict,
+        'worker_declaration_install_inputs_required')
+    project_delta(previous, current)
+    expected = copy.deepcopy(previous)
+    expected['project_files'] = copy.deepcopy(current['project_files'])
+    require('a0_deployment' in previous.get('product', {})
+        and previous['product'].get('runtime') == {'enabled': False},
+        'worker_declaration_disabled_install_input_required')
+    expected['product']['a0_deployment'] = copy.deepcopy(deployment)
+    old_a0 = previous.get('worker_install', {}).get('a0', {})
+    require({'policy', 'network'} <= set(old_a0),
+        'worker_declaration_existing_network_required')
+    expected['worker_install']['a0']['policy'] = copy.deepcopy(worker_inputs['a0_network']['policy'])
+    expected['worker_install']['a0']['network'] = copy.deepcopy(worker_inputs['a0_network'])
+    require(_same(expected, current) and not _same(previous, current),
+        'worker_declaration_unrelated_install_input_delta')
+
