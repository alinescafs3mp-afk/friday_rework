+def _admission(home, profile_home, identity):
+    """Use native current access/proof; no JSON flag confers operator scope."""
+    from hermes_cli import friday_user_scope as user
+    from hermes_cli.friday_product_access import current_access, principal_id
+    require(user._CURRENT.get() is None, 'worker_declaration_operator_scope_required')
+    binding = identity['binding']
+    principal = tuple(binding[k] for k in ('platform', 'transport_profile', 'account_id', 'user_id'))
+    with user.authority(home):
+        row = current_access()['users'].get(principal_id(*principal))
+    require(type(row) is dict and row.get('role') == 'user' and row.get('enabled') is True
+        and type(row.get('generation')) is int and row['generation'] == identity['generation'],
+        'worker_declaration_current_access_required')
+    user.check_onboarding_home(home, profile_home, binding)
+    info = profile_home.stat()
+    with user.authority(profile_home):
+        user.UserScope(home, profile_home, profile_home.name, principal, dict(binding),
+            (info.st_dev, info.st_ino), row['generation']).check()
