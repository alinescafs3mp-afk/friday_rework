+def apply_declarations(request, budget=None, *, request_path=None):
+    """Existing stopped-owner transaction, exact CAS, reseal, rollback/no retry."""
+    require(budget is not None and request_path is not None,
+        'worker_declaration_native_entry_and_budget_required')
+    from scripts import friday_install as f, friday_ordinary_install as ordinary
+    from scripts.dsh_prepare import StopUnconfirmed
+    request_path = _absolute(str(request_path))
+    raw = _read_reference({'path': str(request_path), 'sha256': f.digest(f.owned_file(request_path, private=True))},
+        json_document=False)
+    require(_same(json.loads(raw, object_pairs_hook=f.unique), request), 'worker_declaration_request_changed')
+    values = apply_inputs(request, budget)
+    home, profile_home, access_path, previous, current, marker, plan, identity = values
+    tx = home / 'preparation' / ('worker-declarations-' + request['previous_input']['sha256'])
+    require(not os.path.lexists(tx), 'worker_declaration_consumed_no_retry')
+    owned = {}
+    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    with ordinary.inference_retaining_cleanup(fd) as stack:
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        native = stack.enter_context(ordinary.stopped_consumers(home, request['native_unit'], budget))
+        build = stack.enter_context(ordinary.retained_build_lock(home / 'hermes-agent'))
+        pm = stack.enter_context(ordinary.retained_pm_lock(home, home / 'hermes-agent'))
+        locks = stack.enter_context(ordinary.inference_locks(home, profile_home, access_path, budget))
+        daemon = stack.enter_context(_launcher_custody(budget))
+        require(apply_inputs(request, budget) == values, 'worker_declaration_locked_cas_changed')
+        boundary = home.parent
+        saved = {str((home / n).relative_to(boundary)): ordinary.update_file_state(home / n)
+            for n in request['before']}
+        launch_name = str(_absolute(request['launcher_before']['path']).relative_to(boundary))
+        saved[launch_name] = ordinary.update_file_state(boundary / launch_name)
+        before_refs = {home.name + '/' + n: r for n, r in request['before'].items()}
+        before_refs[launch_name] = request['launcher_before']
+        require(all((s is None and n == home.name + '/' + PLANNER and before_refs[n] is None)
+            or (s is not None and s['mode'] in ((0o400, 0o600, 0o644)
+            if n == launch_name or n.endswith('/worker-runtime-source/scripts/rootless_docker_launch.py') else (0o600,))
+            and before_refs[n] is not None and f.digest(s['data']) == before_refs[n]['sha256'])
+            for n, s in saved.items()), 'worker_declaration_private_before_modes_or_hash_changed')
+        _, worker_inputs, _ = load_declaration_source(request['source'])
+        all_refs = [request['previous_input'], request['current_input'], request['native_unit'],
+            worker_inputs['a0_network']['policy'],
+            {'path': str(f.ROOT / 'scripts/rootless_docker_launch.py'), 'sha256': LAUNCHER_AFTER},
+            marker['ordinary_gateway']['operator_entry']['script'],
+            *request['source'].values(), *identity['source_refs'].values(),
+            *request['retained'].values()]
+        # A stale attachment may already have been natively archived; absence
+        # is not converted into permission to recreate it.
+        all_refs = [ref for ref in all_refs if ref != identity['source_refs']['stale_attachment']
+            or os.path.lexists(ref['path'])]
+        external = {Path(ref['path']): ordinary.update_file_state(Path(ref['path'])) for ref in all_refs}
+        require(all(external[Path(ref['path'])] is not None
+            and f.digest(external[Path(ref['path'])]['data']) == ref['sha256'] for ref in all_refs),
+            'worker_declaration_external_snapshot_changed')
+        external[request_path] = ordinary.update_file_state(request_path)
+        require(external[request_path] is not None and external[request_path]['data'] == raw,
+            'worker_declaration_request_snapshot_changed')
+        changed_paths = {boundary / n for n in saved}
+        external = {p: s for p, s in external.items() if p not in changed_paths}
+        require(all(s is not None for s in external.values()), 'worker_declaration_retained_state_missing')
+        auth_before = {own / 'auth.json': ordinary.update_file_state(own / 'auth.json')
+            for own in (home, profile_home)}
+        dirs = ordinary.SourceUpdateDirectories(boundary, list(saved), [])
+        stack.callback(dirs.close)
+        def worker_inventory():
+            result = {}
+            for root in (home / 'workers', profile_home / 'workers'):
+                if not os.path.lexists(root):
+                    result[str(root)] = None
+                    continue
+                for path in (root, *root.rglob('*')):
+                    st = path.lstat()
+                    if stat.S_ISDIR(st.st_mode):
+                        f.directory(path)
+                        result[str(path)] = (st.st_dev, st.st_ino, st.st_uid, st.st_mode)
+                    else:
+                        require(str(path.relative_to(home)) in request['retained'],
+                            'worker_declaration_unpinned_worker_history')
+                        result[str(path)] = ordinary.update_file_state(path)
+            return result
+        workers_before = worker_inventory()
+        def custody():
+            native(); build(); pm(); locks(); daemon(); dirs.prove(); budget.check()
+        def retained():
+            custody()
+            require(all(ordinary.same_update_file(p, s) for p, s in external.items()),
+                'worker_declaration_retained_identity_changed')
+            require(worker_inventory() == workers_before, 'worker_declaration_worker_history_changed')
+            require(all(ordinary.same_update_file(p, s) for p, s in auth_before.items()),
+                'worker_declaration_auth_identity_changed')
+            plugins = dict(marker['plugin_files'])
+            planner_name = home.name + '/' + PLANNER
+            if os.path.lexists(home / PLANNER):
+                require(planner_name in owned and ordinary.same_update_file(home / PLANNER, owned[planner_name]),
+                    'worker_declaration_unowned_planner_appeared')
+                plugins[PLANNER] = PLANNER_SHA256
+            ordinary.checked_plugin_inventory(home, plugins)
