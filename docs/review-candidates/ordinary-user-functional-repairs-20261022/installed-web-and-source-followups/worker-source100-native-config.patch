+def apply_inputs(request, budget):
+    """Authenticate current installed input before importing native authority."""
+    from scripts import friday_install as f, friday_ordinary_install as ordinary
+    fields = {'schema', 'seconds', 'home', 'profile', 'previous_input', 'current_input',
+        'native_unit', 'source', 'before', 'retained', 'launcher_before'}
+    require(type(request) is dict and set(request) == fields and request['schema'] == APPLY_SCHEMA
+        and type(request['seconds']) is int and 30 <= request['seconds'] <= 180,
+        'worker_declaration_exact_apply_request_required')
+    home = f.directory(_absolute(request['home']))
+    require(os.environ.get('HERMES_HOME') == str(home), 'worker_declaration_exact_home_required')
+    previous = _read_reference(request['previous_input'])
+    current = _read_reference(request['current_input'])
+    require(previous.get('home') == current.get('home') == str(home),
+        'worker_declaration_install_home_changed')
+    project_delta(previous, current)
+    # Existing source-update seam: validate the actual new project inventory,
+    # unchanged donor composition, old installed plugin set and native marker.
+    # f.inspect(previous) deliberately cannot validate a new helper checkout.
+    _, donors = budget.call(f.spec_checked, current, cli_only=True)
+    source = f.directory(home / 'hermes-agent')
+    marker = f.read_json(home / f.MARKER)
+    receipt_path = home / 'hermes-agent.source.json'
+    receipt = f.read_json(receipt_path)
+    old_entry = marker.get('ordinary_gateway', {}).get('operator_entry', {})
+    old_script = old_entry.get('script', {})
+    old_script_path = _absolute(old_script.get('path'))
+    require(marker.get('schema') == f.SCHEMA and marker.get('home') == str(home)
+        and marker.get('source') == str(source)
+        and marker.get('state') == 'INSTALLED_TEMPLATE_INCOMPLETE'
+        and marker.get('worker_state') == 'BOTH_WORKERS_PREPARATION_PENDING'
+        and marker.get('input_sha256') == request['previous_input']['sha256']
+        and marker.get('source_receipt_sha256') == f.digest(f.owned_file(receipt_path)) == SOURCE100_RECEIPT
+        and set(old_entry) == {'input', 'script'} and old_entry['input'] == request['previous_input']
+        and old_script_path.name == 'friday_native.py' and old_script_path.parent.name == 'scripts'
+        and old_script.get('sha256') == previous['project_files'].get('scripts/friday_native.py')
+        and set(marker.get('profile_files', {})) == {'config.yaml', 'SOUL.md', 'FRIDAY-PROFILE.json'}
+        and receipt.get('schema') == 'friday.hermes-source.v1',
+        'worker_declaration_installed_source_lineage_changed')
+    f.pin(old_script)
+    budget.call(f.composition_checked, current, source, receipt, donors['hermes'])
+    old_plugins = {n: h for n, h in previous['project_files'].items()
+        if n.startswith('plugins/friday_rework/')}
+    require(marker.get('plugin_files') == old_plugins, 'worker_declaration_installed_plugin_marker_changed')
+    ordinary.checked_plugin_inventory(home, old_plugins)
+    require(all(f.digest(f.owned_file(home / n, private=True)) == h
+        for n, h in marker['profile_files'].items() if n != 'config.yaml'),
+        'worker_declaration_installed_profile_changed')
+    f.native_packages(source)
+    from hermes_cli.friday_ordinary_gateway import check
+    check(home, role=False)
+    from hermes_constants import get_hermes_home
+    from pm.paths import repo_root
+    from pm.environments import project_python
+    require(get_hermes_home() == home and repo_root() == home / 'hermes-agent'
+        and Path(sys.executable) == project_python(home / 'hermes-agent'),
+        'worker_declaration_native_pm_owner_required')
+    bundle, worker_inputs, identity = load_declaration_source(request['source'])
+    profile_home = f.directory(_absolute(identity['profile']))
+    require(profile_home.parent.parent == home and profile_home.name == request['profile'],
+        'worker_declaration_profile_changed')
+    refs = identity['source_refs']
+    from hermes_cli.plugins_state import _plugin_data_namespace
+    access_path = home / 'plugin-data' / _plugin_data_namespace('friday_rework', '') / 'state.json'
+    require(_absolute(refs['access_state']['path']) == access_path,
+        'worker_declaration_access_namespace_changed')
+    from hermes_cli import friday_user_scope as user
+    prefix = 'profiles/' + request['profile'] + '/'
+    names = {'config.yaml', prefix + 'config.yaml', prefix + user.ONBOARDING,
+        prefix + user.MARKER, f.MARKER, PLANNER,
+        'worker-runtime-source/scripts/rootless_docker_launch.py'}
+    require(type(request['before']) is dict and set(request['before']) == names,
+        'worker_declaration_exact_before_inventory_required')
+    for name, ref in request['before'].items():
+        if name == PLANNER:
+            require(ref is None and not os.path.lexists(home / name),
+                'worker_declaration_existing_planner_refused')
+            continue
+        require(_absolute(ref['path']) == home / name,
+            'worker_declaration_before_path_changed')
+        _read_reference(ref, json_document=False) if not name.startswith('worker-runtime-source/') else f.pin(ref)
+    require(_same(request['before']['config.yaml'], refs['root_configuration'])
+        and _same(request['before'][prefix + 'config.yaml'], refs['configuration'])
+        and _same(request['before'][prefix + user.ONBOARDING], refs['onboarding'])
+        and _same(request['before'][prefix + user.MARKER], refs['user_marker']),
+        'worker_declaration_identity_before_join_changed')
+    from hermes_cli.config import fast_safe_load
+    root_config = fast_safe_load(_read_reference(refs['root_configuration'], json_document=False).decode('utf-8-sig'))
+    profile_config = fast_safe_load(_read_reference(refs['configuration'], json_document=False).decode('utf-8-sig'))
+    validate_declaration_source(request['source'], root_config, profile_config,
+        root_home=home, profile_home=profile_home)
+    plan = plan_declaration_delta(root_config, profile_config, worker_inputs, identity, bundle)
+    # A network policy is executable input, not authority supplied by the bundle.
+    require(worker_inputs['a0_network']['policy']['sha256'] == SPARK_POLICY_SHA256,
+        'worker_declaration_reviewed_network_policy_required')
+    f.pin(worker_inputs['a0_network']['policy'])
+    old_template = root_config['plugins']['entries']['friday_rework']['settings']['onboarding']['templates']['friday-local']['worker_inputs']
+    require(_same(previous['product']['a0_deployment'], root_config['a0_deployment'])
+        and _same(previous['worker_install']['a0']['network'], old_template['a0_network'])
+        and _same(previous['worker_install']['a0']['policy'], old_template['a0_network']['policy'])
+        and _same(old_template['workers']['a0']['a0']['launcher'], request['launcher_before']),
+        'worker_declaration_existing_input_lineage_changed')
+    input_delta(previous, current, plan['root_config']['a0_deployment'], worker_inputs)
+    budget.call(f.spec_checked, current, cli_only=True)
+    marker = f.read_json(home / f.MARKER)
+    require(marker.get('completion_stage') == 'TELEGRAM_ORDINARY' and marker.get('runtime_ready') is False
+        and f.cli_historical_scope_closed(marker['original_attempt'], 'friday.native-install.v1')
+        and (marker.get('cli_segment') is None or f.cli_historical_scope_closed(
+            marker['cli_segment']['clock'], 'friday.cli-segment-clock.v1')),
+        'worker_declaration_closed_original_clocks_required')
+    from scripts import a0_runtime, rootless_docker_launch as launcher
+    profile_validator = f.project_plugin('adapters.a0_profile', current)
+    require(profile_validator.network_endpoints(plan['root_config']['a0_deployment']) == launcher.ENDPOINTS,
+        'worker_declaration_reviewed_launcher_endpoints_required')
+    launcher_path = _absolute(request['launcher_before']['path'])
+    require(launcher_path == a0_runtime.LAUNCHER == launcher.ROOT / 'launch.py'
+        and request['launcher_before']['sha256'] == LAUNCHER_BEFORE
+        and request['before']['worker-runtime-source/scripts/rootless_docker_launch.py']['sha256'] == LAUNCHER_BEFORE
+        and current['project_files']['scripts/rootless_docker_launch.py'] == LAUNCHER_AFTER
+        and worker_inputs['workers']['a0']['a0']['launcher'] == {'path': str(launcher_path), 'sha256': LAUNCHER_AFTER}
+        and launcher.ROOT.parent == home.parent,
+        'worker_declaration_exact_launcher_lineage_required')
+    f.pin(request['launcher_before'])
+    require(f.digest(f.owned_file(f.ROOT / 'scripts/rootless_docker_launch.py')) == LAUNCHER_AFTER,
+        'worker_declaration_reviewed_launcher_changed')
+    required = {'FRIDAY-PROFILE.json', 'hermes-agent.source.json', 'hermes-agent/install-stamp.json',
+        'SOUL.md', prefix + 'SOUL.md', '.env', prefix + '.env', str(access_path.relative_to(home)),
+        str(access_path.with_name('admission.lock').relative_to(home)),
+        *marker['ordinary_gateway']['history'], *old_plugins}
+    retained = request['retained']
+    require(type(retained) is dict and required <= set(retained) and not set(retained) & names,
+        'worker_declaration_retained_history_required')
+    for name, ref in retained.items():
+        require(type(name) is str and name == str(Path(name)) and not Path(name).is_absolute()
+            and '..' not in Path(name).parts and name != '.' and _absolute(ref['path']) == home / name,
+            'worker_declaration_retained_path_changed')
+        f.pin(ref)
+    for own in (home, profile_home):
+        if os.path.lexists(own / 'auth.json'):
+            require(str((own / 'auth.json').relative_to(home)) in retained,
+                'worker_declaration_auth_inventory_required')
+    # Stale preparations/attachment are historical bytes, never renewed here.
+    # Every existing worker file must be pinned; unknown state refuses. A later
+    # supported archive/prepare/qualify must handle them under its own authority.
+    for worker_root in (home / 'workers', profile_home / 'workers'):
+        if not os.path.lexists(worker_root):
+            continue
+        f.directory(worker_root)
+        for path in worker_root.rglob('*'):
+            if path.is_dir() and not path.is_symlink():
+                f.directory(path)
+            else:
+                name = str(path.relative_to(home))
+                require(name in retained, 'worker_declaration_unpinned_worker_history')
+                f.pin(retained[name])
+    if os.path.lexists(profile_home / 'workers/attachment.json'):
+        require(retained.get(prefix + 'workers/attachment.json') == refs['stale_attachment'],
+            'worker_declaration_stale_attachment_changed')
+    _admission(home, profile_home, identity)
+    return home, profile_home, access_path, previous, current, marker, plan, identity
