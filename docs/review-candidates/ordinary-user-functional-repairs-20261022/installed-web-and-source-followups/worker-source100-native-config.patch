+
+# Do not create a namespace `plugins` before native_packages authenticates and
+# extends the regular Hermes package. Use the existing pure validation alias.
+from scripts import friday_install as _installer
+_installer._source_runtime_module('runtime_primitives')
+_declarations = importlib.import_module(
+    '_friday_install_validation_plugins.friday_rework.worker_declarations')
+for _name in ('DeclarationError', 'NATIVE_GAPS', '_absolute', '_read_reference', '_same',
+        'load_declaration_source', 'plan_declaration_delta', 'require', 'validate_declaration_source'):
+    globals()[_name] = getattr(_declarations, _name)
+
+
+def _encoded(value):
+    return (json.dumps(value, ensure_ascii=False, sort_keys=True,
+        indent=2, allow_nan=False) + '\n').encode()
+
+
+APPLY_SCHEMA = 'friday.worker-declarations.apply.v1'
+LAUNCHER_BEFORE = '27d86999105a33ac2e41872dfd9cb9b2c203b65388ecc3642406909383f001f0'
+LAUNCHER_AFTER = 'b6825c510a7b50be20419fc0f57fee042dc9beef6d10a58b10fef1592da2fd77'
+PROJECT_BEFORE = {
+    'scripts/friday_install.py': '73521e7a4dd09b243d41c9db0869bcfc2bd85e0ecd3eac22537dbe4cbeda8901',
+    'tools/configure_product.py': 'ff737472e587c42238b2e6ead282afcf4cad4198751d3acc3382016b096349f4',
+    'scripts/rootless_docker_launch.py': LAUNCHER_BEFORE,
+}
+PLANNER = 'plugins/friday_rework/worker_declarations.py'
+PLANNER_SHA256 = '29ad1098f0d47ee6ac8af33389d39736a1ab141248482bc5885f83a7bfb7ed34'
+PROJECT_NEW = frozenset({PLANNER, 'scripts/friday_worker_declarations.py'})
+SOURCE100_RECEIPT = '58167c442ab3029628ccff89fc85d7d97726aeb612a6716819c3fbba5710ddd7'
+SPARK_POLICY_SHA256 = '4a48202e2704f46968df864c4c3c23b6b5dc941dc11dabf04c5de5d9b1595a4d'
