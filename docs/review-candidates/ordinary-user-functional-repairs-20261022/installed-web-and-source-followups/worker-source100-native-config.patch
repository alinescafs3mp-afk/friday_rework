+"""Exact worker declaration maintenance; never worker/runtime admission.
+
+This entry never invokes historical recovery/rebind commands. Staging does
+not consume an attempt, change a deployment marker, or qualify a worker.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import copy
+import contextlib
+import fcntl
+import sys
+import time
