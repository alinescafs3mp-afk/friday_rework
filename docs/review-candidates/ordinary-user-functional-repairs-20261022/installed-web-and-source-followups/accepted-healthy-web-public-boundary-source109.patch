+def _record_private_web_cause(call_name: str, cause) -> None:
+    """Best-effort typed private diagnostics for a provider/selection cause, recorded
+    BEFORE any ordinary public projection. NOT a guaranteed durable exact receipt:
+    the configured sink may redact literal text, logging may be disabled or the
+    sink may fail, and with no configured handlers stdlib lastResort writes to
+    stderr — so K20-M1 / original B07-R2 stay OPEN. The optional DebugSession
+    stays a supplement; the typed cause never enters the model/public result."""
+    logger.warning("%s private web cause: %s", call_name, cause)
