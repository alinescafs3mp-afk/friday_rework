+def archive_route(app):
+    """Resolve the exact registered POST using current FastAPI route contexts.
+
+    Included routers retain prefix/effective context in the current SDK.
+    Never skip a branch because the wrapper itself has no flat ``path``.
+    """
+    matches = [route for route in iter_route_contexts(app.routes)
+               if route.path == URL.split('?', 1)[0]
+               and route.methods is not None and 'POST' in route.methods]
+    assert len(matches) == 1, 'exactly_one_registered_archive_POST_required'
+    route = matches[0]
+    assert callable(route.endpoint) and '_admin' in route.endpoint.__globals__
+    return route
