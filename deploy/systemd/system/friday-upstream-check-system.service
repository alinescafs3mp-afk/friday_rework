[Unit]
Description=Observe pinned Friday donor metadata with manager-established filesystem protection

[Service]
Type=oneshot
User=jericho
Group=jericho
WorkingDirectory=/var/lib/friday-upstream-check-system
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/friday-upstream-check-system/scripts/check_upstream_system.py
StateDirectory=friday-upstream-check-system
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=100
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=no
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/friday-upstream-check-system
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
