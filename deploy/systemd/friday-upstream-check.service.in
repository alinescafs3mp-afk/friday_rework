[Unit]
Description=Observe pinned Friday donor upstream metadata

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
ExecStart=/usr/bin/python3 "@PROJECT_ROOT@/scripts/check_upstream.py" --report-dir %S/friday-upstream-check
StateDirectory=friday-upstream-check
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=100
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/friday-upstream-check
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
