      "additionalProperties": false,
      "properties": {
        "fd": {
          "minimum": 3,
          "type": "integer"
        },
        "identity": {
          "$ref": "#/$defs/fd"
        },
        "path": {
          "const": "/PRIVATE_WORKSPACE/runtime/Friday_rework-main-publication.lock"
        }
      },
      "required": [
        "path",
        "fd",
        "identity"
      ],
      "type": "object"
    },
    "owned_item": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "maximum": 63,
          "minimum": 0,
          "type": "integer"
        },
        "parent": {
          "$ref": "#/$defs/birth"
        },
        "snapshot": {
          "$ref": "#/$defs/birth"
        }
      },
      "required": [
        "snapshot",
        "parent",
        "depth"
      ],
      "type": "object"
    },
    "owned_observations": {
      "properties": {
        "GO_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "observed": {
          "items": {
            "$ref": "#/$defs/owned_item"
