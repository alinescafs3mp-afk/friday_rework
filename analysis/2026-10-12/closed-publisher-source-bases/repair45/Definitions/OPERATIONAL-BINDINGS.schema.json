  "$id": "FRW-DAILY12OCT-OPERATIONAL-BINDINGS-2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "aggregate_target_ceiling_bytes": 134217728,
  "oneOf": [
    {
      "$ref": "#/$defs/publisher_custody"
    },
    {
      "$ref": "#/$defs/git_intent"
    },
    {
      "$ref": "#/$defs/owned_observations"
    },
    {
      "$ref": "#/$defs/producer_closure"
    },
    {
      "$ref": "#/$defs/durable_chain"
    },
    {
      "$ref": "#/$defs/causal_chain"
    },
    {
      "$ref": "#/$defs/README_custody"
    }
  ],
  "per_file_and_stream_ceiling_bytes": 67108864
}
