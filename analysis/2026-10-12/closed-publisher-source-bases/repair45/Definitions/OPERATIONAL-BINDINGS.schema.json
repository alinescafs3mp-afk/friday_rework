    "producer_closure": {
      "properties": {
        "finite_known_closed": {
          "type": "boolean"
        },
        "no_exhaustive_ephemeral_fork_claim": {
          "const": true
        },
        "observations": {
          "maxItems": 4096,
          "type": "array"
        },
        "schema": {
          "const": "FRW-PRODUCER-CLOSURE-2"
        },
        "unknowns": {
          "type": "array"
        }
      },
      "required": [
        "schema",
        "observations",
        "unknowns",
        "finite_known_closed",
        "no_exhaustive_ephemeral_fork_claim"
