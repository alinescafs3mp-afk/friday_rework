{
  "$comment": "Source contracts only. Every producer emits these layouts; actual GO/receipts unbound, no execution/acceptance.",
  "$defs": {
    "README_custody": {
      "properties": {
        "ctime_ns": {
          "type": "integer"
        },
        "identity": {
          "$ref": "#/$defs/fd"
        },
        "mtime_ns": {
          "type": "integer"
        },
        "preimage": {
          "$ref": "#/$defs/ref"
        },
        "schema": {
          "const": "FRW-README-OPEN-CUSTODY-2"
        },
        "size": {
          "maximum": 67108864,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "identity",
        "size",
        "mtime_ns",
        "ctime_ns",
        "preimage"
      ],
      "type": "object"
    },
    "birth": {
      "properties": {
        "birth": {
          "minimum": 1,
          "type": "integer"
        },
        "boot_id": {
          "minLength": 1,
          "type": "string"
        },
        "pid": {
          "minimum": 1,
          "not": {
            "const": 2306
          },
          "type": "integer"
        }
      },
      "required": [
        "pid",
        "birth",
        "boot_id"
      ],
      "type": "object"
    },
    "causal_chain": {
      "properties": {
        "at": {
          "type": "number"
        },
        "context": {
          "type": "object"
        },
        "durable_inventory": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "maxLength": 4096,
          "type": "string"
        },
        "kind": {
          "enum": [
            "PRIMARY",
            "SECONDARY"
          ]
        },
        "previous_causal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "const": "FRW-CAUSAL-CHAIN-2"
        },
        "unjournaled_refs": {
          "type": "array"
        }
      },
      "required": [
        "schema",
        "kind",
        "error",
        "context",
        "previous_causal",
        "durable_inventory",
        "unjournaled_refs",
        "at"
      ],
      "type": "object"
    },
    "durable_chain": {
      "properties": {
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "schema": {
          "const": "FRW-DURABLE-REF-CHAIN-2"
        }
      },
      "required": [
        "schema",
        "ref",
        "previous"
      ],
      "type": "object"
    },
    "fd": {
      "additionalProperties": false,
      "properties": {
        "dev": {
          "minimum": 0,
          "type": "integer"
        },
        "inode": {
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "minimum": 0,
          "type": "integer"
        },
        "nlink": {
          "minimum": 0,
          "type": "integer"
        },
        "uid": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dev",
        "inode",
        "uid",
        "nlink",
        "mode"
      ],
      "type": "object"
    },
    "git_intent": {
      "properties": {
        "GO": {
          "$ref": "#/$defs/ref"
        },
        "GO_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "clock": {
          "$ref": "#/$defs/ref"
        },
        "effect_reservation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "lock": {
          "$ref": "#/$defs/lock"
        },
        "max_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 45,
          "type": "number"
        },
        "publisher_custody": {
          "$ref": "#/$defs/ref"
        },
        "schema": {
          "const": "FRW-GIT-CUSTODIED-INTENT-2"
        },
        "stderr": {
          "$ref": "#/$defs/fd"
        },
        "stdin": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout": {
          "$ref": "#/$defs/fd"
        },
        "useful_deadline_monotonic": {
          "type": "number"
        }
