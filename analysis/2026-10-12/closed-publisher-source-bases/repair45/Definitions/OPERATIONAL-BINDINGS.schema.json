      "required": [
        "schema",
        "GO_sha256",
        "GO",
        "clock",
        "publisher_custody",
        "argv",
        "effect_reservation",
        "stdin",
        "stdout",
        "stderr",
        "lock",
        "useful_deadline_monotonic",
        "max_seconds"
      ],
      "type": "object"
    },
