    "publisher_custody": {
      "properties": {
        "GNU_parent": {
          "$ref": "#/$defs/birth"
        },
        "GO": {
          "$ref": "#/$defs/ref"
        },
        "admitted_at": {
          "type": "number"
        },
        "clock": {
          "$ref": "#/$defs/ref"
        },
        "gates_complete": {
          "const": true
        },
        "lock": {
          "$ref": "#/$defs/lock"
        },
        "publisher": {
          "$ref": "#/$defs/birth"
        },
        "root_identity": {
          "type": "object"
        },
        "schema": {
          "const": "FRW-PUBLISHER-CUSTODY-2"
        },
        "source": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "schema",
        "publisher",
        "GNU_parent",
        "GO",
        "clock",
        "source",
        "root_identity",
        "lock",
        "gates_complete",
        "admitted_at"
      ],
      "type": "object"
    },
    "ref": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    }
