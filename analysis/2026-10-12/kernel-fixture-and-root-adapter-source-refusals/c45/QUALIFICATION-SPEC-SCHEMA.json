{
  "$defs": {
    "pin": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 2097152,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "cross_field_constraints": [
    "host==qualification_probe",
    "actual unchanged original120incl30 clock independently admitted",
    "child+5<=actual already-elapsed outside GNU remaining",
    "beforefirstbirth45 useful remaining on both clocks",
    "outside_root_original_final-20 actor and final-10 stock exact owned pidfds",
    "current qualification_input_pins harmless independently accepted Source only"
  ],
  "no_actual547_installation_receipt_native_app_prerequisite": true,
  "properties": {
    "clock": {
      "$ref": "#/$defs/pin"
    },
    "domain": {
      "const": "kernel120_qualification"
    },
    "host": {
      "$ref": "#/$defs/pin"
    },
    "native": {
      "properties": {
        "outside_actor_stock_guard": {
          "properties": {
            "driver": {
              "$ref": "#/$defs/pin"
            },
            "gnu_timeout_pin": {
              "allOf": [
                {
                  "$ref": "#/$defs/pin"
                },
                {
                  "properties": {
                    "path": {
                      "const": "/usr/bin/gnutimeout"
                    }
                  }
                }
              ]
            },
            "seconds": {
              "maximum": 90,
              "minimum": 51,
              "type": "integer"
            }
          },
          "required": [
            "seconds",
            "driver",
            "gnu_timeout_pin"
          ],
          "type": "object"
        },
        "outside_closure_seconds": {
          "const": 10
        },
        "qualification_input_pins": {
          "items": {
            "$ref": "#/$defs/pin"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "stock_guard_seconds": {
          "maximum": 85,
          "minimum": 46,
          "type": "integer"
        }
      },
      "required": [
        "action_id",
        "group",
        "group_relative",
        "first_birth_group_identity",
        "stock_guard_seconds",
        "outside_closure_seconds",
        "absolute_stop_monotonic",
        "absolute_stop_unix",
        "outside_actor_stock_guard",
        "qualification_input_pins"
      ],
      "type": "object"
    },
    "owner_host": {
      "$ref": "#/$defs/pin"
    },
    "qualification_case": {
      "enum": [
        "BOOTSTRAP_AND_OPAQUE",
        "TASKS128",
        "OUTPUT_OCCUPANCY",
        "ZOMBIE_ADOPTED",
        "ALL_SAFE",
        "ALL_SAFE_THEN_UNKNOWN",
        "UNKNOWN_PRIVATE_CHILD"
      ]
    },
    "qualification_opaque_import": {
      "$ref": "#/$defs/pin"
    },
    "qualification_probe": {
      "$ref": "#/$defs/pin"
    }
  },
  "required": [
    "domain",
    "host",
    "qualification_probe",
    "qualification_opaque_import",
    "owner_host",
    "clock",
    "qualification_case",
    "native",
    "existing_owner",
    "record",
    "qualification_output_identity",
    "qualification_output_mount_id"
  ],
  "title": "C45 harmless qualification Source pins, separate genuine native gates",
  "type": "object"
}
