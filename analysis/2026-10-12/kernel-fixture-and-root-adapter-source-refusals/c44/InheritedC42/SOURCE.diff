+        'actual_pidfd_retained':retained['pidfd'],'original_clock_pin':spec['clock'],
+        'at_unix':time.time(),'at_monotonic':time.monotonic(),'Source_injected_EIO_not_kernel_EIO':True,
+        'capacity_release':False,'replay':False}
