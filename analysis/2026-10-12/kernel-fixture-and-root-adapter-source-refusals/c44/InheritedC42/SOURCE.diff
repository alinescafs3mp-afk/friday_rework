+    require(libc.prctl(38,1,0,0,0)==0,'qualification actual no_new_privs')
+    require(libc.syscall(444,0,0,1)>=3,'qualification actual Landlock ABI3 required')
+    class Ruleset(ctypes.Structure):_fields_=[('handled_access_fs',ctypes.c_uint64)]
+    class PathRule(ctypes.Structure):
+        _pack_=1
+        _fields_=[('allowed_access',ctypes.c_uint64),('parent_fd',ctypes.c_int)]
+    mask=(1<<1)|sum(1<<i for i in range(4,15));rs=Ruleset(mask)
+    fd=libc.syscall(444,ctypes.byref(rs),ctypes.sizeof(rs),0)
+    require(fd>=0,'qualification actual write ruleset');owned=[fd]
