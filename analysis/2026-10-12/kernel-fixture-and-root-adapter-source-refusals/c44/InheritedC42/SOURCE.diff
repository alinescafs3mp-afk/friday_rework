+    rule=PathRule(mask&~((1<<6)|(1<<11)),root)
+    require(libc.syscall(445,fd,1,ctypes.byref(rule),0)==0,'private output write rule only')
+    require(libc.syscall(446,fd,0)==0,'actual inherited qualification write confinement')
+    for x in reversed(owned):os.close(x)
