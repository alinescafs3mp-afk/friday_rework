{
  "$defs": {
    "pin": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 2097152,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "cross_field_actual_kernel_constraints": [
    "child_seconds+10<=outside_seconds",
    "now+outside_seconds+30<original_final on BOTH clocks",
    "now+child_seconds>=fixed_absolute_stop on BOTH clocks before first birth",
    "absolute_stop<=original_final-30 and original-clock dual alignment<=2s",
    "now+1005<min(original_useful,fixed_absolute_stop)",
    "actual retained group FD identity=group inode, hard controllers before clone3, pids.current0",
    "actual outside actor stock cmdline exact reviewed driver; Root actual exclusive existing slot lock FD",
    "capture six applications disjoint initial bootstrap, actual loader execution/object digest"
  ],
  "existing_C39_native_fields_preserved": true,
  "properties": {
    "absolute_stop_monotonic": {
      "type": "number"
    },
    "absolute_stop_unix": {
      "type": "number"
    },
    "first_birth_group_identity": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "outside_actor_stock_guard": {
      "additionalProperties": false,
      "properties": {
        "driver": {
          "$ref": "#/$defs/pin"
        },
        "seconds": {
          "maximum": 1770,
          "minimum": 1016,
          "type": "integer"
        }
      },
      "required": [
        "seconds",
        "driver"
      ],
      "type": "object"
    },
    "outside_closure_seconds": {
      "const": 30
    },
    "stock_guard_seconds": {
      "maximum": 1760,
      "minimum": 1006,
      "type": "integer"
    }
  },
  "required": [
    "stock_guard_seconds",
    "outside_closure_seconds",
    "absolute_stop_monotonic",
    "absolute_stop_unix",
    "first_birth_group_identity",
    "outside_actor_stock_guard"
  ],
  "title": "C41 existing native spec finite extension; consistency only, never authority",
  "type": "object"
}
