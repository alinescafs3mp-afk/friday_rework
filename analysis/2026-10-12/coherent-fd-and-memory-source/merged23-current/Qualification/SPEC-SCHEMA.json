{
  "$defs": {
    "pin": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 2097152,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "actual_cross_field_requirements": [
    "spec.host==qualification_probe; existingOwner FDgroup/slot actualRootowned and exactinodes",
    "Root verified current spec/source/clock pins against existing trusted context BEFORE launcher, no selfJSON authority",
    "distinct_original120/proposed30Cleanup requires actualRootadmission; historicalkernel120 unchanged",
    "fixedstop+5 <= actualalreadyelapsedguardianbirth+timer, never now+renewal",
    "child_relative_expiry+5 <= actualRootguardianExpiry; guardianExpiry+10<=originalfinal; completebatchfits",
    "all actualhardlimits effective beforeclone, protectedwriters disjointunchanged",
    "Root outputownedFDinventory exactclosedonce before normalumount; OriginalRootflock notunlockedbyhelper",
    "Native spec preserves originalC41 schema plus existingOwner consistency and original1800including180; qualification cannotgrantnative"
  ],
  "properties": {
    "caller": {
      "$ref": "#/$defs/pin"
    },
    "clock": {
      "$ref": "#/$defs/pin"
    },
    "descriptor": {
      "$ref": "#/$defs/pin"
    },
    "domain": {
      "const": "kernel120_qualification"
    },
    "entry": {
      "$ref": "#/$defs/pin"
    },
    "helper": {
      "$ref": "#/$defs/pin"
    },
    "host": {
      "$ref": "#/$defs/pin"
    },
    "owner_host": {
      "$ref": "#/$defs/pin"
    },
    "qualification_case": {
      "enum": [
        "BOOTSTRAP_AND_OPAQUE",
        "TASKS128",
        "OUTPUT_OCCUPANCY",
        "ZOMBIE_ADOPTED",
        "ALL_SAFE",
        "ALL_SAFE_THEN_UNKNOWN",
        "UNKNOWN_PRIVATE_CHILD"
      ]
    },
    "qualification_opaque_import": {
      "$ref": "#/$defs/pin"
    },
    "qualification_output_identity": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "qualification_output_mount_id": {
      "minimum": 1,
      "type": "integer"
    },
    "qualification_probe": {
      "$ref": "#/$defs/pin"
    },
    "qualification_unknown_boundary": {
      "enum": [
        null,
        "AFTER_REAL_PIDFD_FSTAT",
        "AFTER_REAL_MAP_GO",
        "AFTER_REAL_INIT_WAIT",
        "AFTER_REAL_PIPE_CLOSE"
      ]
    }
  },
  "required": [
    "domain",
    "owner_host",
    "host",
    "caller",
    "helper",
    "entry",
    "descriptor",
    "clock",
    "record",
    "native",
    "existing_owner",
    "qualification_probe",
    "qualification_opaque_import",
    "qualification_case",
    "qualification_forbidden_private_file",
    "qualification_output_identity",
    "qualification_output_mount_id"
  ],
  "six_cause_Source_overlay_state": "AUTHOR_AST_ONLY_PENDING_NEW_INDEPENDENT_SAFETY_AND_SOURCE_REVIEW_NOT_RUN",
  "title": "existing finite owner qualification input consistency ONLY, NEVER grant",
  "type": "object"
}
