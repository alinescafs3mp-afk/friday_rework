+def delivery_artifacts(row, paths=None):
+    """Select only retained source paths; selection never recollects or replays bytes."""
+    result = row["result"]
+    if paths is None:
+        return result["artifacts"]
+    if (not isinstance(paths, list) or not 1 <= len(paths) <= 16
+            or any(not isinstance(path, str) for path in paths)
+            or len(set(paths)) != len(paths)):
+        raise AssociationError("invalid_delivery_selection")
+    retained = dict(zip(result["source_paths"], result["artifacts"]))
+    if any(path not in retained for path in paths):
+        raise AssociationError("unknown_delivery_path")
+    return [retained[path] for path in paths]
+
