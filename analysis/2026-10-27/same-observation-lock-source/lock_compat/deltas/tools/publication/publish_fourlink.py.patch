 @contextlib.contextmanager
+def native_lock_custody(paths):
+    """Existing native locks may stamp only across their acquisition boundary.
+
+    Hold pre-acquire nofollow descriptors and immutable custody. Full content and
+    all nine identity fields are sealed only while every native lock is held;
+    thereafter even a same-byte rewrite or normal release fails that seal.
+    """
+    stable = ('st_dev', 'st_ino', 'st_uid', 'st_gid', 'st_mode', 'st_nlink')
+    directory_fields = ('st_dev', 'st_ino', 'st_uid', 'st_gid', 'st_mode')
+    def fields(info, keys):
+        return tuple(getattr(info, key) for key in keys)
+    with contextlib.ExitStack() as keep:
+        before = {}
+        for path in paths:
+            reference = pin(path)
+            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+            keep.callback(os.close, fd)
+            first = identity(os.fstat(fd))
+            need(first == identity(path.lstat()) and sha(os.pread(fd, 64 * 1024 ** 2 + 1, 0)) == reference['sha256'], 'native_lock_before_custody_changed')
+            read_ref(reference)
+            need(first == identity(os.fstat(fd)) == identity(path.lstat()), 'native_lock_before_identity_changed')
+            parents = {q:fields(q.lstat(), directory_fields) for q in path.parents}
+            before[path] = (fd, fields(os.fstat(fd), stable), parents)
+        def custody(path):
+            fd, original, parents = before[path]
+            need(fields(os.fstat(fd), stable) == fields(path.lstat(), stable) == original, 'native_lock_custody_changed')
+            need(all(fields(q.lstat(), directory_fields) == original_parent for q, original_parent in parents.items()), 'native_lock_parent_changed')
+            return fd
+        def held(path):
+            fd = custody(path)
+            reference = pin(path)
+            current = identity(os.fstat(fd))
+            stamp = (str(os.getpid()) + '\n').encode('ascii')
+            need(current == identity(path.lstat()) and os.pread(fd, len(stamp) + 1, 0) == stamp and reference['sha256'] == sha(stamp), 'current_native_lock_pid_stamp_required')
+            def prove():
+                custody(path)
+                read_ref(reference)
+                need(current == identity(os.fstat(fd)) == identity(path.lstat()) and os.pread(fd, len(stamp) + 1, 0) == stamp, 'held_native_lock_changed')
+            prove()
+            return prove
+        yield held
+
+
