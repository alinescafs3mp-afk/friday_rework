+"""The installed Friday worker code for a prepared, isolated user profile.
+
+Only code is shared. PluginManager still registers tools, config and state in the
+calling profile, and normal manifest enable/disable checks still apply there.
+"""
+import json
+from pathlib import Path
+
+
+def _enabled(config):
+    plugins = config.get('plugins', {})
+    if not isinstance(plugins, dict):
+        return False
+    enabled, disabled = plugins.get('enabled', []), plugins.get('disabled', [])
+    return (isinstance(enabled, list) and isinstance(disabled, list)
+            and 'friday_rework' in enabled and 'friday_rework' not in disabled)
+
+
+def prepared_friday_plugin(home):
+    """Return the one installed plugin directory, or fail closed without loading it."""
+    source = Path(__file__).resolve().parents[1]
+    root = source.parent
+    home = Path(home)
+    if home.parent != root / 'profiles' or not (home / '.friday-user-scope.json').exists():
+        return None
+    from hermes_cli.friday_dashboard_owner import read_owned, require, sha
+    from hermes_cli.friday_user_scope import MARKER, ScopeDenied, _private, _fingerprint, authority, policy
+    from hermes_cli.friday_product_access import principal_id
+    from hermes_cli.config import load_config_storage_readonly
+
+    try:
+        require(home.resolve() == home and root.resolve() == root)
+        _private(root, directory=True)
+        _private(home.parent, directory=True)
+        _private(home, directory=True)
+        require(_enabled(load_config_storage_readonly()))
+        active = policy(root)
+        rows = [] if active is None else [r for r in active['bindings']
+                                          if r['runtime_profile'] == home.name]
+        require(len(rows) == 1)
+        binding = rows[0]
+        marker = json.loads(read_owned(home / MARKER, private=True))
+        expected = {'schema': 'friday.user-home.v1',
+                    'principal': principal_id(*(binding[k] for k in
+                                              ('platform', 'transport_profile', 'account_id', 'user_id'))),
+                    'profile': home.name, 'binding_sha256': _fingerprint(binding)}
+        if 'onboarding_sha256' in marker:
+            expected['onboarding_sha256'] = sha(read_owned(home / '.friday-onboarding.json', private=True))
+        require(marker == expected)
+        with authority(root):
+            require(_enabled(load_config_storage_readonly()))
+        receipt = json.loads(read_owned(root / 'FRIDAY-INSTALL.json', private=True))
+        require(receipt.get('schema') == 'friday.native-install.v1'
+                and receipt.get('state') == 'INSTALLED_TEMPLATE_INCOMPLETE'
+                and receipt.get('home') == str(root) and receipt.get('source') == str(source))
+        files = receipt.get('plugin_files')
+        require(isinstance(files, dict) and 'plugins/friday_rework/plugin.yaml' in files)
+        target = root / 'plugins/friday_rework'
+        _private(target.parent, directory=True)
+        _private(target, directory=True)
+        for name, digest in files.items():
+            path = Path(name)
+            require(not path.is_absolute() and '..' not in path.parts
+                    and path.parts[:2] == ('plugins', 'friday_rework') and str(path) == name)
+            require(sha(read_owned(root / path, private=True)) == digest)
+        present = set()
+        for path in target.rglob('*'):
+            if path.is_dir():
+                _private(path, directory=True)
+            else:
+                present.add(str(path.relative_to(root)))
+        require(present == set(files))
+        return target
+    except (OSError, ValueError, TypeError, KeyError, ScopeDenied):
+        return None
