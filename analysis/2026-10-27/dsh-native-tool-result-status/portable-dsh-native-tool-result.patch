+    def test_native_tool_error_is_paired_and_can_recover(self):
+        prefix = lines(OPEN, {"type":"status","phase":"turn_start","turn":1},
+                       {"type":"status","phase":"step_start","turn":1,"step":1},
+                       {"type":"tool_call","callId":"c","tool":"read","input":{}})
+        error = {"type":"tool_result","callId":"c","status":"error","result":"read failed"}
+        suffix = lines({"type":"status","phase":"step_end","turn":1,"step":1},
+                       {"type":"status","phase":"step_start","turn":1,"step":2},
+                       {"type":"text","text":"recovered"},
+                       {"type":"status","phase":"step_end","turn":1,"step":2},
+                       {"type":"status","phase":"turn_end","turn":1,"reason":{"kind":"completed"}},
+                       {"type":"final","text":"done"})
+        event = self.reduce(prefix + lines(error) + suffix)
+        self.assertTrue(event.completed and event.final)
+        self.assertFalse(event.failed)
+        self.assertEqual(event.calls, event.results)
+        # A tool error does not invent completion when the native run stops.
+        event = self.reduce(prefix + lines(error))
+        self.assertFalse(event.completed or event.final or event.failed)
+        # The native terminal reason still controls whole-turn failure.
+        event = self.reduce(prefix + lines(error) + suffix.replace(b'"completed"', b'"failed"'))
+        self.assertTrue(event.failed and event.final)
+        self.assertFalse(event.completed)
