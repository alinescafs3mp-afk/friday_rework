+++ b/tests/test_s437_portable_delta.py
@@ -0,0 +1,107 @@
+"""Focused source controls; no native, model, service or external network effects."""
+import ast
+import contextlib
+import copy
+from dataclasses import dataclass
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import types
+import unittest
+from unittest.mock import patch
+
+from test_a0_web_startup import runtime, web, web_plan
+import test_a0_web_startup as fixtures
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def failure(state='STARTING', phase='supervisor', error='AssertionError', pid=11):
+    return {'status': 'NATIVE_WEB_PROBE_REFUSED', 'phase': phase, 'error_class': error,
+        'supervisor': {'count': 2, 'processes': [
+            {'name': 'run_ui', 'statename': state, 'pid': pid, 'start': 10, 'exitstatus': 0},
+            {'name': 'run_searxng', 'statename': 'RUNNING', 'pid': 12, 'start': 10, 'exitstatus': 0}]}}
+
+
+def healthy(pid=11):
+    return {'status': 'CURRENT_NATIVE_WEB_SERVICE_CHECKED', 'version': 'offline-version',
+        'processes': [dict(name='run_ui', statename='RUNNING', pid=pid, start=10),
+                      dict(name='run_searxng', statename='RUNNING', pid=12, start=10)]}
+
+
+class PortableDelta(unittest.TestCase):
+    def run_probe(self, observations, *, startup):
+        raw = tempfile.TemporaryDirectory()
+        self.addCleanup(raw.cleanup)
+        root = Path(raw.name)
+        instance = fixtures.WebStartup().receipt_runtime(root)
+        for relative, value in web.service_files(web_plan()).items():
+            path = root / 'usr' / relative
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(value if isinstance(value, str) else json.dumps(value))
+        instance.check_network = lambda **kw: None
+        instance.locked = contextlib.nullcontext
+        responses = iter(observations)
+        seen = []
+        def docker(*args, **kw):
+            seen.append(args)
+            return json.dumps(next(responses))
+        instance.docker = docker
+        with patch.object(runtime, 'web_module', return_value=web), patch.object(runtime.time, 'sleep'):
+            result = instance.check_web('a' * 64, startup=startup)
+        return result, seen
+
+    def test_starting_and_connecting_only_observe_same_identity(self):
+        got, seen = self.run_probe([failure(), failure('RUNNING', 'http_connecting', 'OSError'), healthy()], startup=True)
+        self.assertEqual(got, healthy())
+        self.assertEqual(len(seen), 3)
+        self.assertTrue(all(args[0] == 'exec' for args in seen))
+
+    def test_nonstartup_and_fatal_fail_without_passive_retry(self):
+        for observed, startup in [(failure(), False), (failure('FATAL'), True),
+                (failure('RUNNING', 'http_config', 'OSError'), True)]:
+            with self.subTest(observed=observed, startup=startup):
+                with self.assertRaisesRegex(runtime.RuntimeErrorBoundary, 'a0_native_web_probe_'):
+                    self.run_probe([observed], startup=startup)
+
+    def test_changed_identity_refuses_on_retry_and_final_success(self):
+        for followup in (failure(pid=13), healthy(pid=13)):
+            with self.subTest(followup=followup):
+                with self.assertRaisesRegex(runtime.RuntimeErrorBoundary, 'a0_native_web_service_replaced'):
+                    self.run_probe([failure(), followup], startup=True)
+
+    def test_supervisor_fields_are_typed_bounded_and_closed(self):
+        observed = failure()
+        self.assertEqual(runtime.web_probe_failure_checked(observed), observed)
+        bad = []
+        for name, value in [('pid', True), ('start', 2**63), ('exitstatus', 256),
+                ('name', 'PRIVATE_SENTINEL'), ('statename', 'PRIVATE_SENTINEL')]:
+            item = copy.deepcopy(observed)
+            item['supervisor']['processes'][0][name] = value
+            bad.append(item)
+        item = copy.deepcopy(observed); item['supervisor']['message'] = 'PRIVATE_SENTINEL'; bad.append(item)
+        for item in bad:
+            with self.subTest(item=item), self.assertRaises(runtime.RuntimeErrorBoundary):
+                runtime.web_probe_failure_checked(item)
+
+    def test_retained_created_without_grant_has_pregrant_cessation(self):
+        tree = ast.parse((ROOT / 'plugins/friday_rework/host_runtime.py').read_text())
+        cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == 'A0HostSession')
+        method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == 'quiescence')
+        # The two imports are irrelevant to the pre-grant path; retain its exact body.
+        method.body = [n for n in method.body if not isinstance(n, ast.ImportFrom)]
+        namespace = {}
+        exec(compile(ast.fix_missing_locations(ast.Module(body=[method], type_ignores=[])), '<quiescence>', 'exec'), namespace)
+        subject = types.SimpleNamespace(native_cessation=True, unit=types.SimpleNamespace(), route=None,
+            route_only_confirmed=False, no_create_confirmed=False, pre_grant_confirmed=False,
+            created={'container_id': 'a'*64, 'plan_sha256': 'b'*64}, grant={'container_id': 'a'*64},
+            store=types.SimpleNamespace(clock=lambda: 123), key_cleanup='REMOVED')
+        # Supply dataclass serialization for the neutral unit only.
+        namespace['asdict'] = lambda obj: {'quiescent': True}
+        row = {'host': {'a0': {'grant': None}}}
+        self.assertEqual(namespace['quiescence'](subject, row)['kind'], 'a0_pre_grant')
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
