+def _own_web_attribution(session, call, identity, recovery_blocked):
+    recovery = ([ 'registry_recovery_blocked' ] if recovery_blocked else [])
+    if session['detached']:
+        recovery.append('detached_registry_session')
+    if recovery:
+        return 'RECOVERY', recovery
+    if call is None:
+        return 'UNMATCHED', ['registered_call_unavailable']
+    foreign, unknown = [], []
+    comparisons = (
+        ('parent_session', session['parent_session_id'], call['session_id']),
+        ('session_key', session['session_key'], call['session_key']),
+        ('task', session['owner_task_id'], call['task_id']),
+        ('raw_task', session['task_id'], call['task_id']),
+        ('turn', session['web_turn_id'], call['turn_id']),
+        ('call', session['web_tool_call_id'], call['call_id']),
+        ('principal', session['user_authority'], call['user_authority']),
+        ('active_session', call['session_id'], identity['session_id']),
+        ('active_key', call['session_key'], identity['session_key']),
+        ('active_task', call['task_id'], identity['task_id']),
+        ('active_turn', call['turn_id'], identity['turn_id']),
+        ('active_principal', call['user_authority'], identity['user_authority']),
+    )
+    for name, left, right in comparisons:
+        if left is None or right is None or left == '' or right == '':
+            unknown.append(name + '_missing')
+        elif left != right:
+            foreign.append(name + '_mismatch')
+    for flag in ('same_active_agent', 'same_web_turn'):
+        if call[flag] is not True:
+            foreign.append(flag)
+    for flag in ('same_registry_session', 'registered_on_agent', 'uses_web'):
+        if call[flag] is not True:
+            unknown.append(flag)
+    if session['web_custody'] is not True:
+        unknown.append('web_custody_missing')
+    if foreign:
+        return 'FOREIGN', sorted(foreign + unknown)
+    if unknown:
+        return 'UNKNOWN', sorted(unknown)
+    return 'OWN', []
+
