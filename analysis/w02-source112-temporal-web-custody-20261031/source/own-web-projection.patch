+    def web_custody_readonly(self):
+        """Project exact retained custody without settling or adopting foreign work."""
+        from copy import deepcopy
+        with self._lock:
+            retained = [s for s in self._running.values()
+                        if s.web_custody and (not s.web_settled or s._scope_stop_pending)]
+            blocked = bool(getattr(self, '_custody_recovery_blocked', False))
+            receipt = {'status':'STOP_UNCONFIRMED' if retained or blocked else 'QUIESCENT',
+                       'sessions':[s.id for s in retained], 'recovery_blocked':blocked}
+            sessions = [dict(id=s.id, task_id=s.task_id, owner_task_id=s.owner_task_id,
+                session_key=s.session_key, parent_session_id=s.parent_session_id,
+                user_authority=deepcopy(s.user_authority), web_tool_call_id=s.web_tool_call_id,
+                web_turn_id=s.web_turn_id, web_boot_id=s.web_boot_id, web_deadline=s.web_deadline,
+                web_custody=s.web_custody, web_unconfirmed=s.web_unconfirmed,
+                web_settled=s.web_settled, web_stop_requested=s.web_stop_requested,
+                detached=s.detached, exited=s.exited, scope_stop_pending=s._scope_stop_pending,
+                call=None) for s in retained]
+        return {'receipt':receipt, 'recovery_blocked':blocked, 'sessions':sessions}
