--- /dev/null
+++ b/agent/friday_baseline_bridge.py
@@ -0,0 +1,153 @@
+"""Optional idle-baseline bridge. This file is the only native addition.
+
+Friday remains available if the separately prepared baseline package breaks.
+No package installation, network, service, watcher or credential handling.
+"""
+from __future__ import annotations
+
+import functools
+import importlib
+import os
+from pathlib import Path
+import sys
+import uuid
+import hashlib
+
+BASELINE_ROOT = Path("/opt/friday-public-baseline")
+COORDINATOR = BASELINE_ROOT / "runs/.admission/PUBLIC_COORDINATOR_SLOT"
+ENV = "FRIDAY_BASELINE_COORDINATOR_DIR"
+
+
+def _fault(reason):
+    """Use the canonical slot even if an environment path is malformed."""
+    try:
+        if COORDINATOR.is_symlink():
+            return  # The baseline coordinator rejects this independently.
+        COORDINATOR.mkdir(parents=True, exist_ok=True, mode=0o700)
+        st = COORDINATOR.stat()
+        if st.st_uid != os.getuid() or st.st_mode & 0o077:
+            return  # Independently fails the background safe-directory check.
+        fd = os.open(COORDINATOR / "FAULT", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        try:
+            os.write(fd, ("friday_bridge:" + reason[:96] + "\n").encode())
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+    except (Exception, SystemExit):
+        pass
+
+
+def _load():
+    try:
+        value = os.environ.get(ENV)
+        if not value:
+            # This finite native installation activates the one canonical
+            # admission slot for every ordinary client, including fresh CLI
+            # processes that did not inherit a gateway service environment.
+            value = str(COORDINATOR)
+            os.environ[ENV] = value
+        given = Path(value)
+        if given.is_symlink() or given.resolve() != COORDINATOR.resolve():
+            raise ValueError("noncanonical_coordinator")
+        # A protected owner home supplies the ancestor boundary. Do not chmod
+        # historical files merely to satisfy this reader.
+        for path in (BASELINE_ROOT, BASELINE_ROOT / "qpb", BASELINE_ROOT / "qpb/friday_adapter.py"):
+            if path.is_symlink() or path.stat().st_uid != os.getuid():
+                raise ValueError("foreign_baseline_path")
+        existing = sys.modules.get("qpb")
+        if existing is not None and Path(existing.__file__).resolve().parent != BASELINE_ROOT / "qpb":
+            raise ValueError("foreign_qpb_module")
+        root = str(BASELINE_ROOT)
+        if root not in sys.path:
+            sys.path.insert(0, root)
+        module = importlib.import_module("qpb.friday_adapter")
+        if Path(module.__file__).resolve() != BASELINE_ROOT / "qpb/friday_adapter.py":
+            raise ValueError("foreign_adapter_module")
+        return module
+    except (Exception, SystemExit) as exc:
+        _fault(type(exc).__name__)
+        return None
+
+
+def _call(name, *args, **kwargs):
+    module = _load()
+    if module is None:
+        return None
+    try:
+        result = getattr(module, name)(*args, **kwargs)
+        if (name == "begin" and result is None) or (name == "end" and result is False):
+            _fault(name + "_failed")
+        return result
+    except (Exception, SystemExit) as exc:
+        _fault(type(exc).__name__)
+        return None
+
+
+def physical_create(client, request):
+    module = _load()
+    if module is None:
+        return client.chat.completions.create(**request)
+    try:
+        callback = getattr(module, "physical_create")
+        if not callable(callback):
+            raise TypeError("physical_create unavailable")
+    except (Exception, SystemExit) as exc:
+        _fault(type(exc).__name__)
+        return client.chat.completions.create(**request)
+    # Do not catch-and-retry here: an exception can be the actual accepted
+    # model request's failure, which the original Friday caller must see.
+    return callback(client, request)
+
+
+def tracked(client):
+    def decorate(function):
+        @functools.wraps(function)
+        def wrapped(*args, **kwargs):
+            token = _call("begin", client, uuid.uuid4().hex)
+            try:
+                result = function(*args, **kwargs)
+            except BaseException:
+                _call("end", token, outcome_known=False)
+                raise
+            _call("end", token)
+            return result
+        return wrapped
+    return decorate
+
+
+def atracked(client):
+    def decorate(function):
+        @functools.wraps(function)
+        async def wrapped(*args, **kwargs):
+            token = _call("begin", client, uuid.uuid4().hex)
+            try:
+                result = await function(*args, **kwargs)
+            except BaseException:
+                _call("end", token, outcome_known=False)
+                raise
+            _call("end", token)
+            return result
+        return wrapped
+    return decorate
+
+
+def observe_worker(row):
+    _call("observe_worker", row)
+
+
+def start_worker(row):
+    _call("start_worker", row)
+
+
+def session_guard_change(adapter, session_key, old_guard, new_guard):
+    try:
+        group = hashlib.sha256(f"{os.getpid()}:{id(adapter)}:{session_key}".encode()).hexdigest()
+        pending = session_key in getattr(adapter, "_pending_messages", {})
+        runner = getattr(adapter, "gateway_runner", None)
+        if runner is not None and hasattr(runner, "_overflow_queue"):
+            pending = pending or bool(runner._overflow_queue(session_key))
+        _call("session_guard_change", group,
+              str(id(old_guard)) if old_guard is not None else None,
+              str(id(new_guard)) if new_guard is not None else None, pending)
+    except (Exception, SystemExit) as exc:
+        _fault("session_guard:" + type(exc).__name__)
