+def cli_host_phase(home, *, full=False):
+    """Installed CLI stage is a bounded subset, never a full-start grant."""
+    from hermes_cli.friday_dashboard_owner import read_owned
+    import sys, time, math, argparse
+    marker = json.loads(read_owned(Path(home) / 'FRIDAY-INSTALL.json', private=True))
+    stage = marker.get('completion_stage')
+    if stage is None:
+        return  # Existing installations keep their unchanged native contract.
+    require(stage == 'CLI_HOST_ONLY', 'unknown_completion_stage')
+    require(not full and marker.get('state') == 'INSTALLED_TEMPLATE_INCOMPLETE'
+            and marker.get('home') == str(home) and marker.get('runtime_ready') is False
+            and marker.get('worker_state') == 'BOTH_WORKERS_PREPARATION_PENDING',
+            'cli_host_full_start_refused')
+    claim = marker.get('original_attempt', {})
+    deadline = claim.get('deadline_mono')
+    require(claim.get('boot_id') == Path('/proc/sys/kernel/random/boot_id').read_text().strip()
+            and type(deadline) in (int, float) and math.isfinite(deadline)
+            and time.monotonic() < deadline, 'cli_host_original_clock_expired')
+    class Parser(argparse.ArgumentParser):
+        def error(self, message):
+            raise CredentialDenied('cli_host_arguments_refused')
+    parser = Parser(add_help=False, allow_abbrev=False)
+    parser.add_argument('--cli', action='store_true')
+    parser.add_argument('-q', '--query', required=True)
+    parser.add_argument('-Q', '--quiet', action='store_true')
+    parser.add_argument('--one-shot', action='store_true')
+    parser.add_argument('--resume', '-r')
+    parser.add_argument('--no-resume-cwd', action='store_true')
+    parser.add_argument('--format', choices=('text', 'stream-json'))
+    parser.add_argument('-t', '--toolsets')
+    args = list(sys.argv[1:])
+    if args[:1] in (['-p'], ['--profile']):
+        require(args[1:2] == ['default'], 'cli_host_foreign_profile_refused')
+        args = args[2:]
+    if args[:1] == ['--cli']:
+        args.pop(0); prefix = ['--cli']
+    else:
+        prefix = []
+    require(args[:1] == ['chat'], 'cli_host_arguments_refused')
+    checked = parser.parse_args(prefix + args[1:])
+    require(checked.cli and isinstance(checked.query, str) and bool(checked.query)
+            and (checked.toolsets is None or set(checked.toolsets.split(',')) <=
+                 {'file', 'session_search', 'friday_rework'}), 'cli_host_arguments_refused')
+
