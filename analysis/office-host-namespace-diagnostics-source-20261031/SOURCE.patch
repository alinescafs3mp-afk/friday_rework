+# Failure diagnostics share the existing31MiB export ceiling. Normal artifacts
+# leave room for one bounded raw combined log and its numeric/resource record.
+HELPER_LOG_CAP = 64 * 1024
+HELPER_DIAGNOSTIC_CAP = 16 * 1024
+DIAGNOSTIC_RESERVE = 128 * 1024
+
+
+def helper_resource_snapshot(cgroup):
+    """Allowlisted resource facts only: no environment or document contents."""
+    usage = resource.getrusage(resource.RUSAGE_CHILDREN)
+    observed = {'children_user_cpu_seconds': usage.ru_utime,
+                'children_system_cpu_seconds': usage.ru_stime,
+                'children_maxrss_kib_high_water': usage.ru_maxrss,
+                'cgroup': {}}
+    for name in ('memory.events', 'memory.peak', 'memory.current', 'cpu.stat', 'pids.current'):
+        try:
+            with (cgroup / name).open('rb') as stream:
+                data = stream.read(513)
+            require(len(data) <= 512, 'resource observation cap')
+            observed['cgroup'][name] = data.decode('ascii').strip()
+        except Exception as exc:
+            observed['cgroup'][name] = {'unavailable_class': type(exc).__name__}
+    return observed
+
+
+def observed_helper(argv, helper_env, end, scratch, records, emit_data,
+                    stage=None, stage_states=None):
+    """Run once; export protected bounded failure facts before propagating failure.
+
+    Raw combined stdout/stderr remains a private artifact. A truncated log is
+    explicitly an exact prefix, never described as the complete helper output.
+    """
+    index = len(records)
+    log = scratch / ('helper-' + str(index) + '.log')
+    record = {'argv': argv, 'state': 'INTENT_BEFORE_POPEN', 'exit_code': None,
+              'started_monotonic': time.monotonic(), 'pid': None,
+              'process_reaped': False,
+              'resource_before': helper_resource_snapshot(Path('/mnt/observer-cgroup'))}
+    if stage is not None:
+        record['stage'] = stage
+    records.append(record)
+    process, failure = None, None
+    try:
+        with log.open('xb') as stream:
+            process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=stream, stderr=stream,
+                                       env=helper_env, start_new_session=True)
+            record.update(pid=process.pid, state='STARTED_EFFECT_UNKNOWN_UNTIL_RECONCILED')
+            if stage_states is not None:
+                stage_states[stage] = 'STARTED_EFFECT_UNKNOWN_UNTIL_RECONCILED'
+            try:
+                process.wait(timeout=max(0.01, end - time.monotonic() - 2))
+            except BaseException:
+                try:
+                    os.killpg(process.pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+                process.wait(timeout=min(1, max(0.01, end - time.monotonic())))
+                raise
+        record['state'] = 'PROCESS_RETURNED'
+        require(process.returncode == 0, 'helper did not complete successfully')
+    except BaseException as exc:
+        failure = exc
+        record['exception_class'] = type(exc).__name__
+        if process is None:
+            record['state'] = 'POPEN_NOT_COMPLETED_EFFECT_NOT_ESTABLISHED'
+    finally:
+        if process is not None:
+            record['exit_code'] = process.returncode
+            record['process_reaped'] = process.returncode is not None
+            record['exit_signal'] = -process.returncode if process.returncode is not None and process.returncode < 0 else None
+        record['observation_monotonic'] = time.monotonic()
+        if record['process_reaped']:
+            record['process_returned_monotonic'] = record['observation_monotonic']
+            record['process_elapsed_seconds'] = record['process_returned_monotonic'] - record['started_monotonic']
+        record['resource_after'] = helper_resource_snapshot(Path('/mnt/observer-cgroup'))
+        if failure is not None:
+            try:
+                try:
+                    with log.open('rb') as stream:
+                        retained = stream.read(HELPER_LOG_CAP)
+                        total = os.fstat(stream.fileno()).st_size
+                    log_ref = {'name': log.name, 'source_bytes': total, 'retained_bytes': len(retained),
+                               'retained_range': [0, len(retained)], 'complete': total == len(retained),
+                               'sha256': digest(retained), 'stream': 'EXACT_COMBINED_STDOUT_STDERR_BYTES',
+                               'handling': 'PROTECTED_NOT_FOR_PUBLICATION'}
+                except OSError as exc:
+                    retained = None
+                    log_ref = {'name': log.name, 'complete': False, 'source_bytes': None,
+                               'unavailable_class': type(exc).__name__}
+                diagnostic = {'schema': 'frw.helper-failure-diagnostics.v1', 'helper': record,
+                              'log': log_ref, 'cause': 'UNKNOWN_UNLESS_EXACT_OBSERVATIONS_ESTABLISH_IT',
+                              'effect_repeat_authorized': False}
+                payload = json_bytes(diagnostic)
+                require(len(payload) <= HELPER_DIAGNOSTIC_CAP, 'helper diagnostic cap')
+                result_name = 'HELPER-' + str(index) + '-RESULT.json'
+                # No scratch copies: even ENOSPC in the bounded tmpfs must not
+                # discard an existing log. Outer receiver fsyncs owned0600 files.
+                # Keep the same worker end; no extra operation/cleanup budget.
+                if retained is not None:
+                    emit_data(log.name, retained, diagnostic=True)
+                emit_data(result_name, payload, diagnostic=True)
+                record['failure_diagnostics'] = {'log': log_ref,
+                    'result_name': result_name, 'result_sha256': digest(payload)}
+            except Exception as exc:
+                record['diagnostic_export_error_class'] = type(exc).__name__
+    if failure is not None:
+        raise failure
+    with log.open('rb') as stream:
+        stream.seek(max(0, os.fstat(stream.fileno()).st_size - 8192))
+        return stream.read(8192).decode('utf-8', 'replace')
+
