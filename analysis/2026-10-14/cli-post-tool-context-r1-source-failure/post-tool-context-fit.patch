+def bounded_preflight_tool_progress(agent: Any, messages: list) -> bool:
+    """Reconsider a no-op only after a NEW complete tool round; never reset attempts.
+
+    Request-only injections, usage readings and repeated rebuilds cannot clear the
+    latch. Keep the fingerprint on the agent's admitted turn, outside durable rows.
+    """
+    import hashlib
+    if not isinstance(getattr(agent, "_bounded_context_policy", None), BoundedContextPolicy):
+        return False
+    turn = getattr(agent, "_current_turn_timestamp", None)
+    previous = getattr(agent, "_bounded_preflight_tool_progress", None)
+    fingerprint = hashlib.sha256(json.dumps(messages, ensure_ascii=False,
+        separators=(",", ":"), allow_nan=False).encode("utf-8")).hexdigest()
+    current = (turn, len(messages), fingerprint)
+    agent._bounded_preflight_tool_progress = current
+    if not previous or previous[0] != turn or len(messages) <= previous[1] or fingerprint == previous[2]:
+        return False
+    end = len(messages)
+    start = end
+    while start and messages[start - 1].get("role") == "tool":
+        start -= 1
+    if start == end or not start or messages[start - 1].get("role") != "assistant":
+        return False
+    calls = messages[start - 1].get("tool_calls")
+    if not isinstance(calls, list) or not calls:
+        return False
+    ids = [call.get("id") for call in calls if isinstance(call, dict)]
+    results = [row.get("tool_call_id") for row in messages[start:end]]
+    return bool(len(ids) == len(calls) == len(results) and all(isinstance(v, str) and v for v in ids)
+                and len(set(ids)) == len(ids) and set(ids) == set(results))
