+# Two parsed retained config payloads, never evidence or dispatch authority.
+# Each caller still authenticates current bytes with read() before this helper.
+# The exact gate namespace is retained only in this tester process; no disk cache.
+_FOURLINK_YAML_PARSES = []
+
+
+def _fourlink_yaml(raw):
+    import yaml
+    for held, parsed in _FOURLINK_YAML_PARSES:
+        if raw == held:
+            return copy.deepcopy(parsed)
+    parsed = yaml.safe_load(raw)
+    if len(raw) <= 8 * 1024**2:
+        if len(_FOURLINK_YAML_PARSES) == 2:
+            _FOURLINK_YAML_PARSES.pop(0)
+        _FOURLINK_YAML_PARSES.append((raw, copy.deepcopy(parsed)))
+    return parsed
+
