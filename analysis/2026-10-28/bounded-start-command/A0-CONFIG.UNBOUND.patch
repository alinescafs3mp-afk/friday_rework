+def _reviewed_extended_command(command, image, memory_guard, web):
+    """One reviewed Runtime78 composition; never a general long-shell limit.
+
+    The generator's memory/web installers exceed the legacy short-command cap.
+    Any changed producer bytes or dependencies need a separate source review.
+    No asset read here: retained owned stop must remain independent of assets.
+    """
+    if not (len(command) == 8359 and command.isascii()
+            and hashlib.sha256(command.encode('ascii')).hexdigest()
+                == 'UNBOUND_REVIEWED_COMMAND_SHA256'
+            and image == 'sha256:UNBOUND_REVIEWED_IMAGE'
+            and isinstance(memory_guard, PinnedFile)
+            and memory_guard.sha256 == 'UNBOUND_REVIEWED_MEMORY_GUARD_SHA256'
+            and isinstance(web, dict)):
+        return False
+    try:
+        return digest(web) == 'UNBOUND_REVIEWED_WEB_DESCRIPTOR_SHA256'
+    except (TypeError, ValueError):
+        return False
+
