+"""Exact canonical storage-only config reader with one scoped N15 dependency edge."""
+from pathlib import Path
+import builtins,hashlib,sys,types
+H=Path('UNBOUND_PRIVATE_PATH_065')
+N=H/'installs/UNBOUND_DIGEST_016/environments/UNBOUND_DIGEST_007/workspace'
+CONFIG_REF={'path': 'UNBOUND_PRIVATE_PATH_066', 'sha256': 'UNBOUND_DIGEST_008'}
+HOME_REF={'path': 'UNBOUND_PRIVATE_PATH_067', 'sha256': 'UNBOUND_DIGEST_033'}
+NATIVE_CONFIG_REF={'path': 'UNBOUND_PRIVATE_PATH_068', 'sha256': 'UNBOUND_DIGEST_003'}
+
+SUPPORT_REF={'path': 'UNBOUND_PRIVATE_PATH_020', 'sha256': 'UNBOUND_DIGEST_005'}
+
+def load(home,read):
+    from hermes_cli import config as native
+    from hermes_cli import friday_user_scope as scope
+    if Path(native.__file__).resolve()!=Path(NATIVE_CONFIG_REF['path']):raise ValueError('exact_N15_config_required')
+    support={'__file__':SUPPORT_REF['path'],'__name__':'_config_v3_native_custody'}
+    exec(compile(read(SUPPORT_REF),SUPPORT_REF['path'],'exec'),support)
+    support['read'](NATIVE_CONFIG_REF,private=False)
+    if home!=H/'profiles/UNBOUND_PROFILE' or native.get_hermes_home()!=home:raise ValueError('exact_current_child_scope_required')
+    homes=types.ModuleType('_frw_completion_v3_config_home');homes.__file__=HOME_REF['path'];sys.modules[homes.__name__]=homes
+    exec(compile(support['read'](HOME_REF,private=False),HOME_REF['path'],'exec'),homes.__dict__)
+    config=types.ModuleType('_frw_completion_v3_storage_config');config.__file__=CONFIG_REF['path'];sys.modules[config.__name__]=config
+    original_import=builtins.__import__
+    def scoped_import(name,globals=None,locals=None,fromlist=(),level=0):
+        if globals is config.__dict__ and name=='hermes_cli.config_home' and tuple(fromlist)==('validate_home_readonly',) and level==0:
+            return homes
+        return original_import(name,globals,locals,fromlist,level)
+    config.__dict__['__builtins__']=dict(vars(builtins),__import__=scoped_import)
+    exec(compile(read(CONFIG_REF),CONFIG_REF['path'],'exec'),config.__dict__)
+    if config.get_hermes_home()!=home:raise ValueError('canonical_reader_scope_changed')
+    result=config.load_config_storage_readonly()
+    if config.get_hermes_home()!=home or native.get_hermes_home()!=home:raise ValueError('reader_scope_changed')
+    return result
