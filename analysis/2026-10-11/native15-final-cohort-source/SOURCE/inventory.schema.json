            "maxItems": 24000
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 24000
          },
          "elf": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "elf_class": {
                    "const": 64
                  },
                  "byte_order": {
                    "const": "little"
                  },
                  "type": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "machine": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pt_interp": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "needed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 24000
