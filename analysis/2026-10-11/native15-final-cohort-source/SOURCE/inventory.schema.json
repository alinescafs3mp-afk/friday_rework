  "required": [
    "schema",
    "scope",
    "admission",
    "runtime",
    "complete_observation",
    "roots",
    "seeds",
    "root_modules",
    "nodes",
    "edges",
    "gaps",
    "capture",
    "original_deadline_monotonic",
    "graph_sha256",
    "custody"
