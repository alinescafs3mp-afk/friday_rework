                        "flags": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "offset": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "bytes": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "type",
                        "flags",
                        "offset",
                        "bytes"
