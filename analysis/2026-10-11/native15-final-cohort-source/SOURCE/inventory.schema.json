  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:friday:startup-closure-inventory:1",
  "$comment": "Source observations only. inventory_consumer.py requires exact owner input pins, held buffers/AST, original deadline, mandatory gaps, all graph edges, digest and totals; runtime admission unconditional refusal."
}
