    "complete_observation": {
      "const": true
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 24000
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 24000
    },
    "root_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 24000
    },
