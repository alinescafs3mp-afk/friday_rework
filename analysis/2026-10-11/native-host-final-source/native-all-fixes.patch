+def exact_packet(packet, expected, reason):
+    """Whole canonical bytes retain types that Python numeric equality loses."""
+    need(type(packet) is dict and type(expected) is dict, reason)
+    raw = canonical_json(packet)
+    exact_json(raw)
+    need(raw == canonical_json(expected), reason)
+    return raw
+
+
+def exact_birth_packet(birth):
