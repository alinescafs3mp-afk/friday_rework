+def unix_endpoint_inodes(raw):
+    """Unknown, incomplete or malformed kernel reads never prove absence."""
+    need(type(raw) is bytes and 0 < len(raw) <= 4 * 1024 ** 2
+         and raw.endswith(b'\n'), 'COMPLETE_BOUNDED_UNIX_TABLE')
+    lines = raw.decode('ascii').splitlines()
+    need(lines and lines[0].split() ==
+         ['Num', 'RefCount', 'Protocol', 'Flags', 'Type', 'St', 'Inode', 'Path']
+         and len(lines) <= 65537, 'EXACT_UNIX_TABLE_HEADER_AND_BOUND')
+    active = set()
+    for line in lines[1:]:
+        fields = line.split(maxsplit=7)
+        need(len(fields) in (7, 8), 'COMPLETE_UNIX_TABLE_ROW')
+        patterns = (r'[0-9a-fA-F]{8,16}:', r'[0-9a-fA-F]{8}',
+                    r'[0-9a-fA-F]{8}', r'[0-9a-fA-F]{8}',
+                    r'[0-9a-fA-F]{4}', r'[0-9a-fA-F]{2}', r'[1-9][0-9]*')
+        need(all(re.fullmatch(pattern, value) is not None
+                 for pattern, value in zip(patterns, fields[:7])),
+             'EXACT_UNIX_TABLE_ROW_FIELDS')
+        inode = int(fields[6])
+        need(inode not in active, 'DUPLICATE_UNIX_TABLE_INODE')
+        active.add(inode)
+    return active
 
 
