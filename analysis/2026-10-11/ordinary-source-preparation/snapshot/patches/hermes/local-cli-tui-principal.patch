--- /dev/null
+++ b/tui_gateway/authz.py
@@ -0,0 +1,212 @@
+"""Retain the ordinary CLI capability on the original native stdio channel.
+
+This module never admits an OS user or authenticates a network peer. Admission
+belongs to friday_cli_principal; these checks precede native readers/effects.
+"""
+from pathlib import Path
+import os
+
+_stdio = None
+_principal = None
+_process_id = None
+
+# Only the native routes covered by this source package. Other donor surfaces
+# keep their legacy contract when isolation is disabled, and fail closed here.
+_RPC = frozenset({
+    "client.capabilities", "session.create", "session.list", "session.most_recent",
+    "session.resume", "session.active_list", "session.activate", "session.title",
+    "session.close", "session.interrupt", "session.compress", "session.events.since",
+    "session.events.stats", "prompt.submit", "request.answer", "clarify.lock",
+    "approval.pending", "approval.received", "approval.respond", "commands.catalog",
+    "complete.slash", "command.dispatch", "slash.exec",
+})
+_LIVE_REQUIRED = frozenset({
+    "session.activate", "session.title", "session.close", "session.interrupt",
+    "session.compress", "session.events.since", "session.events.stats",
+    "prompt.submit", "request.answer", "clarify.lock", "approval.pending",
+    "approval.received", "approval.respond", "command.dispatch", "slash.exec",
+})
+_SLASH_READS = frozenset({"context", "usage", "status"})
+
+
+def _deny():
+    from hermes_cli.friday_user_scope import ScopeDenied
+    raise ScopeDenied()
+
+
+def current():
+    from hermes_cli.friday_cli_principal import current_cli, refuse_unbound_tui
+    cap = current_cli(required=_principal is not None)
+    if cap is None:
+        refuse_unbound_tui()
+        return None
+    if (cap is not _principal or _process_id != os.getpid()
+            or cap.principal[0] != "cli"):
+        _deny()
+    return cap
+
+
+def prepare_stdio(capability):
+    """Retain entry admission before the facade imports its native readers."""
+    global _principal, _process_id
+    if capability is None:
+        return
+    from hermes_cli.friday_cli_principal import current_cli
+    if _principal is not None or current_cli(required=True) is not capability:
+        _deny()
+    _principal, _process_id = capability, os.getpid()
+    current()
+
+
+def bind_stdio(transport, capability):
+    """Finish the entry's binding with the facade's exact original stdio object."""
+    global _stdio
+    if capability is None:
+        return
+    from hermes_cli.friday_cli_principal import current_cli
+    from tui_gateway.transport import StdioTransport
+    from tui_gateway import server
+    if (transport is not server._stdio_transport
+            or type(transport) is not StdioTransport or _stdio is not None
+            or _principal is not capability
+            or current_cli(required=True) is not capability):
+        _deny()
+    _stdio = transport
+    current()
+
+
+def check_transport(transport):
+    cap = current()
+    if cap is not None and (_stdio is None or transport is not _stdio):
+        _deny()
+    return cap
+
+
+def check_profile(profile=None, home=None):
+    cap = current()
+    if cap is None:
+        return None
+    if profile not in (None, "", "default", cap.profile):
+        _deny()
+    if home is not None and Path(home) != cap.home:
+        _deny()
+    from hermes_constants import get_hermes_home
+    if get_hermes_home() != cap.home:
+        _deny()
+    return cap
+
+
+def session_fields(transport):
+    cap = check_transport(transport)
+    if cap is None:
+        return {}
+    return {"_friday_cli_principal": cap,
+            "_friday_cli_generation": cap.admission_generation,
+            "_friday_cli_session_authority": dict(cap.session_authority),
+            "auth_user_id": cap.principal[3]}
+
+
+def check_session(session, transport=None):
+    cap = current()
+    retained = session.get("_friday_cli_principal") if isinstance(session, dict) else None
+    if cap is None:
+        if retained is not None:
+            _deny()
+        return None
+    if (not isinstance(session, dict) or retained is not cap
+            or session.get("_friday_cli_generation") != cap.admission_generation
+            or session.get("_friday_cli_session_authority") != cap.session_authority
+            or session.get("auth_user_id") != cap.principal[3]
+            or session.get("source") not in {"tui", "cli"}
+            or session.get("transport") is not _stdio):
+        _deny()
+    check_profile(home=session.get("profile_home") or cap.home)
+    check_workspace(session.get("cwd"))
+    if transport is not None:
+        check_transport(transport)
+    agent = session.get("agent")
+    if agent is not None:
+        from hermes_cli.friday_user_scope import check_agent
+        check_agent(agent)
+        if (getattr(agent, "_user_id", None) != cap.principal[3]
+                or getattr(agent, "platform", None) != "cli"):
+            _deny()
+    return cap
+
+
+def check_rpc(transport, method, params, sessions):
+    cap = check_transport(transport)
+    if cap is None:
+        return None
+    if method not in _RPC:
+        _deny()
+    check_profile(params.get("profile"))
+    check_workspace(params.get("cwd"))
+    if params.get("source") not in (None, "", "tui", "cli"):
+        _deny()
+    sid = params.get("session_id")
+    # resume's durable id is read only from the same exclusive native store.
+    session = sessions.get(sid) if isinstance(sid, str) else None
+    if session is not None:
+        check_session(session, transport)
+    elif method in _LIVE_REQUIRED:
+        _deny()
+    if method == "session.resume":
+        for record in tuple(sessions.values()):
+            if record.get("session_key") == sid:
+                check_session(record, transport)
+    if method == "session.active_list":
+        for record in tuple(sessions.values()):
+            check_session(record, transport)
+    if method == "session.create":
+        # Seeded/imported/branch transcripts are outside this source package.
+        if any(params.get(key) for key in ("messages", "parent_session_id", "room_plumbing")):
+            _deny()
+        check_workspace(params.get("cwd"))
+    if method in {"slash.exec", "command.dispatch"}:
+        check_slash(method, params)
+    from hermes_cli.friday_user_scope import check_database
+    check_database(cap)
+    return cap
+
+
+def check_workspace(path):
+    cap = current()
+    if cap is None or path in (None, ""):
+        return
+    path = Path(path)
+    workspace = cap.home / "workspace"
+    if (not path.is_absolute() or not path.is_relative_to(workspace)
+            or path.resolve() != path):
+        _deny()
+
+
+def check_slash(method, params):
+    cap = current()
+    if cap is None:
+        return
+    if method == "slash.exec":
+        command = params.get("command")
+        if not isinstance(command, str):
+            _deny()
+        parts = command.strip().lstrip("/").split(maxsplit=1)
+        if not parts or parts[0].lower() not in _SLASH_READS or len(parts) != 1:
+            _deny()
+    else:
+        # Skills use the existing scanner + prompt submit route. Quick/plugin/
+        # bundle/exec dispatch cannot inherit authority across a child process.
+        name = params.get("name")
+        if not isinstance(name, str) or not name.lstrip("/"):
+            _deny()
+
+
+def origin_json(session=None):
+    cap = check_session(session) if session is not None else current()
+    if cap is None:
+        return None
+    import json
+    return json.dumps({"platform": "cli", "profile": cap.profile,
+                      "friday_cli_authority": dict(cap.session_authority),
+                      "friday_account_origin": {
+                          "schema": "friday.account_origin.v1", "platform": "cli",
+                          "transport_profile": cap.principal[1], "account_id": cap.principal[2]}})
