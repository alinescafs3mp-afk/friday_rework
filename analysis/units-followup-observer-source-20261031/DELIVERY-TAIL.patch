+    if stage=='QUESTION':
+        last=rows(db,'SELECT MAX(id) AS last FROM messages WHERE session_id=?',(k.SID,))
+        latest=[delta.question_terminal(rows,db,k.SID,latest,last,live.baseline_last_id,k.PREDECESSOR.native_head['latest'],need)]
+    need(len(latest)==len(users)==1,'one_actual_latest_user_and_terminal');user=users[0]
