+def main_exception_diagnostic(store, args, exc, phase):
+    """Protected first observation only; never authorizes a retry or changes a run."""
+    if store is None or args.command == 'validate':
+        return
+    commands = {'setup', 'preflight', 'stop', 'reset-stop', 'run', 'resume', 'advance',
+                'inspect', 'reject-evidence', 'retire-prepared', 'recover-document',
+                'reconcile-unknown', 'continue-unknown'}
+    phases = {'MAIN_STATE_ADMISSION', 'MAIN_STOP', 'MAIN_CONSUMER_LOCK',
+              'MAIN_COMMAND_EXECUTION', 'MAIN_CONTINUATION_INPUT',
+              'MAIN_CONTINUATION_ADMISSION', 'MAIN_CREDENTIAL_LOAD',
+              'MAIN_CONTINUATION_EXECUTION', 'MAIN_RESULT_OUTPUT'}
+    if args.command not in commands or phase not in phases:
+        return
+    run_id = getattr(args, 'run_id', None)
+    if type(run_id) is not str or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,63}', run_id) is None:
+        run_id = None
+    plan_sha256 = getattr(args, 'plan_sha256', None)
+    if type(plan_sha256) is not str or re.fullmatch(r'[a-f0-9]{64}', plan_sha256) is None:
+        plan_sha256 = None
+    classes = ((RateLimited, 'RATE_LIMITED'), (Uncertain, 'UNCERTAIN'),
+               (ReplyWindowClosed, 'REPLY_WINDOW_CLOSED'), (Refused, 'REFUSED'),
+               (urllib.error.HTTPError, 'HTTP_ERROR'), (urllib.error.URLError, 'URL_ERROR'),
+               (TimeoutError, 'TIMEOUT_ERROR'), (OSError, 'OS_ERROR'),
+               (ValueError, 'VALUE_ERROR'), (TypeError, 'TYPE_ERROR'),
+               (KeyError, 'KEY_ERROR'), (IndexError, 'INDEX_ERROR'),
+               (AttributeError, 'ATTRIBUTE_ERROR'), (AssertionError, 'ASSERTION_ERROR'),
+               (RuntimeError, 'RUNTIME_ERROR'))
+    category = next((label for kind, label in classes if isinstance(exc, kind)), 'EXCEPTION')
+    allowed = {'main', 'continue_unknown', 'continuation_material', 'observe', 'poll_updates',
+               'guard', 'save', 'process', 'capture', 'verify_reply_custody', 'reply_window',
+               'terminal_drain', 'ready', 'call', '_call', '_request', 'safe_read',
+               'no_symlinks', 'run_path', 'write', 'get', 'lock', 'stamp', 'encoded',
+               'cursor_offsets', 'preflight', 'validate_scenario', 'unique_object',
+               'send', '_send'}
+    frames = []; trace = exc.__traceback__
+    for _ in range(128):
+        if trace is None:
+            break
+        code = trace.tb_frame.f_code
+        if code.co_filename == __file__ and code.co_name in allowed:
+            frames.append(dict(source='bot_tester.py', function=code.co_name, line=trace.tb_lineno))
+            frames = frames[-8:]
+        trace = trace.tb_next
+    report = dict(schema='friday.tester.main-exception-diagnostic.v1', at=stamp(),
+                  command=args.command, run_id=run_id, plan_sha256=plan_sha256,
+                  phase=phase, exception_class=category, frames=frames,
+                  outcome='REFUSED_OR_UNKNOWN', original_failure_cause='UNKNOWN', no_retry=True)
+    # No new directories, reads of operation data, or overwrites during failure handling.
+    root = no_symlinks(store.root)
+    directory_fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        info = os.fstat(directory_fd)
+        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
+            raise Refused('Diagnostic directory custody changed')
+        name = 'main-exception-' + args.command + '-' + (run_id or plan_sha256 or 'uncorrelated') + '.json'
+        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+                     0o600, dir_fd=directory_fd)
+        with os.fdopen(fd, 'wb') as stream:
+            stream.write(encoded(report)); stream.flush(); os.fsync(stream.fileno())
+        os.fsync(directory_fd)
+    finally:
+        os.close(directory_fd)
+
