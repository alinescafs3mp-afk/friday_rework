+    @contextmanager
+    def submission_budget(self, row):
+        """Finite metadata allowance for the one pending native submission.
+
+        Large healthy snapshots can occupy this store longer than an ordinary
+        control call may wait. Keep fresh reads and one cumulative allowance;
+        this context never holds a lock across native work. Its caller leaves
+        the context before stop/error cleanup, which retains the usual budget.
+        """
+        from hermes_cli.plugins_state import LockAcquisitionBudget
+        from hermes_cli.friday_cli_caller import current as current_original_caller
+        if self._storage_readonly or self._lock_allowance.get() is not None:
+            raise AssociationError("invalid_submission_budget_context")
+        deadline_unix = _number(row["deadline_unix"])
+        remaining = min(deadline_unix - _number(self.clock()),
+                        _number(row["budget_seconds"]) - _number(row["elapsed_seconds"]))
+        if remaining <= 0:
+            raise TimeoutError("submission_lock_deadline")
+        cutoff = time.monotonic() + remaining
+        store = self
+        span = current_original_caller()
+
+        class SubmissionBudget(LockAcquisitionBudget):
+            @contextmanager
+            def acquiring(self):
+                # Clip every acquisition, including the native PluginState
+                # locks after slow I/O, against the original absolute bounds.
+                with super().acquiring() as offered:
+                    now = time.monotonic()
+                    end = min(offered, cutoff, now + deadline_unix - _number(store.clock()))
+                    if current_original_caller() is not span:
+                        raise AssociationError("submission_caller_changed")
+                    if span is not None:
+                        span.check("submission_lock_entry", cleanup=True)
+                        end = min(end, span.end)
+                    if end <= now:
+                        raise TimeoutError("submission_lock_deadline")
+                    yield end
+
+        token = self._lock_allowance.set(SubmissionBudget(min(2.0, remaining)))
+        try:
+            yield
+        finally:
+            self._lock_allowance.reset(token)
 
