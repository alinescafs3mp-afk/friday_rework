+"""Private exact native dispatch for the existing source-history projector."""
+raise RuntimeError("UNBOUND archival projection; execution forbidden")
+NATIVE_HISTORY = {'path': 'UNBOUND_PATH_005', 'sha256': 'UNBOUND_DIGEST_081'}
+NATIVE_BASELINE = {'path': 'UNBOUND_PATH_032', 'sha256': 'UNBOUND_DIGEST_131'}
+NATIVE_ORIGINAL = {'path': 'UNBOUND_PATH_033', 'sha256': 'UNBOUND_DIGEST_090'}
+ORIGINAL_PROJECTOR = {'path':'UNBOUND_PATH_113','sha256':'UNBOUND_DIGEST_102'}
+def _historical_namespace(ns, projected):
+    """Only authenticated H paths cross source edges; native stays actual."""
+    if ns.get('NATIVE_VERIFIER') in (NATIVE_BASELINE,NATIVE_ORIGINAL):
+        ns['NATIVE_VERIFIER'] = NATIVE_HISTORY
+    if 'raw' in ns:
+        original_raw=ns['raw']
+        def projected_raw(path):return projected[str(path)][0] if str(path) in projected else original_raw(path)
+        ns['raw']=projected_raw
+    if 'saved_receipt_bytes' in ns and 'state_record' in ns:
+        original_read=ns['read']
+        def projected_read(path):return projected[str(path)] if str(path) in projected else original_read(path)
+        ns['read']=projected_read
+    if '_verified_adapter' in ns:
+        original_adapter=ns['_verified_adapter']
+        def verified_adapter(reference):return _historical_namespace(original_adapter(reference),projected)
+        ns['_verified_adapter']=verified_adapter
+    if 'module' in ns:
+        original_module=ns['module']
+        def projected_module(reference,name):
+            if reference in (NATIVE_BASELINE,NATIVE_HISTORY):
+                return original_module(NATIVE_HISTORY,name)
+            if reference == NATIVE_ORIGINAL:
+                return original_module(NATIVE_HISTORY,name)['module']()
+            if reference == ORIGINAL_PROJECTOR:
+                original=original_module(reference,name)
+                original['_historical_namespace']=_historical_namespace
+                return _historical_namespace(original,projected)
+            return _historical_namespace(original_module(reference,name),projected)
+        ns['module']=projected_module
+    return ns
